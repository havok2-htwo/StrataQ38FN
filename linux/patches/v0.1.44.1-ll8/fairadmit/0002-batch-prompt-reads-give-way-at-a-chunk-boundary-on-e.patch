+// read_yield: where a batch prompt read may give way and into which slot, and that the read after the stop reads the
+// same chunks, takes the same periodic checkpoints and cuts the same segments (synthetic: no model, no GPU).
+#include "strata/program/message_boundary.hpp"
+#include "strata/program/read_yield.hpp"
+
+#include <cstdio>
+#include <utility>
+#include <vector>
+
+namespace ry = strata::program::read_yield;
+
+static int fails = 0;
+#define CHECK(c) do { if (!(c)) { std::printf("FAIL %s:%d %s\n", __FILE__, __LINE__, #c); ++fails; } } while (0)
+
+// the pipelined groups' pad rows (generate.cpp's pump): a group starts at the width of its last active slot, and
+// every idle slot below that width gets a pad row.  true: slot b would be written by a window of its group
+static bool padded(const std::vector<bool>& active, int k, int b) {
+    const int g0 = b - b % k;
+    int width = 0;
+    for (int t = 0; t < k; ++t)
+        if (active[(size_t) (g0 + t)]) width = t + 1;
+    return !active[(size_t) b] && b - g0 < width;
+}
+
+int main() {
+    // ---- switches
+    CHECK(!ry::env_on(nullptr) && !ry::env_on("") && !ry::env_on("0") && ry::env_on("1") && ry::env_on("yes"));
+    CHECK(ry::env_count(nullptr) == 0 && ry::env_count("") == 0 && ry::env_count("x") == 0 && ry::env_count("-3") == 0);
+    CHECK(ry::env_count("3") == 3 && ry::env_count("12a") == 0);
+
+    // ---- the position rule
+    const int64_t C = 512;
+    CHECK(!ry::pos_ok(0, 0, 100000, C, 64));             // never before the first chunk
+    CHECK(ry::pos_ok(512, 0, 100000, C, 64));
+    CHECK(!ry::pos_ok(700, 0, 100000, C, 64));           // not a chunk boundary
+    CHECK(ry::pos_ok(8192 + 1024, 8192, 100000, C, 64)); // the grid is the segment's (it starts at its cut)
+    CHECK(!ry::pos_ok(8192 + 1000, 8192, 100000, C, 64));
+    // the rest must be more than a chunk and more than a short read
+    CHECK(!ry::pos_ok(99840, 0, 100000, C, 64));         // 160 left
+    CHECK(!ry::pos_ok(99840, 0, 100352, C, 64));         // exactly one chunk left: the single-chunk path
+    CHECK(ry::pos_ok(99328, 0, 100352, C, 64));          // two chunks left
+    CHECK(!ry::pos_ok(99328, 0, 100352, C, 1536));       // ... but a short read of 1536 would take that rest
+    CHECK(!ry::pos_ok(100352, 0, 100352, C, 64));        // the end is no stop
+    // STRATA_READ_YIELD_TEST_AT=k: only from chunk k of the segment on
+    CHECK(!ry::pos_ok(1024, 0, 100000, C, 64, 3) && ry::pos_ok(1536, 0, 100000, C, 64, 3));
+    CHECK(ry::pos_ok(8192 + 1536, 8192, 100000, C, 64, 3) && !ry::pos_ok(8192 + 1024, 8192, 100000, C, 64, 3));
+    CHECK(ry::pos_ok(512, 0, 100000, 0, 0));             // (a degenerate chunk counts as 1)
+
+    // ---- the read after the stop reads the chunks the read without it reads, for every allowed stop
+    for (int64_t a0 : {0, 8192, 12345})
+        for (int64_t len : {2048, 5000, 100000, 131071}) {
+            const int64_t b0 = a0 + len;
+            const auto whole = ry::chunks(a0, b0, C);
+            for (int64_t q = a0; q <= b0; ++q) {
+                if (!ry::pos_ok(q, a0, b0, C, 64)) continue;
+                auto split = ry::chunks(a0, q, C);
+                const auto rest = ry::chunks(q, b0, C);
+                CHECK(rest.size() >= 2);                  // never the single-chunk way
+                split.insert(split.end(), rest.begin(), rest.end());
+                CHECK(split == whole);
+            }
+        }
+    // two stops in one read (STRATA_YIELDS_MAX=2): still the same chunks
+    {
+        const int64_t a0 = 4096, b0 = 4096 + 60000;
+        auto v = ry::chunks(a0, a0 + 10 * C, C);
+        CHECK(ry::pos_ok(a0 + 10 * C, a0, b0, C, 64));
+        const auto mid = ry::chunks(a0 + 10 * C, a0 + 30 * C, C);
+        CHECK(ry::pos_ok(a0 + 30 * C, a0 + 10 * C, b0, C, 64));   // the resumed run's own segment start
+        CHECK(ry::pos_ok(a0 + 30 * C, a0, b0, C, 64));            // ... is on the original grid too
+        const auto end = ry::chunks(a0 + 30 * C, b0, C);
