--- /dev/null
+++ b/serve/test_admit_est.py
@@ -0,0 +1,330 @@
+"""serve/test_admit_est.py - STRATA_ADMIT_BY_NEW=1: the admission order by estimated NEW tokens (serve/admit_est.py,
+StrataEngine._take_control / _admit_next / _shorter_waiting / generate_batched; no GPU).
+
+    python -m unittest serve.test_admit_est -v
+"""
+from __future__ import annotations
+
+import contextlib
+import io
+import json
+import random
+import sys
+import time
+import unittest
+from pathlib import Path
+from unittest import mock
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import serve.server as server  # noqa: E402
+from serve.admit_est import BLOCK, AdmitEstimate, chain  # noqa: E402
+from serve import test_admit_order  # noqa: E402
+from serve.test_image_alone import engine_without_process, until  # noqa: E402
+
+
+def toks(n, seed):
+    r = random.Random(seed)
+    return [r.randrange(150000) for _ in range(n)]
+
+
+class Chain(unittest.TestCase):
+    def test_whole_blocks_only_and_deterministic(self):
+        ids = toks(3 * BLOCK + 17, 1)
+        self.assertEqual(len(chain(ids)), 3)
+        self.assertEqual(chain(ids), chain(list(ids)))
+        self.assertEqual(chain(ids[:BLOCK - 1]), [])
+
+    def test_a_chain_covers_everything_before(self):
+        a, b = toks(2 * BLOCK, 2), toks(2 * BLOCK, 2)
+        b[5] += 1                                       # differs in block 0: every later hash differs too
+        ca, cb = chain(a), chain(b)
+        self.assertNotEqual(ca[0], cb[0])
+        self.assertNotEqual(ca[1], cb[1])
+        c = a[:BLOCK] + toks(BLOCK, 3)                  # same block 0, different block 1
+        self.assertEqual(chain(c)[0], ca[0])
+        self.assertNotEqual(chain(c)[1], ca[1])
+
+    def test_extending_a_prefix_equals_hashing_it_all(self):
+        p = toks(5 * BLOCK + 100, 4)
+        full = p + toks(3 * BLOCK, 5)
+        self.assertEqual(chain(full, prefix=chain(p)), chain(full))
+
+    def test_numpy_like_ints_hash_as_ints(self):
+        try:
