+class EndToEnd(unittest.TestCase):
+    """The real StrataEngine + Service with test_parallel's fake engine: a second turn is estimated from the first
+    one's prompt + reply, one admission line each, /v1/load shows the estimator; replies are as without it."""
+
+    def test_second_turn_estimate(self):
+        from serve.test_parallel import ParallelService
+        t = ParallelService("test_concurrent_requests_share_the_slots")
+        out = io.StringIO()
+        with mock.patch.object(server, "ADMIT_BY_NEW", True), mock.patch.object(server, "ADMIT_SHORT_FIRST", 8192), \
+                contextlib.redirect_stdout(out):
+            t.start(2)
+            try:
+                first = "tell me " * 200                # ~1,600 byte tokens: several blocks
+                body1 = [{"role": "user", "content": first}]
+                r1 = t.chat(first)["choices"][0]["message"]["content"]
+                self.assertEqual(r1, "ok, done.")
+                body2 = body1 + [{"role": "assistant", "content": r1}, {"role": "user", "content": "and more " * 60}]
+                req = server.urllib.request.Request(
+                    t.base + "/v1/chat/completions",
+                    data=json.dumps({"messages": body2, "max_tokens": 64, "reasoning_effort": "none"}).encode(),
+                    headers={"Content-Type": "application/json"})
+                with server.urllib.request.urlopen(req, timeout=60) as r:
+                    r2 = json.loads(r.read().decode())["choices"][0]["message"]["content"]
+                self.assertEqual(r2, "ok, done.")
+                load = t.get("/v1/load")
+            finally:
+                t.tearDown()
+        lines = [x for x in out.getvalue().splitlines() if "[strata] admit: total" in x]
+        self.assertEqual(len(lines), 2, out.getvalue()[-3000:])
+        self.assertIn("cached ~0)", lines[0])
+        cached = int(lines[1].split("cached ~")[1].split(")")[0])
+        self.assertGreaterEqual(cached, 1600 // BLOCK * BLOCK - BLOCK, lines)
+        self.assertIn("admit_by_new", load)
+        self.assertGreater(load["admit_by_new"]["cache"]["blocks"], 0)
+        self.assertEqual(load["admit_by_new"]["waiting"], [])
+
