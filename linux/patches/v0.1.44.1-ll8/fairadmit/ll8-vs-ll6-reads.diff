+class OrderByNew(test_admit_order.AdmitOrderTest):
+    """_admit_next and the #656 give-way with estimated new tokens (the entries generate_batched makes)."""
+    # (AdmitOrderTest's own tests run in serve.test_admit_order)
+    test_short_first_puts_the_chat_before_the_agent_reads = test_a_long_request_that_waited_too_long_goes_first = None
+    test_off_by_default = test_a_continuation_is_not_held_back = None
+
+    def ranked(self, est, prompt):
+        _, new, _ = est.estimate(prompt)
+        return new
+
+    def test_follow_ups_go_before_cold_reads(self):
+        """The bench's case: cold 11K first turns queued, then 15K follow-ups whose first 11K the engine holds.  By
+        total every one is long (FIFO); by new tokens the follow-ups (~4K) are short and go first."""
+        est = AdmitEstimate()
+        convs = [toks(11000, 30 + i) for i in range(2)]
+        for p in convs:
+            est.note(p + toks(250, 40))
+        cold = [self.ranked(est, toks(11000, 50 + i)) for i in range(2)]
+        follow = [self.ranked(est, p + toks(250, 40) + toks(4000, 60)) for p in convs]
+        self.assertTrue(all(c > 8192 for c in cold) and all(f <= 8192 for f in follow), (cold, follow))
+        with mock.patch.object(server, "ADMIT_SHORT_FIRST", 8192), mock.patch.object(server, "ADMIT_MAX_WAIT_S", 45.0):
+            order = self.queue(("cold1", cold[0]), ("cold2", cold[1]), ("fu1", follow[0]), ("fu2", follow[1]))
+        self.assertEqual(order, ["fu1", "fu2", "cold1", "cold2"])
+
+    def test_a_cold_read_that_waited_the_limit_goes_first(self):
+        """The max-wait guard still holds: no cold read is starved by a stream of follow-ups."""
+        with mock.patch.object(server, "ADMIT_SHORT_FIRST", 8192), mock.patch.object(server, "ADMIT_MAX_WAIT_S", 0.3):
+            self.assertTrue(self.e.ctl.acquire(timeout=1))
+            self.take("cold", 11000, new=True, total=11000)
+            self.until(lambda: self.e.waiting == 1)
+            time.sleep(0.5)                             # past the limit
+            self.take("fu", 4100, new=True, total=15400)
+            self.until(lambda: self.e.waiting == 2)
+            self.e.ctl.release()
+            self.until(lambda: len(self.order) == 2, s=15.0)
+        self.assertEqual(self.order, ["cold", "fu"])
+
+    def test_the_entries_keep_both_lengths(self):
+        with mock.patch.object(server, "ADMIT_SHORT_FIRST", 8192), mock.patch.object(server, "ADMIT_BY_NEW", True):
+            self.assertTrue(self.e.ctl.acquire(timeout=1))
+            self.take("fu", 4100, new=True, total=15400)
+            self.until(lambda: self.e.waiting == 1)
+            c = self.e.load_counts()
+            self.e.ctl.release()
+            self.until(lambda: len(self.order) == 1)
+        self.assertEqual([(w["total"], w["est_new"]) for w in c["admit_by_new"]], [(15400, 4100)])
+
+    def test_give_way_compares_new_tokens(self):
+        """#656: a cold 11K read gives way to a waiting follow-up of 4K new (15K total); by total it would not."""
+        e = engine_without_process(4)
+        with e.slot_cv:
+            e.wait_lens.append([4100, time.monotonic(), True, 15400])
+        self.assertTrue(e._shorter_waiting(11000))      # by new tokens: 4100 * 2 <= 11000
+        with e.slot_cv:
+            e.wait_lens[:] = [[15400, time.monotonic(), True, 15400]]
+        self.assertFalse(e._shorter_waiting(11000))     # by total (STRATA_ADMIT_BY_NEW off): no
+
