+# STRATA_ADMIT_EST_BLOCKS: the 256-token block hashes kept (default 65536, ~5 MB).  Only the order changes.
+def admit_env(env) -> tuple[int, bool, float, int]:
+    """(STRATA_ADMIT_SHORT_FIRST, STRATA_ADMIT_BY_NEW, STRATA_ADMIT_MAX_WAIT_S, STRATA_ADMIT_EST_BLOCKS) - see above."""
+    try:
+        short = max(0, int(env.get("STRATA_ADMIT_SHORT_FIRST") or 0))
+    except ValueError:
+        short = 0
+    by_new = str(env.get("STRATA_ADMIT_BY_NEW", "")).strip().lower() in ("1", "on", "true", "yes")
+    if by_new and short == 0 and not str(env.get("STRATA_ADMIT_SHORT_FIRST", "")).strip():
+        short = 8192
+    try:
+        wait = float(env.get("STRATA_ADMIT_MAX_WAIT_S", 45.0 if by_new else 30.0))
+    except ValueError:
+        wait = 45.0 if by_new else 30.0
+    try:
+        blocks = max(1, int(env.get("STRATA_ADMIT_EST_BLOCKS") or 65536))
+    except ValueError:
+        blocks = 65536
+    return short, by_new, (0.0 if wait <= 0 else wait), blocks     # (as _timeout_env: nan/inf kept as before)
+
+
+ADMIT_SHORT_FIRST, ADMIT_BY_NEW, ADMIT_MAX_WAIT_S, ADMIT_EST_BLOCKS = admit_env(os.environ)
 
 
