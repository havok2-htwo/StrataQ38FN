+namespace {
+// After the authoritative pools were rewritten: the VRAM slots of a streamed state still hold the outgoing
+// conversation, so resolve must refill them before any attention reads (shared by restore and direct copy).
+bool refresh_residency(const QsaState& st, const ModelGeometry& g, int64_t upto, std::string& error) {
     if (st.kv_mode == 1) strata::kernels::kv_stream_reset(st.map, nullptr);
     if (st.kv_mode == 2 && upto > 0) {
         auto shapes = strata::kernels::qsa_real_shapes();
@@ -224,6 +217,45 @@ bool conversation_kv_restore(const ConversationKv& image, const QsaState& st, co
     error = std::string("conversation snapshot residency restore: ") + cudaGetErrorString(status);
     return false;
 }
+} // namespace
+
+bool conversation_kv_copy(const QsaState& from, const QsaState& to, const ModelGeometry& g,
+                          int64_t upto, bool index, std::string& error) {
+    Layout lf{}, lt{};
+    if (!layout(from, g, upto, index, lf, error) || !valid(from, lf, upto, error) ||
+        !layout(to, g, upto, index, lt, error) || !valid(to, lt, upto, error)) return false;
+    if (lf.format != lt.format || lf.cells != lt.cells || lf.page_size != lt.page_size ||
+        lf.pooled_rows != lt.pooled_rows || lf.data != lt.data || lf.value_data != lt.value_data ||
+        lf.scales != lt.scales || lf.value_scales != lt.value_scales || lf.pooled != lt.pooled) {
+        error = "conversation snapshot: direct K/V copy between different layouts";
+        return false;
+    }
+    // The same bytes conversation_kv_save + conversation_kv_restore move, without the host image: each part
+    // straight from the source's authoritative pool into the target's (device or mapped host memory), queued on
+    // the legacy stream so the residency refresh below and the caller's kernels run after it.
+    const auto src = pools(from);
+    const auto dst = pools(to);
+    const std::array<size_t,5> sizes = {lf.data, lf.value_data, lf.scales, lf.value_scales, lf.pooled};
+    for (size_t i = 0; i < sizes.size(); ++i) {
+        if (!sizes[i]) continue;
+        if (!src[i] || !dst[i]) { error = "conversation snapshot: missing state buffer"; return false; }
+        const cudaError_t e = cudaMemcpyAsync(dst[i], src[i], sizes[i], cudaMemcpyDefault, nullptr);
+        if (e != cudaSuccess) { error = std::string("conversation snapshot direct copy: ") + cudaGetErrorString(e); return false; }
+    }
+    return refresh_residency(to, g, upto, error);
+}
+
+bool conversation_kv_restore(const ConversationKv& image, const QsaState& st, const ModelGeometry& g,
+                             int64_t upto, bool index, std::string& error) {
+    if (!conversation_kv_validate(image, st, g, upto, index, error)) return false;
+    const std::array<const ConversationBuffer*,5> src = {&image.k, &image.v, &image.k_scale, &image.v_scale, &image.pooled};
+    const auto dst = pools(st);
+    for (size_t i = 0; i < src.size(); ++i)
+        if (!src[i]->visit(0, src[i]->size(), [&](const uint8_t* p, size_t n, size_t at) {
+                return transfer(static_cast<uint8_t*>(dst[i]) + at, p, n, error);
+            })) return false;
+    return refresh_residency(st, g, upto, error);
+}
 
 bool conversation_kv_part_sizes(const QsaState& st, const ModelGeometry& g, int64_t upto, bool index,
                                 std::array<uint64_t, 5>& sizes, std::string& error) {
diff --git a/src/core/conversation_state.cpp b/src/core/conversation_state.cpp
index ae40f3a..d4efdbd 100644
--- a/src/core/conversation_state.cpp
+++ b/src/core/conversation_state.cpp
@@ -192,6 +192,43 @@ bool conversation_checkpoint_restore(const ConversationCheckpoint& c, SessionSta
     return sync(error);
 }
 
+bool conversation_checkpoint_copy(const SessionState& from, SessionState& to, const std::vector<int32_t>& ids,
+                                  const ModelGeometry& g, std::string& error) {
+    // conversation_checkpoint_save(from) + conversation_checkpoint_restore(to) without the host image, for two
+    // sessions carved alike on the same device (a stage's own session and its batch slots): the same bytes into
+    // the same places, queued on the legacy stream (asynchronous; the caller synchronizes once at the end).
+    ConversationStateSizes zf, zt;
+    if (!checkpoint_targets(from, g, ids.size(), zf, error) || !checkpoint_targets(to, g, ids.size(), zt, error))
+        return false;
+    if (zf.gdn != zt.gdn || zf.tail != zt.tail || zf.dead != zt.dead || zf.block_pos != zt.block_pos ||
+        owned_qsa(from) != owned_qsa(to) || (from.ple_hist != nullptr) != (to.ple_hist != nullptr))
+        return fail(error, "direct copy between differently carved sessions");
+    auto acopy = [&](void* dst, const void* src, size_t bytes) {
+        if (!bytes) return true;
+        if (!dst || !src) return fail(error, "missing running-state buffer");
+        const auto status = cudaMemcpyAsync(dst, src, bytes, cudaMemcpyDefault, nullptr);
+        if (status == cudaSuccess) return true;
+        error = std::string("conversation snapshot direct running-state copy: ") + cudaGetErrorString(status);
+        return false;
+    };
+    if (!acopy(to.gdn_state, from.gdn_state, zf.gdn) ||
+        !acopy(to.ple_hist, from.ple_hist, from.ple_hist ? zf.ple : 0)) return false;
+    for (size_t j = 0; j < owned_qsa(from); ++j) {
+        const auto& a = owned(from, j);
+        const auto& b = owned(to, j);
+        if (!acopy(b.idx_tail, a.idx_tail, zf.tail) || !acopy(b.idx_dead, a.idx_dead, zf.dead) ||
+            !acopy(b.idx_block_pos, a.idx_block_pos, zf.block_pos)) return false;
+        if (!ids.empty()) {   // restore writes the saved `dead` row into the pooled row the next token fills
+            const size_t row = ids.size() / strata::kernels::qsa_real_shapes().idx_block;
+            if (!acopy(b.idx_pooled + row * g.idx_key_dim, a.idx_dead, zf.dead)) return false;
+        }
+    }
+    const size_t tokens = ids.size();
+    to.ple_prev[0] = tokens >= 2 ? ids[tokens - 2] : -1;
+    to.ple_prev[1] = tokens >= 1 ? ids[tokens - 1] : -1;
+    return true;
+}
+
 bool conversation_snapshot_bytes(const ConversationView& view, const SessionState& ss,
                                  const ModelGeometry& g, const QsaState* draft, size_t& bytes, std::string& error) {
     bytes = 0;
