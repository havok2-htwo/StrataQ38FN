+// One token's top-10 by one warp (route_multi's body; STRATA_ROUTE_PLAN_FUSE runs the same code).  With S_IDS the
+// picked ids are also stored in the block's shared copy at s_ids[rank].
+template <bool S_IDS>
+__device__ __forceinline__ void route_row(const float* __restrict__ logits, int32_t* __restrict__ ids,
+                                          float* __restrict__ weights, int lane, int32_t* s_ids) {
     float values[16];
 #pragma unroll
     for (int i = 0; i < 16; ++i) values[i] = logits[lane + i * 32];
@@ -140,6 +138,7 @@ __global__ void route_multi(const float* __restrict__ logits, int32_t* __restric
         if ((expert & 31) == lane) {
