+// STRATA_GR_UP_SPLIT=2 / 4 (opt-in, with STRATA_GR_FAST): gr_up_fast_kernel on 2 / 4 times the blocks - 8 / 4 columns a
+// block (320 blocks of 256 threads, one pass of 32 rows / 640 blocks of 128 threads, 16 rows), at most 64 registers
+// so the whole grid is resident at once (4 / 8 blocks an SM on 82 SMs), and an instantiation per token count (the
+// token loop and the lo staging unrolled at compile time).  Each row is still 8 lanes with the same chunks, the same
+// combination and the same xor tree, each column's 4 streams sum in one block in the same order: the same bits.
+template <int COLS, int MAX_T, bool EXACT_T>
+__global__ void __launch_bounds__(up_fast_threads<COLS>(), THREADS * 4 / up_fast_threads<COLS>()) gr_up_fast_split_kernel(GrMulti m) {
+    gr_up_fast_body<COLS, MAX_T, EXACT_T>(m);
+}
+template <int COLS>
+void launch_up_split_cols(const GrMulti& m, bool generic, cudaStream_t st) {
+    constexpr int G = N / COLS, NT = up_fast_threads<COLS>();
+    switch (generic ? 0 : m.T) {
+        case 1: gr_up_fast_split_kernel<COLS, 1, true><<<G, NT, 0, st>>>(m); break;
+        case 2: gr_up_fast_split_kernel<COLS, 2, true><<<G, NT, 0, st>>>(m); break;
+        case 3: gr_up_fast_split_kernel<COLS, 3, true><<<G, NT, 0, st>>>(m); break;
+        case 4: gr_up_fast_split_kernel<COLS, 4, true><<<G, NT, 0, st>>>(m); break;
+        case 5: gr_up_fast_split_kernel<COLS, 5, true><<<G, NT, 0, st>>>(m); break;
+        case 6: gr_up_fast_split_kernel<COLS, 6, true><<<G, NT, 0, st>>>(m); break;
+        case 7: gr_up_fast_split_kernel<COLS, 7, true><<<G, NT, 0, st>>>(m); break;
+        case 8: gr_up_fast_split_kernel<COLS, 8, true><<<G, NT, 0, st>>>(m); break;
+        default: gr_up_fast_split_kernel<COLS, kFusedGrMaxT, false><<<G, NT, 0, st>>>(m); break;
+    }
+}
+// generic: STRATA_NO_MULTI_GR=1 (the token count read at run time, as the default kernels then)
+void launch_up_split(const GrMulti& m, int split, bool generic, cudaStream_t st) {
+    if (split == 4) launch_up_split_cols<UPM_COLS / 4>(m, generic, st);
+    else launch_up_split_cols<UPM_COLS / 2>(m, generic, st);
 }
 #endif
 
