+// STRATA_GR_DOWN_SPLIT=2 / 4 (opt-in): the staged down projection on 2 / 4 times the blocks - 4 / 2 rows (warps) a
+// block instead of 8, so 81 / 162 blocks instead of 41 on the card's SMs (an RTX 3090 has 82: the 41-block grid leaves
+// half of them idle, and each busy one reads its 8 rows' weights and runs 8 rows x T tokens of shared-memory dots).
+// Every row is still one warp with the same chunks per lane in the same order and the same xor tree, so every output
+// is the same bits; only how many rows share a block's staged activations changes.  Only the launches with an
+// exact token count (multi-GR on, the default); 4 is taken as 2 for launches of more than 4 tokens (two blocks of
+// 2 x T x 5 KiB would not share an SM).  Anything else = 1, the 41 blocks.  fused_gr_set_down_split (the bench) overrides it.
+int g_down_split = -1;
+int gr_down_split() {
+    static const int env = [] {
+        const char* v = std::getenv("STRATA_GR_DOWN_SPLIT");
+        const int n = v != nullptr ? std::atoi(v) : 1;
+        return n == 2 || n == 4 ? n : 1;
+    }();
+    return g_down_split == 2 || g_down_split == 4 ? g_down_split : (g_down_split >= 0 ? 1 : env);
+}
+template <int PF, int ROWS>
+void launch_down_split_pf(int ct, const GrMulti& c, size_t smem, cudaStream_t st) {
+    constexpr int G = down_grid<ROWS>(), NT = ROWS * 32;
+    switch (ct) {
+        case 1: gr_down_staged_pf_kernel<1, PF, ROWS><<<G, NT, smem, st>>>(c); break;
+        case 2: gr_down_staged_pf_kernel<2, PF, ROWS><<<G, NT, smem, st>>>(c); break;
+        case 3: gr_down_staged_pf_kernel<3, PF, ROWS><<<G, NT, smem, st>>>(c); break;
+        case 4: gr_down_staged_pf_kernel<4, PF, ROWS><<<G, NT, smem, st>>>(c); break;
+        case 5: gr_down_staged_pf_kernel<5, PF, ROWS><<<G, NT, smem, st>>>(c); break;
+        default: gr_down_staged_pf_kernel<6, PF, ROWS><<<G, NT, smem, st>>>(c); break;
+    }
+}
+// the split launch of ct tokens (exact token count): PF tiles of weights in flight for 1..6 tokens (PF 1 = the staged
+// kernel's distance), the generic staged kernel for 7 and 8
+template <int ROWS>
+void launch_down_split(int ct, int pf, const GrMulti& c, size_t smem, cudaStream_t st) {
+    if (ct > 6) {
+        gr_down_staged_kernel<kFusedGrMaxT, false, ROWS><<<down_grid<ROWS>(), ROWS * 32, smem, st>>>(c);
+        return;
+    }
+    if (pf == 3) launch_down_split_pf<3, ROWS>(ct, c, smem, st);
+    else if (pf == 2) launch_down_split_pf<2, ROWS>(ct, c, smem, st);
+    else launch_down_split_pf<1, ROWS>(ct, c, smem, st);
+}
+// the shared-memory opt-in of the split kernels, once per device when a split is first asked for
+template <int ROWS>
+void set_split_attr(int optin) {
+    auto set = [&](auto kernel, int max_t) {
+        int ws = (int) (2 * max_t * H_TILE * sizeof(float));
+        if (optin > 0 && ws > optin) ws = optin;
+        if (ws > 48 * 1024) cudaFuncSetAttribute(kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, ws);
+        cudaFuncSetAttribute(kernel, cudaFuncAttributePreferredSharedMemoryCarveout, 100);
+    };
+    set(gr_down_staged_pf_kernel<1, 1, ROWS>, 1); set(gr_down_staged_pf_kernel<2, 1, ROWS>, 2);
+    set(gr_down_staged_pf_kernel<3, 1, ROWS>, 3); set(gr_down_staged_pf_kernel<4, 1, ROWS>, 4);
+    set(gr_down_staged_pf_kernel<5, 1, ROWS>, 5); set(gr_down_staged_pf_kernel<6, 1, ROWS>, 6);
+    set(gr_down_staged_pf_kernel<1, 2, ROWS>, 1); set(gr_down_staged_pf_kernel<2, 2, ROWS>, 2);
+    set(gr_down_staged_pf_kernel<3, 2, ROWS>, 3); set(gr_down_staged_pf_kernel<4, 2, ROWS>, 4);
+    set(gr_down_staged_pf_kernel<5, 2, ROWS>, 5); set(gr_down_staged_pf_kernel<6, 2, ROWS>, 6);
+    set(gr_down_staged_pf_kernel<1, 3, ROWS>, 1); set(gr_down_staged_pf_kernel<2, 3, ROWS>, 2);
+    set(gr_down_staged_pf_kernel<3, 3, ROWS>, 3); set(gr_down_staged_pf_kernel<4, 3, ROWS>, 4);
+    set(gr_down_staged_pf_kernel<5, 3, ROWS>, 5); set(gr_down_staged_pf_kernel<6, 3, ROWS>, 6);
+    set(gr_down_staged_kernel<kFusedGrMaxT, false, ROWS>, kFusedGrMaxT);
+}
+void ensure_split_attr() {
+    static std::atomic<bool> done[64];
+    int dev = 0;
+    if (cudaGetDevice(&dev) != cudaSuccess || dev < 0 || dev >= 64 || done[dev].load()) return;
+    int optin = 0;
+    cudaDeviceGetAttribute(&optin, cudaDevAttrMaxSharedMemoryPerBlockOptin, dev);
+    optin = strata::smem_optin_of(optin);   // STRATA_EMULATE_CC (tests only)
+    set_split_attr<4>(optin);
+    set_split_attr<2>(optin);
+    cudaGetLastError();      // drop any error the attempt left behind
+    done[dev].store(true);
+}
