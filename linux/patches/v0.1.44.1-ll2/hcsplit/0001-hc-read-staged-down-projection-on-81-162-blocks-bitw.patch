+                        K::fused_gr_read_multi(&as[(size_t) (i % cold_sets) * 8], T, dxn, s, dst, i * 4 + 1);
+                        K::gpu_stamp(dst, i * 4 + 3, s);
+                    }
+                    cudaStreamSynchronize(s);
+                }
+                cudaMemcpy(hst.data(), dst, hst.size() * 8, cudaMemcpyDeviceToHost);
+                double best = 1e30;
+                for (int rep = 0; rep < 3; ++rep) {
+                    cudaEventRecord(e0, s);
+                    for (int i = 0; i < iters; ++i) K::fused_gr_read_multi(&as[(size_t) (i % cold_sets) * 8], T, dxn, s);
+                    cudaEventRecord(e1, s);
+                    cudaEventSynchronize(e1);
+                    float ms = 0;
+                    cudaEventElapsedTime(&ms, e0, e1);
+                    best = std::fmin(best, 1e3 * ms / iters);
+                }
+                std::vector<double> d_;
+                for (int i = 1; i < iters; ++i) d_.push_back((double) (hst[(size_t) i * 4 + 2] - hst[(size_t) i * 4 + 1]));
+                std::sort(d_.begin(), d_.end());
+                std::printf("SPLIT down %d T %d | read %6.1f us (events, best of 3) | down stamp median %5.1f us | %s\n", arm, T,
+                            best, d_[d_.size() / 2] / 1e3, err ? "CUDA ERROR" : (same ? "bitwise equal to down 0" : "DIFFERS from down 0"));
+            }
+            K::fused_gr_set_down_split(-1);
+        }
     }
     std::printf("fused_gr_bench: %d differing\n", failures);
     return failures ? 1 : 0;
