From bbe587e50a682399e2f2b4c9f53d658f85e2e77b Mon Sep 17 00:00:00 2001
From: havok2-htwo <havok2-htwo@users.noreply.github.com>
Date: Fri, 16 Oct 2026 14:13:53 +0200
Subject: [PATCH 6/7] tests: gr_parity arms for down split 4 with PF 1 / 3 and
 up split 4 generic (opt-in STRATA_GR_DOWN_SPLIT / STRATA_GR_UP_SPLIT)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 CMakeLists.txt | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index d0d86356..df49ab5d 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -980,6 +980,10 @@ if(STRATA_ENABLE_CUDA OR STRATA_ENABLE_HIP)
                        "STRATA_HC_SPLIT=2;STRATA_GR_DOWN_SPLIT=4;STRATA_GR_DOWN_PF=2;STRATA_GR_FAST=1;STRATA_GR_NORM_FAST=1")
   add_test(NAME gr_parity_down_split2_pf3 COMMAND gr_parity --selftest)
   set_tests_properties(gr_parity_down_split2_pf3 PROPERTIES ENVIRONMENT "STRATA_HC_SPLIT=2;STRATA_GR_DOWN_SPLIT=2;STRATA_GR_DOWN_PF=3")
+  add_test(NAME gr_parity_down_split4 COMMAND gr_parity --selftest)
+  set_tests_properties(gr_parity_down_split4 PROPERTIES ENVIRONMENT "STRATA_HC_SPLIT=2;STRATA_GR_DOWN_SPLIT=4")
+  add_test(NAME gr_parity_down_split4_pf3 COMMAND gr_parity --selftest)
+  set_tests_properties(gr_parity_down_split4_pf3 PROPERTIES ENVIRONMENT "STRATA_HC_SPLIT=2;STRATA_GR_DOWN_SPLIT=4;STRATA_GR_DOWN_PF=3")
   # the fast up projection on 320 / 640 blocks (STRATA_GR_UP_SPLIT=2 / 4), with the production switches; the
   # STRATA_QFUSE part of gr_parity checks that a q8_1 read keeps the 16-column kernel
   add_test(NAME gr_parity_up_split2 COMMAND gr_parity --selftest)
@@ -991,6 +995,9 @@ if(STRATA_ENABLE_CUDA OR STRATA_ENABLE_HIP)
   add_test(NAME gr_parity_up_split2_generic COMMAND gr_parity --selftest)
   set_tests_properties(gr_parity_up_split2_generic PROPERTIES ENVIRONMENT
                        "STRATA_HC_SPLIT=2;STRATA_GR_UP_SPLIT=2;STRATA_GR_FAST=1;STRATA_NO_MULTI_GR=1")
+  add_test(NAME gr_parity_up_split4_generic COMMAND gr_parity --selftest)
+  set_tests_properties(gr_parity_up_split4_generic PROPERTIES ENVIRONMENT
+                       "STRATA_HC_SPLIT=2;STRATA_GR_UP_SPLIT=4;STRATA_GR_FAST=1;STRATA_NO_MULTI_GR=1")
 
   add_executable(gdn_parity src/kernels/gdn_parity.cpp)
   target_include_directories(gdn_parity PRIVATE ${_strata_gpu_include_directories})
-- 
