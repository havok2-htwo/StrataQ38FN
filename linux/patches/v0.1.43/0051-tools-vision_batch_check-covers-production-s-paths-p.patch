+# ---------------------------------------------------------------------------------------------------------------- GO / NO-GO
+def status_of(rows, inconclusive_empty=True):
+    """NO-GO when a row failed, INCONCLUSIVE when one could not be decided (or nothing was compared), else GO."""
+    if not rows:
+        return "INCONCLUSIVE" if inconclusive_empty else "GO"
+    if any(r["ok"] is False for r in rows):
+        return "NO-GO"
+    if any(r["ok"] is None for r in rows):
+        return "INCONCLUSIVE"
+    return "GO"
+
+
+def detail_of(rows):
+    bad = [r for r in rows if r["ok"] is not True]
+    if not rows:
+        return "nothing compared"
+    if not bad:
+        return f"{len(rows)} of {len(rows)}"
+    return f"{len(rows) - len(bad)} of {len(rows)}; " + "; ".join(
+        r["check"] + (f" [{r['detail']}]" if r.get("detail") else "") +
+        (f" (differs at {r['first_diff']})" if r.get("first_diff") is not None and r.get("same") is False else "")
+        for r in bad[:3]) + (f"; and {len(bad) - 3} more" if len(bad) > 3 else "")
+
+
+def paired(res, sc, kind):
+    """The resumed or promoted image checks of scenario `sc`, each against the text control of its pair: a mismatch is
+    NO-GO only when that control matches (and the control resumed as designed), else INCONCLUSIVE."""
+    rows = res.of(kind, sc)
+    ctl = {r["pair"]: r for r in res.of("control", sc)}
+    path = res.of("reuse", sc + ".ctl")
+    path_ok = bool(path) and all(r["ok"] is True for r in path)
+    if not rows:
+        return "INCONCLUSIVE", "nothing compared"
+    worst, why = "GO", []
+    for r in rows:
+        if r["ok"] is True:
+            continue
+        if r["ok"] is None:
+            st, w = "INCONCLUSIVE", r.get("detail") or "not compared"
+        else:
+            cr = ctl.get(r["pair"])
+            if cr is not None and cr["ok"] is True and path_ok:
+                st, w = "NO-GO", "its text control matches, so the image's own path differs"
+            else:
+                st, w = "INCONCLUSIVE", ("its text control differs too (or was not compared, or did not resume as "
+                                         "designed): a difference of the path itself, older than the regions")
+        worst = max(worst, st, key=RANK.get)
+        why.append(r["check"] + (f" (differs at {r['first_diff']})" if r.get("same") is False else "") + f": {w}")
+    good = sum(r["ok"] is True for r in rows)
+    return worst, f"{good} of {len(rows)}" + ("; " + "; ".join(why[:3]) if why else "")
+
+
+def summarize(mode, res):
+    """One criterion per line: GO, NO-GO, INCONCLUSIVE, or info (never decides)."""
+    crit = []
+
+    def add(name, rows, status=None, detail=None, empty_inconclusive=True):
+        crit.append({"criterion": name, "status": status or status_of(rows, empty_inconclusive),
+                     "detail": detail if detail is not None else detail_of(rows)})
+
+    def soft(name, rows, hint=""):
+        """Only GO or INCONCLUSIVE: what was not exercised, or a difference that is no verdict by itself."""
+        st = "GO" if rows and all(r["ok"] is True for r in rows) else "INCONCLUSIVE"
+        add(name, rows, st, detail_of(rows) + (f" - {hint}" if st != "GO" and hint else ""))
+
+    of = res.of
+    if mode in ("engine", "negative-control", "text-ab"):
+        add("startup: the slot regions exactly where STRATA_MROPE_SLOTS=1 asks for them (regions line, INFO "
+            "mrope_slots)", of("startup", "regions"))
+        add("startup: the expert-cache slots per GPU and the experts resident" +
+            (" equal the old binary's" if mode == "text-ab" else " as expected"), of("startup", "experts"),
+            empty_inconclusive=False)
+        add("startup: no " + ("new " if mode == "text-ab" else "") + "WARNING or unexpected ERR line in the engine "
+            "logs", of("startup", "warnings"))
+        add("every engine run and scenario ran to its end", of("run"))
+    if mode == "engine":
+        add("opt-in: without STRATA_MROPE_SLOTS=1 the engine refuses image and text rows side by side, as the last "
+            "release", of("optin"))
+        add("text slots beside image slots == their solo tokens", of("text"))
+        add("image slots == their references (alone in a slot, alone on the solo path, without the slot regions)",
+            of("image"))
+        soft("(iii) the two pictures put the text after them at different positions (a mix-up of their regions would "
+             "show)", of("layout"))
+        for sc, kind, label in (("ivb", "image-resumed", "(iv) live"), ("ivc", "image-resumed", "(iv) RAM cache"),
+                                ("prom.server", "image-promoted", "promotion, the server's order"),
+                                ("prom.first", "image-promoted", "promotion, text first")):
+            st, detail = paired(res, sc, kind)
+            what = "the follow-up" if kind == "image-resumed" else "solo, then a slot,"
+            crit.append({"criterion": f"{label}: {what} beside a text slot == the same steps alone and == on the solo "
+                                      f"path", "status": st, "detail": detail})
+        add("requests resumed where the scenarios expect (REUSED, 'conversation cache: restored')", of("reuse"))
+        soft("text controls of (iv) and the promotions == their references (resumed and promoted text with the regions "
+             "on)", of("control"), "the text path itself differs beside other slots: no verdict on the regions, "
+                                   "but none for them there either (--text-ab compares resumed text old against new)")
+        soft("coverage: image slots decoded beside text slots, image and text slots in every pipelined group",
+             of("coverage"), "a scenario was not exercised as designed: a larger --text-max-new")
+    elif mode == "negative-control":
+        imgs = of("image") + of("image-resumed") + of("image-promoted")
+        missed = [r for r in imgs if r.get("same") is True]
+        undecided = [r for r in imgs if r.get("same") is None]
+        crit.append({"criterion": "every image comparison FAILS with the region copy skipped (the checks see a "
+                                  "missing copy)",
+                     "status": "NO-GO" if missed else "INCONCLUSIVE" if undecided or not imgs else "GO",
+                     "detail": f"{len(imgs) - len(missed) - len(undecided)} of {len(imgs)} differ" +
+                               (f"; the same anyway: {'; '.join(r['check'] for r in missed[:3])}" if missed else "") +
+                               (f"; {len(undecided)} not compared" if undecided else "")})
+        add("text slots and the text controls == their references", of("text") + of("control"))
+        add("requests resumed where the scenarios expect (the paths do not depend on the positions)", of("reuse"))
+        soft("coverage: image slots decoded beside text slots, every pipelined group", of("coverage"),
+             "a scenario was not exercised as designed: a larger --text-max-new")
+    elif mode == "text-ab":
+        add("batch == solo in every arm", of("text"))
+        add("every arm's text tokens and resume points == its old-binary arm's (old-vision; old-novision for "
+            "new-novision)", of("ab"))
+        add("a slot's state back into the main session (a BSTOPped slot's rest on the solo path, the next turn of a "
+            "slot conversation) == the old binary's", of("ab-back"))
+        add("image requests alone (GENI; BGENI alone in a slot; a long one; the (iv) RAM pattern) == the old binary's, "
+            "tokens and REUSED", of("ab-image"))
+        soft("requests resumed where the A/B scenarios expect", of("reuse"),
+             "the path they were meant to test did not run in some arm")
+    elif mode == "server":
+        ctl_ok = all(r["ok"] for r in of("control"))
+        for kind, label in (("text", "text requests beside images == alone"),
+                            ("image", "image requests in a busy server == alone")):
+            rows = of(kind)
+            st = status_of(rows)
+            if st == "NO-GO" and not ctl_ok:
+                st = "INCONCLUSIVE"
+            add(label, rows, st, detail_of(rows) + ("" if ctl_ok else " - the text-only control differs already: "
+                                                                      "the server's settings are not exact"))
+        add("control: text only at the same concurrency == alone (decides the two above)", of("control"), "info")
+    for r in of("info"):
+        crit.append({"criterion": r["check"], "status": "info",
+                     "detail": r.get("detail") or (f"differs at {r['first_diff']}" if r.get("first_diff") is not None
+                                                   and not r.get("same") else "identical" if r["ok"] else "")})
+    deciding = [x["status"] for x in crit if x["status"] != "info"]
+    verdict = "NO-GO" if "NO-GO" in deciding else "INCONCLUSIVE" if "INCONCLUSIVE" in deciding else "GO"
+    return crit, verdict
+
+
+def print_summary(mode, crit, verdict, a):
+    what = {"engine": f"engine mode, {a.exe} with {OPT_IN}=1",
+            "negative-control": f"negative control, {a.exe} with {OPT_IN}=1 and {SKIP}=1",
+            "text-ab": f"text A/B, {a.text_ab} against {a.exe}", "server": f"server mode, {a.url}"}[mode]
+    print(f"\n==== GO / NO-GO: {what} ====", flush=True)
+    for x in crit:
+        print(f"  {x['status']:<13} {x['criterion']}" + (f"\n                {x['detail']}" if x["detail"] else ""),
+              flush=True)
+    print(f"  ==> {verdict}", flush=True)
 
 
