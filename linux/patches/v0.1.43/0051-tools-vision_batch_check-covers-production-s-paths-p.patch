+def text_run(e, a, P, emb):
+    """(v) one arm, every request with its REUSED: each text request alone, then the batch (text slots spread over the
+    groups, a long prompt read beside them, a late admission while they decode); then a slot's state back into the
+    main session - the server's go-solo hand-back (serve/server.py 1711-1741: a slot BSTOPped mid-reply, its rest on
+    the solo path with GEN and the prompt and every token, from the slot's sessions) and the next turn of the long slot
+    conversation, admitted into the slot that holds it (back from the slot, read, copied into it again, decoded there:
+    a resumed text request in a slot); with --vision (emb) the image requests alone."""
+    k, M = a.texts, a.max_new
+    texts = [P.text(j) for j in range(k + 1)]
+    long_ids = P.chat(P.filler(1, a.long_tokens) + "\n\n" + Q_TEXT_TURN1)
+    solo = [e.solo(M, ids, name=f"text {j}") for j, ids in enumerate(texts)] + [e.solo(M, long_ids, name="long")]
+    S = Slots(e.info, a.batch)
+    order = S.spread(k + 2)
+    batch = [e.admit(s, M, ids, name=f"text {j} in slot {s}") for j, (s, ids) in enumerate(zip(order[:k], texts))]
+    batch.append(e.admit(order[k], M, long_ids, name=f"long in slot {order[k]} (read beside the others)"))
+    batch.append(e.admit(order[k + 1], M, texts[k], name=f"text {k} in slot {order[k + 1]} (late)"))
+    e.drain_all()
+    out = {"solo": [r["tokens"] for r in solo], "batch": [r["tokens"] for r in batch],
+           "batch_ref": [r["tokens"] for r in solo[:k]] + [solo[-1]["tokens"], solo[k]["tokens"]],
+           "reused": [r["reused"] for r in solo + batch]}
+    gb, s = P.text(k + 1), order[0]
+    r = e.admit(s, M, gb, name=f"text {k + 1} in slot {s} (BSTOPped mid-reply)")
+    e.wait_tokens(s, max(2, M // 2))
+    stopped = s not in e.slot_done
+    if stopped:
+        e.bstop(s)
+    e.wait_done(s)
+    got = list(r["tokens"])
+    g = e.solo(max(1, M - len(got)), gb + got, name=f"text {k + 1}: its rest on the solo path (GEN, the prompt and its "
+                                                    f"{len(got)} tokens)")
+    out["giveback"] = {"bstop": stopped, "finish": r.get("finish"), "stopped_at": len(got), "joined": got + g["tokens"],
+                       "reused": g["reused"], "want": len(gb) + len(got) - 1,
+                       "gave_back": any("gave back" in l for l in g.get("log", []))}
+    rep = batch[k]["tokens"]                 # (the slot that holds the long conversation, as the server picks it)
+    f = e.admit(order[k], M, P.follow_ids(long_ids, rep, Q_FOLLOW_TEXT),
+                name=f"long: its next turn (BGEN into slot {order[k]}, which holds it)")
+    e.drain_all()
+    out["follow"] = {"tokens": f["tokens"], "reused": f["reused"], "want": len(long_ids) + len(rep) - 1,
+                     "gave_back": any("gave back" in l or "conversation cache: restored" in l for l in f.get("log", []))}
+    if emb:
+        out["images"] = image_run(e, a, P, emb, S)
+    return out
+
