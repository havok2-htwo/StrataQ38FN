+def compare_engine(c, R, C, O, S):
+    """Every check of process 2 against its references from process 1 and its anchors from process 3 (O; empty in the
+    negative control), and what the checks covered (S: process 2's slots by group)."""
+    res = c.res
+    get = _get
+
+    def cmp(name, got, want, kind, scenario, common=False, note="", pair=None, undecided=None):
+        g, w = (None if x is None else (x["tokens"] if isinstance(x, dict) else x) for x in (got, want))
+        if g is None or w is None:
+            res.crit(f"{name}: {'nothing to check' if g is None else 'no reference'} (its scenario did not run)", None,
+                     kind, scenario, pair=pair)
+            return
+        res.check(name, g, w, kind, scenario, common, note, pair, undecided)
+
+    def beside(rec, label, scenario):
+        if rec is None:
+            return
+        n, b = rec["bt"], rec["beside_text"]
+        ok = n > 0 and 2 * b >= n
+        res.crit(f"{label}: {b} of its {n} tokens in the slot came while a text slot decoded", ok, "coverage",
+                 scenario, "" if ok else f"{scenario} did not keep a text slot decoding beside it (a reply ended "
+                                         f"early: a larger --text-max-new)")
+
+    def gate(x, y):
+        """A promotion is decided only where both solo legs ended alike (DONE fields 1, 6, 7)."""
+        tx, ty = get(x, "solo", "done_triple"), get(y, "solo", "done_triple")
+        if x is None or y is None or (tx == ty and tx is not None and None not in tx):
+            return None
+        return (f"the solo legs ended apart - (tokens, drafts accepted, drafts offered) {tx} here, {ty} there: the "
+                f"tokens between came from solo windows in one run and slot windows in the other, which can leave "
+                f"another numerical state (TESTLOG #59 (4))")
+
+    print("comparisons:", flush=True)
+    i = C.get("i") or {}
+    for name, r in (i.get("texts") or {}).items():
+        cmp(f"(i) {name} in slot {r['slot']} while the image is admitted and decodes", r, R.get("solo:" + name),
