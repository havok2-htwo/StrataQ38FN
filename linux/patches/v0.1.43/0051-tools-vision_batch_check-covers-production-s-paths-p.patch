+def image_run(e, a, P, emb, S):
+    """The image requests alone, as the old binary takes them too (no slot decodes beside an image): GENI on the solo
+    path, BGENI alone in a slot, a long one (several prompt chunks) alone in a slot, and the (iv) RAM pattern - turn 1
+    alone in a slot, one text admission (it parks turn 1), the follow-up alone in a slot (restored)."""
+    M = a.max_new
+    turn1 = P.image("B", Q_IMAGE, 2)
+    steps = [("solo", None, P.image("A", Q_IMAGE), "A"), ("slot", S.at(1, 1), P.image("B", Q_IMAGE2), "B"),
+             ("long", S.at(2, 2), P.image("A", Q_LONG, 3), "A"), ("iv.turn1", S.at(1, 0), turn1, "B"),
+             ("iv.text", S.at(2, 1), P.text(a.texts + 2), None),
+             ("iv.follow", S.at(2, 0), P.follow_up(turn1, CANNED_IMAGE, Q_FOLLOW), "B")]
+    out = {}
+    for name, slot, ids, pic in steps:
+        if slot is None:
+            x = e.solo(M, ids, emb[pic], name=f"image request {name} (GENI alone)")
+        else:
+            x = e.admit(slot, M, ids, emb.get(pic), name=f"{'image' if pic else 'text'} request {name} alone in slot "
+                                                          f"{slot}")
+        e.drain_all()
+        out[name] = {"tokens": x["tokens"], "reused": x["reused"], "prompt": len(ids),
+                     "restored": any("conversation cache: restored" in l for l in x.get("log", []))}
+    out["iv.follow"]["want"] = len(turn1)
+    return out
