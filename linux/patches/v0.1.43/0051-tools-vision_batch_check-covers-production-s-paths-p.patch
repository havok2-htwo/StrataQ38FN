+def sve_header(path):
+    """The first record's header of a strata-vision embeddings file - int32 'SVE1', n_tokens, nx, ny, n_embd, then the
+    rows (tools/vision/strata_vision.cpp 13-14; generate.cpp reads the same, 12045-12057): (n_tokens, nx, ny, n_embd)."""
+    with open(path, "rb") as f:
+        hdr = f.read(20)
+    if len(hdr) != 20:
+        raise SystemExit(f"{path}: not a strata-vision embeddings file (a short header)")
+    magic, n, nx, ny, width = struct.unpack("<5i", hdr)
+    if magic != 0x31455653 or n < 1 or nx * ny != n:
+        raise SystemExit(f"{path}: not a strata-vision embeddings file (magic {magic:#x}, {n} rows of {nx} x {ny})")
+    return n, nx, ny, width
