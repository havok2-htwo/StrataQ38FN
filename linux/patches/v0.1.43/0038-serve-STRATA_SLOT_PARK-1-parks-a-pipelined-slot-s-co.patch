+/// STRATA_SLOT_PARK: one persistent thread per stage device; submit() queues job(k) for every thread k and returns at
+/// once, and each thread runs the queued jobs in their order.  An item is done when every thread has run it (done(),
+/// wait()).  The threads go where StageThreads' go.  A job does not throw.  The destructor stops the threads after the
+/// jobs they are running (the caller stops those first); queued ones are not run.
+class StageQueueThreads {
+public:
+    struct Item {
+        std::function<void(size_t)> job;
+        size_t left = 0;   ///< threads that have not run it yet (under the lock)
+    };
+    explicit StageQueueThreads(size_t n) : n_(n) {}
