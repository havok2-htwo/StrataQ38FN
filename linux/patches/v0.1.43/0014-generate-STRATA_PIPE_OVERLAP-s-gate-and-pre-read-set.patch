+bool MtpDrafter::reserve_prefill_records(int64_t n, std::string& err) {
+    const OnDevice on_device(device_);
+    if (g_ == nullptr) { err = "mtp prefill: not loaded"; return false; }
+    const bool per_group_sync = prefill_per_group_sync();
+    const int64_t per_row = 1 + 4 + g_->n_head;
+    if (!per_group_sync && pf_cap_ < n * per_row) {   // prefill()'s growth, ahead
+        if (pf_dev_) cudaFree(pf_dev_);
+        pf_dev_ = nullptr;
+        pf_cap_ = 0;
+        if (cudaMalloc((void**) &pf_dev_, (size_t) (n * per_row) * sizeof(int32_t)) != cudaSuccess) {
+            err = "mtp prefill: the input records do not fit";
+            return false;
+        }
+        pf_cap_ = n * per_row;
+    }
+    for (int T = 1; T <= max_t_; ++T)
+        if (!(per_group_sync ? capture_prefill(T, err) : capture_prefill_dev(T, err))) return false;
+    return true;
+}
