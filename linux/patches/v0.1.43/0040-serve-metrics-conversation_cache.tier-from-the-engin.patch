From ee67a078d8738ad39e12c5c76565ad8c4df8c8a7 Mon Sep 17 00:00:00 2001
From: havok2-htwo <havok2-htwo@users.noreply.github.com>
Date: Mon, 12 Oct 2026 17:45:48 +0200
Subject: [PATCH 40/40] serve: /metrics' conversation_cache.tier from the
 engine's "conversation tier:" lines

ConvCacheLog reads the disk tier's counters (STRATA_CONV_TIER_DIR) the engine appends to each of its tier log lines -
files, disk bytes, bytes written today, budget left, spills, restores, misses, drops by reason - and the last event.
Without a tier line there is no "tier" entry, so /metrics is unchanged for an engine without the tier.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 serve/server.py       | 11 +++++++++++
 serve/test_monitor.py | 23 +++++++++++++++++++++++
 2 files changed, 34 insertions(+)

diff --git a/serve/server.py b/serve/server.py
index abfab9f4..e0bfc689 100644
--- a/serve/server.py
+++ b/serve/server.py
@@ -508,6 +508,10 @@ class ConvCacheLog:
     EVENT = re.compile(r"conversation cache: (parked|skipped|restored) (\d+) tokens.*?parked=(\d+) bytes=(\d+)"
                        r"(?: evictions=(\d+))?")
     DROPPED = re.compile(r"conversation cache: dropped \d+ superseded .*?parked=(\d+)")
+    # STRATA_CONV_TIER_DIR (the disk tier): "conversation tier: <event>; files=F parts=P disk_bytes=D written_today=W
+    # budget=B budget_left=L spills=S ... restores=R misses=M drops_budget=X ..." - every counter after the event
+    TIER = re.compile(r"conversation tier: (.*?); (files=\d+.*)$")
+    TIER_FIELD = re.compile(r"(\w+)=(\d+)")
     READ_MAX = 1 << 20                                  # at most the last MiB of new lines per read
 
     def __init__(self):
@@ -540,6 +544,13 @@ class ConvCacheLog:
         self.pos += end
         now = time.time()
         for line in data[:end].decode("utf-8", "replace").splitlines():
+            if "conversation tier:" in line:              # (only with the tier on: "tier" is absent otherwise)
+                m = self.TIER.search(line)
+                if m:
+                    tier = {k: int(v) for k, v in self.TIER_FIELD.findall(m.group(2))}
+                    tier["last_event"], tier["last_at"] = m.group(1), now
+                    self.state["tier"] = tier
+                continue
             if "conversation cache:" not in line:
                 continue
             m = self.EVENT.search(line)
diff --git a/serve/test_monitor.py b/serve/test_monitor.py
index 0c82cb0b..64cd8035 100644
--- a/serve/test_monitor.py
+++ b/serve/test_monitor.py
@@ -222,6 +222,29 @@ class ConversationCacheCard(unittest.TestCase):
             self.assertEqual(c.poll(str(log), log.stat().st_size)["parked"], 0)   # the engine started again
             self.assertEqual(c.poll(None, None)["parked"], 0)
 
+    TIER = ("strata serve: conversation tier: spilled 20000 tokens (620.0 MB, 5 files) in 210.0 ms; files=1 parts=4 "
+            "disk_bytes=620000000 written_today=620000000 budget=200000000000 budget_left=199380000000 spills=1 "
+            "written_bytes=620000000 restores=0 restores_queue=0 read_bytes=0 misses=0 drops_small=0 drops_budget=0 "
+            "drops_busy=0 drops_ram=0 drops_cap=0 drops_io=0 kept=0 superseded=0 expired=0 evicted=0 pending=0 "
+            "pending_bytes=0 foreign=0 verified=0\n")
+
+    def test_the_tier_log(self):
+        from serve.server import ConvCacheLog
+        import tempfile
+        with tempfile.TemporaryDirectory() as d:
+            log = Path(d) / "strata.log"
+            log.write_text(self.PARK, encoding="utf-8")
+            c = ConvCacheLog()
+            self.assertNotIn("tier", c.poll(str(log), 0))   # no tier line: no "tier" entry
+            with open(log, "a", encoding="utf-8") as f:
+                f.write(self.TIER + self.TIER.replace("spills=1", "spills=1").replace("restores=0 ", "restores=1 ", 1)
+                        .replace("spilled 20000 tokens (620.0 MB, 5 files) in 210.0 ms", "restored 20000 tokens from disk"))
+            t = c.poll(str(log), 0)["tier"]
+            self.assertEqual((t["files"], t["disk_bytes"], t["spills"], t["restores"], t["budget_left"]),
+                             (1, 620000000, 1, 1, 199380000000))
+            self.assertEqual(t["last_event"], "restored 20000 tokens from disk")
+            self.assertEqual(c.poll(str(log), 0)["parks"], 1)   # the cache's own lines are read as before
+
     def test_metrics(self):
         tok = ByteTokenizer()
         engine = MockEngine(tok, "Thought.</think>\nHello.", max_context=4096)
