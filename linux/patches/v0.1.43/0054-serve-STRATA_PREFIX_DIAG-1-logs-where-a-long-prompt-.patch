@@ -0,0 +1,275 @@
+"""serve/test_prefix_diag.py - STRATA_PREFIX_DIAG=1: where a long prompt read parted from the recent prompts.
+
+The fingerprints (block hashes, token digests, message starts), the line they give (the shared start to the token,
+the request it was shared with, the template's role and section at the offset, never the text), the bounds on what is
+kept, the opt-in, and the whole path: Service._run over the fake batch engine of test_parallel (solo and slot).
+
+    python -m unittest serve.test_prefix_diag -v
+"""
+import contextlib
+import io
+import json
+import threading
+import unittest
+import urllib.request
+from unittest import mock
+
+from serve.frontend import ChatTemplate
+from serve.prefix_diag import PrefixDiag
+from serve.server import ByteTokenizer, MockEngine, Service, StrataEngine
+from serve import test_parallel
+
+TOK = ByteTokenizer()
+SECRET = "hunter2-PLEASE-NEVER-LOG"
+
+
+def render(system_tools=("alpha", "beta", "gamma"), system="You are helpful.", turns=()):
+    """A prompt as the chat template lays it out (ByteTokenizer ids): a system message with a tool list, then turns of
+    (role, text) - role "tool" is a user message holding a tool response."""
+    tools = "".join("\n" + json.dumps({"type": "function", "function": {"name": n}}) for n in system_tools)
+    text = (f"<|im_start|>system\n# Tools\n\nYou have access to the following functions:\n\n<tools>{tools}\n</tools>"
+            f"\n\n{system}<|im_end|>\n")
+    for role, body in turns:
+        if role == "tool":
+            text += f"<|im_start|>user\n<tool_response>\n{body}\n</tool_response><|im_end|>\n"
+        elif role == "assistant":
+            text += f"<|im_start|>assistant\n{body}<|im_end|>\n"
+        else:
+            text += f"<|im_start|>{role}\n{body}<|im_end|>\n"
+    return TOK.encode(text + "<|im_start|>assistant\n", parse_special=True)
+
+
+def long_turns(n=40, filler="x" * 300):
+    out = []
+    for i in range(n):
+        out += [("user", f"question {i} {filler}"), ("assistant", f"<think>\nhm {i}\n</think>\n\nanswer {i} {filler}"),
+                ("tool", f"result {i} {filler}")]
+    return out
+
+
+class Clock:
+    def __init__(self):
+        self.t = 1000.0
+
+    def __call__(self):
+        return self.t
+
+
+class Fingerprints(unittest.TestCase):
+    def test_the_shared_start_to_the_token(self):
+        d = PrefixDiag(TOK, min_read=1)
+        base = list(range(1, 3001))
+        old = d.fingerprint(base)
+        for cut in (0, 1, 255, 256, 257, 511, 512, 1000, 2999):
+            new = list(base)
+            new[cut] = 99999
+            self.assertEqual(d.lcp(d.fingerprint(new), old), cut, cut)
+        self.assertEqual(d.lcp(d.fingerprint(base + [7, 8, 9]), old), 3000)       # the old one is all its start
+        self.assertEqual(d.lcp(d.fingerprint(base[:1300]), old), 1300)            # the new one is a start of it
+        self.assertEqual(d.lcp(d.fingerprint([5]), d.fingerprint([])), 0)
+
+    def test_the_old_requests_output_counts(self):
+        d = PrefixDiag(TOK, min_read=1)
+        old = d.fingerprint(list(range(1, 1001)), output=list(range(5000, 5300)))
