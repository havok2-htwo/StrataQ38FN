new file mode 100644
index 00000000..7dbbac47
--- /dev/null
+++ b/serve/prefix_diag.py
@@ -0,0 +1,271 @@
+"""serve/prefix_diag.py - STRATA_PREFIX_DIAG=1: where a long prompt read parted from the prompts before it (opt-in).
+
+The engine says how many prompt tokens it reused from what it holds (its conversation cache, a slot, a parked slot), not
+where the new prompt differs from the ones it saw before - and prompts are not logged.  With STRATA_PREFIX_DIAG=1 the
+server keeps a fingerprint of each recent request (its prompt and what it generated), and when a request had to read at
+least STRATA_PREFIX_DIAG_MIN tokens (default 8192) it prints one line: the longest start it shares with any recent
+request, which request that was (how long ago it ended, its lengths, where it ran: solo, a batch slot, alone for an
+image), the token offset where the two part, and what is there in the chat template's terms (the message's role and
+index, the tokens into it, and its section: the tool list, a tool response, the thinking, a tool call) - never the text.
+
+    [strata] prefix-diag: read 119419 of 119419 (reused 0): shares 4113 tokens with a request 37 s ago (...)
+
+The fingerprint holds no token ids: a keyed 64-bit hash per 256-token block, chained (block k's hash covers tokens 0 up
+to the end of block k), a keyed 16-bit digest per token (to find the exact token inside the first block that differs; a
+digest collision moves the offset at most a token or two on, 1 in 65536 per token), and where each message starts
+with its role.  The key is random per process.  About 2.1 bytes per token: STRATA_PREFIX_DIAG_KEEP (default 64)
+requests and STRATA_PREFIX_DIAG_TOKENS (default 8M tokens, ~17 MB) at most, the oldest dropped first.
+
+Reading the line: `kind=diverged` - the engine reused all but at most a block (256 tokens) of what a recent request
+shared, so the prompt itself changed at that offset (the client rewrote, reordered or dropped something there, or it is
+a new conversation).  `kind=not-reused` (the engine reused under a block) and `kind=partly-reused` (it reused more, but
+over a block less than was shared, e.g. back to a checkpoint) - a recent request shared more than the engine reused: the
+engine did not have it (evicted, never parked, still being parked, held by a busy slot, only up to a checkpoint) or did
+not find it.  The server only sees what it sent: "shared" is the server's view, not what the engine holds.
+
+    python -m unittest serve.test_prefix_diag -v
+"""
+from __future__ import annotations
+
+import array
+import bisect
+import collections
+import hashlib
+import os
+import secrets
+import threading
+import time
+
+BLOCK = 256
+ROLES = ("system", "user", "assistant", "tool", "other")
+_ROLE_CODE = {r: i for i, r in enumerate(ROLES)}
+
+
+def env_int(env, name: str, default: int) -> int:
+    try:
+        v = int(str(env.get(name, "")).strip() or default)
+    except ValueError:
+        return default
+    return v if v > 0 else default
+
+
+class Entry:
+    """One finished request's fingerprint (no token ids, no text)."""
+    __slots__ = ("seq", "ended", "plen", "n", "chain", "digest", "starts", "roles", "where", "finish", "images",
+                 "reused")
+
+    def size(self) -> int:
+        return self.n
+
+
+class PrefixDiag:
+    def __init__(self, tok, keep: int = 64, max_tokens: int = 8_000_000, min_read: int = 8192, block: int = BLOCK,
+                 clock=time.time):
+        self.tok, self.keep, self.max_tokens, self.min_read, self.block = tok, keep, max_tokens, min_read, block
+        self.clock = clock
+        self.key = secrets.token_bytes(16)
+        self.salt = int.from_bytes(secrets.token_bytes(4), "little") | 1
+        self.entries: collections.deque[Entry] = collections.deque()
+        self.tokens = 0
+        self.seq = 0
+        self.lock = threading.Lock()
+        self.im_start = self._single(tok, "<|im_start|>")
+        self.lines = 0
+
+    @classmethod
+    def from_env(cls, tok, env=None) -> "PrefixDiag | None":
+        """None unless STRATA_PREFIX_DIAG is set (to anything but 0/off/false/no)."""
+        env = os.environ if env is None else env
+        if str(env.get("STRATA_PREFIX_DIAG", "")).strip().lower() in ("", "0", "off", "false", "no"):
+            return None
+        return cls(tok, keep=env_int(env, "STRATA_PREFIX_DIAG_KEEP", 64),
+                   max_tokens=env_int(env, "STRATA_PREFIX_DIAG_TOKENS", 8_000_000),
+                   min_read=env_int(env, "STRATA_PREFIX_DIAG_MIN", 8192))
+
+    @staticmethod
+    def _single(tok, text):
+        try:
+            ids = tok.encode(text, parse_special=True)
+        except Exception:                                # noqa: BLE001 - a tokenizer without specials: no roles
+            return None
+        return ids[0] if len(ids) == 1 else None
+
+    # ------------------------------------------------------------------------------------------- fingerprints
+    def _digests(self, ids) -> array.array:
+        s = self.salt
+        return array.array("H", [((((t ^ s) * 0x9E3779B1) & 0xFFFFFFFF) >> 16) for t in ids])
+
+    def _chain(self, ids) -> list[bytes]:
+        out, prev, b = [], b"", self.block
+        try:
+            raw = array.array("I", ids).tobytes()
+        except (OverflowError, TypeError):              # (not plain non-negative 32-bit ints)
+            raw = array.array("I", (int(t) & 0xFFFFFFFF for t in ids)).tobytes()
+        for k in range(len(ids) // b):
+            prev = hashlib.blake2b(prev + raw[4 * k * b:4 * (k + 1) * b], digest_size=8, key=self.key).digest()
+            out.append(prev)
+        return out
+
+    def _structure(self, ids):
+        """Where each message starts (its <|im_start|>) and its role; a user message that opens with a tool response is
+        the role `tool`.  Only the role words are read (a few tokens after each marker)."""
+        starts, roles = array.array("I"), bytearray()
+        if self.im_start is None:
+            return starts, bytes(roles)
+        im = self.im_start
+        for i, t in enumerate(ids):
+            if t != im:
+                continue
+            starts.append(i)
+            try:
+                head = self.tok.decode(list(ids[i + 1:i + 24]))      # the role word and what opens the message
+            except Exception:                            # noqa: BLE001
+                head = ""
+            role, _, rest = head.partition("\n")
+            role = role.strip()
+            if role == "user" and rest.lstrip().startswith("<tool_response>"):
+                role = "tool"
+            roles.append(_ROLE_CODE.get(role, _ROLE_CODE["other"]))
+        return starts, bytes(roles)
+
+    def fingerprint(self, prompt, output=()) -> Entry:
+        stream = list(prompt) + list(output or ())
+        e = Entry()
+        e.plen, e.n = len(prompt), len(stream)
+        e.chain, e.digest = self._chain(stream), self._digests(stream)
+        e.starts, e.roles = self._structure(prompt)
+        return e
+
+    def lcp(self, new: Entry, old: Entry) -> int:
+        """The tokens the new request's prompt shares from its start with the old request's prompt + output."""
+        limit = min(new.plen, old.n)
+        full = limit // self.block
+        lo, hi = 0, full                                 # the leading blocks that agree: chained, so a prefix property
+        while lo < hi:
+            mid = (lo + hi + 1) // 2
+            if new.chain[mid - 1] == old.chain[mid - 1]:
+                lo = mid
+            else:
+                hi = mid - 1
+        pos = lo * self.block
+        end = min(limit, pos + self.block) if lo < full else limit
+        nd, od = new.digest, old.digest
+        while pos < end and nd[pos] == od[pos]:
+            pos += 1
+        return pos
+
+    # ------------------------------------------------------------------------------------------- descriptions
+    def _msg_at(self, e: Entry, pos: int):
+        """(index, role, tokens into it) of the message holding token `pos` of e's prompt; None before the first."""
+        k = bisect.bisect_right(e.starts, pos) - 1
+        if k < 0:
+            return None
+        return k, ROLES[e.roles[k]], pos - e.starts[k]
+
+    def _section(self, prompt, start: int, pos: int, role: str) -> str:
+        """The part of the message (start: its <|im_start|>) where token `pos` is, from the template's markers only."""
+        if pos <= start + 1:
+            return "its role marker"
+        try:
+            text = self.tok.decode(list(prompt[start:pos]))
+        except Exception:                                # noqa: BLE001
+            return "?"
+        if role == "system":
+            if "<tools>" in text:
+                if "</tools>" not in text:
+                    return f"tool list, tool #{text.split('<tools>', 1)[1].count(chr(10))}"
+                return "after the tool list"
+            return "system text"
+        if role == "assistant":
+            marks = {m: text.rfind(m) for m in ("<think>", "</think>", "<tool_call>", "</tool_call>")}
+            last = max(marks, key=marks.get)
+            if marks[last] < 0:
+                return "answer text"
+            n = text.count("<tool_call>")
+            return {"<think>": "thinking", "</think>": "answer text", "<tool_call>": f"tool call #{n}",
+                    "</tool_call>": f"after tool call #{n}"}[last]
+        if role in ("user", "tool"):
+            a, b = text.rfind("<tool_response>"), text.rfind("</tool_response>")
+            n = text.count("<tool_response>")
+            if a > b:
+                return f"tool response #{n}"
+            if "<|vision_start|>" in text and text.rfind("<|vision_start|>") > text.rfind("<|vision_end|>"):
+                return "inside a picture"
+            return f"after tool response #{n}" if n else "user text"
+        return "?"
+
+    def _where_new(self, prompt, e: Entry, pos: int) -> str:
+        if pos >= e.plen:
+            return "its end"
+        m = self._msg_at(e, pos)
+        if m is None:
+            return f"token {pos} (before the first message)" if self.im_start is not None else f"token {pos}"
+        k, role, into = m
+        start = e.starts[k]
+        if into == 0:
+            return f"{role} msg #{k} starts here"
+        return f"{role} msg #{k} +{into} ({self._section(prompt, start, pos, role)})"
+
+    def _where_old(self, old: Entry, pos: int) -> str:
+        if pos >= old.n:
+            return "its end"
+        if pos >= old.plen:
+            return f"its output +{pos - old.plen}"
+        m = self._msg_at(old, pos)
+        if m is None:
+            return f"token {pos}"
+        k, role, into = m
+        return f"{role} msg #{k} starts here" if into == 0 else f"{role} msg #{k} +{into}"
+
+    @staticmethod
+    def _ran(where) -> str:
+        """where: (path, slot) as StrataEngine.diag_where() says it - ("solo", None), ("slot", 5), ("alone", None)."""
+        w, slot = where if isinstance(where, tuple) and len(where) == 2 else (where, None)
+        if w == "slot":
+            return f"slot {slot}"
+        return {"solo": "solo", "alone": "alone (image)", None: "?"}.get(w, str(w))
+
+    # ------------------------------------------------------------------------------------------- the request
+    def observe(self, prompt, output=(), reused=0, prompt_read=None, where=None, finish=None, images=False):
+        """A finished request: compare it with the recent ones when it read at least min_read tokens (-> the line to
+        print, else None), then keep its fingerprint.  Never raises for odd input; prints no content."""
+        prompt = list(prompt or ())
+        reused = int(reused or 0)
+        read = int(prompt_read) if prompt_read is not None else max(0, len(prompt) - reused)
+        new = self.fingerprint(prompt, output)
+        now = self.clock()
+        new.ended, new.where, new.finish, new.images, new.reused = now, where, finish, bool(images), reused
+        line = None
+        with self.lock:
+            if read >= self.min_read and prompt:
+                line = self._describe(prompt, new, read, reused, now)
+            self.seq += 1
+            new.seq = self.seq
+            self.entries.append(new)
+            self.tokens += new.n
+            while self.entries and (len(self.entries) > self.keep or
+                                    (self.tokens > self.max_tokens and len(self.entries) > 1)):
+                self.tokens -= self.entries.popleft().n
+        if line:
+            self.lines += 1
+        return line
+
+    def _describe(self, prompt, new: Entry, read: int, reused: int, now: float) -> str:
+        best, best_lcp = None, -1
+        for old in reversed(self.entries):              # newest first: a tie goes to the most recent
+            n = self.lcp(new, old)
+            if n > best_lcp:
+                best, best_lcp = old, n
+        head = f"[strata] prefix-diag: read {read} of {new.plen} (reused {reused})"
+        if best is None:
+            return head + ": no earlier request held"
+        back = self.seq - best.seq + 1
+        ago = max(0.0, now - best.ended)
+        about = (f"{back} back of {len(self.entries)}, {ago:.0f} s ago, {best.plen} prompt + {best.n - best.plen} "
+                 f"output, ran {self._ran(best.where)}, finish {best.finish or '?'}, "
+                 f"{'images' if best.images else 'no images'}, it reused {best.reused}")
+        gap = best_lcp - reused
+        kind = ("diverged" if gap <= self.block else "not-reused" if reused < self.block else "partly-reused")
+        return (f"{head}: shares {best_lcp} tokens with a request ({about}); parts at {best_lcp}: "
+                f"new {self._where_new(prompt, new, best_lcp)}, old {self._where_old(best, best_lcp)}; "
+                f"shared but not reused {max(0, gap)}; kind={kind}")
