+        said = self.run_quiet(lambda: (self.chat(text, max_tokens=8), self.chat(text + " and more", max_tokens=8)))
+        self.assertEqual(len(said), 2, said)
+        self.assertTrue(said[0].endswith("no earlier request held"), said[0])
