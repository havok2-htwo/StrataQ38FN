+class ServicePath(unittest.TestCase):
+    """Service._run over the real StrataEngine and the fake batch engine (which reuses nothing)."""
+    P = test_parallel.ParallelService           # its start / tearDown / chat (not its tests: they run in test_parallel)
+    start, tearDown, chat = P.start, P.tearDown, P.chat
