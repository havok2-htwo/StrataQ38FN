+    def test_a_request_in_a_slot_says_its_slot(self):
+        self.start(2)
+        self.svc.prefix_diag = PrefixDiag(TOK, min_read=10 ** 9)
+        errs = []
+
+        def one(t):
+            try:
+                self.chat(t, max_tokens=40)
+            except Exception as e:                              # noqa: BLE001
+                errs.append(e)
+        ts = [threading.Thread(target=one, args=(f"q{i} " + "w" * 200,)) for i in range(3)]
+        self.run_quiet(lambda: ([t.start() for t in ts], [t.join() for t in ts]))
+        self.assertEqual(errs, [])
+        wheres = [e.where for e in self.svc.prefix_diag.entries]
+        self.assertEqual(len(wheres), 3)
+        self.assertTrue(any(w and w[0] == "slot" and isinstance(w[1], int) for w in wheres), wheres)
