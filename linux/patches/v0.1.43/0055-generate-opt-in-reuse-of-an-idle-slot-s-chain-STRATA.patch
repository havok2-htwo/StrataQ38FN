+namespace {
+int failures = 0;
+void check(bool ok, const char* what) {
+    if (!ok) {
+        std::fprintf(stderr, "FAIL: %s\n", what);
+        ++failures;
+    }
+}
+
+constexpr size_t kStages = 3;   // a 4-GPU layer split: the first stage's part plus three stage_parts
+
+// a conversation's tokens: `n` tokens of stream `seed` (two seeds part at token 0, the same seed agrees throughout)
+std::vector<int32_t> tokens(size_t n, uint32_t seed) {
+    std::vector<int32_t> v(n);
+    uint32_t x = seed * 2654435761u + 1u;
+    for (size_t i = 0; i < n; ++i) {
+        x = x * 1664525u + 1013904223u;
+        v[i] = (int32_t) (x >> 8) % 151000;
+    }
+    return v;
+}
+// `a` up to `at`, then `b`'s tokens after it: a sibling or a rewritten history that parts from `a` at `at`
+std::vector<int32_t> part_at(const std::vector<int32_t>& a, size_t at, size_t n, uint32_t seed) {
+    std::vector<int32_t> v(a.begin(), a.begin() + (std::ptrdiff_t) at);
+    const std::vector<int32_t> t = tokens(n - at, seed);
+    v.insert(v.end(), t.begin(), t.end());
+    return v;
+}
+Ck ck(const std::vector<int32_t>& conv, size_t len, size_t parts = kStages) {
+    Ck c;
+    c.ids.assign(conv.begin(), conv.begin() + (std::ptrdiff_t) len);
+    c.stage_parts.resize(parts);
+    for (Ck& p : c.stage_parts) p.ids = c.ids;
+    return c;
+}
+// the engine's starts_with (generate.cpp, the request path): tokens and pictures the start of the prompt, at most
+// n - 1 of them (the last prompt token is always the first window's)
+bool starts(const Ck& c, const std::vector<int32_t>& prompt) {
+    const size_t L = c.ids.size();
+    if (L < 1 || L + 1 > prompt.size()) return false;
+    for (size_t i = 0; i < L; ++i)
+        if (c.ids[i] != prompt[i]) return false;
+    return c.imgs.empty();
+}
+
+// A host model of the sessions: cell i's K/V and the running state after token i are a hash of tokens [0, i], so a
+// cell written for another history (or a state of another prefix) shows up in the end state.
+uint64_t step(uint64_t h, int32_t t) { return (h ^ (uint64_t) (uint32_t) t) * 1099511628211ull + 0x9e3779b97f4a7c15ull; }
+struct Session {
+    std::vector<uint64_t> cells;   // K/V per cell
+    uint64_t state = 1469598103934665603ull;
+    void read(const std::vector<int32_t>& ids, size_t from) {   // the prompt read from `from` on
+        cells.resize(from);
+        for (size_t i = from; i < ids.size(); ++i) {
+            // attention reads every cell below i: a wrong cell changes everything after it
+            uint64_t a = state;
+            for (size_t j = (i > 4 ? i - 4 : 0); j < i; ++j) a ^= cells[j];
+            state = step(a, ids[i]);
+            cells.push_back(state);
+        }
+    }
+};
+uint64_t state_at(const std::vector<int32_t>& ids, size_t L) {   // a checkpoint's state, as the read that took it saw
+    Session s;
+    std::vector<int32_t> pre(ids.begin(), ids.begin() + (std::ptrdiff_t) L);
+    s.read(pre, 0);
+    return s.state;
+}
+// a batch slot as scan_slot sees it (generate.cpp's BSlot: the fields it reads)
+struct FakeSlot {
+    std::vector<int32_t> ids;
+    std::vector<Ck> checks, chain;
+    bool partial = false;
+};
+// the request path's slot loop before STRATA_SLOT_CHAIN_REUSE, transcribed from generate.cpp at g3-143 (0d162062): the
+// oracle scan_slot must equal with the switch off.  Returns {slot, tokens, place in sl.checks or -1 for the end}
+struct OldPick {
+    int slot = -1;
+    int64_t tokens = 0;
+    int ck = -1;
+};
+OldPick old_loop(const std::vector<FakeSlot>& bs, const std::vector<bool>& idle, int64_t resume,
+                 const std::vector<int32_t>& prompt) {
+    OldPick r;
+    for (int b = 0; b < (int) bs.size(); ++b) {
+        const FakeSlot& sl = bs[(size_t) b];
+        const bool idle_source = idle[(size_t) b];
+        if (idle_source && (int64_t) sl.ids.size() > std::max(resume, r.tokens) &&
+            starts(ck(sl.ids, sl.ids.size()), prompt)) {
+            r = OldPick{b, (int64_t) sl.ids.size(), -1};
+        }
+        for (size_t i = 0; i < sl.checks.size(); ++i) {
+            const Ck& c = sl.checks[i];
+            if ((int64_t) c.ids.size() > std::max(resume, r.tokens) && starts(c, prompt))
+                r = OldPick{b, (int64_t) c.ids.size(), (int) i};
+        }
+    }
+    return r;
+}
+// the new loop: scan_slot per slot, as generate.cpp calls it
+struct NewPick {
+    int slot = -1;
+    sc::SlotPick pick;
+};
+NewPick new_loop(const std::vector<FakeSlot>& bs, const std::vector<bool>& idle, int64_t resume, bool chain_on,
+                 const std::vector<int32_t>& prompt) {
+    NewPick r;
+    for (int b = 0; b < (int) bs.size(); ++b) {
+        const sc::SlotPick p = sc::scan_slot(
+            bs[(size_t) b], idle[(size_t) b], chain_on, kStages, std::max(resume, r.pick.tokens),
+            [&](const std::vector<int32_t>& v) { return starts(ck(v, v.size()), prompt); },
+            [&](const Ck& c) { return starts(c, prompt); });
+        if (p.kind != sc::Source::none) r = NewPick{b, p};
+    }
+    return r;
+}
+}  // namespace
+
+int main() {
+    // the production shape: a 2.5K system prompt, the root at the first turn boundary >= 2048, a periodic checkpoint
+    // every 16384 tokens, the turn checkpoint at the last <|im_start|>; the slot holds the prompt and its reply
+    const std::vector<int32_t> conv = tokens(21000, 1);
+    const size_t root = 2533, periodic = 16384, turn = 19876;
+    std::vector<Ck> chain;
+    chain.push_back(ck(conv, root));
+    chain.push_back(ck(conv, periodic));
+    const std::vector<Ck> own{ck(conv, turn)};
+
+    auto pick = [&](const std::vector<int32_t>& prompt, int64_t floor) {
+        return sc::best_chain(chain, conv, kStages, floor, [&](const Ck& c) { return starts(c, prompt); });
+    };
+    // E1: a sibling that parts after the periodic checkpoint but before the turn one continues from the periodic one
+    {
+        const std::vector<int32_t> p = part_at(conv, 18000, 20500, 7);
+        check(pick(p, 0) == 1, "parts at 18000: the periodic checkpoint (16384)");
+        check(!starts(own[0], p), "parts at 18000: the turn checkpoint (19876) is not a start of it");
+        check(pick(p, (int64_t) periodic) == -1, "a source as long as the periodic one already: none from the chain");
+        check(pick(p, (int64_t) root) == 1, "a shorter source (the root, elsewhere): the periodic one is longer");
+    }
+    {
+        const std::vector<int32_t> p = part_at(conv, 9000, 12000, 8);
+        check(pick(p, 0) == 0, "parts at 9000: the root (2533)");
+    }
+    {
+        const std::vector<int32_t> p = part_at(conv, 1500, 9000, 9);
+        check(pick(p, 0) == -1, "parts before the root: nothing (read from 0 as before)");
+    }
+    {
+        const std::vector<int32_t> p(conv.begin(), conv.begin() + (std::ptrdiff_t) periodic);
+        check(pick(p, 0) == 0, "a prompt exactly the periodic checkpoint's tokens: not that one (n - 1), the root");
+    }
+    // what the chain must never hand over
+    {
+        const std::vector<int32_t> p = part_at(conv, 18000, 20500, 7);
+        std::vector<Ck> bad;
+        bad.push_back(ck(conv, periodic, kStages - 1));   // a stage's part missing
+        Ck img = ck(conv, periodic);
+        img.imgs.push_back({100, 42});                    // pictures: never matched by tokens alone
+        bad.push_back(img);
+        Ck other = ck(part_at(conv, 4000, 17000, 3), periodic);   // not a prefix of what the slot holds
+        bad.push_back(other);
+        bad.push_back(Ck{});                              // empty (a moved-from checkpoint)
+        Ck longer = ck(tokens(30000, 1), 22000);          // past what the slot holds
+        bad.push_back(longer);
+        const int at = sc::best_chain(bad, conv, kStages, 0, [&](const Ck& c) { return starts(c, p); });
+        check(at == -1, "incomplete, with pictures, of another history, empty or past the slot's tokens: refused");
+        // the one of another history WOULD start the prompt if the prompt followed it: the slot's cells decide
+        const std::vector<int32_t> q = part_at(other.ids, other.ids.size(), 20000, 11);
+        check(starts(other, q) && !sc::slot_prefix_ok(other, conv, kStages),
+              "a checkpoint that starts the prompt but is not on the slot's tokens: refused (its cells are not there)");
+    }
+    // illustration only (see the top): the slot's cells below the chain checkpoint plus its state, then the rest of the
+    // new prompt read, end where a restore of the slot's image with the same checkpoint mounted ends, because that
+    // image is a capture of the same cells
+    {
+        Session slot;
+        slot.read(conv, 0);   // the slot's prompt read and its reply: its cells
+        const std::vector<int32_t> p = part_at(conv, 18000, 20500, 7);
+        const int at = pick(p, 0);
+        check(at == 1, "mount: the periodic checkpoint");
+        const size_t L = chain[(size_t) at].ids.size();
+        Session from_slot;   // copy_from_slot(b, &c): K/V [0, L) from the slot, the state from the checkpoint
+        from_slot.cells.assign(slot.cells.begin(), slot.cells.begin() + (std::ptrdiff_t) L);
+        from_slot.state = state_at(conv, L);
+        from_slot.read(p, L);
+        Session image = slot;   // the parked image restored whole, then the checkpoint mounted
+        image.cells.resize(L);
+        image.state = state_at(conv, L);
+        image.read(p, L);
+        check(from_slot.state == image.state && from_slot.cells == image.cells,
+              "illustration: mount from the slot's chain = restore of the slot's image + the same checkpoint");
+        // negative control: a checkpoint of another history mounted on the slot's cells ends elsewhere
+        const std::vector<int32_t> other = part_at(conv, 4000, 20500, 3);
+        Session wrong;
+        wrong.cells.assign(slot.cells.begin(), slot.cells.begin() + (std::ptrdiff_t) L);
+        wrong.state = state_at(other, L);
+        std::vector<int32_t> po(other.begin(), other.begin() + (std::ptrdiff_t) L);
+        const std::vector<int32_t> rest = tokens(2000, 5);
+        po.insert(po.end(), rest.begin(), rest.end());
+        wrong.read(po, L);
+        Session want;
+        want.read(po, 0);
+        check(wrong.state != want.state, "negative control: the model sees cells of another history");
+    }
+    // E2: a give-back of everything the slot holds hands over its turn checkpoint (and nothing the main session has)
+    {
+        std::vector<Ck> slot_checks{ck(conv, turn)};
+        std::vector<Ck> checks;   // after the give-back: the chain moved in
+        checks.push_back(ck(conv, root));
+        checks.push_back(ck(conv, periodic));
+        std::vector<size_t> p = sc::giveback_picks(slot_checks, checks, conv, kStages);
+        check(p.size() == 1 && p[0] == 0, "give-back: the slot's turn checkpoint goes along");
+        // the next turn renders the served turn again without its thinking: it parts right after the turn checkpoint
+        // (the loop below stands for the main session's resume loop in generate.cpp, which is not in the header)
+        const std::vector<int32_t> next = part_at(conv, turn, 26000, 13);
+        checks.push_back(slot_checks[p[0]]);
+        int64_t resume = 0;
+        for (const Ck& c : checks)
+            if ((int64_t) c.ids.size() > resume && starts(c, next)) resume = (int64_t) c.ids.size();
+        check(resume == (int64_t) turn, "the next turn resumes at the turn checkpoint, not at an older one");
+        std::vector<Ck> without(checks.begin(), checks.end() - 1);
+        int64_t old = 0;
+        for (const Ck& c : without)
+            if ((int64_t) c.ids.size() > old && starts(c, next)) old = (int64_t) c.ids.size();
+        check(old == (int64_t) periodic, "without it: the periodic one (today's fallback)");
+    }
+    {
+        std::vector<Ck> slot_checks;
+        slot_checks.push_back(ck(conv, periodic));           // a copy of a chain checkpoint the main session has
+        slot_checks.push_back(ck(conv, turn, kStages - 1));  // incomplete
+        Ck img = ck(conv, turn);
+        img.imgs.push_back({3, 9});
+        slot_checks.push_back(img);                          // pictures
+        slot_checks.push_back(ck(part_at(conv, 100, 21000, 4), turn));   // of another history
+        slot_checks.push_back(ck(conv, 20000));              // the one to hand over
+        slot_checks.push_back(ck(conv, 20000));              // the same tokens again: once
+        std::vector<Ck> checks;
+        checks.push_back(ck(conv, periodic));
+        const std::vector<size_t> p = sc::giveback_picks(slot_checks, checks, conv, kStages);
+        check(p.size() == 1 && p[0] == 4, "give-back: no duplicate, nothing incomplete, with pictures or off the tokens");
+        check(sc::giveback_picks(std::vector<Ck>{}, checks, conv, kStages).empty(), "a slot without checkpoints: none");
+    }
+    // scan_slot: the order of a slot's sources and who may use the chain
+    {
+        FakeSlot sl;
+        sl.ids = conv;
+        sl.checks.push_back(ck(conv, turn));
+        sl.chain = chain;
+        auto scan = [&](const FakeSlot& s, bool idle, bool chain_on, const std::vector<int32_t>& prompt,
+                        int64_t floor = 0) {
+            return sc::scan_slot(s, idle, chain_on, kStages, floor,
+                                 [&](const std::vector<int32_t>& v) { return starts(ck(v, v.size()), prompt); },
+                                 [&](const Ck& c) { return starts(c, prompt); });
+        };
+        std::vector<int32_t> next(conv);   // the next turn: all the slot holds, then more
+        const std::vector<int32_t> more = tokens(500, 21);
+        next.insert(next.end(), more.begin(), more.end());
+        sc::SlotPick p = scan(sl, true, true, next);
+        check(p.kind == sc::Source::end && p.tokens == (int64_t) conv.size(), "scan: the next turn takes all it holds");
+        const std::vector<int32_t> after_turn = part_at(conv, turn, 20500, 22);
+        p = scan(sl, true, true, after_turn);
+        check(p.kind == sc::Source::own && p.index == 0 && p.tokens == (int64_t) turn,
+              "scan: parts after the turn checkpoint: its own checkpoint, not the chain");
+        const std::vector<int32_t> sib = part_at(conv, 18000, 20500, 7);
+        p = scan(sl, true, true, sib);
+        check(p.kind == sc::Source::chain && p.index == 1 && p.tokens == (int64_t) periodic,
+              "scan: a sibling before the turn checkpoint: the chain's periodic one");
+        check(scan(sl, true, false, sib).kind == sc::Source::none, "scan: the switch off: no chain (read from 0)");
+        check(scan(sl, false, true, sib).kind == sc::Source::none, "scan: an active slot: never its chain");
+        p = scan(sl, false, true, after_turn);
+        check(p.kind == sc::Source::own, "scan: an active slot: its own checkpoints as before (STRATA_SLOT_CKPT_MOVE)");
+        p = scan(sl, false, true, next);
+        check(p.kind == sc::Source::own && p.tokens == (int64_t) turn, "scan: an active slot: never its end");
+        FakeSlot part = sl;
+        part.partial = true;
+        check(scan(part, true, true, sib).kind == sc::Source::none, "scan: a yielded read: never a chain");
+        check(scan(sl, true, true, sib, (int64_t) periodic).kind == sc::Source::none,
+              "scan: an earlier source as long as the chain's: kept (only a longer one wins)");
+        p = scan(sl, true, true, sib, (int64_t) root);
+        check(p.kind == sc::Source::chain && p.tokens == (int64_t) periodic, "scan: a shorter earlier source: the chain");
+        // a chain checkpoint that is as long as the slot's own one does not take its place
+        FakeSlot tie = sl;
+        tie.chain.push_back(ck(conv, turn));
+        p = scan(tie, true, true, after_turn);
+        check(p.kind == sc::Source::own, "scan: a tie between its own checkpoint and the chain: its own");
+        // ties among its own checkpoints and with the floor: the first one found, and nothing at the floor itself
+        FakeSlot two = sl;
+        two.checks.push_back(ck(conv, turn));
+        p = scan(two, true, true, after_turn);
+        check(p.kind == sc::Source::own && p.index == 0, "scan: two own checkpoints of one length: the first");
+        check(scan(two, true, true, after_turn, (int64_t) turn).kind == sc::Source::none,
+              "scan: an own checkpoint as long as the floor: not taken");
+    }
+    // with the switch off the new loop is the old one, over many slots (the default path, decided in the header)
+    {
+        uint32_t x = 12345u;
+        auto rnd = [&](uint32_t m) {
+            x = x * 1664525u + 1013904223u;
+            return (x >> 8) % m;
+        };
+        int same = 0, cases = 0;
+        for (int t = 0; t < 4000; ++t) {
+            const std::vector<int32_t> base = tokens(3000, 1 + rnd(3));
+            const std::vector<int32_t> prompt = part_at(base, 200 + rnd(2700), 3000, 50 + rnd(5));
+            std::vector<FakeSlot> bs(1 + rnd(5));
+            std::vector<bool> idle(bs.size());
+            for (size_t b = 0; b < bs.size(); ++b) {
+                const std::vector<int32_t> h = rnd(2) ? base : part_at(base, rnd(3000), 3000, 70 + rnd(9));
+                bs[b].ids.assign(h.begin(), h.begin() + (std::ptrdiff_t) (1 + rnd(3000)));
+                for (uint32_t k = rnd(3); k-- > 0;) bs[b].checks.push_back(ck(h, 1 + rnd(2999), rnd(4) ? kStages : 1));
+                for (uint32_t k = rnd(3); k-- > 0;) bs[b].chain.push_back(ck(h, 1 + rnd(2999)));
+                bs[b].partial = rnd(4) == 0;
+                idle[b] = rnd(3) != 0;
+            }
+            const int64_t resume = rnd(3) ? 0 : (int64_t) rnd(3000);
+            const OldPick o = old_loop(bs, idle, resume, prompt);
+            const NewPick n = new_loop(bs, idle, resume, false, prompt);
+            const bool eq = o.slot == n.slot && o.tokens == (n.slot < 0 ? 0 : n.pick.tokens) &&
+                            (n.slot < 0 || (o.ck < 0 ? n.pick.kind == sc::Source::end
+                                                     : n.pick.kind == sc::Source::own && n.pick.index == o.ck));
+            same += eq ? 1 : 0;
+            ++cases;
+            // with the switch on: never shorter than the old pick, and a chain pick always a prefix of its slot
+            const NewPick on = new_loop(bs, idle, resume, true, prompt);
+            if (on.slot >= 0 && on.pick.kind == sc::Source::chain) {
+                const FakeSlot& sl = bs[(size_t) on.slot];
+                check(idle[(size_t) on.slot] && !sl.partial &&
+                          sc::slot_prefix_ok(sl.chain[(size_t) on.pick.index], sl.ids, kStages),
+                      "oracle: a chain pick is an idle, not yielded slot's complete prefix");
+            }
+            check((on.slot < 0 ? 0 : on.pick.tokens) >= o.tokens, "oracle: the switch on never starts earlier");
+        }
+        check(same == cases, "oracle: with the switch off scan_slot picks what the old loop picked, every case");
+    }
+    // chain_along: what comes along with the chosen chain checkpoint
+    {
+        const std::vector<int32_t> sib = part_at(conv, 18000, 20500, 7);
+        auto st = [&](const Ck& c) { return starts(c, sib); };
+        std::vector<size_t> a = sc::chain_along(chain, conv, kStages, 1, st);
+        check(a.size() == 1 && a[0] == 0, "along: the periodic one chosen: the root comes along (first)");
+        check(sc::chain_along(chain, conv, kStages, 0, st).empty(), "along: the root chosen: nothing shorter");
+        check(sc::chain_along(chain, conv, kStages, -1, st).empty(), "along: nothing chosen: nothing");
+        std::vector<Ck> c2 = chain;
+        c2.insert(c2.begin(), ck(conv, root));                 // the root twice (a copy): once
+        c2.push_back(ck(conv, 9000, kStages - 1));             // incomplete
+        c2.push_back(ck(part_at(conv, 3000, 17000, 5), 9000)); // of another history
+        a = sc::chain_along(c2, conv, kStages, 2, st);
+        check(a.size() == 1 && a[0] == 0, "along: no duplicate, nothing incomplete or off the slot's tokens");
+        std::vector<Ck> c3 = chain;
+        c3.push_back(ck(conv, periodic));                      // a copy of the chosen one: not along
+        a = sc::chain_along(c3, conv, kStages, 1, st);
+        check(a.size() == 1 && a[0] == 0, "along: a copy of the chosen one does not come along");
+    }
+    // giveback_plan: what happens to the slot's image, chain and checkpoints
+    {
+        using S = sc::Source;
+        for (int park = 0; park < 2; ++park)
+            for (int on = 0; on < 2; ++on)
+                for (int part = 0; part < 2; ++part)
+                    for (int here = 0; here < 2; ++here)
+                        for (S from : {S::end, S::own, S::chain}) {
+                            const sc::GiveBack g = sc::giveback_plan(park, from, on, part, here);
+                            check(g.discard_park == g.move_chain, "plan: the image goes exactly when the chain moves");
+                            check(g.discard_park == (park && from != S::chain),
+                                  "plan: a chain hit keeps the slot's image and chain; any other give-back, as before");
+                            if (!on) check(!g.hand_checks && !g.hand_move, "plan: STRATA_GIVEBACK_CHECKS off: nothing");
+                            if (from != S::end) check(!g.hand_checks, "plan: only a give-back of all it holds hands over");
+                            if (part) check(!g.hand_checks, "plan: a yielded read the slot keeps keeps its checkpoints");
+                            if (g.hand_move) check(g.hand_checks && here, "plan: moved only into the same slot");
+                        }
+        sc::GiveBack g = sc::giveback_plan(true, S::end, true, false, true);
+        check(g.hand_checks && g.hand_move, "plan: admitted to the same slot: moved (its admission drops them)");
+        g = sc::giveback_plan(true, S::end, true, false, false);
+        check(g.hand_checks && !g.hand_move, "plan: alone or into another slot: copied (the slot can still serve them)");
+        g = sc::giveback_plan(false, S::end, true, false, false);
+        check(g.hand_checks && !g.discard_park, "plan: without STRATA_SLOT_PARK: handed over, no image to drop");
+    }
+    if (failures != 0) return EXIT_FAILURE;
+    std::printf("slot_chain_test: ok\n");
+    return EXIT_SUCCESS;
+}
