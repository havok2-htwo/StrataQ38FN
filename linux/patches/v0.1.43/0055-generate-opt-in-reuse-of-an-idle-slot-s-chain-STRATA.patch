+        out["unexpected"] = e.unexpected[:20]
+    for name, rec in out["requests"].items():
+        notes = [l.split(": ", 1)[-1].strip()[:110] for l in rec.get("log", [])
+                 if "gave back" in l or "restored" in l or "capture=slot" in l]
+        print(f"[{run}] {name}: {rec['op']} {rec['prompt_tokens']} tokens, REUSED {rec['reused']}, "
+              f"{len(rec['tokens'])} generated{''.join(f'; {n}' for n in notes)}", flush=True)
+    return out
