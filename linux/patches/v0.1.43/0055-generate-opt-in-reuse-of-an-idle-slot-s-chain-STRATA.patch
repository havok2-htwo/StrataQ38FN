+def wrapper(path, extra=""):
+    """An executable that runs the fake (the harness starts an engine binary by its path)."""
+    path.write_text(f"#!/bin/sh\nexec {shlex.quote(sys.executable)} {shlex.quote(str(FAKE))} {extra} \"$@\"\n")
+    path.chmod(0o755)
+    return str(path)
