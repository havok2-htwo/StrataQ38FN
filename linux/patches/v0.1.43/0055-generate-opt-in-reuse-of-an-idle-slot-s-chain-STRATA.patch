+bool slot_chain_reuse_env() {
+    static const bool on = [] {
+        const char* v = std::getenv("STRATA_SLOT_CHAIN_REUSE");
+        return v && v[0] != '\0' && v[0] != '0';
+    }();
+    return on;
+}
+// STRATA_GIVEBACK_CHECKS=1 (read once; off by default): a slot that gives back everything it holds (a request goes on
+// with its conversation in the main sessions) also hands over its own checkpoints - the turn checkpoint of the request
+// it served - instead of keeping them until its next admission drops them.  Without it the main session keeps only the
+// slot's chain, so the next turn, which renders the served turn again without its thinking, falls back to an older
+// checkpoint.  The cells below each one are the ones the give-back just copied.  Moved when the request is admitted to
+// that same slot, copied otherwise (the slot, untouched, still serves a sibling from them).  Not from a yielded read
+// the slot keeps for later
+bool giveback_checks_env() {
+    static const bool on = [] {
+        const char* v = std::getenv("STRATA_GIVEBACK_CHECKS");
