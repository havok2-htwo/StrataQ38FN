+def scenario(e, p, a, S, run):
+    """The requests of one process, in order; every record by name."""
+    sx, sz, so, sk = S
+    r = {}
+    ref = RUNS[run][1]
+
+    def turn1(K, slot):
+        r[f"{K}1"] = e.admit(slot, a.max_new, p[f"{K}1"], name=f"{K}1")
+        e.wait_done(slot)
+
+    def nxt(K, text=Q_TURN, role="user"):
+        return e.P.follow(p[f"{K}1"], r[f"{K}1"]["tokens"], text, role=role)
+
+    # E1s: the sibling alone; the next turn continues the slot
+    turn1("X", sx)
+    r["YX"] = e.solo(8, p["YX"], name="YX")
+    r["Xs"] = e.solo(a.max_new, p["Xs"], name="Xs")
+    r["X2"] = e.solo(a.max_new, nxt("X"), name="X2")
+    # E1p: the sibling alone, then the slot overwritten: its image parked, the next turn restored from it
+    turn1("A", sx)
+    r["YA"] = e.solo(8, p["YA"], name="YA")
+    r["As"] = e.solo(a.max_new, p["As"], name="As")
+    r["V"] = e.admit(sx, 4, p["V"], name="V")
+    e.wait_done(sx)
+    r["A2"] = e.solo(a.max_new, nxt("A"), name="A2")
+    # E1a: the sibling admitted into the source slot itself
+    turn1("B", sx)
+    r["YB"] = e.solo(8, p["YB"], name="YB")
+    r["Bs"] = e.admit(sx, a.max_new, p["Bs"], name="Bs")
+    e.wait_done(sx)
+    r["B2"] = e.solo(a.max_new, nxt("B"), name="B2")
+    # E1b: the sibling admitted into another group's slot; the next turn continues the untouched source slot
+    turn1("C", sx)
+    r["YC"] = e.solo(8, p["YC"], name="YC")
+    r["Cs"] = e.admit(so, a.max_new, p["Cs"], name="Cs")
+    e.wait_done(so)
+    r["C2"] = e.solo(a.max_new, nxt("C"), name="C2")
+    role = "tool" if a.tool_role else "user"
+    # E2s: the give-back alone, the slot reused, the turn after
+    turn1("Z", sz)
+    r["Z2"] = e.solo(a.max_new, nxt("Z", TOOL, role), name="Z2")
+    r["WZ"] = e.admit(sz, 4, p["WZ"], name="WZ")
+    e.wait_done(sz)
+    r["Z3"] = e.solo(a.max_new, p["Z3"], name="Z3")
+    # E2c: the give-back admitted into the same slot (the reference: alone, the RAM cache's route)
+    turn1("Q", sz)
+    if ref:
+        r["Q2"] = e.solo(a.max_new, nxt("Q", TOOL, role), name="Q2")
+    else:
+        r["Q2"] = e.admit(sz, a.max_new, nxt("Q", TOOL, role), name="Q2")
+        e.wait_done(sz)
+    r["WQ"] = e.admit(sz, 4, p["WQ"], name="WQ")
+    e.wait_done(sz)
+    r["Q3"] = e.solo(a.max_new, p["Q3"], name="Q3")
+    # E2k: the give-back admitted into another group's slot; the source slot untouched
+    turn1("R", sz)
+    r["R2"] = e.admit(sk, a.max_new, nxt("R", TOOL, role), name="R2")
+    e.wait_done(sk)
+    r["U"] = e.solo(8, p["WR"], name="U")
+    r["R3"] = e.solo(a.max_new, p["R3"], name="R3")
+    return r
