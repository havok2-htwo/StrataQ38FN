+# ---------------------------------------------------------------------------------------------------------------- prompts
+class Prompts:
+    def __init__(self, tok):
+        self.tok = tok
+        self.turn = self.enc("<|im_start|>")[0]
+        self.per = max(1, len(tok.encode(FILLER % 100)))
+        self.per_sys = max(1, len(tok.encode(SYSTEM % 100)))
+
+    def enc(self, s):
+        return self.tok.encode(s, parse_special=True)
+
+    def system(self, variant, tokens):
+        body = "".join(SYSTEM % (1000 * variant + i) for i in range(tokens // self.per_sys + 1))
+        return self.enc(f"<|im_start|>system\n{body}<|im_end|>\n")
+
+    def filler(self, variant, tokens):
+        return "".join(FILLER % (1000 * variant + i) for i in range(max(0, tokens) // self.per + 1))
+
+    def user(self, text):
+        return self.enc(f"<|im_start|>user\n{text}<|im_end|>\n<|im_start|>assistant\n<think>\n\n</think>\n\n")
+
+    def first(self, variant, sys_tokens, total, question):
+        """A conversation's first turn of about `total` tokens: a system prompt of sys_tokens, agenda text, a question."""
+        s = self.system(variant, sys_tokens)
+        u = self.user(self.filler(variant + 1, total - len(s) - 40) + "\n\n" + question)
+        return s + u
+
+    def turn_at(self, ids):
+        """The last turn boundary: where a read's turn checkpoint is taken (its length)."""
+        return max((i for i, t in enumerate(ids) if t == self.turn), default=0)
+
+    def root_at(self, ids, root=2048):
+        """The first turn boundary at `root` tokens or more, before the last one: the root checkpoint's length."""
+        last = self.turn_at(ids)
+        for i in range(1, last):
+            if ids[i] == self.turn:
+                return i if i >= root else -1
+        return -1
+
+    def follow(self, turn1, reply, text, role="user"):
+        """turn 1's prompt, the reply as the slot fed it (an end-of-turn token at its end dropped: the template writes
+        one), and a new turn - it continues everything the slot holds."""
+        r = list(reply)
+        if r and r[-1] in EOS:
+            r = r[:-1]
+        return list(turn1) + r + self.enc(f"<|im_end|>\n<|im_start|>{role}\n{text}<|im_end|>\n<|im_start|>assistant\n"
+                                          f"<think>\n\n</think>\n\n")
+
+
+def plan(P, a):
+    p = {}
+    short = max(a.system_tokens, 1600)
+    for _, K, v in E1_LEGS:
+        k1 = P.first(v, a.system_tokens, a.total_tokens, Q1)
+        cut = len(k1) - a.sibling_back
+        p[f"{K}1"] = k1
+        p[f"{K}s"] = k1[:cut] + P.enc(P.filler(v + 5, 600) + "\n\n" + Q_SIB +
+                                      "<|im_end|>\n<|im_start|>assistant\n<think>\n\n</think>\n\n")
+        p[f"Y{K}"] = P.first(v + 100, a.system_tokens // 2, short, Q1)
+        p[f"cut_{K}"], p[f"root_{K}"], p[f"turn_{K}"] = cut, P.root_at(k1), P.turn_at(k1)
+    p["V"] = P.first(220, a.system_tokens // 2, short, Q_SIB)
+    for _, K, v in E2_LEGS:
+        k1 = P.first(v, a.system_tokens, a.total_tokens, Q1)
+        tz = P.turn_at(k1)
+        p[f"{K}1"] = k1
+        p[f"{K}3"] = k1[:tz] + P.enc(f"<|im_start|>assistant\n{CANNED}<|im_end|>\n<|im_start|>user\n{Q_AFTER}"
+                                     f"<|im_end|>\n<|im_start|>assistant\n<think>\n\n</think>\n\n")
+        p[f"W{K}"] = P.first(v + 200, a.system_tokens // 2, short, Q_SIB)
+        p[f"root_{K}"], p[f"turn_{K}"] = P.root_at(k1), tz
+    return p
+
