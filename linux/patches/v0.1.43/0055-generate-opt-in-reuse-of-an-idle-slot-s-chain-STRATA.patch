+# ---------------------------------------------------------------------------------------------------------------- verdict
+class Crit:
+    def __init__(self):
+        self.rows = []
+
+    def add(self, name, status, detail="", group=""):
+        self.rows.append({"criterion": name, "status": status, "detail": detail, "group": group})
+        print(f"  {status:<12} {name}{f' ({detail})' if detail else ''}", flush=True)
+
+
+def said(rec, pattern):
+    return any(re.search(pattern, l) for l in rec.get("log", []))
+
+
+def said_num(rec, pattern):
+    """The first group of the first log line that matches, as an int (None: no line)."""
+    for l in rec.get("log", []):
+        m = re.search(pattern, l)
+        if m:
+            return int(m.group(1))
+    return None
+
+
+def same_tokens(c, name, got, ref, group, strict=False):
+    """got against ref, two requests that resumed at the same length: the first token decides; a later difference is
+    INCONCLUSIVE where their windows may have gone apart (solo: DONE's drafts accepted / offered differ; a batch slot:
+    always, BDONE has no draft counts) - NO-GO with `strict` (no MTP drafter: both draft from the tokens alike)."""
+    g, w = got["tokens"], ref["tokens"]
+    d = first_diff(g, w)
+    if g == w:
+        return c.add(name, "GO", f"{len(g)} tokens", group)
+    if not g or not w:
+        return c.add(name, "INCONCLUSIVE", "a reply without tokens", group)
+    if g[0] != w[0]:
+        return c.add(name, "NO-GO", "the first token differs: it follows from the prompt read alone", group)
+    if strict:
+        return c.add(name, "NO-GO", f"differs at token {d} of {len(g)} without the MTP drafter", group)
+    if got["op"] != "GEN" or ref["op"] != "GEN":
+        return c.add(name, "INCONCLUSIVE", f"differs at token {d} in a batch slot, whose windows carry no draft "
+                     f"counts (--no-draft-pair decides it)", group)
+    gt, wt = (got.get("done_triple") or [None] * 3)[1:], (ref.get("done_triple") or [None] * 3)[1:]
+    if gt != wt:
+        return c.add(name, "INCONCLUSIVE", f"differs at token {d}, and the solo windows went apart (drafts accepted / "
+                     f"offered {gt} against {wt}): the routes leave the drafter's K/V apart", group)
+    return c.add(name, "NO-GO", f"differs at token {d} of {len(g)} with the same windows (drafts {gt})", group)
+
+
+PARK_LEGS = (("E1p", "A", "V"), ("E1a", "B", "Bs"))
+
+
+def park_rows(c, leg, K, at, rn, rr, p, sx, verify):
+    """`at`'s admission into slot sx parks K1's conversation from the slot (its image, whole: STRATA_SLOT_PARK_VERIFY
+    compares it with a plain capture of the slot first, and a difference stops the engine)."""
+    n = said_num(rr[at], rf"conversation cache: parked (\d+) tokens .*capture=slot {sx}\b")
+    ok = n is not None and n >= len(p[f"{K}1"])
+    c.add(f"{leg} [{rn}]: {at}'s admission into slot {sx} parks {K}1's conversation from the slot ({n} tokens)",
+          "GO" if ok else "NO-GO", "" if ok else "no 'parked ... capture=slot' line", leg)
+    if verify and ok:
+        v = said(rr[at], rf"STRATA_SLOT_PARK_VERIFY: slot {sx}, {n} tokens, \d+ bytes identical")
+        c.add(f"{leg} [{rn}]: STRATA_SLOT_PARK_VERIFY compared that image with the slot", "GO" if v else "info",
+              "" if v else "no comparison line (compared earlier, or not at all)", leg)
+
+
+def held_by(p, req, K):
+    """What a slot holds after K1 decoded: its prompt and every reply token a window fed (all but the last)."""
+    return len(p[f"{K}1"]) + max(0, len(req[f"{K}1"]["tokens"]) - 1)
+
+
+def verdict(a, runs, p):
+    c = Crit()
+    have = {k: v for k, v in runs.items() if v.get("requests")}
+    for k, v in runs.items():
+        if v.get("failed"):   # (a run without the MTP drafter is not production's setup: it cannot fail the check)
+            hard = v.get("engine_error") and not RUNS[k][2]
+            c.add(f"[{k}] the engine run ran to its end", "NO-GO" if hard else "INCONCLUSIVE", v["failed"], "run")
+    for k, v in have.items():
+        bad = [w for w in v.get("warnings", []) if not any(re.search(x, w) for x in a.allow_warning)]
+        c.add(f"[{k}] no WARNING or unexpected ERR line", "NO-GO" if bad or v.get("errs") else "GO",
+              "; ".join((bad + v.get("errs", []))[:3]), "run")
+    if not all(k in have for k in ("off", "ref")):
+        c.add("off and ref ran", "INCONCLUSIVE", "nothing to compare with", "run")
+        return c, finish(c)
+    off, ref = have["off"]["requests"], have["ref"]["requests"]
+    sx, sz, so, sk = have["off"]["slots"]
+    switched = [k for k in SWITCHED if k in have]
+    if not switched:
+        c.add("a run with a switch ran", "INCONCLUSIVE", "--runs has none of on, on-e1, on-e2", "run")
+    verify = not a.no_park_verify
+
+    # ---- E1: the reference's chain checkpoint, the gap, then each run
+    P = {}
+    for leg, K, _ in E1_LEGS:
+        g, s = leg, f"{K}s"
+        P[K] = ref[s]["reused"] or 0
+        cut, root = p[f"cut_{K}"], p[f"root_{K}"]
+        ok = root < P[K] < cut and said(ref[s], rf"conversation cache: restored {P[K]} tokens \(checkpoint\)")
+        P[K] = P[K] if ok else None
+        c.add(f"{leg} reference: {K}' ({ref[s]['op']}) resumed at a chain checkpoint of {K}1 from the RAM cache (REUSED "
+              f"{ref[s]['reused']}, past the root {root}, before the cut {cut})", "GO" if ok else "INCONCLUSIVE",
+              "" if ok else "the reference did not take its route: no length to compare with", g)
+        gap = P[K] is not None and (off[s]["reused"] or 0) < P[K]
+        c.add(f"{leg} reproduced with the switches off: {K}' REUSED {off[s]['reused']} < {P[K]}",
+              "GO" if gap else "INCONCLUSIVE", "" if gap else "the scenario does not show the gap", g)
+    for leg, K, at in PARK_LEGS:
+        park_rows(c, leg, K, at, "off", off, p, sx, verify)
+    for run in switched:
+        rq = have[run]["requests"]
+        e1 = CHAIN in RUNS[run][0]
+        e2 = GIVEBACK in RUNS[run][0]
+        for leg, K, _ in E1_LEGS:
+            g, s = leg, f"{K}s"
+            got = rq[s]["reused"]
+            if e1:
+                line = said(rq[s], rf"gave back {got} tokens of this conversation \(a checkpoint of its chain\)")
+                st = "INCONCLUSIVE" if P[K] is None else "GO" if got == P[K] and line else "NO-GO"
+                c.add(f"{leg} [{run}]: {K}' REUSED {got} == the reference's {P[K]}, from slot {sx}'s chain", st,
+                      "" if line else "no 'gave back ... (a checkpoint of its chain)' line", g)
+                if P[K] is not None and got == P[K]:
+                    same_tokens(c, f"{leg} [{run}]: {K}' tokens == the reference's (the same checkpoint, from RAM)",
+                                rq[s], ref[s], g)
+            else:
+                ok = got == off[s]["reused"] and not said(rq[s], r"a checkpoint of its chain")
+                c.add(f"{leg} [{run}]: without {CHAIN}, {K}' as off (REUSED {got} / {off[s]['reused']})",
+                      "GO" if ok else "NO-GO", "", g)
+                same_tokens(c, f"{leg} [{run}]: {K}' tokens == off's (the same route)", rq[s], off[s], g)
+        # E1s / E1b: the next turn continues all the source slot holds
+        for leg, K in (("E1s", "X"), ("E1b", "C")):
+            g, n = leg, f"{K}2"
+            held = held_by(p, off, K)
+            want = r"\(all it holds, and \d+ checkpoints? of its own\)" if e2 else r"\(all it holds\)"
+            ok = rq[n]["reused"] == off[n]["reused"] and said(rq[n], rf"slot {sx} gave back \d+ tokens of this "
+                                                                    rf"conversation {want}")
+            also = " and hands over its turn checkpoint" if e2 else ", and nothing else ('(all it holds)' exactly)"
+            c.add(f"{leg} [{run}]: slot {sx} kept its conversation - {K}2 continues all it holds (REUSED "
+                  f"{rq[n]['reused']}, off {off[n]['reused']}, about {held}){also}", "GO" if ok else "NO-GO", "", g)
+            same_tokens(c, f"{leg} [{run}]: {K}2 tokens == off's (the same route)", rq[n], off[n], g)
+        # E1p / E1a: the source slot's image parked whole when the slot is overwritten, the next turn restored from it
+        for leg, K, at in PARK_LEGS:
+            g = leg
+            park_rows(c, leg, K, at, run, rq, p, sx, verify)
+            n2 = f"{K}2"
+            ro = said_num(off[n2], r"conversation cache: restored (\d+) tokens \(live\)")
+            rn_ = said_num(rq[n2], r"conversation cache: restored (\d+) tokens \(live\)")
+            ok = ro is not None and rn_ == ro and rq[n2]["reused"] == off[n2]["reused"]
+            c.add(f"{leg} [{run}]: {K}2 restored from that image as off (restored {rn_} / {ro}, REUSED "
+                  f"{rq[n2]['reused']} / {off[n2]['reused']})", "GO" if ok else "NO-GO", "", g)
+            same_tokens(c, f"{leg} [{run}]: {K}2 tokens == off's (the same route)", rq[n2], off[n2], g)
+
+    # ---- E2
+    T = {}
+    for leg, K, _ in E2_LEGS:
+        g, n3, tz, rz = leg, f"{K}3", p[f"turn_{K}"], p[f"root_{K}"]
+        if leg == "E2k":
+            ok = off[n3]["reused"] == tz and said(off[n3], rf"slot {sz} gave back {tz} tokens of this conversation "
+                                                          rf"\(its turn checkpoint\)")
+            c.add(f"{leg} today: R3 resumes at R1's turn checkpoint {tz} from the untouched slot {sz} (off REUSED "
+                  f"{off[n3]['reused']})", "GO" if ok else "INCONCLUSIVE",
+                  "" if ok else "today's engine does not serve it from the slot: the leg shows nothing", g)
+            T[K] = tz if ok else None
+            continue
+        ok = ref[n3]["reused"] == tz and said(ref[n3], rf"conversation cache: restored {tz} tokens \(checkpoint\)")
+        T[K] = tz if ok else None
+        c.add(f"{leg} reference: {K}3 resumed at {K}1's turn checkpoint ({tz}) by the RAM cache's route (REUSED "
+              f"{ref[n3]['reused']})", "GO" if ok else "INCONCLUSIVE", "" if ok else "the reference missed its route",
+              g)
+        gap = (off[n3]["reused"] or 0) < tz
+        c.add(f"{leg} reproduced with the switches off: {K}3 REUSED {off[n3]['reused']} < {tz} (the root is {rz})",
+              "GO" if gap else "INCONCLUSIVE", "" if gap else "today's engine already resumes there", g)
+    for run in switched:
+        rq = have[run]["requests"]
+        e2 = GIVEBACK in RUNS[run][0]
+        for leg, K, _ in E2_LEGS:
+            g, n2, n3, tz = leg, f"{K}2", f"{K}3", p[f"turn_{K}"]
+            ok2 = rq[n2]["reused"] == off[n2]["reused"] and said(off[n2], r"gave back \d+ tokens of this "
+                                                                         r"conversation \(all it holds\)")
+            c.add(f"{leg} [{run}]: {K}2 ({rq[n2]['op']}) gives back all slot {sz} holds as off (REUSED "
+                  f"{rq[n2]['reused']} / {off[n2]['reused']})", "GO" if ok2 else "NO-GO", "", g)
+            same_tokens(c, f"{leg} [{run}]: {K}2 tokens == off's (the same route)", rq[n2], off[n2], g)
+            handed = said(rq[n2], r"\(all it holds, and \d+ checkpoints? of its own\)")
+            if e2:
+                c.add(f"{leg} [{run}]: {K}2's give-back hands over the slot's own checkpoint", "GO" if handed else
+                      "NO-GO", "" if handed else "no 'all it holds, and <n> checkpoint(s) of its own' line", g)
+            else:
+                c.add(f"{leg} [{run}]: without {GIVEBACK}, {K}2's give-back is today's ('(all it holds)' exactly)",
+                      "NO-GO" if handed else "GO", "", g)
+            if leg == "E2k":
+                ok = T[K] is not None and rq[n3]["reused"] == tz
+                c.add(f"{leg} [{run}]: R3 REUSED {rq[n3]['reused']} == today's {tz} (the source slot keeps its turn "
+                      f"checkpoint)", "GO" if ok else "INCONCLUSIVE" if T[K] is None else "NO-GO", "", g)
+                if ok:
+                    same_tokens(c, f"{leg} [{run}]: R3 tokens == off's (the same checkpoint)", rq[n3], off[n3], g)
+                continue
+            if e2:
+                route = leg != "E2c" or said(rq[n3], rf"conversation cache: restored {tz} tokens \(checkpoint\)")
+                st = "GO" if rq[n3]["reused"] == tz and route else "NO-GO"
+                c.add(f"{leg} [{run}]: {K}3 REUSED {rq[n3]['reused']} == {K}1's turn checkpoint {tz}"
+                      f"{' (restored from the image slot ' + str(sz) + ' parked)' if leg == 'E2c' else ''}", st, "", g)
+                if T[K] is not None and rq[n3]["reused"] == tz:
+                    same_tokens(c, f"{leg} [{run}]: {K}3 tokens == the reference's (the same checkpoint)", rq[n3],
+                                ref[n3], g)
+            else:
+                ok = rq[n3]["reused"] == off[n3]["reused"]
+                c.add(f"{leg} [{run}]: without {GIVEBACK}, {K}3 as off (REUSED {rq[n3]['reused']} / "
+                      f"{off[n3]['reused']})", "GO" if ok else "NO-GO", "", g)
+                same_tokens(c, f"{leg} [{run}]: {K}3 tokens == off's (the same route)", rq[n3], off[n3], g)
+
+    # ---- without the MTP drafter: every difference decides
+    if "on-nd" in have and "ref-nd" in have:
+        on_nd, ref_nd = have["on-nd"]["requests"], have["ref-nd"]["requests"]
+        for leg, K, _ in E1_LEGS:
+            s = f"{K}s"
+            if on_nd[s]["reused"] == ref_nd[s]["reused"] and P[K] is not None:
+                same_tokens(c, f"{leg} [on-nd]: {K}' tokens == ref-nd's", on_nd[s], ref_nd[s], "nodraft", strict=True)
+            else:
+                c.add(f"{leg} [on-nd]: {K}' REUSED {on_nd[s]['reused']} == ref-nd's {ref_nd[s]['reused']}",
+                      "NO-GO" if P[K] is not None else "INCONCLUSIVE", "", "nodraft")
+        for leg, K in (("E2s", "Z"), ("E2c", "Q")):
+            n3 = f"{K}3"
+            if on_nd[n3]["reused"] == ref_nd[n3]["reused"] == p[f"turn_{K}"]:
+                same_tokens(c, f"{leg} [on-nd]: {K}3 tokens == ref-nd's", on_nd[n3], ref_nd[n3], "nodraft",
+                            strict=True)
+            else:
+                c.add(f"{leg} [on-nd]: {K}3 REUSED {on_nd[n3]['reused']} == ref-nd's {ref_nd[n3]['reused']} == "
+                      f"{p[f'turn_{K}']}", "NO-GO" if T[K] is not None else "INCONCLUSIVE", "", "nodraft")
+    elif "on-nd" in runs or "ref-nd" in runs:
+        c.add("the runs without the MTP drafter both ran", "INCONCLUSIVE", "", "nodraft")
+
+    # ---- the default path
+    if "old" in have:
+        g = "default"
+        old = have["old"]["requests"]
+        for k in off:
+            ok = off[k]["reused"] == old[k]["reused"] and off[k]["tokens"] == old[k]["tokens"]
+            c.add(f"default path: off's {k} == the old binary's (REUSED {off[k]['reused']} / {old[k]['reused']}, "
+                  f"{len(off[k]['tokens'])} tokens)", "GO" if ok else "NO-GO",
+                  "" if ok else f"tokens differ at {first_diff(off[k]['tokens'], old[k]['tokens'])}", g)
+        fo, fn = have["old"]["facts"].get("expert_slots"), have["off"]["facts"].get("expert_slots")
+        c.add(f"default path: expert-cache slots {fn} == the old binary's {fo}", "GO" if fo == fn else "INCONCLUSIVE",
+              "", g)
+    elif "old" in runs:
+        c.add("default path: the old binary ran", "INCONCLUSIVE", runs["old"].get("failed", ""), "default")
+    return c, finish(c)
+
+
+def finish(c):
+    worst = max((RANK[r["status"]] for r in c.rows), default=1)
+    return {0: "GO", 1: "INCONCLUSIVE", 2: "NO-GO"}[worst]
+
+
+# ---------------------------------------------------------------------------------------------------------------- main
+def check(argv):
+    ap = Parser(description="E1 / E2: where a request starts reading (see the module docstring)")
+    ap.add_argument("--exe", required=True, help="the engine to check (with the two switches)")
+    ap.add_argument("--config", default=CONFIG)
+    ap.add_argument("--old-exe", default=None, help="the production binary: the default path must be unchanged")
+    ap.add_argument("--old-extra", default="", help="arguments for the old binary only (the self-test's --fake-old)")
+    ap.add_argument("--batch", type=int, default=16)
+    ap.add_argument("--max-new", type=int, default=48)
+    ap.add_argument("--system-tokens", type=int, default=2500)
+    ap.add_argument("--total-tokens", type=int, default=20000)
+    ap.add_argument("--sibling-back", type=int, default=1500, help="K' parts from K1 this many tokens before its end")
+    ap.add_argument("--every", type=int, default=16384, help="the engine's --prompt-cache-every (only checked here)")
+    ap.add_argument("--tool-role", action="store_true", help="K2's tool result as a 'tool' turn (default: 'user')")
+    ap.add_argument("--extra", default=EXACT)
+    ap.add_argument("--mt-min", default="1")
+    ap.add_argument("--no-config-env", action="store_true")
+    ap.add_argument("--no-park-verify", action="store_true", help=f"do not set {PARK_VERIFY}=1")
+    ap.add_argument("--no-draft-pair", action="store_true",
+                    help="also run on-nd and ref-nd without the MTP drafter, where a later-token difference is NO-GO")
+    ap.add_argument("--allow-warning", action="append", default=[])
+    ap.add_argument("--runs", default="off,ref,on,on-e1,on-e2",
+                    help="which processes (old is added by --old-exe, on-nd and ref-nd by --no-draft-pair)")
+    ap.add_argument("--logs", default=None)
+    ap.add_argument("--out", default=None)
+    ap.add_argument("--tokenizer", default=None, help="instead of the config's")
+    ap.add_argument("--line-timeout", type=float, default=300.0)
+    ap.add_argument("--start-timeout", type=float, default=900.0)
+    a = ap.parse_args(argv)
+    try:
+        cfg = json.loads(Path(a.config).read_text())
+    except (OSError, ValueError) as x:
+        usage(f"--config {a.config}: {x}")
+    if a.system_tokens < 2100:
+        usage("--system-tokens below 2100: the root checkpoint (first turn boundary >= 2048) would not be at its end")
+    if a.total_tokens - a.sibling_back < a.every + 1100 or a.sibling_back < 200:
+        usage(f"--total-tokens {a.total_tokens} - --sibling-back {a.sibling_back} must leave the cut past the periodic "
+              f"checkpoint ({a.every} + a chunk) and before the turn checkpoint")
+    runs_wanted = [r for r in a.runs.split(",") if r]
+    if any(r not in ("off", "ref", "on", "on-e1", "on-e2") for r in runs_wanted):
+        usage(f"--runs {a.runs}: off, ref, on, on-e1 and on-e2 only")
+    if "off" not in runs_wanted or "ref" not in runs_wanted:
+        usage(f"--runs {a.runs}: off and ref are what every other run is compared with")
+    if a.old_exe:
+        runs_wanted.append("old")
+    if a.no_draft_pair:
+        if "--mtp" not in cfg.get("args", []):
+            usage("--no-draft-pair: the config has no --mtp to drop")
+        runs_wanted += ["on-nd", "ref-nd"]
+    try:
+        tok = vbc.tokenizer(a.tokenizer or cfg["tokenizer"])
+    except Exception as x:  # noqa: BLE001
+        usage(f"the tokenizer cannot be read: {x!r}")
+    a.logs = a.logs or tempfile.mkdtemp(prefix="cache-reuse-logs-")
+    Path(a.logs).mkdir(parents=True, exist_ok=True)
+    tier_root = tempfile.mkdtemp(prefix="cache-reuse-tier-")
+    P = Prompts(tok)
+    p = plan(P, a)
+    print("prompts: " + "; ".join(f"{K}1 {len(p[K + '1'])} (root {p['root_' + K]}, turn {p['turn_' + K]}"
+                                   f"{', parts at ' + str(p['cut_' + K]) if 'cut_' + K in p else ''})"
+                                   for _, K, _ in E1_LEGS + E2_LEGS), flush=True)
+    if any(p[f"root_{K}"] < 0 for _, K, _ in E1_LEGS + E2_LEGS):
+        usage("no root checkpoint position in the prompts (a system prompt below 2048 tokens)")
+    runs = {}
+    try:
+        for r in runs_wanted:
+            exe = a.old_exe if r == "old" else a.exe
+            try:
+                runs[r] = run_one(a, cfg, exe, r, p, P, tier_root)
+            except EngineError as x:
+                runs[r] = {"exe": exe, "failed": str(x), "engine_error": True}
+                print(f"[{r}] {x}", flush=True)
+            except Exception as x:  # noqa: BLE001
+                traceback.print_exc()
+                runs[r] = {"exe": exe, "failed": f"this tool failed: {x!r}"}
+    finally:
+        for e in list(LIVE):
+            e.quit()
+        shutil.rmtree(tier_root, ignore_errors=True)
+    print("summary:", flush=True)
+    c, v = verdict(a, runs, p)
+    print(f"VERDICT {v}  (engine logs: {a.logs})", flush=True)
+    if a.out:
+        Path(a.out).write_text(json.dumps({"verdict": v, "criteria": c.rows, "runs": runs, "settings": vars(a),
+                                           "prompts": {k: (len(x) if isinstance(x, list) else x) for k, x in p.items()}},
+                                          indent=1))
+    return EXIT[v]
+
