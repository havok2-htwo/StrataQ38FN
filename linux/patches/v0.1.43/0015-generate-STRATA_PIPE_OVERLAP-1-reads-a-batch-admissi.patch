+void Prefill::join_chain() noexcept {
+    for (Prefill* p = this; p != nullptr; p = p->next_)   // stage k's future is stage k+1's chunk (it may start k+2's)
+        if (p->next_run_.valid()) {
+            try {
+                (void) p->next_run_.get();
+            } catch (...) {
+            }
+        }
