+const PipeOverlapDebug& pipe_overlap_debug() {
+    static const PipeOverlapDebug d = [] {
+        PipeOverlapDebug r;
+        if (!pipe_overlap_env()) return r;
+        if (const char* v = std::getenv("STRATA_PIPE_OVERLAP_FORCE_PADUP")) r.force_padup = std::atoi(v);
