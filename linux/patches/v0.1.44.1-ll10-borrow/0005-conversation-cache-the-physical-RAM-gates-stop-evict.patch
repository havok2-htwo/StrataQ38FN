diff --git a/include/strata/core/conversation_memory.hpp b/include/strata/core/conversation_memory.hpp
index 81ea0b07..d8230e97 100644
--- a/include/strata/core/conversation_memory.hpp
+++ b/include/strata/core/conversation_memory.hpp
@@ -71,4 +71,74 @@ inline bool conversation_memory_admit(std::optional<uint64_t> available,
     return available && *available >= floor && allocation <= *available - floor;
 }
 
+// ---- STRATA_GATE_EVICT=1 (default off): the physical-RAM gates' evict-to-fit loop with a stop rule (#3115)
+//
+// The gates in generate.cpp (a park's admission, a batch slot's capture) evict the least recently active parked
+// conversations until the reading admits the allocation.  Whether an eviction raises the next reading depends on the
+// allocator (conversation_alloc.hpp, STRATA_CONV_MMAP): with plain malloc, glibc keeps what an eviction frees in its
+// arenas, MemAvailable stays where it was, and the old loop emptied the whole cache and refused anyway (measured on the
+// production host).  This loop evicts one entry at a time as before, but
+//   * not at all when evicting every evictable entry could not cover the need even if all of it came back
+//     (available + evictable < allocation + floor), or when the reading is unknown (the old loop evicted everything
+//     against an unknown reading, which never admits);
+//   * stops when the rest of the cache could no longer cover the need from the current reading;
+//   * stops after `stall_limit` evictions in a row that each did not raise the reading by at least half of the
+//     evicted entry's accounted bytes (gate_evict_returned) - the memory is not coming back to the kernel, so
+//     further evictions only throw away cache for nothing.  A returning eviction resets the count.
+// Not a reservation and not exact: other writers move the reading between samples, which is what the half-size
+// margin and the k-in-a-row rule absorb (a lone noisy sample stops nothing).
+
+/// Did one eviction give its memory back?  `before`/`after` the readings around it, `freed` its accounted bytes.
+/// An unknown reading on either side counts as not returned.
+inline bool gate_evict_returned(std::optional<uint64_t> before, std::optional<uint64_t> after, uint64_t freed) {
+    return before && after && *after >= *before && *after - *before >= freed / 2;
+}
+
+/// Could evicting `evictable` bytes, all of them returned, let `allocation` in above `floor`?  Unknown: no.
+inline bool gate_evict_can_help(std::optional<uint64_t> available, uint64_t evictable, uint64_t allocation,
+                                uint64_t floor) {
+    if (!available) return false;
+    const uint64_t best = evictable > UINT64_MAX - *available ? UINT64_MAX : *available + evictable;
+    return conversation_memory_admit(best, allocation, floor);
+}
+
+struct GateEvictOutcome {
+    bool admitted = false;   ///< the last reading admits the allocation
+    bool hopeless = false;   ///< stopped (or never started) because the evictable rest could not cover the need
+    bool stalled = false;    ///< stopped after stall_limit evictions in a row that did not raise the reading
+    size_t evicted = 0;
+    uint64_t freed = 0;      ///< the evicted entries' accounted bytes
+    std::optional<uint64_t> first, last;   ///< the readings before the first eviction and after the last
+    /// the reading's change from first to last in bytes (0 when either is unknown)
+    int64_t rose() const { return first && last ? (int64_t) (*last - *first) : 0; }
+};
+
+/// The loop.  sample(): the guard's reading (std::optional<uint64_t>); victim_bytes(): the accounted bytes of the entry
+/// evict() would take next (std::optional<uint64_t>, nullopt: none can go); evict(): evicts it (false: none went).
+/// `evictable`: the accounted bytes of every entry that can go.  `max_evictions` bounds the loop (the cache's slots).
+template<class Sample, class VictimBytes, class Evict>
+GateEvictOutcome gate_evict_to_fit(Sample&& sample, VictimBytes&& victim_bytes, Evict&& evict, uint64_t evictable,
+                                   uint64_t allocation, uint64_t floor, size_t max_evictions,
+                                   unsigned stall_limit = 2) {
+    GateEvictOutcome out;
+    std::optional<uint64_t> now = sample();
+    out.first = now;
+    unsigned stalls = 0;
+    for (;;) {
+        if (conversation_memory_admit(now, allocation, floor)) { out.admitted = true; break; }
+        if (!gate_evict_can_help(now, evictable - out.freed, allocation, floor)) { out.hopeless = true; break; }
+        if (out.evicted >= max_evictions) break;
+        const std::optional<uint64_t> bytes = victim_bytes();
+        if (!bytes || !evict()) break;
+        ++out.evicted;
+        out.freed += *bytes > evictable - out.freed ? evictable - out.freed : *bytes;
+        const std::optional<uint64_t> after = sample();
+        stalls = gate_evict_returned(now, after, *bytes) ? 0 : stalls + 1;
+        now = after;
+        if (stalls >= stall_limit && !conversation_memory_admit(now, allocation, floor)) { out.stalled = true; break; }
+    }
+    out.last = now;
+    return out;
+}
+
 } // namespace strata::core
diff --git a/src/core/conversation_cache_test.cpp b/src/core/conversation_cache_test.cpp
