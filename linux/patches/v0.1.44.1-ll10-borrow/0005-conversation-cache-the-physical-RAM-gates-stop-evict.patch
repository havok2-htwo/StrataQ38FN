         check(!cache.evict_oldest() && cache.size() == 1, "only a pinned one is left: nothing more can go");
+        check(cache.evictable_bytes() == 0 && !cache.oldest_evictable_bytes(),
+              "only a pinned one is left: nothing evictable, no victim");
         // #879: after non-finite logits every parked conversation goes, the pinned one too
         cache.put(image({4, 5, 6}));
         std::vector<ConversationKv> kv(1);
diff --git a/src/core/conversation_memory_test.cpp b/src/core/conversation_memory_test.cpp
index c95e70bf..80bd1c59 100644
--- a/src/core/conversation_memory_test.cpp
+++ b/src/core/conversation_memory_test.cpp
@@ -4,6 +4,7 @@
 #include <cstdlib>
