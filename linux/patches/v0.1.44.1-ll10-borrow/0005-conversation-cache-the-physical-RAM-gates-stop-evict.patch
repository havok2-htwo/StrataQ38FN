+#include <vector>
 
 #if defined(_WIN32)
 #ifndef NOMINMAX
@@ -49,6 +50,100 @@ int main() {
                                    std::numeric_limits<uint64_t>::max(), 0), "maximal exact bound");
     check(!conversation_memory_admit(std::numeric_limits<uint64_t>::max(),
                                     std::numeric_limits<uint64_t>::max(), 1), "maximal sum overflow rejected");
+    // ---- STRATA_GATE_EVICT: gate_evict_to_fit's stop rule against a fake cache and a fake reading
+    check(gate_evict_returned(100, 150, 100), "an eviction that raised the reading by half its size returned");
+    check(!gate_evict_returned(100, 149, 100), "one byte under half its size: not returned");
+    check(!gate_evict_returned(100, 90, 0), "a falling reading is not returned, even for an empty entry");
+    check(gate_evict_returned(100, 100, 1), "half of one byte rounds down: an unchanged reading counts");
+    check(!gate_evict_returned({}, 200, 10) && !gate_evict_returned(100, {}, 10), "unknown on either side: not returned");
+    check(gate_evict_can_help(50, 60, 40, 70), "all evictable back would just cover it");
+    check(!gate_evict_can_help(50, 59, 40, 70), "one byte short even with everything back");
+    check(!gate_evict_can_help({}, 1000, 0, 0), "unknown reading: evicting cannot be shown to help");
+    check(gate_evict_can_help(std::numeric_limits<uint64_t>::max(), std::numeric_limits<uint64_t>::max(), 1, 1),
+          "available plus evictable saturates instead of wrapping");
+    struct Fake {
+        std::vector<uint64_t> entries;   // accounted bytes, oldest first
+        std::vector<uint64_t> returns;   // what the k-th eviction gives back to the reading (default: all of it)
+        std::optional<uint64_t> avail;
+        size_t samples = 0, evicted = 0;
+        uint64_t evictable() const { uint64_t n = 0; for (uint64_t e : entries) n += e; return n; }
+        GateEvictOutcome run(uint64_t allocation, uint64_t floor, size_t max_evictions) {
+            return gate_evict_to_fit(
+                [&]() -> std::optional<uint64_t> { ++samples; return avail; },
+                [&]() -> std::optional<uint64_t> {
+                    return entries.empty() ? std::nullopt : std::optional<uint64_t>(entries.front());
+                },
+                [&] {
+                    if (entries.empty()) return false;
+                    const uint64_t back = evicted < returns.size() ? returns[evicted] : entries.front();
+                    if (avail) *avail += back;
+                    entries.erase(entries.begin());
+                    ++evicted;
+                    return true;
+                },
+                evictable(), allocation, floor, max_evictions);
+        }
+    };
+    {   // it fits already: one reading, nothing evicted
+        Fake f{{100, 100}, {}, 500};
+        const auto r = f.run(100, 100, 8);
+        check(r.admitted && r.evicted == 0 && f.samples == 1 && f.entries.size() == 2, "fits: nothing evicted");
+    }
+    {   // every eviction returns its memory: oldest first, stop as soon as it fits
+        Fake f{{100, 100, 100, 100}, {}, 0};
+        const auto r = f.run(150, 0, 8);
+        check(r.admitted && r.evicted == 2 && r.freed == 200 && r.rose() == 200 && f.entries.size() == 2,
+              "returning evictions: just enough of them, oldest first");
+    }
+    {   // malloc keeps everything (#3115): two evictions in a row gave nothing back - stop, the rest stays parked
+        Fake f{{100, 100, 100, 100, 100}, {0, 0, 0, 0, 0}, 0};
+        const auto r = f.run(150, 0, 8);
+        check(!r.admitted && r.stalled && !r.hopeless && r.evicted == 2 && f.entries.size() == 3 && r.rose() == 0,
+              "two non-returning evictions in a row stop the loop; the cache is not emptied for nothing");
+    }
+    {   // a returning eviction resets the count: stall, return, stall, stall -> stops after four
+        Fake f{{100, 100, 100, 100, 100, 100}, {0, 100, 0, 0}, 0};
+        const auto r = f.run(1000, 0, 8);
+        check(r.evicted == 0 && r.hopeless, "600 evictable cannot cover 1000: nothing is evicted at all");
+        Fake g{{100, 100, 100, 100, 100, 100}, {0, 100, 0, 0}, 0};
+        const auto s = g.run(350, 0, 8);
+        check(!s.admitted && s.stalled && s.evicted == 4 && s.rose() == 100 && g.entries.size() == 2,
+              "the stall count is consecutive: a returning eviction in between resets it");
+    }
+    {   // half-returned is returned: 60 of 100 back each time, keeps going until it fits
+        Fake f{{100, 100, 100, 100}, {60, 60, 60, 60}, 0};
+        const auto r = f.run(150, 0, 8);
+        check(r.admitted && r.evicted == 3 && r.rose() == 180, "evictions returning more than half their size go on");
+    }
+    {   // the rest can no longer cover it: stop early (hopeless), here after the first half-return
+        Fake f{{100, 100, 100}, {50, 0, 0}, 0};
+        const auto r = f.run(300, 0, 8);
+        check(!r.admitted && r.hopeless && !r.stalled && r.evicted == 1 && f.entries.size() == 2,
+              "after a partial return the rest (200) cannot lift 50 to 300: stop");
+    }
+    {   // the floor counts as part of the need; the slot bound caps the loop
+        Fake f{{100, 100, 100, 100}, {}, 0};
+        const auto r = f.run(100, 200, 2);
+        check(!r.admitted && r.evicted == 2 && !r.stalled && !r.hopeless, "max_evictions bounds the loop");
+        Fake g{{100, 100, 100, 100}, {}, 0};
+        check(g.run(100, 200, 8).evicted == 3, "allocation plus floor: three of 100 for 100 + 200");
+    }
+    {   // unknown reading: no eviction (the old loop emptied the cache against it and refused anyway)
+        Fake f{{100, 100}, {}, std::nullopt};
+        const auto r = f.run(0, 0, 8);
+        check(!r.admitted && r.hopeless && r.evicted == 0 && f.entries.size() == 2, "unknown reading: nothing evicted");
+    }
+    {   // nothing evictable (empty, or only pinned entries: evictable 0) and short: hopeless at once
+        Fake f{{}, {}, 10};
+        const auto r = f.run(100, 0, 8);
+        check(!r.admitted && r.hopeless && r.evicted == 0 && f.samples == 1, "empty cache: one reading, no loop");
+    }
+    {   // a fit reached on the stalling eviction still admits (the stop rule only applies while it does not fit)
+        Fake f{{100, 100, 100}, {0, 40}, 60};
+        const auto r = f.run(100, 0, 8);
+        check(r.admitted && !r.stalled && r.evicted == 2 && f.entries.size() == 1,
+              "the second short return still lifts it to the need: admitted, not stalled");
+    }
     // Test the real provider without assuming any particular amount of free RAM.
     const auto available = available_host_bytes();
     check(!available || conversation_memory_admit(available, 0, 0), "provider returns bytes or unknown");
