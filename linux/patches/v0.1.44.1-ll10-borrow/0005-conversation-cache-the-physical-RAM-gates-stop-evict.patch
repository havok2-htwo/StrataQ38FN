@@ -162,8 +162,16 @@ int main() {
         pinned.checkpoints.back().gdn.resize(64, 1);
         cache.put(std::move(pinned));
         cache.put(image({9, 8, 7}));
+        // STRATA_GATE_EVICT's view of the same choice: the pinned entry counts for nothing, the next victim is the
+        // unpinned one evict_oldest() takes
+        const size_t unpinned = image({9, 8, 7}).bytes();
+        check(cache.evictable_bytes() == unpinned, "evictable_bytes counts the unpinned entries only");
+        check(cache.oldest_evictable_bytes() == std::optional<size_t>(unpinned),
