diff --git a/include/strata/core/conversation_alloc.hpp b/include/strata/core/conversation_alloc.hpp
new file mode 100644
index 00000000..65b1a869
--- /dev/null
+++ b/include/strata/core/conversation_alloc.hpp
@@ -0,0 +1,160 @@
+// include/strata/core/conversation_alloc.hpp - where parked conversation state gets its host memory.
+//
+// A parked conversation is its K/V (ConversationBuffer segments, conversation_buffer.hpp) and its checkpoints'
+// running state (ConversationCheckpoint::gdn / ple / tails / dead / block_pos, conversation_cache.hpp): pageable host
+// memory, tens of MiB to GiB per conversation, freed when the cache evicts it.  By default it comes from malloc
+// (operator new), as it always has.  glibc's malloc does not give such memory back to the kernel reliably (#3115):
+//
+//   * a request is served from a free chunk of an arena whenever one is large enough - the mmap threshold is only
+//     consulted when no free chunk can serve it - so once an arena holds freed snapshots, even the full 16 MiB
+//     segments and the ~30 MB checkpoint vectors are carved from it, not mmapped;
+//   * with glibc's default (dynamic) threshold, freeing an mmapped 16 MiB chunk raises the threshold above 16 MiB,
+//     so from then on the segments go to the arenas anyway;
+//   * a thread arena (the park threads' captures land in theirs) shrinks only at its topmost heap's top, and only by
+//     what lies above the trim threshold; free chunks in the middle of a heap stay resident until malloc_trim.
+//
+// So an eviction frees the bytes into the arena, the process's RSS stays where it was, and the physical-RAM gate
+// (generate.cpp, sample_host_memory: MemAvailable and the cgroup) sees nothing come back.  Measured on the
+// production host: 1,946 arena heaps holding 108 GiB RSS, an evict-everything that freed 22 GiB of parked
+// conversations and left "available" where it was, and 15 GB of new snapshots admitted with zero RSS growth.
+//
+// STRATA_CONV_MMAP=1: every such allocation of at least 64 KiB is its own anonymous mapping (mmap, rounded up to whole
+// pages) and is munmap'ed when it is freed, so an evicted conversation's memory is back with the kernel when
+// evict_oldest() returns, whatever glibc's thresholds and arenas do.  Below 64 KiB (a short capture's scale buffers,
+// a checkpoint's dead rows and block positions) stays with malloc: those are few bytes beside the rest, and a mapping
+// each would only cost syscalls and map count.  Reproducer (variant f, an mmap per segment / gdn vector): the
+// arenas' RSS after an evict-all went from 6.2 GiB to 0.2 GiB and no park was refused (was 57 of 400).
+//
+// The switch is read once, at the first allocation, and never changes in the process: deallocate() decides by the
+// size alone whether the block was mapped, which is the same size allocate() was given (the allocator contract).
+// Unset or anything but 1: operator new / operator delete, exactly std::allocator's behaviour.  The memory is
+// ordinary pageable memory either way; cudaMemcpy to and from it goes through the driver's staging as before, and
+// nothing registers it with cudaHostRegister (a pinned range must not be unmapped under the driver).
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <new>
+#include <type_traits>
+#include <utility>
+#include <vector>
+
+#if defined(__unix__) || defined(__APPLE__)
+#include <sys/mman.h>
+#include <unistd.h>
+#define STRATA_CONV_MMAP_SUPPORTED 1
+#else
+#define STRATA_CONV_MMAP_SUPPORTED 0
+#endif
+
+namespace strata::core {
+
+namespace conversation_alloc_detail {
+struct Mode {
+    bool mmap = false;
+    size_t min = 0;    ///< the smallest allocation that is mapped (bytes)
+    size_t page = 4096;
+};
+inline Mode read_mode() {
+    Mode m;
+#if STRATA_CONV_MMAP_SUPPORTED
+    const char* e = std::getenv("STRATA_CONV_MMAP");
+    m.mmap = e != nullptr && std::strcmp(e, "1") == 0;
+    const long page = sysconf(_SC_PAGESIZE);
+    if (page > 0 && (page & (page - 1)) == 0) m.page = (size_t) page;
+    m.min = std::max<size_t>(65536, m.page);
+#endif
+    return m;
+}
+inline const Mode& mode() {
+    static const Mode m = read_mode();
+    return m;
+}
+inline size_t page_round(size_t bytes, size_t page) {
+    return bytes > std::numeric_limits<size_t>::max() - (page - 1) ? 0 : (bytes + page - 1) & ~(page - 1);
+}
+}  // namespace conversation_alloc_detail
+
+/// STRATA_CONV_MMAP=1 in this process (read once).
+inline bool conversation_mmap_enabled() { return conversation_alloc_detail::mode().mmap; }
+
+/// True when an allocation of `bytes` is its own mapping: the switch is on and it is at least the minimum.  Such a
+/// block is zero when allocate() returns it (fresh anonymous pages), so a caller that filled it with zeros would
+/// write every page twice (ConversationBuffer::resize skips that).
+inline bool conversation_mmap_block(size_t bytes) {
+    const auto& m = conversation_alloc_detail::mode();
+    return m.mmap && bytes >= m.min;
+}
+
+/// The capacity worth reserving for `bytes`: with the switch on and a mapped block, `bytes` rounded up to whole pages
+/// (the mapping holds them anyway, so the container may as well use them and the cache counts what is resident);
+/// otherwise `bytes` unchanged.  0 for a count that does not round (the caller's overflow checks refuse it).
+inline size_t conversation_alloc_capacity(size_t bytes) {
+    if (!conversation_mmap_block(bytes)) return bytes;
+    return conversation_alloc_detail::page_round(bytes, conversation_alloc_detail::mode().page);
+}
+
+/// The allocator of parked conversation state.  Stateless: every instance allocates the same way, so containers move
+/// in O(1) and compare equal.  ValueInit = false: construct(p) with no argument leaves the element alone (a container
+/// that resizes without a fill value does not write the new elements); ConversationBuffer uses it for its segments and
+/// passes the fill value explicitly unless the block is a fresh mapping.  ValueInit = true: std::allocator's
+/// value-initialization (resize(n) zeroes), for the checkpoint vectors, whose callers rely on it as before.
+template<class T, bool ValueInit = true>
+struct ConversationAllocator {
+    using value_type = T;
+    using size_type = std::size_t;
+    using difference_type = std::ptrdiff_t;
+    using propagate_on_container_move_assignment = std::true_type;
+    using is_always_equal = std::true_type;
+    template<class U> struct rebind { using other = ConversationAllocator<U, ValueInit>; };
+
+    ConversationAllocator() noexcept = default;
+    template<class U> ConversationAllocator(const ConversationAllocator<U, ValueInit>&) noexcept {}
+
+    T* allocate(size_t n) {
+        if (n > std::numeric_limits<size_t>::max() / sizeof(T)) throw std::bad_array_new_length();
+        const size_t bytes = n * sizeof(T);
+#if STRATA_CONV_MMAP_SUPPORTED
+        if (conversation_mmap_block(bytes)) {
+            const size_t len = conversation_alloc_detail::page_round(bytes, conversation_alloc_detail::mode().page);
+            if (len == 0) throw std::bad_alloc();
+            void* p = ::mmap(nullptr, len, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+            if (p == MAP_FAILED) throw std::bad_alloc();
+            return static_cast<T*>(p);
+        }
+#endif
+        return std::allocator<T>().allocate(n);
+    }
+    void deallocate(T* p, size_t n) noexcept {
+        if (p == nullptr) return;
+#if STRATA_CONV_MMAP_SUPPORTED
+        const size_t bytes = n * sizeof(T);
+        if (conversation_mmap_block(bytes)) {
+            ::munmap(static_cast<void*>(p), conversation_alloc_detail::page_round(bytes, conversation_alloc_detail::mode().page));
+            return;
+        }
+#endif
+        std::allocator<T>().deallocate(p, n);
+    }
+
+    template<class U> void construct(U* p) noexcept(std::is_nothrow_default_constructible_v<U>) {
+        if constexpr (ValueInit) ::new ((void*) p) U();
+        else ::new ((void*) p) U;
+    }
+    template<class U, class... A> void construct(U* p, A&&... a) {
+        ::new ((void*) p) U(std::forward<A>(a)...);
+    }
+
+    template<class U> bool operator==(const ConversationAllocator<U, ValueInit>&) const noexcept { return true; }
+    template<class U> bool operator!=(const ConversationAllocator<U, ValueInit>&) const noexcept { return false; }
+};
+
+/// A checkpoint's running-state bytes (ConversationCheckpoint::gdn and the rest): a std::vector with the allocator
+/// above.  Same interface and semantics as std::vector<uint8_t>; only where the memory comes from differs.
+using ConversationBytes = std::vector<uint8_t, ConversationAllocator<uint8_t>>;
+
+}  // namespace strata::core
