+// STRATA_GR_DOWN_PF=2 / 3 (opt-in): gr_down_staged_kernel with the weights of PF tiles in flight instead of one.  The
+// eight tiles are unrolled, so a lane's weights sit in a ring of PF + 1 register slots at compile-time indices and
+// the staged kernel's copy of the next tile into the current registers (which made the loads of tile h + 2 wait for
+// tile h + 1) is gone.  The activations' staging, the barriers and every sum are the staged kernel's (a lane
+// accumulates the chunks lane + 32 q of tile h in ascending h, then q), so the same bits.  Only for the exact-token
+// launches of 1..6 tokens: (PF + 1) x 5 uint4 a thread beside the token sums.
+template <int T, int PF>
+__global__ void __launch_bounds__(THREADS) gr_down_staged_pf_kernel(GrMulti m) {
+    static_assert(PF >= 1 && PF < N_HTILES, "the prefetch distance is 1..7 tiles");
+    extern __shared__ __align__(16) float4 hbuf[];      // 2 buffers x [T][2][160] float4
+    const int t = threadIdx.x, lane = t & 31, warp = t >> 5;
+    const bool inject_block = blockIdx.x == DOWN_BLOCKS;
+    const int row = inject_block ? warp : blockIdx.x * WARPS + warp;
+    const bool active = !(inject_block && (m.a[0].w_inject == nullptr || warp >= HC));
+    const uint16_t* wrow = (inject_block ? m.a[0].w_inject : m.a[0].w_down) + (size_t) (active ? row : 0) * D;
+    const uint4* w4 = reinterpret_cast<const uint4*>(wrow);
+    const size_t buf_f4 = (size_t) T * (H_TILE / 4);    // float4 per buffer (the second one follows the first)
+    float acc[T];
+#pragma unroll
+    for (int k = 0; k < T; ++k) acc[k] = 0.0f;
+    uint4 wr[PF + 1][HQ];                               // tile h in slot h % (PF + 1)
+    if (active) {
+#pragma unroll
+        for (int p = 0; p < PF; ++p) {
+#pragma unroll
+            for (int q = 0; q < HQ; ++q) wr[p][q] = __ldg(w4 + p * (H_TILE / 8) + lane + 32 * q);
+        }
+    }
+    stage_htile(m, T, 0, hbuf, t);
+    cp_async_commit();
+    stage_htile(m, T, 1, hbuf + buf_f4, t);
+    cp_async_commit();
+#pragma unroll
+    for (int h = 0; h < N_HTILES; ++h) {
+        if (active && h + PF < N_HTILES) {              // into the slot tile h - 1 left
+#pragma unroll
+            for (int q = 0; q < HQ; ++q)
+                wr[(h + PF) % (PF + 1)][q] = __ldg(w4 + (h + PF) * (H_TILE / 8) + lane + 32 * q);
+        }
+        if (h + 1 < N_HTILES) cp_async_wait1();         // tile h has landed (h + 1 may still be on its way)
+        else cp_async_wait0();
+        __syncthreads();
+        const float4* cur = hbuf + (h & 1) * buf_f4;
+        if (active) {
+#pragma unroll
+            for (int q = 0; q < HQ; ++q) {
+                const int j = lane + 32 * q;
+                const Bf16x8 wvq = unpack8(wr[h % (PF + 1)][q]);
+#pragma unroll
+                for (int k = 0; k < T; ++k) {
+                    const float4* pk = cur + (size_t) k * (H_TILE / 4);
+                    acc[k] += dot8u(wvq, pk[j], pk[H_TILE / 8 + j]);
+                }
+            }
+        }
+        __syncthreads();                                // every warp is done with buffer h & 1
+        if (h + 2 < N_HTILES) stage_htile(m, T, h + 2, hbuf + (h & 1) * buf_f4, t);
+        cp_async_commit();                              // an empty group at the end keeps the wait counts simple
+    }
+    if (!active) return;
+    float s[T];
+#pragma unroll
+    for (int k = 0; k < T; ++k) s[k] = warp_sum(acc[k]);
+    // lane k writes token k (every lane holds every sum after the xor reduction)
+#pragma unroll
+    for (int k = 0; k < T; ++k) {
+        if (lane != k) continue;
+        if (inject_block) {
+            m.a[k].inject_out[row] = s[k];
+        } else {
+            const float x = s[k] / (float) HC;
+            m.a[k].lo[row] = x / (1.0f + __expf(-x));
+        }
+    }
+}
+
+// STRATA_GR_DOWN_PF: 2 or 3 tiles of weights in flight in the staged down projection (above); anything else = 1, the
+// staged kernel itself.  Read once.
+int gr_down_pf() {
+    static const int pf = [] {
+        const char* v = std::getenv("STRATA_GR_DOWN_PF");
+        const int n = v != nullptr ? std::atoi(v) : 1;
+        return n == 2 || n == 3 ? n : 1;
+    }();
+    return pf;
+}
+template <int PF>
+void launch_down_staged_pf(int ct, const GrMulti& c, size_t smem, cudaStream_t st) {
+    switch (ct) {
+        case 1: gr_down_staged_pf_kernel<1, PF><<<DOWN_BLOCKS + 1, THREADS, smem, st>>>(c); break;
+        case 2: gr_down_staged_pf_kernel<2, PF><<<DOWN_BLOCKS + 1, THREADS, smem, st>>>(c); break;
+        case 3: gr_down_staged_pf_kernel<3, PF><<<DOWN_BLOCKS + 1, THREADS, smem, st>>>(c); break;
+        case 4: gr_down_staged_pf_kernel<4, PF><<<DOWN_BLOCKS + 1, THREADS, smem, st>>>(c); break;
+        case 5: gr_down_staged_pf_kernel<5, PF><<<DOWN_BLOCKS + 1, THREADS, smem, st>>>(c); break;
+        default: gr_down_staged_pf_kernel<6, PF><<<DOWN_BLOCKS + 1, THREADS, smem, st>>>(c); break;
+    }
+}
+
 // the current device is Volta (sm_70): the fast norm/up is its default
 bool cur_dev_volta() {
 #if defined(__HIPCC__)
@@ -1466,6 +1564,21 @@ int down_chunk(bool staged, int* tile_out) {
         set_staged_attr(gr_down_staged_kernel<6, true>, 6);
         set_staged_attr(gr_down_staged_kernel<4, false>, 4);
         set_staged_attr(gr_down_staged_kernel<kFusedGrMaxT, false>, kFusedGrMaxT);
+        if (gr_down_pf() == 2) {
+            set_staged_attr(gr_down_staged_pf_kernel<1, 2>, 1);
+            set_staged_attr(gr_down_staged_pf_kernel<2, 2>, 2);
+            set_staged_attr(gr_down_staged_pf_kernel<3, 2>, 3);
+            set_staged_attr(gr_down_staged_pf_kernel<4, 2>, 4);
+            set_staged_attr(gr_down_staged_pf_kernel<5, 2>, 5);
+            set_staged_attr(gr_down_staged_pf_kernel<6, 2>, 6);
+        } else if (gr_down_pf() == 3) {
+            set_staged_attr(gr_down_staged_pf_kernel<1, 3>, 1);
+            set_staged_attr(gr_down_staged_pf_kernel<2, 3>, 2);
+            set_staged_attr(gr_down_staged_pf_kernel<3, 3>, 3);
+            set_staged_attr(gr_down_staged_pf_kernel<4, 3>, 4);
+            set_staged_attr(gr_down_staged_pf_kernel<5, 3>, 5);
+            set_staged_attr(gr_down_staged_pf_kernel<6, 3>, 6);
+        }
         cudaGetLastError();      // drop any error the attempt left behind
         // The opt-in is a promise a pre-Volta card does not keep: an sm_60 answers 65536 and accepts the
         // cudaFuncSetAttribute for 61440 B, then fails the LAUNCH with "invalid argument".  What such a card
@@ -1644,16 +1757,22 @@ void launch_multi(const GrMulti& m, int variant, cudaStream_t st, unsigned long
         const bool max4 = ct <= 4 && gr_down_max4();
         if (staged) {
             // #783 PR-g (stuchapin909): a launch of exactly ct <= 6 tokens is its own instantiation, the loop bounds
-            // are compile-time (the same sums in the same order); STRATA_NO_MULTI_GR=1 keeps the generic kernels
+            // are compile-time (the same sums in the same order); STRATA_NO_MULTI_GR=1 keeps the generic kernels.
+            // STRATA_GR_DOWN_PF=2|3: those launches with 2 or 3 tiles of weights in flight (the same sums, same order),
+            // where no token groups split the launch (down_tg)
             const int tg = down_tg(ct);
-            if (exact_t && tg > 0 && tg < ct) {
+            const bool split_tg = exact_t && tg > 0 && tg < ct;
+            const int pf = exact_t && !split_tg && ct <= 6 ? gr_down_pf() : 1;
+            if (split_tg) {
                 const dim3 grid(DOWN_BLOCKS + 1, (unsigned) (ct / tg));
                 const size_t sm_g = (size_t) tg * per_tok;
                 if (tg == 1) gr_down_staged_kernel<1, true><<<grid, THREADS, sm_g, st>>>(c);
                 else if (tg == 2) gr_down_staged_kernel<2, true><<<grid, THREADS, sm_g, st>>>(c);
                 else gr_down_staged_kernel<3, true><<<grid, THREADS, sm_g, st>>>(c);
             } else
-            if (exact_t && ct == 1) gr_down_staged_kernel<1, true><<<DOWN_BLOCKS + 1, THREADS, smem, st>>>(c);
+            if (pf == 2) launch_down_staged_pf<2>(ct, c, smem, st);
+            else if (pf == 3) launch_down_staged_pf<3>(ct, c, smem, st);
+            else if (exact_t && ct == 1) gr_down_staged_kernel<1, true><<<DOWN_BLOCKS + 1, THREADS, smem, st>>>(c);
             else if (exact_t && ct == 2) gr_down_staged_kernel<2, true><<<DOWN_BLOCKS + 1, THREADS, smem, st>>>(c);
             else if (exact_t && ct == 3) gr_down_staged_kernel<3, true><<<DOWN_BLOCKS + 1, THREADS, smem, st>>>(c);
             else if (exact_t && ct == 4) gr_down_staged_kernel<4, true><<<DOWN_BLOCKS + 1, THREADS, smem, st>>>(c);
