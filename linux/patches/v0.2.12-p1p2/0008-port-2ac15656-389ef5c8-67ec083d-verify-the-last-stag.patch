+bool sample_tokens_reserve(int n_vocab, void* stream) {
+    if (stream_capturing(stream)) return false;
+    const int n_blocks = (n_vocab + kSplitBlockSpan - 1) / kSplitBlockSpan;
+    if (sampled_path() == SampledPath::Split && n_vocab > 0 && n_blocks <= kSplitMaxBlocks)
+        (void) split_scratch(stream, (size_t) 16 * n_blocks * kSelMax);   // sample_tokens' size for <= 16 rows
+    return true;
+}
+
 namespace {
 int coupled_blocks(int nv) { return (nv + kSplitBlockSpan - 1) / kSplitBlockSpan; }
 int coupled_kpart(int nv) { return nv < kSelMax ? nv : kSelMax; }
diff --git a/tests/core/sampler_same_test.cpp b/tests/core/sampler_same_test.cpp
new file mode 100644
index 00000000..d6e9e06f
--- /dev/null
+++ b/tests/core/sampler_same_test.cpp
@@ -0,0 +1,71 @@
+// same_sampling (include/strata/kernels/sampler.hpp): STRATA_EARLY_SAMPLE keeps a row drawn in batch_launch only when
+// batch_poll's draw would be the same, so a change in any field sample_tokens reads must be seen.  Header-only, CPU.
+#include "strata/kernels/sampler.hpp"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+
+namespace {
+int failures = 0;
+void check(bool ok, const char* what) {
+    if (!ok) {
+        std::fprintf(stderr, "FAIL: %s\n", what);
+        ++failures;
+    }
+}
+}  // namespace
+
+int main() {
+    using strata::kernels::SamplerParams;
+    using strata::kernels::same_sampling;
+    SamplerParams a;
+    {
+        // exactly these 14 fields: a new one (even a bool in a padding hole, where the size stays 80) stops this
+        // binding from compiling - add it to same_sampling, to the list below and to its `differs` line
+        [[maybe_unused]] const auto& [top_k, top_p, min_p, temperature, min_keep, penalty_last_n, penalty_repeat,
+                                      penalty_freq, penalty_present, seed, counter, greedy, logit_bias, gumbel] = a;
+    }
+    a.temperature = 0.7f;
+    a.seed = 42;
+    a.counter = 1000;
+    check(same_sampling(a, a), "a draw is its own");
+    SamplerParams b = a;
+    check(same_sampling(a, b), "a copy");
+    const float bias = 0.0f;
+    const auto differs = [&](void (*edit)(SamplerParams&, const float*), const char* what) {
+        SamplerParams c = a;
+        edit(c, &bias);
+        check(!same_sampling(a, c) && !same_sampling(c, a), what);
+    };
+    differs([](SamplerParams& p, const float*) { p.top_k = 40; }, "top_k");
+    differs([](SamplerParams& p, const float*) { p.top_p = 0.9f; }, "top_p");
+    differs([](SamplerParams& p, const float*) { p.min_p = 0.05f; }, "min_p");
+    differs([](SamplerParams& p, const float*) { p.temperature = 0.8f; }, "temperature");
+    differs([](SamplerParams& p, const float*) { p.min_keep = 2; }, "min_keep");
+    differs([](SamplerParams& p, const float*) { p.penalty_last_n = 64; }, "penalty_last_n");
+    differs([](SamplerParams& p, const float*) { p.penalty_repeat = 1.1f; }, "penalty_repeat");
+    differs([](SamplerParams& p, const float*) { p.penalty_freq = 0.5f; }, "penalty_freq");
+    differs([](SamplerParams& p, const float*) { p.penalty_present = 0.5f; }, "penalty_present");
+    differs([](SamplerParams& p, const float*) { p.seed = 43; }, "seed");
+    differs([](SamplerParams& p, const float*) { p.counter = 1001; }, "counter (the position)");
+    differs([](SamplerParams& p, const float*) { p.greedy = true; }, "greedy");
+    differs([](SamplerParams& p, const float* x) { p.logit_bias = x; }, "logit_bias");
+    differs([](SamplerParams& p, const float*) { p.gumbel = true; }, "gumbel");
+    // bit for bit: -0.0 is not 0.0, and a NaN is never the same draw
+    differs([](SamplerParams& p, const float*) { p.min_p = -0.0f; }, "min_p -0.0 vs 0.0");
+    {
+        // two NaNs: float == calls even the same one different, so a match here is the bit compare
+        const auto nan_bits = [](uint32_t u) { float f; std::memcpy(&f, &u, sizeof f); return f; };
+        SamplerParams n = a, m = a;
+        n.top_p = nan_bits(0x7fc00000u);
+        m.top_p = nan_bits(0x7fc00000u);
+        check(same_sampling(n, m), "the same NaN bits are the same draw");
+        m.top_p = nan_bits(0x7fc00001u);
+        check(!same_sampling(n, m) && !same_sampling(m, n), "NaN payloads differ");
+        check(!same_sampling(n, a), "NaN top_p vs 0.95");
+    }
+    if (failures != 0) return 1;
+    std::puts("sampler_same_test: passed");
+    return 0;
+}
