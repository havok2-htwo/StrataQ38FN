+// STRATA_EARLY_SAMPLE: slot_row_draw's draw for a row that stages nothing (no penalty history) and reads no logit bias
+// (one device buffer per slot that set_slot_logit_bias may rewrite while the window runs)
+bool Verifier::early_row_draw(int t, strata::kernels::SamplerParams& sp) const {
+    sp = slot_sp_[(size_t) last_rows_[t]];
+    const bool pen = sp.penalty_last_n > 0 && (sp.penalty_repeat != 1.0f || sp.penalty_freq != 0.0f || sp.penalty_present != 0.0f);
+    if (sp.greedy || sp.temperature <= 0.0f || pen || sp.logit_bias != nullptr) return false;
+    sp.counter = (uint64_t) last_pos_b_[t];   // as slot_row_draw: Philox(seed, position)
+    sp.penalty_last_n = 0;
+    return true;
+}
