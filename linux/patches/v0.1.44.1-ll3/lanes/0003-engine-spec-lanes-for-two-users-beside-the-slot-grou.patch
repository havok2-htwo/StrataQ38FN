+// include/strata/program/spec_lanes.hpp - STRATA_SPEC_LANES=2 (opt-in): spec lanes beside the --batch slot groups
+// (header-only: the rules, no CUDA).
+//
+// With pipelined slot groups (--batch with --batch-groups G > 1 on a layer split) two users decode in two groups, one
+// row each, with no drafts.  A spec lane runs one such slot as its own solo-MTP stream instead: its own verifier per
+// stage (bound to the slot's sessions), its own drafter (sharing the solo drafter's weights), its windows launched on
+// the stages as each stage finishes the one before (the two lanes' windows interleave on every card), the verdict on
+// the last stage, the commit queued on every stage at once (eager), the drafter's chain for the next window.  The same
+// window graphs as the solo loop's, the same exact-match verdict and Philox(seed, position) draw: a lane emits the
+// tokens the serial solo loop would.  These are the rules the engine and its test share.
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+
+namespace strata::program::spec_lanes {
+
+/// STRATA_SPEC_LANES: unset, empty and "0..." are off (0); "2" is two lanes; anything else is not supported (-1:
+/// said, and off).
+inline int env_lanes(const char* v) {
+    if (v == nullptr || v[0] == '\0' || v[0] == '0') return 0;
+    return v[0] == '2' && v[1] == '\0' ? 2 : -1;
+}
+
+/// The lane slots: the first `L` of the order the server fills pipelined groups in (0, GS, 2 GS, ...: one user per
+/// group), so two users land on them.  False when the slots do not form `L` groups of GS (no lanes).
+inline bool lane_slots(int batch, int groups, int L, int* out) {
+    if (L < 1 || groups < L || batch <= 0 || groups <= 1 || batch % groups != 0) return false;
+    const int gs = batch / groups;
+    for (int j = 0; j < L; ++j) out[j] = j * gs;
+    return true;
+}
+
+/// What the gate looks at of one slot.
+struct Slot {
+    bool active = false;   ///< decoding (BSlot::active)
+    bool lane_ok = false;  ///< its request can run in a lane: no images, no penalties, no logit bias (set at admission)
+};
+
+/// Do the lanes run now?  `lanes`: the L lane slots; `others_active`: an active slot that is not a lane slot.
+/// Every lane slot active (`one`: at least one) and no other slot active, and each active lane slot lane_ok.
+inline bool gate(const Slot* lanes, int L, bool others_active, bool one) {
+    if (others_active) return false;
+    int n = 0;
+    for (int j = 0; j < L; ++j) {
+        if (!lanes[j].active) continue;
+        if (!lanes[j].lane_ok) return false;
+        ++n;
+    }
+    return one ? n >= 1 : n == L;
+}
+
+/// The serial loop's window size: 1 + the drafts (of `avail`) whose probability is at least `min_p` (min_p 0: all),
+/// at most `s_mtp` rows, and never past the context (`room` = max_context - p cells left).
+inline int window_size(const float* prob, int avail, int s_mtp, double min_p, int64_t room) {
+    int T = 1;
+    while (T < s_mtp && T - 1 < avail && (min_p <= 0.0 || prob[T - 1] >= (float) min_p)) ++T;
+    return (int) std::max<int64_t>(1, std::min<int64_t>(T, room));
+}
+
+/// One window's verdict.  The window fed `tok[0..T)` at positions p..; `out[t]` is the pick after row t.  `a` rows of
+/// drafts are accepted (exact match); the picks out[0..a] go out one by one with the batch path's checks per token,
+/// and the slot's sessions keep exactly the rows whose picks went out (`commit`), so what they hold is what the slot's
+/// token list says (a finished slot is a conversation cache like any other).
+struct Verdict {
+    int a = 0;                 ///< accepted drafts
+    int emit = 0;              ///< picks that go out (out[0..emit))
+    int commit = 0;            ///< rows the sessions keep (= emit)
+    const char* fin = nullptr; ///< why the slot ends ("stop", "cancel", "length"), or nullptr: it goes on
+};
+
+/// `produced`: the slot's tokens out so far; `is_eos(y)`: an end token.  The checks per token are the pump's: an end
+/// token, a stop asked for (BSTOP), max_new, and the context (the position of the row's token + 2 past max_context).
+template <class Eos>
+inline Verdict verdict(const int32_t* tok, const int32_t* out, int T, int64_t p, int64_t produced, int64_t max_new,
+                       bool stop, int64_t max_context, Eos&& is_eos) {
+    Verdict v;
+    while (v.a < T - 1 && tok[v.a + 1] == out[v.a]) ++v.a;
+    for (int i = 0; i <= v.a; ++i) {
+        const int32_t y = out[i];
+        ++produced;
+        ++v.emit;
+        v.fin = is_eos(y) ? "stop" : stop ? "cancel" : produced >= max_new ? "length"
+              : p + i + 2 > max_context ? "length" : nullptr;
+        if (v.fin != nullptr) break;
+    }
+    v.commit = v.emit;
+    return v;
+}
+
+}  // namespace strata::program::spec_lanes
