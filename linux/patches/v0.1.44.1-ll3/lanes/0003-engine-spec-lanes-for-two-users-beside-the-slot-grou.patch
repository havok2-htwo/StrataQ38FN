+// STRATA_SPEC_LANES's rules (include/strata/program/spec_lanes.hpp): the switch, the lane slots, the gate, the window
+// size and one window's verdict (what goes out and what the slot keeps).  Header-only, CPU: no model, no GPU.
+#include "strata/program/spec_lanes.hpp"
+
+#include <cstdio>
+#include <cstring>
+
+namespace sl = strata::program::spec_lanes;
+
+namespace {
+int failures = 0;
+void check(bool ok, const char* what) {
+    if (!ok) {
+        std::fprintf(stderr, "FAIL: %s\n", what);
+        ++failures;
+    }
+}
+}  // namespace
+
+int main() {
+    // the switch: unset, empty and 0 are off (the default path); 2 is two lanes; anything else unsupported
+    check(sl::env_lanes(nullptr) == 0, "unset is off");
+    check(sl::env_lanes("") == 0, "empty is off");
+    check(sl::env_lanes("0") == 0, "0 is off");
+    check(sl::env_lanes("2") == 2, "2 is two lanes");
+    check(sl::env_lanes("1") == -1, "1 is not supported");
+    check(sl::env_lanes("4") == -1, "4 is not supported (yet)");
+    check(sl::env_lanes("22") == -1, "22 is not supported");
+
+    // the lane slots: the server's spreading order (0, GS, ...): production --batch 16 in 4 groups -> 0 and 4
+    int ls[4] = {-1, -1, -1, -1};
+    check(sl::lane_slots(16, 4, 2, ls) && ls[0] == 0 && ls[1] == 4, "16 slots in 4 groups: 0, 4");
+    check(sl::lane_slots(8, 2, 2, ls) && ls[0] == 0 && ls[1] == 4, "8 slots in 2 groups: 0, 4");
+    check(sl::lane_slots(12, 4, 2, ls) && ls[0] == 0 && ls[1] == 3, "12 slots in 4 groups: 0, 3");
+    check(!sl::lane_slots(16, 1, 2, ls), "one group: no lanes");
+    check(!sl::lane_slots(0, 4, 2, ls), "no slots: no lanes");
+    check(!sl::lane_slots(15, 4, 2, ls), "groups that do not divide the slots: no lanes");
+
+    // the gate: both lane slots active, nothing else, both lane_ok
+    sl::Slot both[2] = {{true, true}, {true, true}};
+    check(sl::gate(both, 2, false, false), "slots 0 and 4 active: lanes");
+    check(!sl::gate(both, 2, true, false), "a third slot active: the pump");
+    sl::Slot img[2] = {{true, true}, {true, false}};
+    check(!sl::gate(img, 2, false, false), "an image / penalty slot: the pump");
+    sl::Slot one[2] = {{true, true}, {false, false}};
+    check(!sl::gate(one, 2, false, false), "one lane slot active: the pump (the default)");
+    check(sl::gate(one, 2, false, true), "one lane slot active with STRATA_SPEC_LANES_ONE: its lane");
+    sl::Slot none[2] = {{false, false}, {false, false}};
+    check(!sl::gate(none, 2, false, true), "nothing active: no lanes");
+    check(!sl::gate(img, 2, false, true), "one: an active slot that may not run in a lane stops them");
+
+    // the window size: the serial loop's rule (drafts while their probability is >= spec_min_p), the context room
+    const float pr[3] = {0.9f, 0.6f, 0.4f};
+    check(sl::window_size(pr, 3, 4, 0.5, 1000) == 3, "min_p 0.5: two drafts");
+    check(sl::window_size(pr, 3, 4, 0.0, 1000) == 4, "min_p 0: all three drafts");
+    check(sl::window_size(pr, 3, 4, 0.95, 1000) == 1, "first draft below min_p: one row");
+    check(sl::window_size(pr, 1, 4, 0.0, 1000) == 2, "only one draft available");
+    check(sl::window_size(pr, 3, 4, 0.0, 2) == 2, "two cells of context left");
+    check(sl::window_size(pr, 3, 2, 0.0, 1000) == 2, "--mtp-max-t 2");
+    check(sl::window_size(pr, 0, 4, 0.0, 1000) == 1, "no drafts: one row");
+
+    auto never = [](int32_t) { return false; };
+    auto eos7 = [](int32_t y) { return y == 7; };
+    {   // all drafts accepted: every pick goes out, every row is kept
+        const int32_t tok[4] = {10, 11, 12, 13}, out[4] = {11, 12, 13, 14};
+        const sl::Verdict v = sl::verdict(tok, out, 4, 100, 5, 1000, false, 4096, never);
+        check(v.a == 3 && v.emit == 4 && v.commit == 4 && v.fin == nullptr, "all accepted");
+    }
+    {   // the second draft rejected: picks 0 and 1 go out (the second is the correction), rows 0 and 1 kept
+        const int32_t tok[4] = {10, 11, 99, 13}, out[4] = {11, 12, 13, 14};
+        const sl::Verdict v = sl::verdict(tok, out, 4, 100, 5, 1000, false, 4096, never);
+        check(v.a == 1 && v.emit == 2 && v.commit == 2 && v.fin == nullptr, "one accepted");
+    }
+    {   // an end token inside the accepted run: it goes out, the slot ends, the rows after it are not kept
+        const int32_t tok[4] = {10, 11, 7, 13}, out[4] = {11, 7, 13, 14};
+        const sl::Verdict v = sl::verdict(tok, out, 4, 100, 5, 1000, false, 4096, eos7);
+        check(v.a == 3 && v.emit == 2 && v.commit == 2 && v.fin != nullptr && std::strcmp(v.fin, "stop") == 0,
+              "end token at pick 1");
+    }
+    {   // max_new reached inside the window
+        const int32_t tok[4] = {10, 11, 12, 13}, out[4] = {11, 12, 13, 14};
+        const sl::Verdict v = sl::verdict(tok, out, 4, 100, 8, 10, false, 4096, never);
+        check(v.emit == 2 && v.commit == 2 && v.fin != nullptr && std::strcmp(v.fin, "length") == 0, "max_new at pick 1");
+    }
+    {   // BSTOP: the first pick goes out, then the slot ends (the pump's rule)
+        const int32_t tok[4] = {10, 11, 12, 13}, out[4] = {11, 12, 13, 14};
+        const sl::Verdict v = sl::verdict(tok, out, 4, 100, 5, 1000, true, 4096, never);
+        check(v.emit == 1 && v.commit == 1 && v.fin != nullptr && std::strcmp(v.fin, "cancel") == 0, "stop at pick 0");
+    }
+    {   // the context: the pump ends a slot once its fed token's position + 2 passes max_context (a window that just
+        // fits, positions 100..102 of 103: the third pick is the last)
+        const int32_t tok[3] = {10, 11, 12}, out[3] = {11, 12, 13};
+        const sl::Verdict v = sl::verdict(tok, out, 3, 100, 5, 1000, false, 103, never);
+        check(v.emit == 3 && v.commit == 3 && v.fin != nullptr && std::strcmp(v.fin, "length") == 0, "context end");
+        const sl::Verdict w = sl::verdict(tok, out, 3, 100, 5, 1000, false, 104, never);
+        check(w.emit == 3 && w.fin == nullptr, "one cell more: it goes on");
+    }
+    {   // a one-row window
+        const int32_t tok[1] = {10}, out[1] = {11};
+        const sl::Verdict v = sl::verdict(tok, out, 1, 100, 5, 1000, false, 4096, never);
+        check(v.a == 0 && v.emit == 1 && v.commit == 1 && v.fin == nullptr, "one row");
+    }
+
+    if (failures == 0) std::printf("spec_lanes_test: all checks passed\n");
+    return failures == 0 ? 0 : 1;
+}
