+// STRATA_SOLO_PIPELINE's rules (include/strata/program/solo_pipeline.hpp): the switch, how --pipeline-windows resolves
+// beside --batch, the room a card needs before the second verifier, and which solo requests stay serial.  Header-only,
+// CPU: no model, no GPU.
+#include "strata/program/solo_pipeline.hpp"
+
+#include <cstdio>
+#include <cstring>
+
+namespace sp = strata::program::solo_pipeline;
+
+namespace {
+int failures = 0;
+void check(bool ok, const char* what) {
+    if (!ok) {
+        std::fprintf(stderr, "FAIL: %s\n", what);
+        ++failures;
+    }
+}
+}  // namespace
+
+int main() {
+    // the switch: unset, empty and 0 are off (the default path), anything else on
+    check(!sp::env_on(nullptr), "unset is off");
+    check(!sp::env_on(""), "empty is off");
+    check(!sp::env_on("0"), "0 is off");
+    check(sp::env_on("1"), "1 is on");
+    check(sp::env_on("yes"), "text is on");
+
+    // --pipeline-windows: only a value that was not asked for (auto, resolved to 0 on CUDA) becomes 2, and only with
+    // --batch and the switch; an explicit 0 or 1 stays, batch 0 stays (the single-stream server's own rule)
+    check(sp::resolve_windows(0, true, 16, true) == 2, "auto + batch + switch -> 2");
+    check(sp::resolve_windows(0, true, 16, false) == 0, "no switch: unchanged");
+    check(sp::resolve_windows(0, true, 0, true) == 0, "no batch: unchanged");
+    check(sp::resolve_windows(0, false, 16, true) == 0, "--pipeline-windows 0 given: unchanged");
+    check(sp::resolve_windows(1, false, 16, true) == 1, "--pipeline-windows 1 given: unchanged");
+    check(sp::resolve_windows(2, true, 0, false) == 2, "auto on (HIP) stays on");
+
+    // asked: switch, batch slots, two windows; --pipeline-windows 1 stays refused beside --batch
+    check(sp::asked(2, 16, true), "pw 2 + batch + switch");
+    check(!sp::asked(2, 16, false), "no switch: refused as before");
+    check(!sp::asked(1, 16, true), "pw 1 beside batch: refused");
+    check(!sp::asked(2, 0, true), "no batch: the batch-0 pipeline, not this");
+
+    // the room: verifier + snapshots + floor + 256 MiB
+    check(sp::room_need_bytes(160, 0, 512) == (int64_t) (160 + 512 + 256) << 20, "last stage: no snapshots");
+    check(sp::room_need_bytes(160, 56ll << 20, 512) == (int64_t) (160 + 56 + 512 + 256) << 20, "front stage: snapshots");
+    // the production split after load (12,25,37, 2026-10-16): CUDA0 ~1570 MiB free before the verifiers - fits; the s28r
+    // split's CUDA1 (~920 MiB) does not
+    check(((int64_t) 1570 << 20) >= sp::room_need_bytes(160, 56ll << 20, 512), "prod CUDA0 fits");
+    check(((int64_t) 920 << 20) < sp::room_need_bytes(160, 56ll << 20, 512), "s28r CUDA1 stays serial");
+
+    // the requests: a plain lone request is pipelined; every other kind decodes serially, an admission silently
+    bool quiet = true;
+    sp::Request r;
+    check(sp::why_serial(r, quiet) == nullptr && !quiet, "a plain solo request is pipelined");
+    r.admission = true;
+    check(sp::why_serial(r, quiet) != nullptr && quiet, "an admission's first token: serial, silent");
+    r = sp::Request{};
+    r.images = true;
+    check(sp::why_serial(r, quiet) != nullptr && !quiet, "images: serial, said");
+    r = sp::Request{};
+    r.slots_active = true;
+    check(sp::why_serial(r, quiet) != nullptr, "slots decoding: serial");
+    r = sp::Request{};
+    r.groups_in_flight = true;
+    check(sp::why_serial(r, quiet) != nullptr, "groups in flight: serial");
+    r = sp::Request{};
+    r.out_of_vram = true;
+    check(sp::why_serial(r, quiet) != nullptr, "experts out of VRAM: serial");
+    r = sp::Request{};
+    r.snapshot_resized = true;
+    check(sp::why_serial(r, quiet) != nullptr, "snapshot size changed: serial");
+    // an admission wins over everything (never said)
+    r = sp::Request{};
+    r.admission = r.images = r.slots_active = true;
+    check(sp::why_serial(r, quiet) != nullptr && quiet && std::strcmp(sp::why_serial(r, quiet), "a batch admission") == 0,
+          "an admission first");
+
+    if (failures == 0) std::printf("solo_pipeline_test: all checks passed\n");
+    return failures == 0 ? 0 : 1;
+}
