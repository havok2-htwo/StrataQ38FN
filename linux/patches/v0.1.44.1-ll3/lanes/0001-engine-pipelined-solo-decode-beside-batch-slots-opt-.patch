@@ -0,0 +1,55 @@
+// include/strata/program/solo_pipeline.hpp - STRATA_SOLO_PIPELINE (opt-in): --pipeline-windows 2 beside --batch slots
+// (header-only: the rules, no CUDA).
+//
+// With --batch the server sends a request that is alone to the solo path (GEN) and the engine decodes it with the serial
+// solo loop.  STRATA_SOLO_PIPELINE=1 lets that request run the pipelined decode loop instead (two verifiers per stage,
+// one conversation's windows overlapped across the stages; the same graphs, so the same tokens).  The batch windows,
+// the admissions (BGEN's first token) and every prompt read keep their serial windows.  These are the rules that decide
+// when it is on, for the engine and its test.
+#pragma once
+
+#include <cstdint>
+
+namespace strata::program::solo_pipeline {
+
+/// The switch's text: unset, empty and "0..." are off, anything else on.
+inline bool env_on(const char* v) { return v != nullptr && v[0] != '\0' && v[0] != '0'; }
+
+/// --pipeline-windows as the engine resolves it: not asked for (`auto_pw`), --batch on and the switch on: 2.
+inline int resolve_windows(int pipeline_windows, bool auto_pw, int batch, bool env) {
+    return auto_pw && pipeline_windows == 0 && batch > 0 && env ? 2 : pipeline_windows;
+}
+
+/// Is it asked for: the switch, --batch and --pipeline-windows 2 (1 stays refused beside --batch).
+inline bool asked(int pipeline_windows, int batch, bool env) { return env && batch > 0 && pipeline_windows >= 2; }
+
+/// What one card needs free before the second verifier is made: the verifier (`window_mib`, as the cache sizing holds
+/// it back), the stage's GDN snapshots (front stages; 0 on the last), and the engine's safe floor plus 256 MiB for the
+/// even verifier and the graphs still to come.  Less: the solo path stays serial (no loan, no paging).
+inline int64_t room_need_bytes(int64_t window_mib, int64_t snapshot_bytes, int64_t safe_mib) {
+    return ((window_mib + safe_mib + 256) << 20) + snapshot_bytes;
+}
+
+/// One solo request, as the decode loop sees it before it starts.
+struct Request {
+    bool admission = false;        ///< a batch admission's first token (BGEN): the batch path's, never pipelined
+    bool images = false;           ///< images in the request or the live session (the serial loop, as measured)
+    bool slots_active = false;     ///< batch slots decoding (nothing pumps them while a solo request runs)
+    bool groups_in_flight = false; ///< pipelined slot groups not drained
+    bool out_of_vram = false;      ///< an all-resident stage with experts out of VRAM now (its graphs were captured all-resident)
+    bool snapshot_resized = false; ///< a front stage's GDN state is no longer the size its snapshots were made for
+};
+
+/// Why `r` decodes serially (said once per reason), or nullptr: pipelined.  `silent`: an admission, not worth a line.
+inline const char* why_serial(const Request& r, bool& silent) {
+    silent = false;
+    if (r.admission) { silent = true; return "a batch admission"; }
+    if (r.images) return "images in its context";
+    if (r.slots_active) return "batch slots decoding";
+    if (r.groups_in_flight) return "slot groups in flight";
+    if (r.out_of_vram) return "experts out of VRAM (a loan, a shrink or a swap)";
+    if (r.snapshot_resized) return "a GDN state of another size";
+    return nullptr;
+}
+
+}  // namespace strata::program::solo_pipeline
