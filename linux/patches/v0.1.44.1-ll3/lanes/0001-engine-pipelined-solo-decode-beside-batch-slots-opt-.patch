+bool Verifier::set_pl_mode(bool on, std::string& err) {
+    if (fl_active_) { err = "verify: a window is in flight on this verifier"; return false; }
+    // a window staged ahead (prestage) and never launched: the batch and serial windows stage over its inputs between
+    pl_prestaged_ = false;
+    if (!on) {
+        pl_mode_ = false;
+        return true;
+    }
+    if (g_ == nullptr) { err = "verify: set_pl_mode before init"; return false; }
+    if (always_publish_) { pl_mode_ = false; return true; }   // its normal graphs are the pipelined ones already
+    if (device_plan_) { err = "the device-planned layers (STRATA_VERIFY_DEVICE_PLAN)"; return false; }
+    if (remote_opt_ != nullptr) { err = "--remote-expert-opt"; return false; }
+    refresh_ar();
+    if (all_resident_ && ar_off_) { err = "experts out of VRAM (a prompt loan, a shrink or a swap)"; return false; }
+    pl_mode_ = true;
+    return true;
+}
