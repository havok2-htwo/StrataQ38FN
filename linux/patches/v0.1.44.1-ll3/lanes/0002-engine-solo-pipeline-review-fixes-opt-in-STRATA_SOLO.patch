-        // STRATA_SOLO_PIPELINE=1 (opt-in): not asked for, --batch on: the solo path's decode pipelined (see solo_pipeline_env)
-        o.pipeline_windows = strata::program::solo_pipeline::resolve_windows(o.pipeline_windows, true, o.batch,
+        // STRATA_SOLO_PIPELINE=1 (opt-in): not asked for, --batch on: the solo path's decode pipelined (see solo_pipeline_env);
+        // STRATA_PIPELINE_AUTO=0 keeps it off here too (an explicit --pipeline-windows 2 still turns it on)
+        o.pipeline_windows = strata::program::solo_pipeline::resolve_windows(o.pipeline_windows,
+                                                                             !(ae != nullptr && std::atoi(ae) == 0), o.batch,
                                                                              solo_pipeline_env());
     }
     // STRATA_SOLO_PIPELINE=1: --pipeline-windows 2 beside --batch slots (the solo path only; see solo_pipeline_env)
@@ -4092,7 +4094,10 @@ int main(int argc, char** argv) {
     if (solo_pl)
         std::fprintf(stderr, "strata generate: STRATA_SOLO_PIPELINE: --pipeline-windows 2 beside --batch %d: a request "
