+            // STRATA_SOLO_PIPELINE_LOG=1 (testing): one line per solo request, pipelined or not and why
+            if (solo_pl && admit_slot < 0) {
+                static const bool solo_pl_log = [] { const char* v = std::getenv("STRATA_SOLO_PIPELINE_LOG");
+                                                     return v != nullptr && v[0] != '\0' && v[0] != '0'; }();
+                if (solo_pl_log)
+                    std::fprintf(stderr, "strata serve: STRATA_SOLO_PIPELINE: request pipelined=%d (%s)\n", solo_pl_on ? 1 : 0,
+                                 solo_pl_on ? "pipelined" : !pl_want ? "the pipeline is off for it (switch, snapshots)"
+                                 : pl_serial != nullptr ? pl_serial : cancelled ? "cancelled"
+                                 : produced_n >= max_new ? "nothing left to decode" : solo_pl_why.c_str());
+            }
             if (pl_want && pl_serial == nullptr && solo_pl_why.empty() && !cancelled && produced_n < max_new) {
                 pl_ran = true;
                 std::vector<int64_t> solo_pl_cap0;   // STRATA_SOLO_PIPELINE: the graphs' VRAM, said at the first capture
@@ -15278,8 +15299,10 @@ int main(int argc, char** argv) {
                     if (!last && ajob && !adapt_tick(false)) return die("an adaptive refill failed");
                     if (last) ending = true;
                 }
-                pl_drain();   // nothing in flight: both stages' commits and the drafter have landed
+                const std::string pl_drain_err = pl_drain();   // nothing in flight: both stages' commits and the drafter have landed
                 if (solo_pl_on) {   // STRATA_SOLO_PIPELINE: the even verifiers' own graphs again (the batch's, the serial loop's)
