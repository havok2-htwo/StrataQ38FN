+                                     "this split\n", (long long) kPipeWindowMib, (int) strata::kernels::kVerifyMaxT);
             return ok_r;
         };
         const bool pipe = o.pipeline_windows > 0 && n_stages >= 2 && !split_same && (int) stages.size() == n_stages - 1 &&
@@ -8860,7 +8870,7 @@ int main(int argc, char** argv) {
