+                    if (!pl_drain_err.empty()) return die("the pipelined windows did not drain: " + pl_drain_err);
                     std::string pe;
                     for (int st = 0; st < n_stages; ++st) {
                         strata::core::Verifier& v0 = stage_ver_p(st, 0);
