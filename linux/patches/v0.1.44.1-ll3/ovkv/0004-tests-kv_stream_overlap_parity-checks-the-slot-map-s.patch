         r.out_b.resize((size_t) SB * RB * NH * D);
         ck(cudaMemcpy(r.out_a.data(), out_a, r.out_a.size() * 4, cudaMemcpyDeviceToHost), "out a");
         ck(cudaMemcpy(r.out_b.data(), out_b, r.out_b.size() * 4, cudaMemcpyDeviceToHost), "out b");
