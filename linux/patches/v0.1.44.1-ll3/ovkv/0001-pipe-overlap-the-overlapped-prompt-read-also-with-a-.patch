diff --git a/tests/program/overlap_kvs_test.cpp b/tests/program/overlap_kvs_test.cpp
new file mode 100644
index 00000000..afb8e3a6
--- /dev/null
+++ b/tests/program/overlap_kvs_test.cpp
@@ -0,0 +1,47 @@
+// overlap_kvs_allows / kv_spans_disjoint: the K/V streaming part of the STRATA_PIPE_OVERLAP gate (synthetic: no
+// model, no GPU).
+#include "strata/program/overlap_kvs.hpp"
+
+#include <cstdio>
+#include <string>
+#include <vector>
+
+using strata::program::KvSpan;
+using strata::program::kv_span;
+using strata::program::kv_spans_disjoint;
+using strata::program::overlap_kvs_allows;
+
+static int fails = 0;
+#define CHECK(c) do { if (!(c)) { std::printf("FAIL %s:%d %s\n", __FILE__, __LINE__, #c); ++fails; } } while (0)
+
+int main() {
+    std::string why;
+    // no --kv-resident: streaming never refuses, whatever the switches
+    CHECK(overlap_kvs_allows(false, false, false, true, why) && why.empty());
+    CHECK(overlap_kvs_allows(true, false, false, false, why) && why.empty());
+    // --kv-resident without the switch (or the switch without STRATA_PIPE_OVERLAP): today's refusal, today's text
+    for (int ov = 0; ov < 2; ++ov)
+        for (int kvs = 0; kvs < 2; ++kvs) {
+            if (ov && kvs) continue;
+            why.clear();
+            CHECK(!overlap_kvs_allows(ov != 0, kvs != 0, true, true, why));
+            CHECK(why == "K/V streaming (--kv-resident)");
+        }
+    // with both: allowed when the states are disjoint, refused (with its own reason) when they are not
+    why.clear();
+    CHECK(overlap_kvs_allows(true, true, true, true, why) && why.empty());
+    CHECK(!overlap_kvs_allows(true, true, true, false, why));
+    CHECK(why.find("shares a buffer") != std::string::npos);
+
+    // spans: half-open ranges, points, null skipped
+    alignas(64) static char buf[4096];
+    const std::vector<KvSpan> a = {kv_span(buf, 1024), kv_span(buf + 2048, 0), kv_span(nullptr, 99)};
+    CHECK(kv_spans_disjoint(a, {kv_span(buf + 1024, 512)}));            // touching, not overlapping
+    CHECK(!kv_spans_disjoint(a, {kv_span(buf + 1023, 1)}));             // last byte of the range
+    CHECK(!kv_spans_disjoint(a, {kv_span(buf + 2048, 0)}));             // the same point
+    CHECK(!kv_spans_disjoint(a, {kv_span(buf + 2000, 100)}));           // a range over a point
+    CHECK(kv_spans_disjoint(a, {kv_span(buf + 2049, 0), kv_span(nullptr, 4096)}));   // null never collides
+    CHECK(kv_spans_disjoint({}, a) && kv_spans_disjoint(a, {}));
+    std::printf(fails ? "overlap_kvs_test: %d failures\n" : "overlap_kvs_test: ok\n", fails);
+    return fails ? 1 : 0;
+}
