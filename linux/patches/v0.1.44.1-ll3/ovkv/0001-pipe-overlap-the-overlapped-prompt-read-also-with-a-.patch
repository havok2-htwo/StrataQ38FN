diff --git a/include/strata/program/overlap_kvs.hpp b/include/strata/program/overlap_kvs.hpp
new file mode 100644
index 00000000..32989fee
--- /dev/null
+++ b/include/strata/program/overlap_kvs.hpp
@@ -0,0 +1,57 @@
+// include/strata/program/overlap_kvs.hpp - STRATA_PIPE_OVERLAP_KVS: may an overlapped prompt read run with a streamed
+// K/V cache (--kv-resident)?  Header-only: it is the gate's arithmetic, tested without a model or a GPU.
+//
+// With --kv-resident every QSA state is streamed (kv_mode 1: a VRAM page pool, a page map and a pinned host copy per
+// state).  The prompt read writes the MAIN sessions' states (the host copy, and the VRAM slots of blocks its map holds
+// resident) and fills its own staging pool from that host copy; the decoding windows resolve and append in the SLOT
+// sessions' states only.  The read stays exact beside the windows as long as no buffer of a main state is a buffer of
+// a slot state (and the drafter's main ring is not a slot drafter's ring).  Each state is its own carve today
+// (session_init per slot, one cudaHostAlloc per host copy); the check below is the insurance against a future shared
+// carve.
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace strata::program {
+
+/// One buffer a K/V state owns: [lo, hi) in its address space (VRAM or the mapped host copy).  A buffer whose size is
+/// not known to the caller is a point (hi = lo + 1): it still catches a second state that carves the same pointer.
+struct KvSpan {
+    uintptr_t lo = 0, hi = 0;
+};
+inline KvSpan kv_span(const void* p, uint64_t bytes) {
+    const uintptr_t a = reinterpret_cast<uintptr_t>(p);
+    return KvSpan{a, a + (bytes > 0 ? bytes : 1)};
+}
+
+/// True when no span of `a` intersects a span of `b` (null spans, lo == 0, are skipped).
+inline bool kv_spans_disjoint(const std::vector<KvSpan>& a, const std::vector<KvSpan>& b) {
+    for (const KvSpan& x : a) {
+        if (x.lo == 0) continue;
+        for (const KvSpan& y : b) {
+            if (y.lo == 0) continue;
+            if (x.lo < y.hi && y.lo < x.hi) return false;
+        }
+    }
+    return true;
+}
+
+/// The generate-side part of the overlap gate for K/V streaming.  `overlap_env`: STRATA_PIPE_OVERLAP=1;
+/// `kvs_env`: STRATA_PIPE_OVERLAP_KVS=1; `kv_resident`: --kv-resident > 0; `states_disjoint`: kv_spans_disjoint over
+/// every main state against every slot state (main sessions vs slot sessions, main drafter vs slot drafters).
+/// True: streaming does not refuse the read (the other conditions of the gate still apply).  False with `why`.
+/// Without KVS the answer and the text are today's: "K/V streaming (--kv-resident)".
+inline bool overlap_kvs_allows(bool overlap_env, bool kvs_env, bool kv_resident, bool states_disjoint,
+                               std::string& why) {
+    if (!kv_resident) return true;
+    if (!(overlap_env && kvs_env)) { why = "K/V streaming (--kv-resident)"; return false; }
+    if (!states_disjoint) {
+        why = "K/V streaming (--kv-resident): a main session's K/V state shares a buffer with a slot's";
+        return false;
+    }
+    return true;
+}
+
+}  // namespace strata::program
