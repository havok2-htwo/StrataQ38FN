+def positive_float(value) -> float:
+    """A finite number above 0, else 0.0 (a bad env value or file entry is "not set", never nan or inf)."""
+    try:
+        v = float(value)
+    except (TypeError, ValueError):
+        return 0.0
+    return v if math.isfinite(v) and v > 0 else 0.0
+
