+    }
+    std::sort(env.begin(), env.end());
+    SessionIdentityBuilder b(0x5354524954494552ull);
+    b.u64("config", config);
+    b.u64("binary", binary);
+    b.i64("args", (int64_t) args.size());
+    for (const auto& a : args) b.str("arg", a);
+    b.i64("env", (int64_t) env.size());
+    for (const auto& v : env) b.str("var", v);
+    out = b.digest();
+    return true;
