+                    self._drain_control("DONE", born=born)
+            except EngineDied:
+                pass
+            if holding:
+                self.ctl.release()
+            with self.slot_cv:                          # the next image request, or the requests that stood back
+                if me in self.image_line:
+                    self.image_line.remove(me)
+                self.slot_cv.notify_all()
