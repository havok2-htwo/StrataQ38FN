+class DeadVision:
+    """An image encoder that died and cannot start again."""
+
+    def __init__(self, d):
+        self.dir = Path(d)
+        self.rows = self.dir / "img.sve"
+        self.rows.write_bytes(b"rows")
+        self.starts = 0
+
+    def alive(self):
+        return False
+
+    def restart(self):
+        self.starts += 1
+        raise RuntimeError("no GPU for it")
+
+    def unload(self):
+        pass
+
+    def encode(self, source, keep=()):
+        return self.rows, 3
+
+
+class LiveVision(DeadVision):
+    def alive(self):
+        return True
