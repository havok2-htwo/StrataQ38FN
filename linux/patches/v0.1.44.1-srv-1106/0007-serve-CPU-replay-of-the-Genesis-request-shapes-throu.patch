+"""CPU replay of the Genesis request shapes through the production parser (90f73293) and this tree's parser.
+
+The port batch fc27296d + b145a4a2 (scan speed-ups) and 77794e34 + b72f56e0 (quoted tool-call markup in string
+values) changes serve/frontend.py only.  This feeds plausible model outputs for the four request shapes Genesis
+sends (via the G3 proxy) through both OutputParsers - streamed tool arguments on and off, recovery on and off,
+whole and in deltas of many sizes, ended by a stop and by max_tokens - and asserts identical events.  It also checks
+that the request side (openai_to_messages, the rendered prompt, the default-effort fill of e69cbfa5) is unchanged.
+
+The shapes:
+  a) helper, thinking off:  "Antworte nur mit OK.", enable_thinking false, max_tokens 24
+  b) like a) with response_format json_object
+  c) agent with tools:      system "Du bist ein Testagent.", tools [get_time], chat_template_kwargs.reasoning_effort
+                            "low" (or xhigh), reasoning_budget 2048
+  d) follow-up without a tool role: the assistant's tool_calls (content null), then the result as a user message
+
+The old parser is read from git (90f73293:serve/frontend.py); the test is skipped where that is not available.
+Values that quote a whole tool call are the one place the two parsers are meant to differ (#4078); that case is
+checked separately: the new parser keeps the value exact.
+
+    python -m unittest serve.test_genesis_shapes_replay -v
+"""
+import importlib.util
+import json
+import random
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from serve import frontend as new
+
+ROOT = Path(__file__).resolve().parent.parent
+OLD_REV = "90f73293"
+
+
+def _load_old():
+    try:
+        src = subprocess.run(["git", "-C", str(ROOT), "show", f"{OLD_REV}:serve/frontend.py"], capture_output=True,
+                             text=True, check=True, timeout=30).stdout
+    except (OSError, subprocess.SubprocessError):
+        return None
+    d = tempfile.mkdtemp(prefix="strata-old-frontend-")
+    path = Path(d) / "frontend_90f73293.py"
+    path.write_text(src, encoding="utf-8")
+    spec = importlib.util.spec_from_file_location("frontend_90f73293", path)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = mod                    # dataclasses look their module up while the class is built
+    spec.loader.exec_module(mod)
+    return mod
+
+
+old = _load_old()
+
+# ------------------------------------------------------------------------------------------------ the requests
+GET_TIME = {"type": "function", "function": {"name": "get_time", "description": "Aktuelle Uhrzeit",
+                                             "parameters": {"type": "object", "properties": {}}}}
+# a Genesis agent also has file/shell tools; these carry the long string values (code fences, literal tags)
+WRITE_FILE = {"type": "function", "function": {"name": "write_file", "description": "Datei schreiben", "parameters": {
+    "type": "object", "properties": {"path": {"type": "string"}, "content": {"type": "string"}},
+    "required": ["path", "content"]}}}
+RUN = {"type": "function", "function": {"name": "run_shell", "parameters": {
+    "type": "object", "properties": {"command": {"type": "string"}, "timeout": {"type": "integer"},
+                                     "background": {"type": "boolean"}}}}}
+
+REQ_A = {"messages": [{"role": "user", "content": "Antworte nur mit OK."}], "temperature": 0, "max_tokens": 24,
+         "chat_template_kwargs": {"enable_thinking": False}, "stream": True, "stream_options": {"include_usage": True}}
+REQ_B = {**REQ_A, "response_format": {"type": "json_object"}}
+REQ_B_LOGPROBS = {**REQ_B, "logprobs": True, "top_logprobs": 2}
+REQ_C = {"messages": [{"role": "system", "content": "Du bist ein Testagent."},
+                      {"role": "user", "content": "Wie spät ist es? Nutze das Werkzeug."}],
+         "temperature": 0.1, "max_tokens": 2048, "tools": [GET_TIME], "chat_template_kwargs": {"reasoning_effort": "low"},
+         "reasoning_budget": 2048, "stream": True, "stream_options": {"include_usage": True}}
+REQ_C_XHIGH = {**REQ_C, "chat_template_kwargs": {"reasoning_effort": "xhigh"}}
+REQ_C_TOP = {**REQ_C, "reasoning_effort": "xhigh"}           # the same level also given at the top
+REQ_C_FILES = {**REQ_C, "tools": [GET_TIME, WRITE_FILE, RUN]}
+REQ_D = {**REQ_C, "messages": REQ_C["messages"] + [
+    {"role": "assistant", "content": None,
+     "tool_calls": [{"id": "call_1", "type": "function", "function": {"name": "get_time", "arguments": "{}"}}]},
+    {"role": "user", "content": "[Runtime System Instruction]\nTool Result:\n08:01"}]}
+REQUESTS = {"a": REQ_A, "b": REQ_B, "b_logprobs": REQ_B_LOGPROBS, "c": REQ_C, "c_xhigh": REQ_C_XHIGH,
+            "c_top": REQ_C_TOP, "c_files": REQ_C_FILES, "d": REQ_D}
+
+# ------------------------------------------------------------------------------------------------ the outputs
+FENCED = ("# Notizen\n\nSo ruft man es auf:\n\n```python\nimport time\n\n\ndef now():\n    return time.strftime('%H:%M')\n"
+          "```\n\nUnd in der Shell:\n\n```bash\ndate +%H:%M\n```\n")
+LITERAL_CLOSE = ("Das Format schliesst einen Wert mit </parameter> ab, z.B. `<parameter=path>x</parameter>`.\n"
+                 "Ein </parameter> mitten im Satz ist Text.\n")
+NESTED_FENCE = "````markdown\n```json\n{\"a\": 1}\n```\n````\n"
+
+
+def call(name, **params):
+    body = "".join(f"<parameter={k}>\n{v}\n</parameter>\n" for k, v in params.items())
+    return f"<tool_call>\n<function={name}>\n{body}</function>\n</tool_call>"
+
+
+# (request, thinking on, model text): the text after the prompt's "<think>\n" when thinking is on
+OUTPUTS = {
+    "a_ok": ("a", False, "OK"),
+    "a_ok_dot": ("a", False, "OK."),
+    "a_cut": ("a", False, "OK, ich antworte nur mit OK und sonst nichts weiter, wie"),
+    "b_json": ("b", False, '{"status": "OK"}'),
+    "b_json_fenced": ("b", False, '```json\n{"status": "OK"}\n```'),
+    "b_logprobs": ("b_logprobs", False, '{"antwort":"OK"}'),
+    "c_call": ("c", True, "Der Nutzer fragt nach der Uhrzeit. Ich nutze get_time.\n</think>\n\n" + call("get_time")),
+    "c_call_prose": ("c", True, "Uhrzeit gefragt.\n</think>\n\nIch rufe das Werkzeug auf.\n\n" + call("get_time")),
+    "c_call_no_params_inline": ("c", True, "ok\n</think>\n\n<tool_call>\n<function=get_time>\n</function>\n</tool_call>"),
+    "c_reasoning_quotes_markup": ("c_xhigh", True,
+                                  "Das Format ist `<tool_call>` mit `<function=get_time>`; ich schreibe es nicht hier.\n"
+                                  "```\n<tool_call>\n<function=get_time>\n</function>\n</tool_call>\n```\n"
+                                  "Jetzt der echte Aufruf.\n</think>\n\n" + call("get_time")),
+    "c_call_in_reasoning": ("c_top", True, "Ich brauche die Zeit.\n\n" + call("get_time") + "\n</think>\n\n"),
+    "c_call_in_reasoning_end": ("c_top", True, "Ich brauche die Zeit.\n\n" + call("get_time")),
+    "c_budget_cut": ("c", True, "Lange Überlegung " * 40),
+    "c_write_fenced": ("c_files", True, "Schreibe die Notizen.\n</think>\n\n" +
+                       call("write_file", path="docs/notizen.md", content=FENCED)),
+    "c_write_literal_close": ("c_files", True, "Doku.\n</think>\n\n" +
+                              call("write_file", path="docs/format.md", content=LITERAL_CLOSE)),
+    "c_write_nested_fence": ("c_files", True, "x\n</think>\n\n" +
+                             call("write_file", path="a.md", content=NESTED_FENCE + LITERAL_CLOSE + FENCED)),
+    "c_write_value_ends_in_close_text": ("c_files", True, "x\n</think>\n\n" +
+                                         call("write_file", path="b.md", content="Schluss: </parameter> ist das Ende")),
+    "c_two_calls": ("c_files", True, "Zwei Schritte.\n</think>\n\n" + call("get_time") + "\n" +
+                    call("run_shell", command="ls -la | grep '</parameter>'", timeout=30, background="false")),
+    "c_mixed_types": ("c_files", True, "y\n</think>\n\n" +
+                      call("run_shell", command="cat <<'EOF'\n```\n</parameter>\nEOF", timeout="120", background="true")),
+    "c_write_cut": ("c_files", True, "z\n</think>\n\n<tool_call>\n<function=write_file>\n<parameter=path>\nc.md\n"
+                    "</parameter>\n<parameter=content>\n" + FENCED[:60]),
+    "d_answer": ("d", True, "Das Werkzeug lieferte 08:01.\n</think>\n\nEs ist 08:01 Uhr."),
+    "d_answer_fenced": ("d", True, "08:01\n</think>\n\nEs ist **08:01** Uhr.\n\n```text\n08:01\n```"),
+    "d_call_again": ("d", True, "Nochmal prüfen.\n</think>\n\n" + call("get_time")),
+    "d_empty_think": ("d", True, "\n</think>\n\nEs ist 08:01 Uhr."),
+}
+
+
+def tools_of(mod, req):
+    return mod.openai_to_messages(req)[1]
+
+
+def norm(events):
+    """Events as plain data; call ids (random) replaced by their order of appearance."""
+    ids, out = {}, []
+    for e in events:
+        c = e.call
+        call_ = None
+        if c is not None:
+            call_ = (c.name, json.dumps(c.arguments, sort_keys=True, ensure_ascii=False), ids.setdefault(c.id, len(ids)))
+        out.append((e.kind, e.text, call_))
+    return out
+
+
+def joined(events):
+    """Consecutive "tool_args" pieces of one call joined into one (the text a client concatenates)."""
+    out = []
+    for e in events:
+        if out and e[0] == "tool_args" and out[-1][0] == "tool_args" and out[-1][2] == e[2]:
+            out[-1] = ("tool_args", out[-1][1] + e[1], e[2])
+        else:
+            out.append(e)
+    return out
+
+
+def chunkings(text, seed):
+    """Whole, fixed sizes, every character, and a seeded random split (token-like deltas of 1..12 characters)."""
+    yield "whole", [text]
+    for size in (1, 2, 3, 5, 7, 16, 64):
+        yield f"size{size}", [text[i:i + size] for i in range(0, len(text), size)]
+    rnd = random.Random(seed)
+    parts, i = [], 0
+    while i < len(text):
+        n = rnd.randint(1, 12)
+        parts.append(text[i:i + n])
+        i += n
+    yield "random", parts
+
+
+def run(mod, req, thinking, parts, stream_tools, recover, reason):
+    parser = mod.OutputParser(thinking=thinking, tools=tools_of(mod, req), stream_tools=stream_tools, recover=recover)
+    events = []
+    for p in parts:
+        events.extend(parser.feed(p))
+    events.extend(parser.finish(reason))
+    return norm(events)
+
+
+@unittest.skipIf(old is None, f"the production parser ({OLD_REV}:serve/frontend.py) is not readable from git here")
+class GenesisReplay(unittest.TestCase):
+    maxDiff = None
+
+    def test_the_request_side_is_unchanged(self):
+        tpl_new = new.ChatTemplate(Path(new.__file__).parent / "chat_template.jinja")
+        tpl_old = old.ChatTemplate(Path(new.__file__).parent / "chat_template.jinja")
+        for name, req in REQUESTS.items():
+            with self.subTest(name):
+                a, b = old.openai_to_messages(json.loads(json.dumps(req))), new.openai_to_messages(json.loads(json.dumps(req)))
+                self.assertEqual(a, b)
+                messages, tools, kw = b
+                self.assertEqual(tpl_old.render(messages, tools, **kw), tpl_new.render(messages, tools, **kw))
+
+    def test_the_default_effort_fill_is_unchanged_for_the_shapes(self):
+        """e69cbfa5: only a missing or empty reasoning_effort takes the default; every Genesis shape is filled (or
+        not) exactly as before, whatever the config's default."""
+        from serve.server import Service
+
+        class Stub:
+            shared = {}
+
+            def __init__(self, effort):
+                self.effort = effort
+
+            def effort_default(self):
+                return self.effort
+
+        def old_rule(req, effort):
+            req = dict(req)
+            ctk = req.get("chat_template_kwargs") if isinstance(req.get("chat_template_kwargs"), dict) else {}
+            if effort and not req.get("reasoning_effort") and not req.get("reasoning") and \
+                    "enable_thinking" not in ctk and "reasoning_effort" not in ctk:
+                req["reasoning_effort"] = effort
+            return req
+
+        for effort in (None, "none", "low", "high", "xhigh"):
+            for name, req in REQUESTS.items():
+                with self.subTest(effort=effort, shape=name):
+                    self.assertEqual(Service.with_shared(Stub(effort), dict(req), "openai"), old_rule(req, effort))
+
+    def test_outputs_give_identical_events(self):
+        """Every event identical once a call's consecutive "tool_args" pieces are joined; with token-like deltas
+        (1-3 characters, the seeded 1-12 split) identical piece for piece too.  The one allowed difference: when a
+        delta brings a literal `</parameter>` in a value together with the real close and a `<parameter=NA` whose name
+        is still arriving, the new parser (77794e34: the same name again would be part of the value) holds the
+        arguments from the literal tag until the name is complete - the same text, in one more piece."""
+        n, regrouped = 0, []
+        for label, (shape, thinking, text) in OUTPUTS.items():
+            req = REQUESTS[shape]
+            for cut, parts in chunkings(text, label):
+                for stream_tools in (True, False):
+                    for recover in (False, True):
+                        for reason in (None, "length"):
+                            with self.subTest(label=label, cut=cut, stream_tools=stream_tools, recover=recover,
+                                              reason=reason):
+                                a = run(new, req, thinking, parts, stream_tools, recover, reason)
+                                b = run(old, req, thinking, parts, stream_tools, recover, reason)
+                                self.assertEqual(joined(a), joined(b))
+                                if a != b:
+                                    regrouped.append((label, cut))
+                                    self.assertNotIn(cut, ("size1", "size2", "size3", "random"))
+                                    self.assertIn("</parameter>", text)
+                                n += 1
+        self.assertGreater(n, 1000)
+        print(f"\n[replay] {n} runs; tool_args regrouped (same text) in {len(regrouped)}: {sorted(set(regrouped))}",
+              file=sys.stderr)
+
+    def test_the_outputs_mean_what_genesis_expects(self):
+        """A sanity check of the replay itself (the new parser): calls, their arguments and the visible text."""
+        def collect(label):
+            shape, thinking, text = OUTPUTS[label]
+            events = new.OutputParser(thinking=thinking, tools=tools_of(new, REQUESTS[shape]), stream_tools=True)
+            evs = []
+            for p in chunkings(text, label).__next__()[1]:
+                evs.extend(events.feed(p))
+            evs.extend(events.finish())
+            calls = [(e.call.name, e.call.arguments) for e in evs if e.kind == "tool_call"]
+            content = "".join(e.text for e in evs if e.kind == "content")
+            args = "".join(e.text for e in evs if e.kind == "tool_args")
+            return calls, content, args
+
+        self.assertEqual(collect("a_ok")[:2], ([], "OK"))
+        self.assertEqual(json.loads(collect("b_json")[1]), {"status": "OK"})
+        self.assertEqual(collect("c_call")[0], [("get_time", {})])
+        self.assertEqual(collect("c_reasoning_quotes_markup")[0], [("get_time", {})])
+        self.assertEqual(collect("c_call_in_reasoning")[0], [("get_time", {})])
+        for label, content in (("c_write_fenced", FENCED), ("c_write_literal_close", LITERAL_CLOSE),
+                               ("c_write_nested_fence", NESTED_FENCE + LITERAL_CLOSE + FENCED)):
+            calls, _, args = collect(label)
+            self.assertEqual([c[1]["content"] for c in calls], [content], label)
+            self.assertEqual(json.loads(args)["content"], content, label)
+        calls = collect("c_two_calls")[0]
+        self.assertEqual([c[0] for c in calls], ["get_time", "run_shell"])
+        self.assertEqual(calls[1][1], {"command": "ls -la | grep '</parameter>'", "timeout": 30, "background": False})
+        self.assertEqual(collect("d_answer")[:2], ([], "Es ist 08:01 Uhr."))
+
+
+class QuotedCallValueIsTheIntendedDifference(unittest.TestCase):
+    """#4078: the one shape of output the two parsers are meant to read differently - a written file that quotes a
+    whole tool call (an agent documenting its own call format).  The new parser keeps the value exact."""
+    QUOTED = call("write_file", path="x.txt")
+
+    def test_the_new_parser_keeps_a_quoted_call_in_a_value(self):
+        content = f"Beispiel:\n{self.QUOTED}\nEnde der Doku."
+        text = "x\n</think>\n\n" + call("write_file", path="doku.md", content=content)
+        for cut, parts in chunkings(text, "quoted"):
+            for stream_tools in (True, False):
+                with self.subTest(cut=cut, stream_tools=stream_tools):
+                    p = new.OutputParser(thinking=True, tools=tools_of(new, REQ_C_FILES), stream_tools=stream_tools)
+                    evs = [e for part in parts for e in p.feed(part)] + p.finish()
+                    calls = [e.call for e in evs if e.kind == "tool_call"]
+                    self.assertEqual([c.arguments for c in calls], [{"path": "doku.md", "content": content}])
+                    if stream_tools:
+                        self.assertEqual(json.loads("".join(e.text for e in evs if e.kind == "tool_args"))["content"],
+                                         content)
+
+    @unittest.skipIf(old is None, "no production parser here")
+    def test_the_production_parser_cuts_that_value(self):
+        content = f"Beispiel:\n{self.QUOTED}\nEnde der Doku."
+        text = "x\n</think>\n\n" + call("write_file", path="doku.md", content=content)
+        p = old.OutputParser(thinking=True, tools=tools_of(old, REQ_C_FILES), stream_tools=False)
+        evs = p.feed(text) + p.finish()
+        got = [e.call.arguments.get("content") for e in evs if e.kind == "tool_call"]
+        self.assertNotEqual(got, [content])
+
+
+if __name__ == "__main__":
+    unittest.main()
