+    def _solo_new_tokens(self, ids: list[int]) -> int:
+        """STRATA_READS_SOLO (the caller holds slot_cv): _new_tokens, and less the start of the prompt the last solo
+        request read (the main session holds it, or its checkpoints do: a follow-up turn of a solo conversation reads
+        only its new part there).  An under-estimate keeps the request solo, as without the switch."""
+        v = self._new_tokens(ids)
+        h = self._solo_ids
+        n = min(len(h), len(ids) - 1)
+        if n <= 0:
+            return v
+        lo, B = 0, 4096
+        while lo + B <= n and ids[lo:lo + B] == h[lo:lo + B]:
+            lo += B
+        while lo < n and ids[lo] == h[lo]:
+            lo += 1
+        return min(v, len(ids) - lo)
