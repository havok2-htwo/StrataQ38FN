+"""serve/test_reads.py - STRATA_SERVER_READS with an engine run with STRATA_READS=N (INFO reads=N reads_row=k): a long
+admission names a reserved top-row slot (bg=<park>), the engine reads its batched parts there in the background
+(BREAD / BPP / BREADY / BRDONE), the admission slot and the control lines go back meanwhile, and the request finishes
+with priority on the control lines (yslot=<park>).  Unset: never.  No GPU: the unit part has no process, the service
+part runs test_parallel's fake engine with background reads added.
+
+    python -m unittest serve.test_reads -v
+"""
+from __future__ import annotations
+
+import sys
+import threading
+import time
+import unittest
+from pathlib import Path
+from unittest import mock
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import serve.server as server  # noqa: E402
+from serve.test_parallel import FAKE_BATCH, ParallelService  # noqa: E402
+from serve.test_read_yield import engine  # noqa: E402
+
+
+class Rules(unittest.TestCase):
+    def test_off_without_the_switch_or_the_engine(self):
+        e = engine(16, {"reads": 2, "reads_row": 4}, gs=4)
+        with mock.patch.object(server, "SERVER_READS", False):
+            self.assertEqual(e._reads_row(), 0)
+        with mock.patch.object(server, "SERVER_READS", True):
+            self.assertEqual(e._reads_row(), 4)
+            e.info = {}
+            self.assertEqual(e._reads_row(), 0)                         # an engine without STRATA_READS
+
+    def test_the_park_slot(self):
+        e = engine(16, {"reads": 2, "reads_row": 4}, gs=4)
+        e.bg_parks = set()
+        with mock.patch.object(server, "SERVER_READS", True), e.slot_cv:
+            self.assertEqual(e._reads_park_pick(7), 7)                   # its own slot is a top row
+            self.assertIn(e._reads_park_pick(0), (3, 7, 11, 15))         # a lane slot: a free top row
+            e.slot_held[3] = [1]
+            e.slot_used = [float(b) for b in range(16)]
+            self.assertEqual(e._reads_park_pick(0), 7)
+            e.bg_parks = {7, 11}                                         # as many held as the engine takes
+            self.assertIsNone(e._reads_park_pick(0))
+            e.bg_parks = {7}
+            self.assertEqual(e._reads_park_pick(0), 11)                  # (3 holds something: 11 is empty)
+            for b in (3, 11, 15):
+                e.slot_busy[b] = True
+            self.assertIsNone(e._reads_park_pick(0))
+
+    def test_a_finish_goes_first_on_the_control_lines(self):
+        e = engine(4, {"reads": 1, "reads_row": 1})
+        e.ctl = threading.Lock()
+        e.waiting = 0
+        e.standing = 0
+        e.ctl_epoch = 0
+        e.image_line = []
+        e.alive = lambda: True
+        e.ctl.acquire()                                                  # someone has the lines
+        got = []
+        cancel = threading.Event()
+
+        def take(name, prio):
+            for _ in e._take_control(cancel, 10, ids=[1] * 10, prio=prio):
+                pass
+            got.append(name)
+            time.sleep(0.05)
+            e.ctl.release()
+        a = threading.Thread(target=take, args=("plain", False))
+        a.start()
+        time.sleep(0.2)
+        b = threading.Thread(target=take, args=("finish", True))
+        b.start()
+        time.sleep(0.2)
+        e.ctl.release()
+        a.join(10)
+        b.join(10)
+        self.assertEqual(got, ["finish", "plain"])
+        self.assertEqual(e.prio_waiting, 0)
+
+
+# the fake engine with STRATA_READS: INFO reads=N reads_row=K; a BGEN with bg=<P> is handed to the background (BREAD,
+# DONE cancel, BADM 0) and read between the lines a chunk per turn (BPP), then BREADY <P> <n - 1>; BSTOP <P> while it
+# reads: BRDONE <P> cancel; a BGEN for a slot a read reads into is refused (#1994's answer)
+FAKE_READS = FAKE_BATCH.replace(
+    'groups = int(args[args.index("--says-groups") + 1]) if "--says-groups" in args else 0',
+    'groups = int(args[args.index("--says-groups") + 1]) if "--says-groups" in args else 0\n'
+    'READS = int(args[args.index("--reads") + 1]) if "--reads" in args else 0\n'
+    'RROW = int(args[args.index("--reads-row") + 1]) if "--reads-row" in args else 1\n'
+    'ERRBG = "--bg-err" in args\n'
+    'bgr = {}   # park -> [ids, done, cancelled]').replace(
+    '(f" batch_groups={groups}" if groups > 1 else ""), flush=True)',
+    '(f" batch_groups={groups}" if groups > 1 else "") + (f" reads={READS} reads_row={RROW}" if READS else ""), flush=True)'
+).replace(
+    'log = open(args[args.index("--log") + 1], "a") if "--log" in args else None\n',
+    'log = open(args[args.index("--log") + 1], "a") if "--log" in args else None\n'
+    'def bg_step():      # one chunk of every background read (between the lines, as the engine)\n'
+    '    for P in list(bgr):\n'
+    '        ids, done, cancelled = bgr[P]\n'
+    '        if cancelled or (ERRBG and done > 4 * CH):\n'
+    '            print(f"BRDONE {P} " + ("cancel" if cancelled else "err a test failure"), flush=True)\n'
+    '            if log:\n'
+    '                log.write(f"BRDONE {P}\\n"); log.flush()\n'
+    '            del bgr[P]\n'
+    '            continue\n'
+    '        done = min(len(ids) - 1, done + CH)\n'
+    '        print(f"BPP {P} {done} {len(ids)} 1 1", flush=True)\n'
+    '        if done >= len(ids) - 1:\n'
+    '            print(f"BREADY {P} {done}", flush=True)\n'
+    '            if log:\n'
+    '                log.write(f"BREADY {P} {done}\\n"); log.flush()\n'
+    '            del bgr[P]\n'
+    '        else:\n'
+    '            bgr[P][1] = done\n'
+).replace(
+    'line = lines.get(timeout=STEP if active else None)',
+    'line = lines.get(timeout=STEP if active or bgr else None)'
+).replace(
+    '''        b = int(line.split()[1])
+        if b in active:''',
+    '''        b = int(line.split()[1])
+        if b in bgr:
+            bgr[b][2] = True
+        if b in active:'''
+).replace(
+    '''        if log:
+            log.write(f"{f[0]} {slot} {len(ids)} {max(len(active), 0)}\\n"); log.flush()''',
+    '''        if slot is not None and slot in bgr:
+            print(f"ERR BGEN: no such free slot (--batch {slots}) or a bad max_new", flush=True)
+            continue
+        bgk = [x for x in f if x.startswith("bg=")]
+        if READS and bgk and slot is not None and len(bgr) < READS:
+            P = int(bgk[0][3:])
+            bgr[P] = [ids, CH, False]
+            if log:
+                log.write(f"BREAD {slot} {P} {len(ids)}\\n"); log.flush()
+            print(f"BREAD {slot} {P} {CH}", flush=True)
+            print(f"DONE 0 {len(ids)} 5.0 0.0 cancel 0 0 0", flush=True)
+            print(f"BADM {slot} 0", flush=True)
+            continue
+        if log:
+            log.write(f"{f[0]} {slot} {len(ids)} {max(len(active), 0)}" +
+                      "".join(" " + x for x in f if x.startswith(("yslot=", "bg="))) + "\\n"); log.flush()''')
+FAKE_READS = FAKE_READS[:FAKE_READS.rindex("    window()\n")] + "    bg_step()\n    window()\n"
+
+
+class ReadsService(ParallelService):
+    """The real StrataEngine and Service over HTTP with the fake engine's background reads."""
+
+    def start(self, slots, *a, **kw):
+        with mock.patch("serve.test_parallel.FAKE_BATCH", FAKE_READS):
+            super().start(slots, *a, **kw)
+
+    def setUp(self):
+        for needle in ("reads={READS}", "BREAD {slot}", "BREADY {P}", "bg_step()\n    window()", "if b in bgr:",
+                       "timeout=STEP if active or bgr"):
+            self.assertIn(needle, FAKE_READS)
+        patches = [mock.patch.object(server, "SERVER_READS", True), mock.patch.object(server, "READS_BG_MIN", 1000)]
+        for p in patches:
+            p.start()
+            self.addCleanup(p.stop)
+
+    def _busy_slot(self):
+        bg = threading.Thread(target=lambda: self.chat("LONGREPLY background", max_tokens=60))
+        bg.start()
+        time.sleep(0.1)
+        return bg
+
+    def test_a_long_admission_reads_in_the_background_and_a_short_one_goes_meanwhile(self):
+        self.start(8, says_groups=2, more=["--reads", "2", "--reads-row", "4"])
+        bg = self._busy_slot()
+        long_q, short_q = "long " * 600, "short"
+        res = self.race(long_q, short_q)
+        bg.join(30)
+        self.assertEqual(res[long_q][0], "ok, done.")
+        self.assertEqual(res[short_q][0], "ok, done.")
+        self.assertLess(res[short_q][1], res[long_q][1] - 0.5, res)
+        log = self.log.read_text().splitlines()
+        breads = [x.split() for x in log if x.startswith("BREAD ")]
+        self.assertTrue(breads, log)
+        park = breads[0][2]
+        self.assertIn(park, ("3", "7"), log)                                 # a top row (k = 4)
+        self.assertTrue(any(x.startswith(f"BREADY {park} ") for x in log), log)
+        # the finish: the same prompt again, naming the park slot (or admitted into it), after BREADY
+        ready_at = next(i for i, x in enumerate(log) if x.startswith("BREADY "))
+        fin = [x.split() for x in log[ready_at:] if x.startswith("BGEN ") and int(x.split()[2]) > 2600]
+        self.assertTrue(fin and (fin[0][-1] == f"yslot={park}" or fin[0][1] == park), log)
+        self.assertFalse(any("bg=" in x for x in log[ready_at:] if x.startswith("BGEN ") and int(x.split()[2]) > 2600), log)
+        # the short request went while the long one was read in the background
+        bread_at = next(i for i, x in enumerate(log) if x.startswith("BREAD "))
+        short_at = [i for i, x in enumerate(log) if i > bread_at and x.startswith("BGEN ") and int(x.split()[2]) < 200]
+        self.assertTrue(short_at and bread_at < short_at[0] < ready_at, log)
+        time.sleep(0.3)
+        self.assertFalse(any(self.engine.slot_busy), self.engine.slot_busy)
+        self.assertEqual(self.engine.bg_parks, set())
+
+    def test_a_long_request_alone_reads_in_the_background_too(self):
+        self.start(8, says_groups=2, more=["--reads", "2", "--reads-row", "4"])
+        long_q, short_q = "long " * 600, "short"
+        with mock.patch.object(server, "READS_SOLO", True):
+            res = self.race(long_q, short_q)
+        self.assertEqual(res[long_q][0], "ok, done.")
+        self.assertEqual(res[short_q][0], "ok, done.")
+        self.assertLess(res[short_q][1], res[long_q][1] - 0.5, res)
+        log = self.log.read_text().splitlines()
+        self.assertTrue(log and log[0].startswith("BREAD "), log)            # not a solo GEN: an admission with bg=
+        with mock.patch.object(server, "READS_SOLO", False):
+            r = self.chat("long " * 601)
+        self.assertEqual(r["choices"][0]["message"]["content"], "ok, done.")
+        self.assertTrue(self.log.read_text().splitlines()[-1].startswith("GEN None"), self.log.read_text())
+        time.sleep(0.3)
+        self.assertFalse(any(self.engine.slot_busy), self.engine.slot_busy)
+
+    def test_a_solo_conversation_follow_up_stays_solo(self):
+        # the main session holds the last solo prompt: a follow-up turn reads only its new part, never a background
+        self.start(8, says_groups=2, more=["--reads", "2", "--reads-row", "4"])
+        with mock.patch.object(server, "READS_SOLO", True):
+            self.engine._solo_ids = []
+            with self.engine.slot_cv:
+                self.assertGreaterEqual(self.engine._solo_new_tokens([5] * 1000), 1000)
+            self.engine._solo_ids = [5] * 900 + [6]
+            with self.engine.slot_cv:
+                self.assertEqual(self.engine._solo_new_tokens([5] * 900 + [6] + [7] * 99), 99)
+                self.assertEqual(self.engine._solo_new_tokens([5] * 10 + [8] * 90), 90)
+                self.assertEqual(self.engine._solo_new_tokens([5] * 901), 1)
+        self.assertFalse(server.READS_SOLO)                                  # opt-in
+
+    def test_short_prompts_are_read_on_the_control_lines(self):
+        self.start(8, says_groups=2, more=["--reads", "2", "--reads-row", "4"])
+        bg = self._busy_slot()
+        r = self.chat("short one")
+        bg.join(30)
+        self.assertEqual(r["choices"][0]["message"]["content"], "ok, done.")
+        self.assertFalse(any(x.startswith("BREAD ") for x in self.log.read_text().splitlines()))
+
+    def test_unset_never_sends_bg(self):
+        with mock.patch.object(server, "SERVER_READS", False):
+            self.start(8, says_groups=2, more=["--reads", "2", "--reads-row", "4"])
+            bg = self._busy_slot()
+            r = self.chat("long " * 600)
+            bg.join(30)
+        self.assertEqual(r["choices"][0]["message"]["content"], "ok, done.")
+        log = self.log.read_text()
+        self.assertNotIn("BREAD", log)
+        self.assertNotIn("bg=", log)
+
+    def test_a_dropped_background_read_is_read_on_the_lines(self):
+        self.start(8, says_groups=2, more=["--reads", "2", "--reads-row", "4", "--bg-err"])
+        bg = self._busy_slot()
+        r = self.chat("long " * 600)
+        bg.join(30)
+        self.assertEqual(r["choices"][0]["message"]["content"], "ok, done.")
+        log = self.log.read_text().splitlines()
+        self.assertTrue(any(x.startswith("BRDONE ") for x in log), log)
+        after = log[next(i for i, x in enumerate(log) if x.startswith("BRDONE ")):]
+        again = [x for x in after if x.startswith("BGEN ") and int(x.split()[2]) > 2600]
+        self.assertTrue(again and "bg=" not in again[0] and "yslot=" not in again[0], log)
+        time.sleep(0.3)
+        self.assertFalse(any(self.engine.slot_busy), self.engine.slot_busy)
+
+    def test_a_client_that_leaves_during_the_background_read_stops_it(self):
+        import json
+        import socket
+        self.start(8, says_groups=2, more=["--reads", "2", "--reads-row", "4"])
+        bg = self._busy_slot()
+        host, port = self.httpd.server_address[:2]
+        body = json.dumps({"messages": [{"role": "user", "content": "long " * 700}], "max_tokens": 16,
+                           "stream": True, "reasoning_effort": "none"}).encode()
+        s = socket.create_connection((host, port), timeout=10)
+        s.sendall(b"POST /v1/chat/completions HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Type: application/json\r\n"
+                  b"Content-Length: " + str(len(body)).encode() + b"\r\n\r\n" + body)
+        deadline = time.time() + 10
+        while time.time() < deadline and "BREAD" not in self.log.read_text():
+            time.sleep(0.02)
+        self.assertIn("BREAD", self.log.read_text())
+        s.close()                                                        # the client leaves
+        deadline = time.time() + 20
+        while time.time() < deadline and "BRDONE" not in self.log.read_text():
+            time.sleep(0.05)
+        bg.join(30)
+        self.assertIn("BRDONE", self.log.read_text())
+        deadline = time.time() + 5
+        while time.time() < deadline and any(self.engine.slot_busy):
+            time.sleep(0.05)
+        self.assertFalse(any(self.engine.slot_busy), self.engine.slot_busy)
+        r = self.chat("short after")                                     # nothing leaked: the engine still answers
+        self.assertEqual(r["choices"][0]["message"]["content"], "ok, done.")
+
+
+for _name in dir(ParallelService):   # (its own tests run in test_parallel)
+    if _name.startswith("test_") and _name not in ReadsService.__dict__:
+        setattr(ReadsService, _name, None)
+del ParallelService
+
+if __name__ == "__main__":
+    unittest.main()
