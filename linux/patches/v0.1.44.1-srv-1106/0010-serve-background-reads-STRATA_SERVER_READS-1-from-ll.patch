+# --batch, with an engine run with STRATA_READS=N (INFO reads=N reads_row=k): STRATA_SERVER_READS=1 (opt-in; unset: never)
+# lets an admission with at least STRATA_READS_BG_MIN new tokens (default 8192) read its batched parts in the background:
+# its BGEN names a free top-row slot (bg=<park>, reserved here: its own slot when that is one); the engine copies the part
+# read so far there and ends the request (BREAD <slot> <park> <q>, DONE cancel, BADM 0), reads the rest between its
+# lines while the slots decode and other admissions come and go (BPP <park> ... progress), then says BREADY <park> <h>.
+# The request then takes the control lines before every other waiting one and is sent again with yslot=<park>: it
+# finishes on the engine's main sessions (the last part, the first token), as a read that gave way.  BRDONE <park>
+# cancel|err: the background read was dropped (err: the request is read here instead).  Its admission slot is free
+# meanwhile; only the park slot stays reserved.  Never for a request with pictures.
+# A long request alone on the engine may go the same way (STRATA_READS_SOLO=1, opt-in; default 0: it reads on the solo
+# path as before), so requests arriving during its read are served meanwhile; once it decodes alone in its slot it goes
+# back to the solo path as any slot does (_may_go_solo).  Only with at least STRATA_READS_BG_MIN tokens the engine
+# would read: what a slot holds and the start of the last solo prompt (the main session's) are not counted.
+SERVER_READS = os.environ.get("STRATA_SERVER_READS", "") not in ("", "0")
+READS_BG_MIN = max(1, _int_env("STRATA_READS_BG_MIN", 8192))
+READS_SOLO = os.environ.get("STRATA_READS_SOLO", "0") not in ("", "0")
+READS_RELEASE_S = 600.0     # a left request's background read: its park slot is freed after this long without a BPP
 STALL_CPU_EPS_S = 0.5       # CPU seconds the engine may use in the whole stall window and still count as frozen
 STALL_IO_EPS_B = 1 << 20    # bytes read or written in that window
 
