+    return on;
+}
+// STRATA_GIVEBACK_CHECKS=1 (read once; off by default): a slot that gives back everything it holds (a request goes on
+// with its conversation in the main sessions) moves its own checkpoints - the turn checkpoint of the request it served
+// - into the main session when the request is admitted to that same slot (whose admission drops them), instead of
+// copying them (~112 MB of host vectors each).  The give-back hands them over either way (#2526: the slot's checkpoints
+// that are prefixes of the tokens copied back); copied when admitted elsewhere, so the untouched slot still serves a
+// sibling from them, and nothing moves from a yielded read the slot keeps for later.  It also names them in the
+// give-back's log line
+bool giveback_checks_env() {
+    static const bool on = [] {
+        const char* v = std::getenv("STRATA_GIVEBACK_CHECKS");
+        return v && v[0] != '\0' && v[0] != '0';
+    }();
+    return on;
+}
 
