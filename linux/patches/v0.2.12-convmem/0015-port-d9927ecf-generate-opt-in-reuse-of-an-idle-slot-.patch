+// include/strata/program/slot_chain.hpp - which checkpoints an idle batch slot can hand to a request, and what a
+// give-back does with the slot's checkpoints (header-only: it compares token lists and flags).
+//
+// With STRATA_SLOT_PARK a slot's conversation stays in the slot until the slot is overwritten.  Its sessions' cells
+// [0, ids) hold the K/V of `ids` (its prompt and reply), so a checkpoint c whose tokens are a prefix of `ids` can be
+// continued from there: the slot's K/V up to c plus c's running state is what the conversation cache gives back when
+// it restores the slot's image and mounts c, because that image is a capture of the same cells and carries c along
+// (slot_park_put's along_ok rule, the same test as slot_prefix_ok below).
+//
+// STRATA_SLOT_CHAIN_REUSE (E1): the slot's chain (its prompt's root and periodic checkpoints) is a source too, not
+// only its turn checkpoint and its end.  STRATA_GIVEBACK_CHECKS (E2): a slot that gives back everything it holds also
+// hands over its own checkpoints (the turn checkpoint of the request it served), which the next turn needs once the
+// client drops that turn's thinking.  Upstream's give-back now copies them without the switch (#2526: the slot's
+// checkpoints that are prefixes of the tokens copied back), so generate.cpp only takes giveback_plan's hand_move from
+// it (moved, not copied, into the slot the request is admitted to); giveback_picks stays as the rule's model for the
+// test.
+//
+// generate.cpp calls scan_slot for every slot a request may continue from and giveback_plan once a slot has been
+// copied back, so the order of the sources and what happens to the slot's image, chain and checkpoints are decided
+// here, where tests/program/slot_chain_test.cpp can reach them without a GPU.
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace strata::program::slot_chain {
+
+/// c is a complete checkpoint of the conversation `held` (what a slot's cells hold): every stage's part, no pictures,
+/// and its tokens a non-empty prefix of `held`.  A checkpoint with pictures is never matched by tokens alone, and one
+/// without every stage's part cannot be mounted on a layer split.
+template <class Ck>
+inline bool slot_prefix_ok(const Ck& c, const std::vector<int32_t>& held, size_t n_stage_parts) {
+    return c.stage_parts.size() == n_stage_parts && !c.ids.empty() && c.ids.size() <= held.size() && c.imgs.empty() &&
+           std::equal(c.ids.begin(), c.ids.end(), held.begin());
+}
+
+/// The chain checkpoint of an idle slot a request continues from: the longest one that slot_prefix_ok accepts for the
+/// slot's tokens, that is longer than `floor` (what the live session, the other checkpoints and the other slots
+/// already give) and that `starts_prompt` accepts (its tokens and pictures are the start of the new prompt, at most
+/// n - 1 of them).  -1: none.
+template <class Ck, class StartsPrompt>
+inline int best_chain(const std::vector<Ck>& chain, const std::vector<int32_t>& slot_ids, size_t n_stage_parts,
+                      int64_t floor, StartsPrompt&& starts_prompt) {
+    int best = -1;
+    int64_t best_len = floor;
+    for (size_t i = 0; i < chain.size(); ++i) {
+        const Ck& c = chain[i];
+        const int64_t len = (int64_t) c.ids.size();
+        if (len > best_len && slot_prefix_ok(c, slot_ids, n_stage_parts) && starts_prompt(c)) {
+            best = (int) i;
+            best_len = len;
+        }
+    }
+    return best;
+}
+
+/// The other chain checkpoints that come along with the one at `chosen` (best_chain's pick), in chain order: the
+/// shorter ones the same rules accept.  The main session's checkpoints then start with the conversation's root as
+/// they would after a read from 0 (the cache keeps the first one of them longest), not with the chosen one alone.
+template <class Ck, class StartsPrompt>
+inline std::vector<size_t> chain_along(const std::vector<Ck>& chain, const std::vector<int32_t>& slot_ids,
+                                       size_t n_stage_parts, int chosen, StartsPrompt&& starts_prompt) {
+    std::vector<size_t> out;
+    if (chosen < 0 || (size_t) chosen >= chain.size()) return out;
+    const size_t len = chain[(size_t) chosen].ids.size();
+    for (size_t i = 0; i < chain.size(); ++i) {
+        const Ck& c = chain[i];
+        if (i == (size_t) chosen || c.ids.size() >= len || !slot_prefix_ok(c, slot_ids, n_stage_parts) ||
+            !starts_prompt(c))
+            continue;
+        bool dup = false;
+        for (size_t j : out) dup = dup || chain[j].ids == c.ids;
+        if (!dup) out.push_back(i);
+    }
+    return out;
+}
+
+/// A slot gave back everything it holds (`held`, now the main session's tokens): the places in `slot_checks` of the
+/// checkpoints that go along into the main session's `checks`.  Each is slot_prefix_ok for `held`, and none has the
+/// same tokens as one `checks` already has or as an earlier pick (a copy of a chain checkpoint the slot kept).
+template <class Ck>
+inline std::vector<size_t> giveback_picks(const std::vector<Ck>& slot_checks, const std::vector<Ck>& checks,
+                                          const std::vector<int32_t>& held, size_t n_stage_parts) {
+    std::vector<size_t> picks;
+    for (size_t i = 0; i < slot_checks.size(); ++i) {
+        const Ck& c = slot_checks[i];
+        if (!slot_prefix_ok(c, held, n_stage_parts)) continue;
+        bool dup = false;
+        for (const Ck& k : checks) dup = dup || k.ids == c.ids;
+        for (size_t j : picks) dup = dup || slot_checks[j].ids == c.ids;
+        if (!dup) picks.push_back(i);
+    }
+    return picks;
+}
+
+/// Where in one slot a request can start: nothing, all the slot holds (an idle slot only), one of its own checkpoints
+/// (sl.checks: its turn checkpoint, or a yielded read's) or one of its chain (STRATA_SLOT_CHAIN_REUSE).
+enum class Source { none, end, own, chain };
+struct SlotPick {
+    Source kind = Source::none;
+    int index = -1;       ///< the checkpoint's place in sl.checks (own) or sl.chain (chain)
+    int64_t tokens = 0;   ///< where the request goes on from
+};
+
+/// One slot of the request path's search (generate.cpp, "an idle slot that holds the start of this prompt"): the
+/// longest start past `floor` (what the live session, the main checkpoints and the slots before this one give), the
+/// later kind winning a tie only when strictly longer, in the order the engine has always tried them: the slot's end,
+/// then its own checkpoints, then (chain_on, an idle slot that is not a yielded read) its chain.  The caller has
+/// already skipped a slot of another control vector or one that is neither an idle source nor an active one.
+/// starts_ids(ids): the slot's tokens are a start of the prompt; starts_ck(c): a checkpoint's tokens and pictures are.
+template <class Slot, class StartsIds, class StartsCk>
+inline SlotPick scan_slot(const Slot& sl, bool idle_source, bool chain_on, size_t n_stage_parts, int64_t floor,
+                          StartsIds&& starts_ids, StartsCk&& starts_ck) {
+    SlotPick p;
+    int64_t at = floor;
+    if (idle_source && (int64_t) sl.ids.size() > at && starts_ids(sl.ids)) {
+        p = SlotPick{Source::end, -1, (int64_t) sl.ids.size()};
+        at = p.tokens;
+    }
+    for (size_t i = 0; i < sl.checks.size(); ++i) {
+        const auto& c = sl.checks[i];
+        if ((int64_t) c.ids.size() > at && starts_ck(c)) {
+            p = SlotPick{Source::own, (int) i, (int64_t) c.ids.size()};
+            at = p.tokens;
+        }
+    }
+    // a yielded read (`partial`) has no chain: its checkpoints are in sl.checks
+    if (chain_on && idle_source && !sl.partial) {
+        const int i = best_chain(sl.chain, sl.ids, n_stage_parts, at, starts_ck);
+        if (i >= 0) p = SlotPick{Source::chain, i, (int64_t) sl.chain[(size_t) i].ids.size()};
+    }
+    return p;
+}
+
+/// What a request that was just copied back from a slot does with the slot (the give-back branch of the request
+/// path).  discard_park / move_chain: the slot's pending image capture is dropped and its chain moves into the main
+/// session (its conversation goes on here) - not after a chain checkpoint (the slot keeps its conversation, which parts
+/// from this one, and parks it when it is overwritten).  hand_checks (STRATA_GIVEBACK_CHECKS): the slot gave back
+/// everything it holds, so its own checkpoints come along too - not from a yielded read the slot keeps (`partial`
+/// still set: it goes on with them later).  hand_move: moved, because the request is admitted to that same slot,
+/// whose admission drops them; otherwise copied, so the untouched slot can still serve a sibling from them.
+struct GiveBack {
+    bool discard_park = false;
+    bool move_chain = false;
+    bool hand_checks = false;
+    bool hand_move = false;
+};
+inline GiveBack giveback_plan(bool slot_park_on, Source from, bool giveback_on, bool partial_after,
+                              bool admitted_here) {
+    GiveBack g;
+    g.discard_park = g.move_chain = slot_park_on && from != Source::chain;
+    g.hand_checks = giveback_on && from == Source::end && !partial_after;
+    g.hand_move = g.hand_checks && admitted_here;
+    return g;
+}
+
+}  // namespace strata::program::slot_chain
