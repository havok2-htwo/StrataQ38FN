+/// STRATA_MSG_CKPT_TAIL=N (opt-in): the longest last message, in tokens, that a prompt read checkpoints in front of.
+/// Unset, empty, 0, negative or not a number: 0 (off).  At most 1 << 20.
+inline int64_t msg_ckpt_tail_parse(const char* v) {
+    if (v == nullptr || v[0] == '\0') return 0;
+    char* end = nullptr;
+    const long long n = std::strtoll(v, &end, 10);
+    if (end == v || *end != '\0' || n <= 0) return 0;
+    return n > (1LL << 20) ? (1LL << 20) : (int64_t) n;
+}
+
+/// Where a prompt read takes its message-boundary checkpoint (`at`, -1: none) and whether it is the "tail" kind (the
+/// first to be evicted, one alive at a time).
+///   tail > 0 (STRATA_MSG_CKPT_TAIL): the <|im_start|> of the last message before the turn boundary when that message
+///     is at most `tail` tokens and the prefix at least 8192 - on every layout, a layer split too - as an ordinary
+///     checkpoint.  An agent that sends a transient last user message (a reminder, its environment) each turn and drops
+///     it from the next request's history parts there, before the turn checkpoint: the next turn resumes from it.
+///   else STRATA_CACHE_MESSAGE_BOUNDARY=1 (`legacy`) as before: a tail of at most 1024, not with a layer split, the
+///     tail kind.
+///   Neither, or no prompt cache: none (the default path).
+struct MessageCut {
+    int64_t at = -1;
+    bool as_tail = false;
+};
+inline MessageCut message_cut(const std::vector<int64_t>& ids, int64_t resume, int64_t turn_at, int64_t turn_token,
+                              bool prompt_cache_on, bool legacy, bool multi_gpu, int64_t tail) {
+    MessageCut c;
+    if (!prompt_cache_on) return c;
+    if (tail > 0) {
+        c.at = message_checkpoint_boundary(ids, resume, turn_at, turn_token, 8192, tail);
+        return c;
+    }
+    if (legacy && !multi_gpu) {
+        c.at = message_checkpoint_boundary(ids, resume, turn_at, turn_token);
+        c.as_tail = true;
+    }
+    return c;
+}
+
 } // namespace strata::program
