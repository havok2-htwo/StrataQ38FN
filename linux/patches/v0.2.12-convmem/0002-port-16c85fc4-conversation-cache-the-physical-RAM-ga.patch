     return std::to_string(mem->available >> 20) + " MiB available, source " + strata::core::memory_source_name(mem->source);
 }
 
+// STRATA_GATE_EVICT: why a gate's eviction loop stopped short (gate_evict_to_fit); "" when it did not.  The caller
+// prefixes it and prints its own refusal line after it, as without the switch
+static std::string gate_evict_note(const strata::core::GateEvictOutcome& r, size_t evictable_left, size_t parked) {
+    if (r.admitted || (!r.stalled && !r.hopeless)) return std::string();
+    char buf[320];
+    if (r.stalled)
+        std::snprintf(buf, sizeof buf, "STRATA_GATE_EVICT: stopped evicting after %zu (2 in a row did not raise the "
+                      "available RAM by half their size: the allocator keeps the memory; %llu MiB evicted, available "
+                      "rose %lld MiB, %zu still parked)", r.evicted, (unsigned long long) (r.freed >> 20),
+                      (long long) (r.rose() / (1 << 20)), parked);
+    else
+        std::snprintf(buf, sizeof buf, "STRATA_GATE_EVICT: stopped evicting after %zu (the evictable rest, %zu MiB, "
+                      "cannot cover the need; %llu MiB evicted, available rose %lld MiB, %zu still parked)", r.evicted,
+                      evictable_left >> 20, (unsigned long long) (r.freed >> 20), (long long) (r.rose() / (1 << 20)),
+                      parked);
+    return buf;
+}
