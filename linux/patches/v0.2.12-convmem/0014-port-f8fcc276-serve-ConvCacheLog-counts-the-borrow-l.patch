--- a/serve/server.py
+++ b/serve/server.py
@@ -874,8 +874,13 @@ def narrate_start(log_path: str, offset: int, args: list, done: threading.Event,
 class ConvCacheLog:
     """#596: the engine's conversation cache as its log tells it (the engine writes "strata serve: conversation
     cache: parked N tokens ...; parked=P bytes=B evictions=E" and "restored N tokens ...; parked=P bytes=B" to stderr,
-    which is the log): read on from where it was last read, from the start of the engine's current run."""
-    EVENT = re.compile(r"conversation cache: (parked|skipped|restored) (\d+) tokens.*?parked=(\d+) bytes=(\d+)"
+    which is the log): read on from where it was last read, from the start of the engine's current run.  A borrow is
+    its own line - "borrowed N tokens from a parked conversation, which stays parked, ...; parked=P bytes=B" (one
+    GPU), and with STRATA_PARK_BORROW=1 on a layer split "borrowed N of a parked M-token conversation ...; parked=P
+    bytes=B" - and with that switch a restore line names the donor ("restored N of M tokens"): all count as restores,
+    a borrow also as one of "borrows"."""
+    EVENT = re.compile(r"conversation cache: (parked|skipped|restored|borrowed) (\d+)"
+                       r"(?: of (?:a parked )?\d+(?:-token conversation)?)?(?: tokens)?.*?parked=(\d+) bytes=(\d+)"
                        r"(?: evictions=(\d+))?")
     DROPPED = re.compile(r"conversation cache: dropped \d+ superseded .*?parked=(\d+)")
     # STRATA_CONV_TIER_DIR (the disk tier): "conversation tier: <event>; files=F parts=P disk_bytes=D written_today=W
@@ -890,7 +895,7 @@ class ConvCacheLog:
         self.reset()
 
