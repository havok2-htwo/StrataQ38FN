diff --git a/src/core/conversation_alloc_test.cpp b/src/core/conversation_alloc_test.cpp
new file mode 100644
index 00000000..0721af30
--- /dev/null
+++ b/src/core/conversation_alloc_test.cpp
@@ -0,0 +1,191 @@
+// CPU only (no device, no CUDA): the parked conversation state's allocator (conversation_alloc.hpp, STRATA_CONV_MMAP).
+//
+//   conversation_alloc_test        STRATA_CONV_MMAP=1 (set here before the first allocation): every block of 64 KiB
+//                                  or more is a mapping of its own, and what the cache frees leaves the process's RSS
+//                                  at once - also when a thread of its own allocated it (glibc would give it a thread
+//                                  arena) and when the heap already held freed snapshots
+//   conversation_alloc_test --off  the switch unset: the same container semantics through operator new; the RSS is
+//                                  printed, not checked (glibc decides)
+//
+// Both check what the switch must not change: resize's fill value and zeroing (also of bytes a shrink left behind
+// within the capacity), growth, copy / move / operator==, a checkpoint's vectors.
+#include "strata/core/conversation_cache.hpp"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <thread>
+#include <utility>
+#include <vector>
+
+#include <unistd.h>
+
+using namespace strata::core;
+
+static int checks_run = 0;
+static void check(bool ok, const char* label) {
+    ++checks_run;
+    if (!ok) { std::fprintf(stderr, "FAIL: %s\n", label); std::exit(1); }
+}
+
+// Resident anonymous memory of this process (RssAnon, /proc/self/status), bytes.
+static size_t rss_anon() {
+    FILE* f = std::fopen("/proc/self/status", "r");
+    if (!f) return 0;
+    char line[256];
+    size_t kb = 0;
+    while (std::fgets(line, sizeof line, f))
+        if (std::strncmp(line, "RssAnon:", 8) == 0) { kb = std::strtoull(line + 8, nullptr, 10); break; }
+    std::fclose(f);
+    return kb * 1024;
+}
+
+static bool all(const ConversationBuffer& b, uint8_t v) {
+    return b.visit(0, b.size(), [&](const uint8_t* p, size_t n, size_t) {
+        for (size_t i = 0; i < n; ++i) if (p[i] != v) return false;
+        return true;
+    });
+}
+static void fill(ConversationBuffer& b, size_t from, uint8_t salt) {
+    b.visit(from, b.size() - from, [&](uint8_t* p, size_t n, size_t at) {
+        for (size_t i = 0; i < n; ++i) p[i] = (uint8_t) (salt + (at + i) * 131);
+        return true;
+    });
+}
+
+// A parked conversation of `layers` K/V buffers of `kv` bytes each (written as a capture would) and one checkpoint
+// with a `gdn`-byte recurrence.
+static SavedConversation conversation(size_t layers, size_t kv, size_t gdn, int salt) {
+    SavedConversation c;
+    c.live.ids = {salt, 1, 2, 3};
+    c.live.gdn.resize(gdn);
+    for (size_t i = 0; i < gdn; i += 4096) c.live.gdn[i] = (uint8_t) salt;
+    c.kv.resize(layers);
+    for (auto& l : c.kv) {
+        l.k.resize(kv); fill(l.k, 0, (uint8_t) salt);
+        l.v.resize(kv); fill(l.v, 0, (uint8_t) (salt + 1));
+        l.k_scale.resize(kv / 32); fill(l.k_scale, 0, 3);
+    }
+    return c;
+}
+
+static void semantics() {
+    const bool on = conversation_mmap_enabled();
+    // a fresh buffer: zero, whatever the source of its pages
+    ConversationBuffer a;
+    a.resize(40u << 20);                      // two full segments and an 8 MiB tail
+    check(a.size() == (40u << 20) && all(a, 0), "a fresh buffer reads zero");
+    fill(a, 0, 9);
+    ConversationBuffer b = a;
+    check(b == a, "a copy equals its source");
+    // a shrink leaves stale bytes in the last segment's capacity: growing back must zero them again
+    a.resize((32u << 20) + 100);
+    a.resize(40u << 20);
+    bool tail_zero = a.visit((32u << 20) + 100, (8u << 20) - 100, [](const uint8_t* p, size_t n, size_t) {
+        for (size_t i = 0; i < n; ++i) if (p[i]) return false;
+        return true;
+    });
+    check(tail_zero, "growing over stale bytes zeroes them");
+    check(!(a == b), "the zeroed range differs from the copy");
+    // an explicit fill value, on a fresh mapping and on an extension
+    ConversationBuffer c;
+    c.resize(3u << 20, 0x5a);
+    check(all(c, 0x5a), "a fill value reaches a fresh segment");
+    c.resize((3u << 20) + 5000, 0x5a);
+    check(c.size() == (3u << 20) + 5000 && all(c, 0x5a), "a fill value reaches an extension");
+    // a growing buffer (the chat-turn appends): the reserve is whole pages when mapped
+    ConversationBuffer d;
+    d.resize(100000);
+    fill(d, 0, 1);
+    for (int t = 0; t < 200; ++t) d.resize(d.size() + 7777);
+    check(d.size() == 100000 + 200 * 7777, "appends grow the size");
+    bool appended_zero = d.visit(100000, d.size() - 100000, [](const uint8_t* p, size_t n, size_t) {
+        for (size_t i = 0; i < n; ++i) if (p[i]) return false;
+        return true;
+    });
+    check(appended_zero, "appended bytes are zero");
+    if (on) check(conversation_alloc_capacity(100000) % (size_t) sysconf(_SC_PAGESIZE) == 0 &&
+                  conversation_alloc_capacity(100000) >= 100000 && conversation_alloc_capacity(1000) == 1000,
+                  "a mapped segment's capacity is whole pages");
+    else check(conversation_alloc_capacity(100000) == 100000, "without the switch the capacity is the request");
+    check(d.allocation_peak(d.size() + (20u << 20)) >= d.bytes() + (19u << 20), "the peak estimate covers a growth");
+    // move: O(1), the source is empty
+    ConversationBuffer e = std::move(b);
+    check(b.empty() && e.size() == (40u << 20), "a move takes the segments");
+    ConversationBuffer f{1, 2, 3};
+    uint8_t g[3] = {};
+    check(f.read(g, 0, 3) && g[0] == 1 && g[2] == 3, "the initializer-list buffer");
+
+    // the checkpoint vectors: std::vector semantics, resize(n) zeroes
+    ConversationBytes v;
+    v.resize(1u << 20);
+    bool zero = true;
+    for (uint8_t x : v) zero = zero && x == 0;
+    check(zero, "a checkpoint vector resizes to zero");
+    std::memset(v.data(), 0xee, v.size());
+    v.resize(1000);
+    v.resize(1u << 20);
+    zero = true;
+    for (size_t i = 1000; i < v.size(); ++i) zero = zero && v[i] == 0;
+    check(zero && v[999] == 0xee, "regrowing a checkpoint vector zeroes, keeps the head");
+    ConversationBytes w = v;
+    check(w == v && w.data() != v.data(), "a checkpoint vector copies");
+    for (int i = 0; i < 100000; ++i) w.push_back((uint8_t) i);
+    check(w.size() == (1u << 20) + 100000 && w[(1u << 20) + 99999] == (uint8_t) 99999, "push_back grows");
+    const uint8_t* before = w.data();
+    ConversationBytes x = std::move(w);
+    check(x.data() == before && w.empty(), "a checkpoint vector moves without copying");
+    ConversationCheckpoint ck;
+    ck.gdn.assign(300000, 7); ck.ple = {1, 2}; ck.tails.assign(70000, 9);
+    ConversationCheckpoint ck2 = ck;
+    check(ck2.gdn == ck.gdn && ck2.ple == ck.ple && ck2.tails == ck.tails, "a checkpoint copies");
+    check(ck.bytes() >= 300000 + 70000 + 2, "a checkpoint counts its vectors");
+}
+
+// The cache's own path: park, evict, see the RSS fall.  `strict`: the switch is on, so it must.
+static void rss_returns(bool strict) {
+    const size_t layers = 13, kv = (20u << 20) + 12345, gdn = 30u << 20;   // ~550 MiB a conversation
+    ConversationCache cache(8ull << 30, 64, 1);
+    const size_t base = rss_anon();
+    // captured on threads of their own, as the park threads do (glibc: one arena each)
+    std::vector<SavedConversation> made(4);
+    std::vector<std::thread> threads;
+    for (size_t i = 0; i < made.size(); ++i)
+        threads.emplace_back([&, i] { made[i] = conversation(layers, kv, gdn, (int) i + 10); });
+    for (auto& t : threads) t.join();
+    for (auto& c : made) check(cache.put(std::move(c)), "a conversation parks");
+    made.clear();
+    const size_t parked = cache.bytes(), full = rss_anon();
+    std::printf("  parked %zu MiB in %zu entries: RssAnon %zu -> %zu MiB\n", parked >> 20, cache.size(), base >> 20,
+                full >> 20);
+    if (strict) check(full >= base + parked * 9 / 10, "the parked bytes are resident");
+    while (cache.evict_oldest()) {}
+    const size_t after = rss_anon();
+    std::printf("  evicted all: RssAnon %zu MiB (%s)\n", after >> 20, strict ? "checked" : "glibc's choice, not checked");
+    if (strict) check(after < base + (16u << 20), "an eviction gives the RAM back at once");
+    // a second round reuses nothing: the heap held freed snapshots before (the case where glibc carves new
+    // segments from its free chunks), and the mapping still returns
+    for (int round = 0; round < 2; ++round) {
+        SavedConversation c = conversation(layers, kv, gdn, 40 + round);
+        check(cache.put(std::move(c)), "a second conversation parks");
+        cache.evict_oldest();
+    }
+    const size_t again = rss_anon();
+    std::printf("  park + evict twice more: RssAnon %zu MiB\n", again >> 20);
+    if (strict) check(again < base + (16u << 20), "the RAM comes back on every round");
+}
+
+int main(int argc, char** argv) {
+    const bool off = argc > 1 && std::string(argv[1]) == "--off";
+    if (off) unsetenv("STRATA_CONV_MMAP");
+    else setenv("STRATA_CONV_MMAP", "1", 1);      // before the first allocation: the mode is read once
+    check(conversation_mmap_enabled() == !off, "the switch is read once from the environment");
+    check(!conversation_mmap_block(65535) && conversation_mmap_block(65536) == !off, "the 64 KiB minimum");
+    setenv("STRATA_CONV_MMAP", off ? "1" : "0", 1);
+    check(conversation_mmap_enabled() == !off, "a later change of the environment changes nothing");
+    semantics();
+    rss_returns(!off);
+    std::printf("conversation_alloc_test%s: %d checks passed\n", off ? " --off" : "", checks_run);
+    return 0;
+}
