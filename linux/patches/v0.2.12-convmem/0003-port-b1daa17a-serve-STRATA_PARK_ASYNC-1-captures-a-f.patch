+/// whatever that variable says: its process-wide stage is the serve thread's only.  The engine prints which one runs.
+inline bool conversation_park_capture_env() {
+    static const bool on = [] {
+        for (const char* name : {"STRATA_PARK_CAPTURE", "STRATA_PARK_CAPTURE_THREADS"}) {
+            const char* v = std::getenv(name);
+            if (v && v[0] != '0') return true;
+        }
+        return false;
+    }();
+    return on;
+}
