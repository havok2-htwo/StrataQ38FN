diff --git a/include/strata/program/solo_pipeline.hpp b/include/strata/program/solo_pipeline.hpp
new file mode 100644
index 00000000..e0ea39ed
--- /dev/null
+++ b/include/strata/program/solo_pipeline.hpp
@@ -0,0 +1,60 @@
+// include/strata/program/solo_pipeline.hpp - STRATA_SOLO_PIPELINE (opt-in): --pipeline-windows 2 beside --batch slots
+// (header-only: the rules, no CUDA).
+//
+// With --batch the server sends a request that is alone to the solo path (GEN) and the engine decodes it with the serial
+// solo loop.  STRATA_SOLO_PIPELINE=1 lets that request run the pipelined decode loop instead (two verifiers per stage,
+// one conversation's windows overlapped across the stages; the same graphs, so the same tokens).  The batch windows,
+// the admissions (BGEN's first token) and every prompt read keep their serial windows.  These are the rules that decide
+// when it is on, for the engine and its test.
+#pragma once
+
+#include <cstdint>
+
+namespace strata::program::solo_pipeline {
+
+/// The switch's text: unset, empty and "0..." are off, anything else on.
+inline bool env_on(const char* v) { return v != nullptr && v[0] != '\0' && v[0] != '0'; }
+
+/// The switch with STRATA_SPEC_LANES (`lanes`: its value, 2..4 on): the low-concurrency modes fold the solo pipeline in
+/// (one user: the pipelined solo path; two to four: one lane each), so it is on when STRATA_SOLO_PIPELINE is not set;
+/// a value set (STRATA_SOLO_PIPELINE=0: the lanes alone, as M1b) is what it says.  Neither set: off, as before.
+inline bool env_on_with_lanes(const char* v, int lanes) { return v != nullptr ? env_on(v) : lanes >= 2; }
+
+/// --pipeline-windows as the engine resolves it: not asked for (`auto_pw`), --batch on and the switch on: 2.
+inline int resolve_windows(int pipeline_windows, bool auto_pw, int batch, bool env) {
+    return auto_pw && pipeline_windows == 0 && batch > 0 && env ? 2 : pipeline_windows;
+}
+
+/// Is it asked for: the switch, --batch and --pipeline-windows 2 (1 stays refused beside --batch).
+inline bool asked(int pipeline_windows, int batch, bool env) { return env && batch > 0 && pipeline_windows >= 2; }
+
+/// What one card needs free before the second verifier is made: the verifier (`window_mib`, as the cache sizing holds
+/// it back), the stage's GDN snapshots (front stages; 0 on the last), and the engine's safe floor plus 256 MiB for the
+/// even verifier and the graphs still to come.  Less: the solo path stays serial (no loan, no paging).
+inline int64_t room_need_bytes(int64_t window_mib, int64_t snapshot_bytes, int64_t safe_mib) {
+    return ((window_mib + safe_mib + 256) << 20) + snapshot_bytes;
+}
+
+/// One solo request, as the decode loop sees it before it starts.
+struct Request {
+    bool admission = false;        ///< a batch admission's first token (BGEN): the batch path's, never pipelined
+    bool images = false;           ///< images in the request or the live session (the serial loop, as measured)
+    bool slots_active = false;     ///< batch slots decoding (nothing pumps them while a solo request runs)
+    bool groups_in_flight = false; ///< pipelined slot groups not drained
+    bool out_of_vram = false;      ///< an all-resident stage with experts out of VRAM now (its graphs were captured all-resident)
+    bool snapshot_resized = false; ///< a front stage's GDN state is no longer the size its snapshots were made for
+};
+
+/// Why `r` decodes serially (said once per reason), or nullptr: pipelined.  `silent`: an admission, not worth a line.
+inline const char* why_serial(const Request& r, bool& silent) {
+    silent = false;
+    if (r.admission) { silent = true; return "a batch admission"; }
+    if (r.images) return "images in its context";
+    if (r.slots_active) return "batch slots decoding";
+    if (r.groups_in_flight) return "slot groups in flight";
+    if (r.out_of_vram) return "experts out of VRAM (a loan, a shrink or a swap)";
+    if (r.snapshot_resized) return "a GDN state of another size";
+    return nullptr;
+}
+
+}  // namespace strata::program::solo_pipeline
diff --git a/include/strata/program/spec_lanes.hpp b/include/strata/program/spec_lanes.hpp
new file mode 100644
index 00000000..2ed8193c
--- /dev/null
+++ b/include/strata/program/spec_lanes.hpp
@@ -0,0 +1,201 @@
+// include/strata/program/spec_lanes.hpp - STRATA_SPEC_LANES=2..4 (opt-in): spec lanes beside the --batch slot groups
+// (header-only: the rules, no CUDA).
+//
+// With pipelined slot groups (--batch with --batch-groups G > 1 on a layer split) two users decode in two groups, one
+// row each, with no drafts.  A spec lane runs one such slot as its own solo-MTP stream instead: its own verifier per
+// stage (bound to the slot's sessions), its own drafter (sharing the solo drafter's weights), its windows launched on
+// the stages as each stage finishes the one before (the two lanes' windows interleave on every card), the verdict on
+// the last stage, the commit queued on every stage at once (eager), the drafter's chain for the next window.  The same
+// window graphs as the solo loop's, the same exact-match verdict and Philox(seed, position) draw: a lane emits the
+// tokens the serial solo loop would.  These are the rules the engine and its test share.
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+
+namespace strata::program::spec_lanes {
+
+/// The most lanes: one per pipelined slot group of production's --batch 16 in 4 groups (slots 0, 4, 8, 12).
+constexpr int kLanesMax = 4;
+
+/// STRATA_SPEC_LANES: unset, empty and "0..." are off (0); "2", "3" and "4" are up to that many lanes (Lmax; the
+/// boot may run fewer, said there); anything else is not supported (-1: said, and off).
+inline int env_lanes(const char* v) {
+    if (v == nullptr || v[0] == '\0' || v[0] == '0') return 0;
+    return v[0] >= '2' && v[0] <= '0' + kLanesMax && v[1] == '\0' ? v[0] - '0' : -1;
+}
+
+/// The lane slots: the first `L` of the order the server fills pipelined groups in (0, GS, 2 GS, ...: one user per
+/// group), so two users land on them.  False when the slots do not form `L` groups of GS (no lanes).
+inline bool lane_slots(int batch, int groups, int L, int* out) {
+    if (L < 1 || groups < L || batch <= 0 || groups <= 1 || batch % groups != 0) return false;
+    const int gs = batch / groups;
+    for (int j = 0; j < L; ++j) out[j] = j * gs;
+    return true;
+}
+
+/// What the gate looks at of one slot.
+struct Slot {
+    bool active = false;   ///< decoding (BSlot::active)
+    bool lane_ok = false;  ///< its request can run in a lane: no images, no penalties, no logit bias (set at admission)
+    bool fresh = false;    ///< it has only its admission's token so far (STRATA_SPEC_LANES_HOLD)
+};
+
+/// The active lane slots, or -1 when one of them may not run in a lane (or another slot decodes: `others_active`).
+inline int lane_count(const Slot* lanes, int L, bool others_active) {
+    if (others_active) return -1;
+    int n = 0;
+    for (int j = 0; j < L; ++j) {
+        if (!lanes[j].active) continue;
+        if (!lanes[j].lane_ok) return -1;
+        ++n;
+    }
+    return n;
+}
+
+/// Do the lanes start now?  `lanes`: the L lane slots; `others_active`: an active slot that is not a lane slot.  At
+/// least `n_min` lane slots active (each lane_ok) and nothing else (n_min = L: every lane slot, as M1b's two lanes).
+inline bool gate_start(const Slot* lanes, int L, bool others_active, int n_min) {
+    const int n = lane_count(lanes, L, others_active);
+    return n >= std::max(1, n_min) && n <= L;
+}
+
+/// Do running lanes go on?  `keep` (the default): while at least one lane slot decodes and nothing else does (a user
+/// who is done leaves the others running, without a drain); off (STRATA_SPEC_LANES_KEEP=0): while gate_start holds.
+inline bool gate_keep(const Slot* lanes, int L, bool others_active, int n_min, bool keep) {
+    return keep ? lane_count(lanes, L, others_active) >= 1 : gate_start(lanes, L, others_active, n_min);
+}
+
+/// M1b's gate (STRATA_SPEC_LANES=2): every lane slot active (`one`: at least one) - gate_start with n_min L (or 1).
+inline bool gate(const Slot* lanes, int L, bool others_active, bool one) {
+    return gate_start(lanes, L, others_active, one ? 1 : L);
+}
+
+/// STRATA_SPEC_LANES_HOLD=k (testing): fresh lane slots wait (no batch window runs them) until k of them have been
+/// admitted, so every one runs admission -> lane windows only.  True while 1 <= n < k lane slots decode, each fresh
+/// and lane_ok, and nothing else.  (k = 2 is M1b's HOLD=1: one lone fresh lane slot.)
+/// (review: k = 2 is exactly M1b's rule - a lone fresh lane slot waits whether or not it may run in a lane; k >= 3
+/// holds only lane_ok slots, since a slot that may not run in a lane would keep the others waiting for nothing)
+inline bool hold(const Slot* lanes, int L, bool others_active, int k) {
+    if (others_active) return false;
+    int n = 0;
+    for (int j = 0; j < L; ++j) {
+        if (!lanes[j].active) continue;
+        if (!lanes[j].fresh || (k != 2 && !lanes[j].lane_ok)) return false;
+        ++n;
+    }
+    return n >= 1 && n < k;
+}
+/// STRATA_SPEC_LANES_HOLD's value: unset / empty / "0": off (0); "1": M1b's (2); k = 2..L: k; more than L: L.
+inline int env_hold(const char* v, int L) {
+    if (v == nullptr || v[0] == '\0' || v[0] == '0') return 0;
+    const int k = v[0] >= '1' && v[0] <= '9' && v[1] == '\0' ? v[0] - '0' : 2;
+    return std::min(std::max(k, 2), std::max(L, 2));
+}
+
+/// The shared-VRAM profile's default (STRATA_LC_SHARE unset; review of the low-concurrency modes): on for 3 and 4
+/// lanes, off for 2 - STRATA_SPEC_LANES=2 alone is M1b as deployed (an arena per lane, KEEP=0, M1b's boot rule, the
+/// solo pipeline's graphs captured at its first request), so a binary swap under production's config changes nothing.
+inline bool share_default(int lanes) { return lanes >= 3; }
+/// A switch with a default: unset: `def`; set: its number, non-zero on (so "" and "0" are off, as before).
+inline bool env_flag(const char* v, bool def) {
+    if (v == nullptr) return def;
+    long n = 0;
+    bool neg = false;
+    const char* c = v;
+    if (*c == '-' || *c == '+') neg = *c++ == '-';
+    while (*c >= '0' && *c <= '9') n = n * 10 + (*c++ - '0');
+    return (neg ? -n : n) != 0;
+}
+
+// ---- The shared VRAM (STRATA_SPEC_LANES with STRATA_LC_SHARE: the default for 3 and 4 lanes).  The modes never run at once (every
+// line but BSTOP/BYIELD drains the lanes; the solo path runs only with nothing else), so a lane's verifier carves its
+// buffers from the arena of a verifier that is idle while the lanes run: lane 0 from the stage's main verifier (the
+// batch windows', the serial solo windows'), lane 1 from the solo pipeline's second verifier (when there is one).
+// Lanes 2 and 3 have their own; the solo pipeline's GDN snapshots of a front stage live in lane 2's arena.
+
+/// The arenas a card allocates for L lanes: none for lane 0 (the main verifier's) and lane 1 with a second verifier
+/// (`has_b`: the solo pipeline's), one for each other lane; `share` off (STRATA_LC_SHARE=0): one per lane, as M1b.
+inline int own_arenas(int L, bool share, bool has_b) {
+    if (L <= 0) return 0;
+    if (!share) return L;
+    return std::max(0, L - (has_b ? 2 : 1));
+}
+
+/// Do the solo pipeline's two GDN snapshots of a front stage (`snap_bytes` each, 256-aligned) fit in lane 2's arena
+/// below its first buffer that outlives a window (`room`: Verifier::persist_offset - argmax_rows' counter and the
+/// constant 1 sit there, and nothing may overwrite them; review)?
+inline bool snaps_in_lane(int L, bool share, bool has_b, int64_t snap_bytes, int64_t room) {
+    const int64_t one = (snap_bytes + 255) & ~(int64_t) 255;
+    return share && has_b && L >= 3 && snap_bytes > 0 && 2 * one <= room;
+}
+
+/// What L lanes take on one card (bytes, estimated before they are made): their own arenas (`arena` each, with the
+/// verifier object `obj`), each lane's graphs and objects (`per_lane`), less the snapshots (`snap_total`, both
+/// buffers) that move into lane 2's arena instead of their own allocation.
+/// (`room`: the arena's bytes below its persistent buffers, Verifier::persist_offset; snaps_in_lane)
+inline int64_t lanes_cost(int L, bool share, bool has_b, int64_t arena, int64_t per_lane, int64_t snap_total,
+                          int64_t room) {
+    if (L <= 0) return 0;
+    const int own = own_arenas(L, share, has_b);
+    int64_t c = (int64_t) own * arena + (int64_t) L * per_lane;
+    if (snap_total > 0 && snaps_in_lane(L, share, has_b, snap_total / 2, room)) c -= snap_total;
+    return c;
+}
+
+/// The boot's VRAM rule: with everything of the lanes made, a card keeps `floor` (the engine's safe floor + 256 MiB)
+/// free after what is still made lazily on it (`lazy`: the batch layouts' graphs, the overlap's buffers, the main
+/// verifier's serial graphs).
+inline bool room_ok(int64_t free_after, int64_t lazy, int64_t floor) { return free_after - lazy >= floor; }
+
+/// The most lanes (Lmax down to 2; 0: none) for which every card i of `n` keeps room_ok, given what it has free now
+/// (`free[i]`) and what L lanes would take there (`cost(i, L)`).
+template <class Cost>
+inline int fit_lanes(int Lmax, int n, const int64_t* free, int64_t lazy, int64_t floor, Cost&& cost) {
+    for (int L = std::min(Lmax, kLanesMax); L >= 2; --L) {
+        bool ok = true;
+        for (int i = 0; i < n && ok; ++i) ok = room_ok(free[i] - cost(i, L), lazy, floor);
+        if (ok) return L;
+    }
+    return 0;
+}
+
+/// The serial loop's window size: 1 + the drafts (of `avail`) whose probability is at least `min_p` (min_p 0: all),
+/// at most `s_mtp` rows, and never past the context (`room` = max_context - p cells left).
+inline int window_size(const float* prob, int avail, int s_mtp, double min_p, int64_t room) {
+    int T = 1;
+    while (T < s_mtp && T - 1 < avail && (min_p <= 0.0 || prob[T - 1] >= (float) min_p)) ++T;
+    return (int) std::max<int64_t>(1, std::min<int64_t>(T, room));
+}
+
+/// One window's verdict.  The window fed `tok[0..T)` at positions p..; `out[t]` is the pick after row t.  `a` rows of
+/// drafts are accepted (exact match); the picks out[0..a] go out one by one with the batch path's checks per token,
+/// and the slot's sessions keep exactly the rows whose picks went out (`commit`), so what they hold is what the slot's
+/// token list says (a finished slot is a conversation cache like any other).
+struct Verdict {
+    int a = 0;                 ///< accepted drafts
+    int emit = 0;              ///< picks that go out (out[0..emit))
+    int commit = 0;            ///< rows the sessions keep (= emit)
+    const char* fin = nullptr; ///< why the slot ends ("stop", "cancel", "length"), or nullptr: it goes on
+};
+
+/// `produced`: the slot's tokens out so far; `is_eos(y)`: an end token.  The checks per token are the pump's: an end
+/// token, a stop asked for (BSTOP), max_new, and the context (the position of the row's token + 2 past max_context).
+template <class Eos>
+inline Verdict verdict(const int32_t* tok, const int32_t* out, int T, int64_t p, int64_t produced, int64_t max_new,
+                       bool stop, int64_t max_context, Eos&& is_eos) {
+    Verdict v;
+    while (v.a < T - 1 && tok[v.a + 1] == out[v.a]) ++v.a;
+    for (int i = 0; i <= v.a; ++i) {
+        const int32_t y = out[i];
+        ++produced;
+        ++v.emit;
+        v.fin = is_eos(y) ? "stop" : stop ? "cancel" : produced >= max_new ? "length"
+              : p + i + 2 > max_context ? "length" : nullptr;
+        if (v.fin != nullptr) break;
+    }
+    v.commit = v.emit;
+    return v;
+}
+
+}  // namespace strata::program::spec_lanes
diff --git a/tests/program/solo_pipeline_test.cpp b/tests/program/solo_pipeline_test.cpp
new file mode 100644
index 00000000..1f28940a
--- /dev/null
+++ b/tests/program/solo_pipeline_test.cpp
@@ -0,0 +1,89 @@
+// STRATA_SOLO_PIPELINE's rules (include/strata/program/solo_pipeline.hpp): the switch, how --pipeline-windows resolves
+// beside --batch, the room a card needs before the second verifier, and which solo requests stay serial.  Header-only,
+// CPU: no model, no GPU.
+#include "strata/program/solo_pipeline.hpp"
+
+#include <cstdio>
+#include <cstring>
+
+namespace sp = strata::program::solo_pipeline;
+
+namespace {
+int failures = 0;
+void check(bool ok, const char* what) {
+    if (!ok) {
+        std::fprintf(stderr, "FAIL: %s\n", what);
+        ++failures;
+    }
+}
+}  // namespace
+
+int main() {
+    // the switch: unset, empty and 0 are off (the default path), anything else on
+    check(!sp::env_on(nullptr), "unset is off");
+    check(!sp::env_on(""), "empty is off");
+    check(!sp::env_on("0"), "0 is off");
+    check(sp::env_on("1"), "1 is on");
+    check(sp::env_on("yes"), "text is on");
+    // STRATA_SPEC_LANES folds it in: on when not set, what it says when set; neither: off (the default path)
+    check(!sp::env_on_with_lanes(nullptr, 0), "neither switch: off");
+    check(sp::env_on_with_lanes(nullptr, 4), "STRATA_SPEC_LANES=4 alone: the solo pipeline too");
+    check(sp::env_on_with_lanes(nullptr, 2), "STRATA_SPEC_LANES=2 alone: the solo pipeline too");
+    check(!sp::env_on_with_lanes("0", 4), "STRATA_SOLO_PIPELINE=0: the lanes alone (M1b)");
+    check(sp::env_on_with_lanes("1", 0), "STRATA_SOLO_PIPELINE=1 alone: M1a");
+    check(!sp::env_on_with_lanes(nullptr, -1), "an unsupported STRATA_SPEC_LANES: off");
+
+    // --pipeline-windows: only a value that was not asked for (auto, resolved to 0 on CUDA) becomes 2, and only with
+    // --batch and the switch; an explicit 0 or 1 stays, batch 0 stays (the single-stream server's own rule)
+    check(sp::resolve_windows(0, true, 16, true) == 2, "auto + batch + switch -> 2");
+    check(sp::resolve_windows(0, true, 16, false) == 0, "no switch: unchanged");
+    check(sp::resolve_windows(0, true, 0, true) == 0, "no batch: unchanged");
+    check(sp::resolve_windows(0, false, 16, true) == 0, "--pipeline-windows 0 given: unchanged");
+    check(sp::resolve_windows(0, false, 16, true) == 0, "STRATA_PIPELINE_AUTO=0 (auto_pw false): unchanged");
+    check(sp::resolve_windows(1, false, 16, true) == 1, "--pipeline-windows 1 given: unchanged");
+    check(sp::resolve_windows(2, true, 0, false) == 2, "auto on (HIP) stays on");
+
+    // asked: switch, batch slots, two windows; --pipeline-windows 1 stays refused beside --batch
+    check(sp::asked(2, 16, true), "pw 2 + batch + switch");
+    check(!sp::asked(2, 16, false), "no switch: refused as before");
+    check(!sp::asked(1, 16, true), "pw 1 beside batch: refused");
+    check(!sp::asked(2, 0, true), "no batch: the batch-0 pipeline, not this");
+
+    // the room: verifier + snapshots + floor + 256 MiB
+    check(sp::room_need_bytes(160, 0, 512) == (int64_t) (160 + 512 + 256) << 20, "last stage: no snapshots");
+    check(sp::room_need_bytes(160, 56ll << 20, 512) == (int64_t) (160 + 56 + 512 + 256) << 20, "front stage: snapshots");
+    // the production split after load (12,25,37, 2026-10-16): CUDA0 ~1570 MiB free before the verifiers - fits; the s28r
+    // split's CUDA1 (~920 MiB) does not
+    check(((int64_t) 1570 << 20) >= sp::room_need_bytes(160, 56ll << 20, 512), "prod CUDA0 fits");
+    check(((int64_t) 920 << 20) < sp::room_need_bytes(160, 56ll << 20, 512), "s28r CUDA1 stays serial");
+
+    // the requests: a plain lone request is pipelined; every other kind decodes serially, an admission silently
+    bool quiet = true;
+    sp::Request r;
+    check(sp::why_serial(r, quiet) == nullptr && !quiet, "a plain solo request is pipelined");
+    r.admission = true;
+    check(sp::why_serial(r, quiet) != nullptr && quiet, "an admission's first token: serial, silent");
+    r = sp::Request{};
+    r.images = true;
+    check(sp::why_serial(r, quiet) != nullptr && !quiet, "images: serial, said");
+    r = sp::Request{};
+    r.slots_active = true;
+    check(sp::why_serial(r, quiet) != nullptr, "slots decoding: serial");
+    r = sp::Request{};
+    r.groups_in_flight = true;
+    check(sp::why_serial(r, quiet) != nullptr, "groups in flight: serial");
+    r = sp::Request{};
+    r.out_of_vram = true;
+    check(sp::why_serial(r, quiet) != nullptr, "experts out of VRAM: serial");
+    r = sp::Request{};
+    r.snapshot_resized = true;
+    check(sp::why_serial(r, quiet) != nullptr, "snapshot size changed: serial");
+    // an admission wins over everything (never said)
+    r = sp::Request{};
+    r.admission = r.images = r.slots_active = true;
+    check(sp::why_serial(r, quiet) != nullptr && quiet && std::strcmp(sp::why_serial(r, quiet), "a batch admission") == 0,
+          "an admission first");
+
+    if (failures == 0) std::printf("solo_pipeline_test: all checks passed\n");
+    return failures == 0 ? 0 : 1;
+}
diff --git a/tests/program/spec_lanes_test.cpp b/tests/program/spec_lanes_test.cpp
new file mode 100644
index 00000000..49a86e40
--- /dev/null
+++ b/tests/program/spec_lanes_test.cpp
@@ -0,0 +1,226 @@
+// STRATA_SPEC_LANES's rules (include/strata/program/spec_lanes.hpp): the switch, the lane slots, the gate, the window
+// size and one window's verdict (what goes out and what the slot keeps).  Header-only, CPU: no model, no GPU.
+#include "strata/program/spec_lanes.hpp"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+
+namespace sl = strata::program::spec_lanes;
+
+namespace {
+int failures = 0;
+void check(bool ok, const char* what) {
+    if (!ok) {
+        std::fprintf(stderr, "FAIL: %s\n", what);
+        ++failures;
+    }
+}
+}  // namespace
+
+int main() {
+    // the switch: unset, empty and 0 are off (the default path); 2 is two lanes; anything else unsupported
+    check(sl::env_lanes(nullptr) == 0, "unset is off");
+    check(sl::env_lanes("") == 0, "empty is off");
+    check(sl::env_lanes("0") == 0, "0 is off");
+    check(sl::env_lanes("2") == 2, "2 is two lanes");
+    check(sl::env_lanes("3") == 3, "3 is up to three lanes");
+    check(sl::env_lanes("4") == 4, "4 is up to four lanes");
+    check(sl::env_lanes("1") == -1, "1 is not supported");
+    check(sl::env_lanes("5") == -1, "5 is not supported (four groups)");
+    check(sl::env_lanes("22") == -1, "22 is not supported");
+    check(sl::env_lanes("4x") == -1, "4x is not supported");
+
+    // the lane slots: the server's spreading order (0, GS, ...): production --batch 16 in 4 groups -> 0 and 4
+    int ls[4] = {-1, -1, -1, -1};
+    check(sl::lane_slots(16, 4, 2, ls) && ls[0] == 0 && ls[1] == 4, "16 slots in 4 groups: 0, 4");
+    check(sl::lane_slots(8, 2, 2, ls) && ls[0] == 0 && ls[1] == 4, "8 slots in 2 groups: 0, 4");
+    check(sl::lane_slots(12, 4, 2, ls) && ls[0] == 0 && ls[1] == 3, "12 slots in 4 groups: 0, 3");
+    check(!sl::lane_slots(16, 1, 2, ls), "one group: no lanes");
+    check(!sl::lane_slots(0, 4, 2, ls), "no slots: no lanes");
+    check(!sl::lane_slots(15, 4, 2, ls), "groups that do not divide the slots: no lanes");
+    check(sl::lane_slots(16, 4, 4, ls) && ls[0] == 0 && ls[1] == 4 && ls[2] == 8 && ls[3] == 12,
+          "16 slots in 4 groups, four lanes: 0, 4, 8, 12");
+    check(sl::lane_slots(16, 4, 3, ls) && ls[2] == 8, "three lanes: 0, 4, 8");
+    check(!sl::lane_slots(8, 2, 3, ls), "three lanes need three groups");
+
+    // the gate: both lane slots active, nothing else, both lane_ok
+    sl::Slot both[2] = {{true, true}, {true, true}};
+    check(sl::gate(both, 2, false, false), "slots 0 and 4 active: lanes");
+    check(!sl::gate(both, 2, true, false), "a third slot active: the pump");
+    sl::Slot img[2] = {{true, true}, {true, false}};
+    check(!sl::gate(img, 2, false, false), "an image / penalty slot: the pump");
+    sl::Slot one[2] = {{true, true}, {false, false}};
+    check(!sl::gate(one, 2, false, false), "one lane slot active: the pump (the default)");
+    check(sl::gate(one, 2, false, true), "one lane slot active with STRATA_SPEC_LANES_ONE: its lane");
+    sl::Slot none[2] = {{false, false}, {false, false}};
+    check(!sl::gate(none, 2, false, true), "nothing active: no lanes");
+    check(!sl::gate(img, 2, false, true), "one: an active slot that may not run in a lane stops them");
+
+    // the generalized gates (up to four lanes): start with n_min .. L lane slots, keep while one decodes
+    {
+        sl::Slot s4[4] = {{true, true}, {true, true}, {false, false}, {false, false}};
+        check(sl::lane_count(s4, 4, false) == 2, "two of four lane slots active");
+        check(sl::gate_start(s4, 4, false, 2), "two users of up to four: lanes");
+        check(!sl::gate_start(s4, 4, false, 4), "n_min 4 (every lane slot): not with two");
+        check(!sl::gate_start(s4, 4, true, 2), "a fifth user on a non-lane slot: the pump");
+        s4[2] = {true, true};
+        s4[3] = {true, true};
+        check(sl::gate_start(s4, 4, false, 2), "four users: four lanes");
+        s4[1] = {true, false};
+        check(!sl::gate_start(s4, 4, false, 2), "a penalty / image request on a lane slot: the pump for all");
+        check(!sl::gate_keep(s4, 4, false, 2, true), "... and running lanes drain for it");
+        sl::Slot k1[4] = {{false, false}, {true, true}, {false, false}, {false, false}};
+        check(!sl::gate_start(k1, 4, false, 2), "one user: no start (the solo path)");
+        check(sl::gate_start(k1, 4, false, 1), "one user with STRATA_SPEC_LANES_ONE: its lane");
+        check(sl::gate_keep(k1, 4, false, 2, true), "keep: the last user's lane goes on");
+        check(!sl::gate_keep(k1, 4, false, 2, false), "STRATA_SPEC_LANES_KEEP=0: it drains (M1b)");
+        check(!sl::gate_keep(k1, 4, true, 2, true), "keep: another slot decoding drains it");
+        sl::Slot k0[4] = {};
+        check(!sl::gate_keep(k0, 4, false, 2, true), "keep: nothing left, the lanes end");
+        // M1b's gate is gate_start with n_min = L
+        sl::Slot two[2] = {{true, true}, {true, true}};
+        check(sl::gate(two, 2, false, false) == sl::gate_start(two, 2, false, 2), "gate == gate_start(L)");
+    }
+    // HOLD=k: fresh lane slots wait until k are admitted
+    {
+        check(sl::env_hold(nullptr, 4) == 0 && sl::env_hold("0", 4) == 0, "HOLD unset / 0: off");
+        check(sl::env_hold("1", 4) == 2, "HOLD=1 is M1b's (2)");
+        check(sl::env_hold("3", 4) == 3 && sl::env_hold("4", 4) == 4, "HOLD=3, 4");
+        check(sl::env_hold("4", 2) == 2, "HOLD past L: L");
+        sl::Slot h[4] = {{true, true, true}, {false, false, false}, {false, false, false}, {false, false, false}};
+        check(sl::hold(h, 4, false, 2), "one fresh, k 2: held");
+        h[1] = {true, true, true};
+        check(!sl::hold(h, 4, false, 2), "two fresh, k 2: they start");
+        check(sl::hold(h, 4, false, 3), "two fresh, k 3: held");
+        h[1].fresh = false;
+        check(!sl::hold(h, 4, false, 3), "one has decoded already: not held");
+        h[1].fresh = true;
+        check(!sl::hold(h, 4, true, 3), "another slot decodes: not held");
+        check(!sl::hold(h, 4, false, 0), "off");
+        // (review) k 2 is M1b's rule: a lone fresh lane slot waits whether or not it may run in a lane; k 3 only lane_ok
+        sl::Slot hx[4] = {{true, false, true}, {}, {}, {}};
+        check(sl::hold(hx, 4, false, 2), "k 2: a lone fresh image request held (M1b)");
+        check(!sl::hold(hx, 4, false, 3), "k 3: a slot that may not run in a lane is not held");
+        hx[0].fresh = false;
+        check(!sl::hold(hx, 4, false, 2), "k 2: not fresh: not held");
+    }
+    // the profile's defaults: STRATA_SPEC_LANES=2 alone is M1b (no sharing), 3 and 4 share
+    {
+        check(!sl::share_default(2) && sl::share_default(3) && sl::share_default(4), "share default: 3 and 4");
+        check(sl::env_flag(nullptr, true) && !sl::env_flag(nullptr, false), "flag unset: the default");
+        check(!sl::env_flag("", true) && !sl::env_flag("0", true), "flag empty / 0: off");
+        check(sl::env_flag("1", false) && sl::env_flag("2", false) && !sl::env_flag("x", true), "flag 1, 2 on; junk off");
+    }
+    // the shared arenas: what a card allocates for L lanes
+    {
+        check(sl::own_arenas(2, true, true) == 0, "M1a + 2 lanes shared: no arena of their own");
+        check(sl::own_arenas(4, true, true) == 2, "4 lanes shared: lanes 2 and 3");
+        check(sl::own_arenas(3, true, false) == 2, "3 lanes without M1a: lanes 1 and 2");
+        check(sl::own_arenas(2, false, true) == 2, "STRATA_LC_SHARE=0: one each (M1b)");
+        check(sl::own_arenas(0, true, true) == 0, "no lanes: nothing");
+        const int64_t A = 100ll << 20, S = 30ll << 20;   // production: 100 MiB arenas, 2 x 30 MiB snapshots (CUDA0)
+        check(!sl::snaps_in_lane(2, true, true, S, A), "two lanes: the snapshots keep their own");
+        check(sl::snaps_in_lane(3, true, true, S, A), "three lanes: the snapshots in lane 2's arena");
+        check(!sl::snaps_in_lane(3, false, true, S, A), "not shared: their own");
+        check(!sl::snaps_in_lane(3, true, false, S, A), "no solo pipeline: no snapshots");
+        check(!sl::snaps_in_lane(3, true, true, 60ll << 20, A), "snapshots larger than half an arena: their own");
+        check(!sl::snaps_in_lane(3, true, true, 0, A), "the last stage: none");
+        // (review) bounded by the persistent tail (argmax_rows' counter, the constant 1), not the whole arena
+        check(sl::snaps_in_lane(3, true, true, 50ll << 20, A), "2 x 50 MiB in a 100 MiB arena: fits the whole arena");
+        check(!sl::snaps_in_lane(3, true, true, 50ll << 20, A - (1ll << 20)), "but not below a tail 1 MiB from the end");
+        check(sl::snaps_in_lane(3, true, true, (50ll << 20) - 256, A - 512), "the boundary itself: fits");
+        check(!sl::snaps_in_lane(3, true, true, (50ll << 20) - 255, A - 512), "one aligned row past it: not");
+        const int64_t G = 25ll << 20;
+        check(sl::lanes_cost(2, true, true, A, G, 2 * S, A) == 2 * G, "2 lanes: their graphs only");
+        check(sl::lanes_cost(3, true, true, A, G, 2 * S, A) == A + 3 * G - 2 * S, "3 lanes: one arena, less the snapshots");
+        check(sl::lanes_cost(4, true, true, A, G, 2 * S, A) == 2 * A + 4 * G - 2 * S, "4 lanes: two arenas");
+        check(sl::lanes_cost(2, false, true, A, G, 2 * S, A) == 2 * A + 2 * G, "M1b's allocation");
+        check(sl::lanes_cost(0, true, true, A, G, 2 * S, A) == 0, "no lanes: 0");
+        // the region formula of the design: k*A + max(0, S - (k-1)*A) with k = max(1, L-1) (ver_b's arena included)
+        for (int L = 2; L <= 4; ++L) {
+            const int k = std::max(1, L - 1);
+            const int64_t region = (int64_t) k * A + std::max<int64_t>(0, 2 * S - (int64_t) (k - 1) * A);
+            const int64_t ours = A + sl::lanes_cost(L, true, true, A, 0, 2 * S, A) + 2 * S;   // ver_b + lanes + snapshots
+            check(region == ours, "the design's region formula");
+        }
+    }
+    // the boot's choice of L: the most lanes for which every card keeps the floor after the lazy allocations
+    {
+        const int64_t MiB = 1ll << 20, A = 100 * MiB, G = 25 * MiB, S = 30 * MiB;
+        // (the lane drafters load before the caches; the second verifiers, the snapshots and their graphs are made
+        // before the lanes: `free` is what is left then)
+        auto cost = [&](int i, int L) { return sl::lanes_cost(L, true, true, A, G + 3 * MiB, i < 3 ? 2 * S : 0, A - MiB); };
+        const int64_t f32[4] = {1090 * MiB, 1180 * MiB, 2050 * MiB, 1460 * MiB};   // ~production at 32K, at boot
+        const int L32 = sl::fit_lanes(4, 4, f32, 141 * MiB, 768 * MiB, cost);
+        check(L32 == 3, "32K: four asked, three fit");
+        const int64_t f28[4] = {1319 * MiB, 1394 * MiB, 2300 * MiB, 1680 * MiB};
+        check(sl::fit_lanes(4, 4, f28, 141 * MiB, 768 * MiB, cost) == 4, "28K: four fit");
+        check(sl::fit_lanes(2, 4, f28, 141 * MiB, 768 * MiB, cost) == 2, "Lmax 2: two");
+        const int64_t tiny[4] = {800 * MiB, 800 * MiB, 800 * MiB, 800 * MiB};
+        check(sl::fit_lanes(4, 4, tiny, 141 * MiB, 768 * MiB, cost) == 0, "no room: none");
+        check(sl::room_ok(1000 * MiB, 141 * MiB, 768 * MiB) && !sl::room_ok(900 * MiB, 141 * MiB, 768 * MiB), "room_ok");
+        // STRATA_LC_SHARE off (M1b's rule, generalised): 200 MiB per lane, the floor before them, nothing lazy
+        auto m1b = [&](int, int L) { return (int64_t) L * 200 * MiB; };
+        const int64_t f1168[4] = {1168 * MiB, 1300 * MiB, 2000 * MiB, 1400 * MiB};
+        check(sl::fit_lanes(2, 4, f1168, 0, 768 * MiB, m1b) == 2, "M1b: 400 + 512 + 256 = 1168 MiB free: two lanes");
+        const int64_t f1167[4] = {1167 * MiB, 1300 * MiB, 2000 * MiB, 1400 * MiB};
+        check(sl::fit_lanes(2, 4, f1167, 0, 768 * MiB, m1b) == 0, "M1b: 1167 MiB: none");
+    }
+
+    // the window size: the serial loop's rule (drafts while their probability is >= spec_min_p), the context room
+    const float pr[3] = {0.9f, 0.6f, 0.4f};
+    check(sl::window_size(pr, 3, 4, 0.5, 1000) == 3, "min_p 0.5: two drafts");
+    check(sl::window_size(pr, 3, 4, 0.0, 1000) == 4, "min_p 0: all three drafts");
+    check(sl::window_size(pr, 3, 4, 0.95, 1000) == 1, "first draft below min_p: one row");
+    check(sl::window_size(pr, 1, 4, 0.0, 1000) == 2, "only one draft available");
+    check(sl::window_size(pr, 3, 4, 0.0, 2) == 2, "two cells of context left");
+    check(sl::window_size(pr, 3, 2, 0.0, 1000) == 2, "--mtp-max-t 2");
+    check(sl::window_size(pr, 0, 4, 0.0, 1000) == 1, "no drafts: one row");
+
+    auto never = [](int32_t) { return false; };
+    auto eos7 = [](int32_t y) { return y == 7; };
+    {   // all drafts accepted: every pick goes out, every row is kept
+        const int32_t tok[4] = {10, 11, 12, 13}, out[4] = {11, 12, 13, 14};
+        const sl::Verdict v = sl::verdict(tok, out, 4, 100, 5, 1000, false, 4096, never);
+        check(v.a == 3 && v.emit == 4 && v.commit == 4 && v.fin == nullptr, "all accepted");
+    }
+    {   // the second draft rejected: picks 0 and 1 go out (the second is the correction), rows 0 and 1 kept
+        const int32_t tok[4] = {10, 11, 99, 13}, out[4] = {11, 12, 13, 14};
+        const sl::Verdict v = sl::verdict(tok, out, 4, 100, 5, 1000, false, 4096, never);
+        check(v.a == 1 && v.emit == 2 && v.commit == 2 && v.fin == nullptr, "one accepted");
+    }
+    {   // an end token inside the accepted run: it goes out, the slot ends, the rows after it are not kept
+        const int32_t tok[4] = {10, 11, 7, 13}, out[4] = {11, 7, 13, 14};
+        const sl::Verdict v = sl::verdict(tok, out, 4, 100, 5, 1000, false, 4096, eos7);
+        check(v.a == 3 && v.emit == 2 && v.commit == 2 && v.fin != nullptr && std::strcmp(v.fin, "stop") == 0,
+              "end token at pick 1");
+    }
+    {   // max_new reached inside the window
+        const int32_t tok[4] = {10, 11, 12, 13}, out[4] = {11, 12, 13, 14};
+        const sl::Verdict v = sl::verdict(tok, out, 4, 100, 8, 10, false, 4096, never);
+        check(v.emit == 2 && v.commit == 2 && v.fin != nullptr && std::strcmp(v.fin, "length") == 0, "max_new at pick 1");
+    }
+    {   // BSTOP: the first pick goes out, then the slot ends (the pump's rule)
+        const int32_t tok[4] = {10, 11, 12, 13}, out[4] = {11, 12, 13, 14};
+        const sl::Verdict v = sl::verdict(tok, out, 4, 100, 5, 1000, true, 4096, never);
+        check(v.emit == 1 && v.commit == 1 && v.fin != nullptr && std::strcmp(v.fin, "cancel") == 0, "stop at pick 0");
+    }
+    {   // the context: the pump ends a slot once its fed token's position + 2 passes max_context (a window that just
+        // fits, positions 100..102 of 103: the third pick is the last)
+        const int32_t tok[3] = {10, 11, 12}, out[3] = {11, 12, 13};
+        const sl::Verdict v = sl::verdict(tok, out, 3, 100, 5, 1000, false, 103, never);
+        check(v.emit == 3 && v.commit == 3 && v.fin != nullptr && std::strcmp(v.fin, "length") == 0, "context end");
+        const sl::Verdict w = sl::verdict(tok, out, 3, 100, 5, 1000, false, 104, never);
+        check(w.emit == 3 && w.fin == nullptr, "one cell more: it goes on");
+    }
+    {   // a one-row window
+        const int32_t tok[1] = {10}, out[1] = {11};
+        const sl::Verdict v = sl::verdict(tok, out, 1, 100, 5, 1000, false, 4096, never);
+        check(v.a == 0 && v.emit == 1 && v.commit == 1 && v.fin == nullptr, "one row");
+    }
+
+    if (failures == 0) std::printf("spec_lanes_test: all checks passed\n");
+    return failures == 0 ? 0 : 1;
+}
