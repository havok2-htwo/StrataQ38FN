+// include/strata/program/read_yield.hpp - STRATA_READ_YIELD: where a batch prompt read may give way to a waiting
+// request, and into which slot (header-only: it is arithmetic).
+//
+// A long prompt read in progress stops at a chunk boundary q when the server sends `BYIELD <slot>` (a short request
+// waits behind it): the part read so far, [0, q), is copied into that slot, the request ends with `YIELDED <slot> q`,
+// and the server sends it again once the short requests are in.  The read then goes on from q in the same chunks
+// (q lies on the grid of the segment it was in), so every token and every slot's state is the one the read without
+// the stop gives; only the timing changes.  generate.cpp decides with these rules; tests/program/read_yield_test.cpp
+// checks them without a GPU.
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdlib>
+#include <utility>
+#include <vector>
+
+namespace strata::program::read_yield {
+
+/// An on/off switch: set, not empty and not starting with '0'.
+inline bool env_on(const char* v) { return v != nullptr && v[0] != '\0' && v[0] != '0'; }
+
+/// A count from the environment (STRATA_READ_YIELD_TEST_AT): unset, empty, negative or not a number: 0.
+inline int64_t env_count(const char* v) {
+    if (v == nullptr || v[0] == '\0') return 0;
+    char* end = nullptr;
+    const long long n = std::strtoll(v, &end, 10);
+    if (end == v || *end != '\0' || n <= 0) return 0;
+    return (int64_t) n;
+}
+
+/// The position rule: the read of segment [a0, b0) in chunks of `chunk` may stop at q.  q must be a chunk boundary
+/// inside the segment, past its first chunk, and the rest [q, b0) must be more than a chunk (a one-chunk run takes the
+/// prompt path's single-chunk way, which a run of more chunks does not) and more than a short read (the rest of a
+/// segment that short would go through the verify windows instead: another path, so another result).
+/// `test_at` (STRATA_READ_YIELD_TEST_AT, a test knob): only from the segment's chunk `test_at` on (0: any).
+inline bool pos_ok(int64_t q, int64_t a0, int64_t b0, int64_t chunk, int64_t short_read, int64_t test_at = 0) {
+    chunk = std::max<int64_t>(chunk, 1);
+    if (q <= a0 || q >= b0 || (q - a0) % chunk != 0) return false;
+    if (b0 - q <= std::max(chunk, short_read)) return false;
+    return test_at <= 0 || (q - a0) / chunk >= test_at;
+}
+
+/// Which slots a yielded read may wait in: slot b with b % k == k - 1 (k = 1: any).  The pipelined groups (--batch
+/// in G groups of k = batch / G slots) run a group's window over its slots up to its last active one, and each idle
+/// slot below that row gets a pad row that writes the slot's state (token 0 at position 0).  Only the top row of a
+/// group is never below an active slot of its group, so only there does the part read so far stay until the read goes
+/// on.  The serial windows (no groups) touch active slots only: any slot.
+inline int yield_row(bool piped, int batch, int groups) {
+    if (!piped || batch <= 0 || groups <= 1 || batch % groups != 0) return 1;
+    return batch / groups;
+}
+inline bool slot_pad_safe(int slot, int k) { return slot >= 0 && (k <= 1 || slot % k == k - 1); }
+
+/// The resumed read's cuts (the turn boundary, the tail-role turn, the message boundary) are searched from where the
+/// FIRST part resumed (`resume0`), not from where the read stopped: the same cuts as the read without the stop, so the
+/// segments after q and the checkpoints at them are the same (a cut at or below q is skipped, its checkpoint came
+/// along with the slot).  resume0 < 0: no yielded read.
+inline int64_t cut_from(int64_t resume, int64_t resume0) {
+    return resume0 >= 0 && resume0 < resume ? resume0 : resume;
+}
+
+/// The slot a resumed read goes on from (the pin): the slot the server names with `yslot=<b>` on the resumed BGEN (a
+/// free top-row slot it reserved for the pause, so the request itself decodes in any slot), else the admission's own
+/// slot.  It is taken only while it still holds this read's paused part: idle, cached, `partial` from a yield
+/// (partial_next_check >= 0), shorter than the prompt and `usable` (its tokens start the prompt, same control vector,
+/// not tainted).  A pinned slot wins over every other source - a main-session checkpoint at exactly q, a longer
+/// checkpoint of a sibling slot, the RAM cache or the SSD tier - because only it carries the read's checkpoint progress
+/// and cut origin; another source would read the rest on another grid.  -1: no pin (the usual source search).
+template <class Slot, class Usable>
+inline int pin_slot(const std::vector<Slot>& slots, int yslot, int admit_slot, int64_t n, Usable&& usable) {
+    const int b = yslot >= 0 ? yslot : admit_slot;
+    if (b < 0 || b >= (int) slots.size()) return -1;
+    const Slot& s = slots[(size_t) b];
+    if (s.active || !s.cached || !s.partial || s.partial_next_check < 0 || s.ids.empty() || (int64_t) s.ids.size() >= n)
+        return -1;
+    return usable(s) ? b : -1;
+}
+
+/// The chunks a run over [a0, b0) reads (host model of the prompt path's loop: c0 = a0, a0 + C, ...).
+inline std::vector<std::pair<int64_t, int64_t>> chunks(int64_t a0, int64_t b0, int64_t chunk) {
+    std::vector<std::pair<int64_t, int64_t>> v;
+    chunk = std::max<int64_t>(chunk, 1);
+    for (int64_t c = a0; c < b0; c += chunk) v.emplace_back(c, std::min(b0, c + chunk));
+    return v;
+}
+
+/// The periodic checkpoint positions a read of [from, to) takes (host model of on_chunk's rule: after a chunk that
+/// reaches next_check, the next is done + every).  `next_check`: the first position due.  Returns the positions and
+/// leaves next_check at the next one due (what a yielded read carries over to its resume).
+inline std::vector<int64_t> periodic_checks(const std::vector<std::pair<int64_t, int64_t>>& read, int64_t every,
+                                            int64_t& next_check) {
+    std::vector<int64_t> v;
+    if (every <= 0) return v;
+    for (const auto& c : read)
+        if (c.second >= next_check) {
+            v.push_back(c.second);
+            next_check = c.second + every;
+        }
+    return v;
+}
+
+}  // namespace strata::program::read_yield
