diff --git a/tests/program/read_yield_test.cpp b/tests/program/read_yield_test.cpp
new file mode 100644
index 00000000..def3fc3c
--- /dev/null
+++ b/tests/program/read_yield_test.cpp
@@ -0,0 +1,190 @@
+// read_yield: where a batch prompt read may give way and into which slot, and that the read after the stop reads the
+// same chunks, takes the same periodic checkpoints and cuts the same segments (synthetic: no model, no GPU).
+#include "strata/program/message_boundary.hpp"
+#include "strata/program/read_yield.hpp"
+
+#include <cstdio>
+#include <utility>
+#include <vector>
+
+namespace ry = strata::program::read_yield;
+
+static int fails = 0;
+#define CHECK(c) do { if (!(c)) { std::printf("FAIL %s:%d %s\n", __FILE__, __LINE__, #c); ++fails; } } while (0)
+
+// the pipelined groups' pad rows (generate.cpp's pump): a group starts at the width of its last active slot, and
+// every idle slot below that width gets a pad row.  true: slot b would be written by a window of its group
+static bool padded(const std::vector<bool>& active, int k, int b) {
+    const int g0 = b - b % k;
+    int width = 0;
+    for (int t = 0; t < k; ++t)
+        if (active[(size_t) (g0 + t)]) width = t + 1;
+    return !active[(size_t) b] && b - g0 < width;
+}
+
+int main() {
+    // ---- switches
+    CHECK(!ry::env_on(nullptr) && !ry::env_on("") && !ry::env_on("0") && ry::env_on("1") && ry::env_on("yes"));
+    CHECK(ry::env_count(nullptr) == 0 && ry::env_count("") == 0 && ry::env_count("x") == 0 && ry::env_count("-3") == 0);
+    CHECK(ry::env_count("3") == 3 && ry::env_count("12a") == 0);
+
+    // ---- the position rule
+    const int64_t C = 512;
+    CHECK(!ry::pos_ok(0, 0, 100000, C, 64));             // never before the first chunk
+    CHECK(ry::pos_ok(512, 0, 100000, C, 64));
+    CHECK(!ry::pos_ok(700, 0, 100000, C, 64));           // not a chunk boundary
+    CHECK(ry::pos_ok(8192 + 1024, 8192, 100000, C, 64)); // the grid is the segment's (it starts at its cut)
+    CHECK(!ry::pos_ok(8192 + 1000, 8192, 100000, C, 64));
+    // the rest must be more than a chunk and more than a short read
+    CHECK(!ry::pos_ok(99840, 0, 100000, C, 64));         // 160 left
+    CHECK(!ry::pos_ok(99840, 0, 100352, C, 64));         // exactly one chunk left: the single-chunk path
+    CHECK(ry::pos_ok(99328, 0, 100352, C, 64));          // two chunks left
+    CHECK(!ry::pos_ok(99328, 0, 100352, C, 1536));       // ... but a short read of 1536 would take that rest
+    CHECK(!ry::pos_ok(100352, 0, 100352, C, 64));        // the end is no stop
+    // STRATA_READ_YIELD_TEST_AT=k: only from chunk k of the segment on
+    CHECK(!ry::pos_ok(1024, 0, 100000, C, 64, 3) && ry::pos_ok(1536, 0, 100000, C, 64, 3));
+    CHECK(ry::pos_ok(8192 + 1536, 8192, 100000, C, 64, 3) && !ry::pos_ok(8192 + 1024, 8192, 100000, C, 64, 3));
+    CHECK(ry::pos_ok(512, 0, 100000, 0, 0));             // (a degenerate chunk counts as 1)
+
+    // ---- the read after the stop reads the chunks the read without it reads, for every allowed stop
+    for (int64_t a0 : {0, 8192, 12345})
+        for (int64_t len : {2048, 5000, 100000, 131071}) {
+            const int64_t b0 = a0 + len;
+            const auto whole = ry::chunks(a0, b0, C);
+            for (int64_t q = a0; q <= b0; ++q) {
+                if (!ry::pos_ok(q, a0, b0, C, 64)) continue;
+                auto split = ry::chunks(a0, q, C);
+                const auto rest = ry::chunks(q, b0, C);
+                CHECK(rest.size() >= 2);                  // never the single-chunk way
+                split.insert(split.end(), rest.begin(), rest.end());
+                CHECK(split == whole);
+            }
+        }
+    // two stops in one read (STRATA_YIELDS_MAX=2): still the same chunks
+    {
+        const int64_t a0 = 4096, b0 = 4096 + 60000;
+        auto v = ry::chunks(a0, a0 + 10 * C, C);
+        CHECK(ry::pos_ok(a0 + 10 * C, a0, b0, C, 64));
+        const auto mid = ry::chunks(a0 + 10 * C, a0 + 30 * C, C);
+        CHECK(ry::pos_ok(a0 + 30 * C, a0 + 10 * C, b0, C, 64));   // the resumed run's own segment start
+        CHECK(ry::pos_ok(a0 + 30 * C, a0, b0, C, 64));            // ... is on the original grid too
+        const auto end = ry::chunks(a0 + 30 * C, b0, C);
+        v.insert(v.end(), mid.begin(), mid.end());
+        v.insert(v.end(), end.begin(), end.end());
+        CHECK(v == ry::chunks(a0, b0, C));
+    }
+
+    // ---- periodic checkpoints: carried over (BSlot::partial_next_check) they land where the read without the stop
+    // puts them; restarted from the stop (resume + every) they would not
+    {
+        const int64_t a0 = 3000, b0 = 3000 + 70000, every = 16384;
+        int64_t nc = a0 + every;
+        const auto ref = ry::periodic_checks(ry::chunks(a0, b0, C), every, nc);
+        for (int64_t q = a0 + C; q < b0; q += 7 * C) {
+            if (!ry::pos_ok(q, a0, b0, C, 64)) continue;
+            int64_t carry = a0 + every;
+            auto got = ry::periodic_checks(ry::chunks(a0, q, C), every, carry);
+            const auto after = ry::periodic_checks(ry::chunks(q, b0, C), every, carry);
+            got.insert(got.end(), after.begin(), after.end());
+            CHECK(got == ref);
+        }
+        // the restart rule moves them (why the carry is needed)
+        const int64_t q = a0 + 20 * C;
+        int64_t restart = q + every, nc1 = a0 + every;
+        auto moved = ry::periodic_checks(ry::chunks(a0, q, C), every, nc1);
+        const auto after = ry::periodic_checks(ry::chunks(q, b0, C), every, restart);
+        moved.insert(moved.end(), after.begin(), after.end());
+        CHECK(moved != ref);
+    }
+
+    // ---- the cuts after the stop: searched from the first part's resume, the same as without the stop
+    {
+        const int64_t turn = 7;
+        std::vector<int64_t> ids(40000, 1);
+        ids[9000] = turn;    // the system prompt's end (root)
+        ids[30000] = turn;   // the last message's start
+        ids[30500] = turn;   // the new turn's header (turn_at)
+        auto turn_at_from = [&](int64_t r) {
+            for (int64_t i = (int64_t) ids.size() - 1; i > r; --i)
+                if (ids[(size_t) i] == turn) return i;
+            return (int64_t) -1;
+        };
+        const int64_t resume0 = 0;
+        const int64_t t0 = turn_at_from(resume0);
+        const auto m0 = strata::program::message_cut(ids, resume0, t0, turn, true, false, false, 8192);
+        CHECK(t0 == 30500 && m0.at == 30000);
+        // a stop inside [9000, 30000): the message cut and the turn cut are still ahead, found either way
+        for (int64_t q : {int64_t(9000 + 2 * C), int64_t(29000)}) {
+            const int64_t cr = ry::cut_from(q, resume0);
+            CHECK(cr == resume0);
+            CHECK(turn_at_from(cr) == t0);
+            CHECK(strata::program::message_cut(ids, cr, turn_at_from(cr), turn, true, false, false, 8192).at == m0.at);
+        }
+        // a stop past the message cut (in [30000, 30500) no stop fits; the last segment is [30500, n - 1)): from
+        // the stop itself the turn would be missed, from resume0 it is the same, and the read loop skips it (at or
+        // below where the read goes on: its checkpoint came along with the slot)
+        const int64_t q = 30500 + 4 * C;
+        CHECK(turn_at_from(q) == -1);
+        CHECK(turn_at_from(ry::cut_from(q, resume0)) == t0);
+        CHECK(ry::cut_from(q, -1) == q);   // no yielded read: as before
+        CHECK(ry::cut_from(100, 200) == 100);
+    }
+
+    // ---- the slots a yielded read may wait in: no pad row ever writes them
+    CHECK(ry::yield_row(false, 16, 4) == 1 && ry::yield_row(true, 16, 1) == 1 && ry::yield_row(true, 16, 4) == 4);
+    CHECK(ry::yield_row(true, 16, 3) == 1 && ry::yield_row(true, 0, 4) == 1 && ry::yield_row(true, 16, 2) == 8);
+    CHECK(ry::slot_pad_safe(3, 4) && ry::slot_pad_safe(15, 4) && !ry::slot_pad_safe(2, 4) && !ry::slot_pad_safe(0, 4));
+    CHECK(ry::slot_pad_safe(0, 1) && ry::slot_pad_safe(5, 1) && !ry::slot_pad_safe(-1, 1));
+    // every pattern of active slots in 4 groups of 4: a pad-safe idle slot is never padded; every other row is
+    // padded by some pattern (the review's finding: the protection is the row, not a flag)
+    {
+        const int k = 4, B = 16;
+        std::vector<bool> reachable(B, false);
+        for (int mask = 0; mask < (1 << B); ++mask) {
+            std::vector<bool> act(B);
+            for (int b = 0; b < B; ++b) act[(size_t) b] = (mask >> b) & 1;
+            for (int b = 0; b < B; ++b)
+                if (padded(act, k, b)) {
+                    reachable[(size_t) b] = true;
+                    CHECK(!ry::slot_pad_safe(b, k));
+                }
+        }
+        for (int b = 0; b < B; ++b) CHECK(reachable[(size_t) b] == !ry::slot_pad_safe(b, k));
+    }
+
+    // ---- the pin: a resumed read goes on from the slot that holds its paused part, named by yslot= (a reserved top-row
+    // slot, the request decoding elsewhere) or its own admission slot - and only while that slot still holds it
+    {
+        struct S {
+            bool active = false, cached = false, partial = false;
+            int64_t partial_next_check = -1;
+            std::vector<int32_t> ids;
+        };
+        std::vector<S> sl(16);
+        const int64_t n = 100000;
+        auto paused = [](S& s, int64_t q) {
+            s.cached = s.partial = true;
+            s.partial_next_check = 16384;
+            s.ids.assign((size_t) q, 1);
+        };
+        auto ok = [](const S&) { return true; };
+        paused(sl[3], 30720);
+        CHECK(ry::pin_slot(sl, 3, 0, n, ok) == 3);    // yslot=3, admitted to lane slot 0
+        CHECK(ry::pin_slot(sl, -1, 3, n, ok) == 3);   // its own slot (no yslot)
+        CHECK(ry::pin_slot(sl, -1, 0, n, ok) == -1);  // slot 0 holds nothing paused: the usual search
+        CHECK(ry::pin_slot(sl, 3, 0, n, [](const S&) { return false; }) == -1);   // not a start of this prompt
+        CHECK(ry::pin_slot(sl, 3, 0, 30720, ok) == -1);   // the whole prompt: nothing left to read
+        CHECK(ry::pin_slot(sl, 99, 0, n, ok) == -1 && ry::pin_slot(sl, -1, -1, n, ok) == -1);
+        sl[3].active = true;
+        CHECK(ry::pin_slot(sl, 3, 0, n, ok) == -1);
+        sl[3].active = false;
+        sl[3].partial_next_check = -1;                 // a #656 part (no yield carry-over): not pinned
+        CHECK(ry::pin_slot(sl, 3, 0, n, ok) == -1);
+        sl[3].partial_next_check = 16384;
+        sl[3].partial = false;                         // taken back already (resumed once)
+        CHECK(ry::pin_slot(sl, 3, 0, n, ok) == -1);
+    }
+
+    if (fails == 0) std::printf("read_yield_test: ok\n");
+    return fails == 0 ? 0 : 1;
+}
