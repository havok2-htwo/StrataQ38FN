+bool Verifier::poison_arena(cudaStream_t s, int byte, std::string& err) {
+    if (arena_ == nullptr) return true;
+    const OnDevice on_device(device_);
+    uint8_t* const a = (uint8_t*) arena_;
+    uint8_t* const keep0 = arg_scratch_;           // argmax_rows' scratch, then one_ (carve: adjacent, in this order)
+    uint8_t* const keep1 = (uint8_t*) hist_snap_;  // the buffer carved after one_
+    if (!strata::core::arena_carve::keep_range_ok(a, arena_bytes_, keep0, (const uint8_t*) one_, keep1)) {
+        err = "verify: poison: the carve is not the one poison_arena knows";
+        return false;
+    }
+    if (cudaMemsetAsync(a, byte & 0xff, (size_t) (keep0 - a), s) != cudaSuccess ||
+        cudaMemsetAsync(keep1, byte & 0xff, (size_t) (a + arena_bytes_ - keep1), s) != cudaSuccess) {
+        (void) cudaGetLastError();
+        err = "verify: poison: a fill failed";
+        return false;
+    }
+    return true;
+}
