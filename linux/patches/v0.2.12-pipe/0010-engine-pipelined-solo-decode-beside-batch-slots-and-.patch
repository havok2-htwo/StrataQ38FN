+    static const bool on[2] = {
+        strata::program::solo_pipeline::env_on_with_lanes(std::getenv("STRATA_SOLO_PIPELINE"), 0),
+        strata::program::solo_pipeline::env_on_with_lanes(std::getenv("STRATA_SOLO_PIPELINE"), spec_lanes_env())};
+    return on[lanes_may ? 1 : 0];
+}
+// STRATA_LC_SHARE (with STRATA_SPEC_LANES; read once): the shared-VRAM profile - lane 0 carves the stage's main
+// verifier's arena, lane 1 the solo pipeline's second verifier's, the solo pipeline's GDN snapshots move into lane 2's;
+// the lanes keep running while one lane slot decodes (STRATA_SPEC_LANES_KEEP), the solo pipeline's graphs are captured
+// at boot, the lanes' graphs go up to the MTP's window, and the boot's rule counts what is left after the lanes.
+// Default (review): on for STRATA_SPEC_LANES=3 and 4, off for 2 - then every lane verifier has an arena of its own and
+// the rest is M1b's as deployed (KEEP=0, M1b's boot rule, the solo pipeline's graphs at its first request), so
+// STRATA_SPEC_LANES=2 alone stays M1b.  STRATA_LC_SHARE=1 / =0 says so for any N.
+bool lc_share_env() {
