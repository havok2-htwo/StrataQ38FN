+bool Verifier::has_batch_layout(int base, int S) const {
+    if (S < 1 || S > strata::kernels::kVerifyMaxT) return false;
+    int rows[strata::kernels::kVerifyMaxT] = {};
+    for (int t = 0; t < S; ++t) rows[t] = base + t;
+    return layout_captured(bkey(rows, S, base));
+}
+
+bool Verifier::layout_captured(const std::vector<int>& key) const {
+    const auto e = exec_bm_.find(key);   // (find: a failed capture leaves a null entry)
+    const auto c = commit_bm_.find(key);
+    if (key.size() >= 3 && batch_self_commits(key.data() + 1, (int) key.size() - 2))   // [hbase, rows.., ar_off_]
+        return e != exec_bm_.end() && e->second != nullptr;   // the window keeps its rows: no commit graph
+    return e != exec_bm_.end() && e->second != nullptr && c != commit_bm_.end() && c->second != nullptr;
+}
+
+// The captures stage_batch makes on a layout's first window, made ahead (the graphs are the same: record_window reads
+// only what is fixed while nothing runs - the slots' sessions, the table's verdict, the PLE setup).  The commit graph
+// is uploaded too, so its first launch does not.  Both graphs, always: STRATA_PIPED_MTP's deferred commits (no commit
+// graph, staging_deferred_) never reach this (the overlap gate refuses it).
+bool Verifier::ensure_batch_layouts(int GS, int groups, int& captured, std::string& err, const std::vector<int>* narrow) {
+    const OnDevice on_device(device_);
+    captured = 0;
+    if (g_ == nullptr || slots_.empty()) { err = "verify: batch layouts before init_slots"; return false; }
+    if (released_.load()) { err = "verify: an earlier window never finished on the GPU (#267); restart the engine"; return false; }
+    if (GS < 1 || GS > max_t_ || GS > strata::kernels::kVerifyMaxT || groups < 1 || groups * GS > (int) slots_.size()) {
+        err = "verify: batch layouts out of range";
+        return false;
+    }
+    refresh_ar();
+    // the narrower ones first, each one held marked as used too: an LRU limit evicts none of them here, and the full
+    // widths, which must be kept, last of all
+    std::vector<std::pair<int, int>> want;   // (base, S)
+    if (narrow != nullptr)
+        for (int gi = 0; gi < groups && gi < (int) narrow->size(); ++gi)
+            for (int S = 1; S <= std::min((*narrow)[(size_t) gi], GS - 1); ++S) want.emplace_back(gi * GS, S);
+    for (int gi = 0; gi < groups; ++gi) want.emplace_back(gi * GS, GS);
+    for (const auto& [base, S] : want) {
+        int rows[strata::kernels::kVerifyMaxT] = {};
+        for (int t = 0; t < S; ++t) rows[t] = base + t;
+        const auto key = bkey(rows, S, base);
+        if (layout_captured(key)) {
+            bm_used_[key] = ++bm_tick_;
+            continue;
+        }
+        bool evicted = false;
+        if (batch_graph_limit_ > 0 && exec_bm_.find(key) == exec_bm_.end() && exec_bm_.size() >= batch_graph_limit_ &&
+            !evict_batch_graph(key, evicted, err))
+            return false;
+        bm_used_[key] = ++bm_tick_;
+        if (!capture_batch(rows, S, base, err) || !capture_commit_batch(rows, S, base, err)) return false;
+        if (!batch_self_commits(rows, S)) cudaGraphUpload(commit_bm_[key], cs_);
+        ++captured;
+    }
+    if (captured > 0 && cudaStreamSynchronize(cs_) != cudaSuccess) {
+        err = std::string("verify: batch layouts: ") + cudaGetErrorString(cudaGetLastError());
+        return false;
+    }
+    for (int gi = 0; gi < groups; ++gi)   // a later capture may have evicted an earlier one (no VRAM)
+        if (!has_batch_layout(gi * GS, GS)) {
+            err = "verify: the batch layout over slots " + std::to_string(gi * GS) + ".." + std::to_string(gi * GS + GS - 1) +
+                  " could not be kept";
+            return false;
+        }
+    return true;
+}
