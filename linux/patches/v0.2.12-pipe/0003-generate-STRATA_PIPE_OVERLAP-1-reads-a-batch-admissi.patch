+// STRATA_PIPE_OVERLAP=1 (read once; off by default)
+bool pipe_overlap_env() {
+    static const bool on = kPipeOverlapBuild && [] {
+        const char* v = std::getenv("STRATA_PIPE_OVERLAP");
+        return v && v[0] != '0';
+    }();
+    return on;
