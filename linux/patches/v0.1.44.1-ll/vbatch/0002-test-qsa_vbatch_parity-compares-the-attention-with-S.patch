   endif()
   # the QSA selection (block scores on the warp kernel and the tensor-core one, top-k): a GPU bench with a
   # scorer-vs-scorer comparison and an FP64 accuracy gate (synthetic, no model); the ctest runs a 32K context under a
diff --git a/src/kernels/qsa_vbatch_parity.cpp b/src/kernels/qsa_vbatch_parity.cpp
new file mode 100644
index 00000000..d1494baf
--- /dev/null
+++ b/src/kernels/qsa_vbatch_parity.cpp
@@ -0,0 +1,241 @@
+// src/kernels/qsa_vbatch_parity.cpp - STRATA_ATTN_VBATCH: the decode attention's value loop with the V loads of 8
+// (and 4) cells issued together against the plain one-cell loop, through all three launchers (qsa_decode_attn_batch,
+// qsa_decode_attn_slots, qsa_decode_attn_step), switched in one process with qsa_decode_attn_set_vbatch.  KV formats
+// fp16, int8, q4_0 and int8-K/q4_0-V; 1/2/4/8 rows; contexts from 1 cell to past the selection width, so every chunk
+// tail length the groups of 8 leave (n_here 1, 3, 7, 8, 9, 37, 63, 64) runs; non-resident pages (page -1, masked
+// cells) at the start, middle and end of a group, a whole group masked and a masked tail, so the batched loop's
+// fall-back to the scalar one runs.  The attention output and the per-chunk partials (acc, max, sum) must be bitwise
+// identical.  Synthetic data, no model.  Run it once more with STRATA_ATTN_LANECELL=1 for the lane-cell kernels.
+#include "strata/kernels/kv_q4.hpp"
+#include "strata/kernels/kv_q8.hpp"
+#include "strata/kernels/qsa.hpp"
+#include "strata/kernels/qsa_decode_attn.hpp"
+
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <numeric>
+#include <random>
+#include <vector>
+
+namespace k = strata::kernels;
+namespace {
+
+void ck(cudaError_t e) {
+    if (e != cudaSuccess) {
+        std::fprintf(stderr, "CUDA: %s\n", cudaGetErrorString(e));
+        std::exit(2);
+    }
+}
+template <typename T> T* up(const std::vector<T>& h) {
+    T* d = nullptr;
+    ck(cudaMalloc(&d, h.size() * sizeof(T)));
+    ck(cudaMemcpy(d, h.data(), h.size() * sizeof(T), cudaMemcpyHostToDevice));
+    return d;
+}
+template <typename T> std::vector<T> down(const T* d, size_t n) {
+    std::vector<T> h(n);
+    ck(cudaMemcpy(h.data(), d, n * sizeof(T), cudaMemcpyDeviceToHost));
+    return h;
+}
+// a finite fp16 of magnitude 2^-5 .. 2^2
+uint16_t rnd_half(std::mt19937& r) {
+    const uint32_t x = r();
+    return (uint16_t) (((x & 1u) << 15) | ((10u + (x >> 1) % 7u) << 10) | ((x >> 4) & 0x3ffu));
+}
+
+constexpr int64_t kPhysPages = 4096;   // pool pages per slot; a longer context's page table maps onto them
+constexpr int kMaxRows = k::kQsaAttnMaxSlots;
+
+struct Pools {
+    void* bufs[4] = {};
+    k::QsaAttnPools pools;
+};
+
+Pools make_pools(int fmt, const k::QsaShapes& s, std::mt19937& r) {
+    Pools pl;
+    const size_t rows = (size_t) (kPhysPages * s.n_head_kv * s.page_size), hd = (size_t) s.head_dim;
+    auto halves = [&](size_t n) { std::vector<uint16_t> h(n); for (auto& v : h) v = rnd_half(r); return h; };
+    auto codes = [&](size_t n) { std::vector<int8_t> h(n); for (auto& v : h) v = (int8_t) (r() & 0xff); return h; };
+    auto q4 = [&](size_t n_rows) {
+        std::vector<uint8_t> h(n_rows * (size_t) k::kv_q4_bytes_per_head((int) hd));
+        k::block_q4_0* b = reinterpret_cast<k::block_q4_0*>(h.data());
+        for (size_t i = 0; i < h.size() / sizeof(k::block_q4_0); ++i) {
+            b[i].d = rnd_half(r);
+            for (auto& q : b[i].qs) q = (uint8_t) (r() & 0xff);
+        }
+        return h;
+    };
+    if (fmt == 0) {
+        pl.pools.k_pool = (const uint16_t*) (pl.bufs[0] = up(halves(rows * hd)));
+        pl.pools.v_pool = (const uint16_t*) (pl.bufs[1] = up(halves(rows * hd)));
+    } else if (fmt == 1 || fmt == 3) {
+        pl.pools.k_q = (const int8_t*) (pl.bufs[0] = up(codes(rows * hd)));
+        pl.pools.k_scale = (const uint16_t*) (pl.bufs[1] = up(halves(rows * hd / k::KV_Q8_GROUP)));
+        if (fmt == 1) {
+            pl.pools.v_q = (const int8_t*) (pl.bufs[2] = up(codes(rows * hd)));
+            pl.pools.v_scale = (const uint16_t*) (pl.bufs[3] = up(halves(rows * hd / k::KV_Q8_GROUP)));
+        } else {
+            pl.pools.v_q4 = (const uint8_t*) (pl.bufs[2] = up(q4(rows)));
+        }
+    } else {
+        pl.pools.k_q4 = (const uint8_t*) (pl.bufs[0] = up(q4(rows)));
+        pl.pools.v_q4 = (const uint8_t*) (pl.bufs[1] = up(q4(rows)));
+    }
+    return pl;
+}
+
+enum Result { kPass, kFail, kSkip };
+
+// one launcher's outputs with the switch off, at 8 cells and at 4
+constexpr int kVariants = 3;
+constexpr int kCells[kVariants] = {0, 8, 4};
+struct Out {
+    float *scratch[kVariants] = {}, *attn[kVariants] = {};
+};
+
+// one case: `m` rows, KV format `fmt`, contexts `ctx[i]`, each row with its own selection and page table (masked
+// pages per `mask`); the rows' pools are `pools[i]` (the batch and step launchers use pools[0] for every row)
+Result check(int fmt, int m, const int64_t* ctx, bool mask, const Pools* pools, uint32_t seed) {
+    const k::QsaShapes s = k::qsa_real_shapes();
+    const int64_t cap = k::qsa_selection_width(k::kTopkMaxCells, s);
+    const int64_t NH = s.n_head, HD = s.head_dim;
+    const int64_t sf = (int64_t) k::qsa_decode_attn_scratch_floats(cap, s);
+    std::mt19937 r(seed);
+    std::normal_distribution<float> nd(0.f, 1.f);
+    std::vector<float> qcur((size_t) (m * NH * HD));
+    for (auto& v : qcur) v = nd(r);
+    std::vector<int32_t> steps((size_t) (m * k::kStepCount)), ids((size_t) (m * cap), 0);
+    std::vector<int32_t*> d_pt((size_t) m);
+    for (int t = 0; t < m; ++t) {
+        k::qsa_step_fill(steps.data() + t * k::kStepCount, ctx[t] - 1, s);
+        const int64_t w = steps[(size_t) (t * k::kStepCount + k::kStepWidth)];
+        // the selection: ascending cells, every cell below the width, else a random w of the context
+        int32_t* id = ids.data() + t * cap;
+        if (w == ctx[t]) {
+            std::iota(id, id + w, 0);
+        } else {
+            std::vector<int32_t> all((size_t) ctx[t]);
+            std::iota(all.begin(), all.end(), 0);
+            std::shuffle(all.begin(), all.end(), r);
+            std::sort(all.begin(), all.begin() + w);
+            std::copy(all.begin(), all.begin() + w, id);
+        }
+        const int64_t pages = (ctx[t] + s.page_size - 1) / s.page_size;
+        std::vector<int32_t> pt((size_t) pages);
+        for (auto& p : pt) p = (int32_t) (r() % (uint32_t) kPhysPages);
+        if (mask) {
+            // selection positions whose page is made non-resident: a group's first, middle and last cell, a whole
+            // group (128..135), a chunk tail (2048..2050) and the last cell; a page holds neighbours too
+            for (int64_t pos : {0, 13, 23, 71, 128, 129, 130, 131, 132, 133, 134, 135, 1000, 2048, 2050})
+                if (pos < w) pt[(size_t) (id[pos] / s.page_size)] = -1;
+            if (w > 0) pt[(size_t) (id[w - 1] / s.page_size)] = -1;
+            for (int i = 0; i < 3; ++i) pt[(size_t) (r() % (uint32_t) pages)] = -1;
+        }
+        d_pt[(size_t) t] = up(pt);
+    }
+    float* d_q = up(qcur);
+    int32_t* d_ids = up(ids);
+    int32_t* d_steps = up(steps);
+    k::QsaAttnPools p0 = pools[0].pools;   // the batch launcher's one pool set, with row 0's page table
+    p0.page_table = d_pt[0];
+    k::QsaAttnSlotPools px;
+    for (int t = 0; t < m; ++t) { px.p[t] = pools[t].pools; px.p[t].page_table = d_pt[(size_t) t]; }
+    Out o[3];   // batch, slots, step
+    for (auto& oo : o)
+        for (int v = 0; v < kVariants; ++v) {
+            ck(cudaMalloc(&oo.scratch[v], (size_t) (m * sf) * 4));
+            ck(cudaMalloc(&oo.attn[v], (size_t) (m * NH * HD) * 4));
+            ck(cudaMemset(oo.scratch[v], 0, (size_t) (m * sf) * 4));
+            ck(cudaMemset(oo.attn[v], 0, (size_t) (m * NH * HD) * 4));
+        }
+    bool slots_ran = true;
+    for (int v = 0; v < kVariants; ++v) {
+        k::qsa_decode_attn_set_vbatch(kCells[v]);
+        k::qsa_decode_attn_batch(d_q, p0, d_ids, d_steps, cap, s, o[0].scratch[v], o[0].attn[v], m, nullptr);
+        if (!k::qsa_decode_attn_slots(d_q, px, d_ids, d_steps, cap, s, o[1].scratch[v], o[1].attn[v], m, nullptr))
+            slots_ran = false;
+        for (int t = 0; t < m; ++t)
+            k::qsa_decode_attn_step(d_q + t * NH * HD, px.p[t], d_ids + t * cap, d_steps + t * k::kStepCount, cap, s,
+                                    o[2].scratch[v] + t * sf, o[2].attn[v] + t * NH * HD, nullptr);
+        ck(cudaDeviceSynchronize());
+    }
+    k::qsa_decode_attn_set_vbatch(-1);
+    bool ok = true;
+    static const char* const names[3] = {"batch", "slots", "step"};
+    for (int l = 0; l < 3 && ok; ++l) {
+        if (l == 1 && !slots_ran) continue;
+        const auto a0 = down(o[l].attn[0], (size_t) (m * NH * HD));
+        const auto s0 = down(o[l].scratch[0], (size_t) (m * sf));
+        for (int v = 1; v < kVariants && ok; ++v) {
+            const auto a1 = down(o[l].attn[v], (size_t) (m * NH * HD));
+            const auto s1 = down(o[l].scratch[v], (size_t) (m * sf));
+            for (int t = 0; t < m && ok; ++t) {
+                const char* what = nullptr;
+                if (std::memcmp(&a0[(size_t) (t * NH * HD)], &a1[(size_t) (t * NH * HD)], (size_t) (NH * HD) * 4))
+                    what = "attention";
+                else if (std::memcmp(&s0[(size_t) (t * sf)], &s1[(size_t) (t * sf)], (size_t) sf * 4))
+                    what = "partials (acc, max, sum)";
+                if (what) {
+                    std::fprintf(stderr, "FAIL %s cells=%d fmt=%d rows=%d row=%d ctx=%lld mask=%d: %s differ\n",
+                                 names[l], kCells[v], fmt, m, t, (long long) ctx[t], (int) mask, what);
+                    ok = false;
+                }
+            }
+        }
+        double mag = 0;   // the attention output is not trivially zero (a short masked context can be all masked)
+        for (float x : a0) mag += std::fabs(x);
+        if (ok && !mask && !(mag > 0)) {
+            std::fprintf(stderr, "FAIL %s fmt=%d rows=%d: attention output is zero\n", names[l], fmt, m);
+            ok = false;
+        }
+    }
+    for (auto& oo : o)
+        for (int v = 0; v < kVariants; ++v) { ck(cudaFree(oo.scratch[v])); ck(cudaFree(oo.attn[v])); }
+    ck(cudaFree(d_q)); ck(cudaFree(d_ids)); ck(cudaFree(d_steps));
+    for (int32_t* p : d_pt) ck(cudaFree(p));
+    if (!ok) return kFail;
+    return slots_ran ? kPass : kSkip;
+}
+
+}  // namespace
+
+int main() {
+    int devices = 0;
+    if (cudaGetDeviceCount(&devices) != cudaSuccess || devices == 0) {
+        std::puts("SKIP: no CUDA device");
+        return 77;
+    }
+    // contexts: below, at and past the selection width (2051 cells); the last chunk holds width % 64 cells, so
+    // 1, 3, 7, 8, 9, 37, 63 and 64 cover tails shorter than, equal to and longer than a group of 8
+    const int64_t ctx_sets[3][kMaxRows] = {
+        {1, 3, 7, 8, 9, 37, 63, 64},
+        {65, 71, 137, 2049, 2051, 2060, 32768, 190000},
+        {190000, 4096, 2050, 520, 1000, 131072, 72, 2051},
+    };
+    int cases = 0, slots_declined = 0;
+    for (int fmt = 0; fmt < 4; ++fmt) {
+        std::mt19937 r(7000u + (uint32_t) fmt);
+        Pools pools[kMaxRows];
+        for (auto& pl : pools) pl = make_pools(fmt, k::qsa_real_shapes(), r);
+        for (int set = 0; set < 3; ++set)
+            for (int m : {1, 2, 4, 8})
+                for (bool mask : {false, true}) {
+                    const uint32_t seed = 100000u * (uint32_t) fmt + 1000u * (uint32_t) set + 10u * (uint32_t) m + mask;
+                    const Result res = check(fmt, m, ctx_sets[set], mask, pools, seed);
+                    if (res == kFail) return 1;
+                    ++cases;
+                    if (res == kSkip) ++slots_declined;
+                }
+        for (auto& pl : pools)
+            for (void* b : pl.bufs) if (b) ck(cudaFree(b));
+    }
+    std::printf("PASS: %d cases (4 KV formats x 1/2/4/8 rows x 24 contexts, masked pages on and off%s; slots launch "
+                "declined in %d): attention and partials bitwise identical with STRATA_ATTN_VBATCH off, 8 and 4\n",
+                cases, std::getenv("STRATA_ATTN_LANECELL") ? ", lane-cell" : "", slots_declined);
+    return 0;
+}
