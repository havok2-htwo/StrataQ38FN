 inline bool g_qfuse() { static const bool on = [] { const char* v = std::getenv("STRATA_QFUSE"); return v != nullptr && std::atoi(v) != 0; }(); return on; }
 #define VDBG(...) do { if (g_dbg) { std::fprintf(stderr, "verify dbg: " __VA_ARGS__); std::fflush(stderr); } } while (0)
 
@@ -2826,6 +2828,13 @@ bool Verifier::init_slots(const std::vector<SessionState*>& slots, std::string&
     slot_sp_.assign(slots.size(), sampling_);   // greedy until set_slot_sampling
     std::fprintf(stderr, "strata verify: batch windows of up to %lld sequences (layers [%lld, %lld))%s\n", (long long) S,
                  (long long) lb_, (long long) le_, g_batch_self_commit ? ", one-row windows keep their rows" : "");
+    // STRATA_EARLY_SAMPLE: sample_tokens must not reach cudaMalloc in batch_launch, with the window in flight (a
+    // malloc that synchronises would wait on a graph that waits on this thread's doorbells)
+    if (g_early_sample() && last_stage()) {
+        early_sample_ = strata::kernels::sample_tokens_reserve((int) n_vocab_, cs_);
+        std::fprintf(stderr, "strata verify: STRATA_EARLY_SAMPLE=1: %s\n",
+                     early_sample_ ? "sampled rows are drawn right behind the window" : "off (the stream is being captured)");
+    }
     return true;
 }
 
@@ -3086,6 +3095,7 @@ bool Verifier::stage_batch(const int* rows, int S, int hbase, const int32_t* tok
     *(volatile uint32_t*) h_flagB_ = 0;
     std::atomic_thread_fence(std::memory_order_seq_cst);
     last_t_ = S;
+    b_early_ = 0;   // (batch_launch sets it after this)
     for (int t = 0; t < S; ++t) last_rows_[t] = rows[t];
     row_base_ = hbase;   // the graphs' key (and nothing else) reads it until the next stage_batch
     last_batch_ = true;
@@ -3253,13 +3263,20 @@ bool Verifier::commit_slot_prefixes(const int* keep, std::string& err) {
     return next_ == nullptr || next_->commit_slot_prefixes(keep, err);
 }
 
+bool Verifier::row_draw(int t, strata::kernels::SamplerParams& sp) const {
+    sp = slot_sp_[(size_t) last_rows_[t]];
+    if (sp.greedy || sp.temperature <= 0.0f) return false;
+    sp.counter = (uint64_t) last_pos_b_[t];   // Philox(seed, position): the solo window's draw for this position
+    sp.penalty_last_n = 0;
+    return true;
+}
+
 bool Verifier::sample_rows(int S, std::string& err) {
     bool any = false;
     for (int t = 0; t < S; ++t) {
-        strata::kernels::SamplerParams sp = slot_sp_[(size_t) last_rows_[t]];
-        if (sp.greedy || sp.temperature <= 0.0f) continue;
-        sp.counter = (uint64_t) last_pos_b_[t];   // Philox(seed, position): the solo window's draw for this position
-        sp.penalty_last_n = 0;
+        strata::kernels::SamplerParams sp;
+        if (!row_draw(t, sp)) continue;
+        if ((b_early_ >> t & 1u) && strata::kernels::same_sampling(sp, b_early_sp_[t])) continue;   // drawn in batch_launch
         strata::kernels::sample_tokens(head_logits_ + (size_t) t * (size_t) n_vocab_, 1, (int) n_vocab_, nullptr, 0, sp,
                                        m_out_ + t, cs_);
         any = true;
@@ -3343,6 +3360,17 @@ bool Verifier::batch_launch(int base, int S, const int32_t* tokens, const int64_
     if (le == cudaSuccess && !batch_self_commits(rows, S))   // (else the window has kept its rows itself)
         le = cudaGraphLaunch(commit_bm_[bkey(rows, S, base)], cs_);   // right behind it: every row is kept
     if (le != cudaSuccess) { err = std::string("verify: batch launch: ") + cudaGetErrorString(le); return false; }
+    b_early_ = 0;
+    if (early_sample_ && last_stage())   // STRATA_EARLY_SAMPLE: sample_rows' draws, in its order behind the window and its commit
+        for (int t = 0; t < S; ++t) {
+            strata::kernels::SamplerParams sp;
+            // (a logit bias lives in one device buffer that set_logit_bias may rewrite: batch_poll draws that row)
+            if (!row_draw(t, sp) || sp.logit_bias != nullptr) continue;
+            strata::kernels::sample_tokens(head_logits_ + (size_t) t * (size_t) n_vocab_, 1, (int) n_vocab_, nullptr, 0,
+                                           sp, m_out_ + t, cs_);
+            b_early_ |= 1u << t;
+            b_early_sp_[t] = sp;
+        }
     (void) cudaStreamQuery(cs_);
     if (ple_stage())   // the host's side of the commit (the hash's last two tokens)
         for (int t = 0; t < S; ++t) {
diff --git a/src/kernels/cuda/sampler.cu b/src/kernels/cuda/sampler.cu
