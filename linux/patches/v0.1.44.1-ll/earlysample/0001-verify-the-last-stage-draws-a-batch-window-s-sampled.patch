diff --git a/include/strata/kernels/sampler.hpp b/include/strata/kernels/sampler.hpp
index a3121ba1..7cf4baaa 100644
--- a/include/strata/kernels/sampler.hpp
+++ b/include/strata/kernels/sampler.hpp
@@ -9,6 +9,7 @@
 #include <algorithm>
 #include <cstddef>
 #include <cstdint>
+#include <cstring>
 
 namespace strata::kernels {
 
@@ -44,6 +45,23 @@ struct SamplerParams {
 void sample_tokens(const float* logits, int n_tokens, int n_vocab, const int* history, int history_len,
                    const SamplerParams& p, int* out, void* stream);
 
+// STRATA_EARLY_SAMPLE: sample_tokens on `stream` (the current device) for up to 16 rows of `n_vocab` never calls
+// cudaMalloc after this - the split's scratch is taken now, or its failure is remembered and the one-block kernel
+// runs, as it would have anyway.  Call it while the stream is idle and not being captured; false (nothing done) for
+// a stream under capture.
+bool sample_tokens_reserve(int n_vocab, void* stream);
+
+// Every field sample_tokens reads is the same (floats bit for bit): the two draws pick the same token.
+inline bool same_sampling(const SamplerParams& a, const SamplerParams& b) {
+    const auto bits = [](float f) { uint32_t u = 0; std::memcpy(&u, &f, sizeof u); return u; };
+    return a.top_k == b.top_k && bits(a.top_p) == bits(b.top_p) && bits(a.min_p) == bits(b.min_p) &&
+           bits(a.temperature) == bits(b.temperature) && a.min_keep == b.min_keep &&
+           a.penalty_last_n == b.penalty_last_n && bits(a.penalty_repeat) == bits(b.penalty_repeat) &&
+           bits(a.penalty_freq) == bits(b.penalty_freq) && bits(a.penalty_present) == bits(b.penalty_present) &&
+           a.seed == b.seed && a.counter == b.counter && a.greedy == b.greedy && a.logit_bias == b.logit_bias &&
+           a.gumbel == b.gumbel;
+}
+
 // The greedy pick (no penalties) on a thread-block cluster of 8 CTAs per row (sm_90+, CUDA; S19): the same token as
 // sample_tokens' one-block argmax, which takes it unless STRATA_ARGMAX_MULTI=0.  False (nothing launched) where it
 // cannot run: HIP, a card or a build below sm_90.  Device pointers; capturable.
