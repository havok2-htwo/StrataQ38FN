 // the emitter: started once, after READY, only when on().  A line when the content changed (at most one per period),
-// else one every 10 periods; one printf per line (stdio's lock: it cannot tear against the loop's BT lines)
+// else one every heartbeat_ms(); one printf per line (stdio's lock: it cannot tear against the loop's BT lines).
+// stop_emitter() wakes and joins it: the serve function stops it on every way out (QUIT, and an ERR's return through
+// its guard), and an atexit hook covers exit() - no STAT line follows the engine's last words, none runs into stdio's
+// teardown.
+namespace detail {
+struct Emitter {
+    std::mutex mu;
+    std::condition_variable cv;
+    std::thread* th = nullptr;   // (a pointer: never a joinable std::thread in a static destructor)
+};
+inline Emitter& emitter() {
+    static Emitter* e = new Emitter;   // (never destroyed: the atexit hook may run after statics go)
+    return *e;
+}
+}  // namespace detail
+
+inline void stop_emitter() {
+    State& S = state();
+    detail::Emitter& E = detail::emitter();
+    std::thread* th = nullptr;
+    {
+        std::lock_guard<std::mutex> g(E.mu);
+        S.stop.store(true, std::memory_order_relaxed);
+        th = E.th;
+        E.th = nullptr;
+    }
+    E.cv.notify_all();
+    if (th != nullptr) {
+        if (th->get_id() != std::this_thread::get_id()) th->join();
+        else th->detach();
+        delete th;
+    }
+}
+
 inline void start_emitter() {
     if (!on()) return;
-    std::printf("INFO status_lines=%d\n", period_ms());
+    detail::Emitter& E = detail::emitter();
+    std::lock_guard<std::mutex> g(E.mu);
+    if (E.th != nullptr || state().stop.load(std::memory_order_relaxed)) return;   // (once; never after a stop)
+    std::printf("INFO status_lines=%d status_heartbeat=%d\n", period_ms(), heartbeat_ms());
     std::fflush(stdout);
-    std::thread([] {
+    E.th = new std::thread([] {
         State& S = state();
+        detail::Emitter& E = detail::emitter();
         Rates rates;
         std::string last;
         int quiet = 0;
         const int p = period_ms();
-        while (!S.stop.load(std::memory_order_relaxed)) {
-            std::this_thread::sleep_for(std::chrono::milliseconds(p));
-            if (S.stop.load(std::memory_order_relaxed)) break;
+        const int hb = heartbeat_periods(p);
+        for (;;) {
+            {
+                std::unique_lock<std::mutex> lk(E.mu);
+                if (E.cv.wait_for(lk, std::chrono::milliseconds(p),
+                                  [&] { return S.stop.load(std::memory_order_relaxed); }))
+                    break;
+            }
             const int64_t now = now_ms();
             Rates probe = rates;   // (the change test must not advance the rates)
             const std::string body = to_json(S, now, &probe, false);
-            if (body == last && ++quiet < 10) continue;
+            if (body == last && ++quiet < hb) continue;
             quiet = 0;
             last = body;
             const std::string line = to_json(S, now, &rates, true);
+            if (S.stop.load(std::memory_order_relaxed)) break;   // (stop_emitter joins: no line after it returns)
             std::printf("STAT %s\n", line.c_str());
             std::fflush(stdout);
         }
-    }).detach();
+    });
+    static const bool hooked = (std::atexit([] { stop_emitter(); }), true);
+    (void) hooked;
 }
-inline void stop_emitter() { state().stop.store(true, std::memory_order_relaxed); }
 
 }  // namespace strata::program::live_status
