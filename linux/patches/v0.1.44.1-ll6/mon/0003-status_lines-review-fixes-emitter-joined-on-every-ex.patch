+# not know it ignores it.  A status older than status_stale_s() is not shown (the engine stopped sending: an old engine,
+# or it is gone): STATUS_STALE_S, or STATUS_STALE_BEATS x the heartbeat the engine announced (`INFO status_heartbeat=`,
+# a line at least that often while nothing changes) when that is longer.
 STATUS_LINES_MS = "500"
 STATUS_STALE_S = 5.0
+STATUS_STALE_BEATS = 2.5
+
+
+def status_heartbeat_s(info: dict) -> float | None:
+    """The engine's announced STAT heartbeat in s (INFO status_heartbeat=<ms>; an engine with only status_lines=<ms>:
+    10 periods), None without either."""
+    for k, f in (("status_heartbeat", 1), ("status_lines", 10)):
+        v = info.get(k)
+        if isinstance(v, int) and v > 0:
+            return v * f / 1000.0
+    return None
+
+
+def status_stale_s(info: dict) -> float:
+    hb = status_heartbeat_s(info)
+    return max(STATUS_STALE_S, STATUS_STALE_BEATS * hb) if hb else STATUS_STALE_S
 
 
