diff --git a/serve/test_status_lines.py b/serve/test_status_lines.py
new file mode 100644
index 00000000..449e1b97
--- /dev/null
+++ b/serve/test_status_lines.py
@@ -0,0 +1,158 @@
+"""serve/test_status_lines.py - STRATA_STATUS_LINES: the engine's `STAT {json}` lines are taken out of the stdout pump
+before any reader of the control lines sees them (a request, a session save), and show in /metrics as new keys only
+(fake engine process: no GPU, no pack).
+
+    python -m unittest serve.test_status_lines -v
+"""
+from __future__ import annotations
+
+import json
+import os
+import sys
+import tempfile
+import threading
+import time
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from serve.frontend import ChatTemplate  # noqa: E402
+from serve.server import (ByteTokenizer, Service, StrataEngine, engine_mode_view, parse_status_line,  # noqa: E402
+                          slot_status_keys)
+
+STAT = {"v": 1, "t": 1, "seq": 3,
+        "lanes": {"on": 4, "live": 1, "n": 2, "starts": 7, "wait": None},
+        "overlap": {"active": 1},
+        "solo": None,
+        "slots": [{"s": 0, "m": "lane", "lane": 0, "tok": 300, "tok_s": 41.2, "tok_s_mean": 39.0,
+                   "offered": 100, "accepted": 70, "acc": 0.7},
+                  {"s": 4, "m": "lane", "lane": 1, "tok": 12, "tok_s": 40.0, "tok_s_mean": 40.0,
+                   "offered": 0, "accepted": 0, "acc": None},
+                  {"s": 5, "m": "read_ovl", "lane": -1},
+                  {"s": 2, "m": "cached", "lane": -1}],
+        "reads": [{"slot": 5, "done": 8192, "total": 30000, "from": 0, "tok_s": 1450.0, "beside": "decode",
+                   "state": "run"}]}
+
+# a fake `strata --serve`: says what STRATA_STATUS_LINES it got, then puts a STAT line before and between every answer
+FAKE = r'''
+import json, os, sys
+stat = json.loads(sys.argv[sys.argv.index('--stat') + 1])
+print('INFO status_env=%s' % os.environ.get('STRATA_STATUS_LINES', 'unset'), flush=True)
+print('READY 4096 stop', flush=True)
+def st():
+    print('STAT ' + json.dumps(stat, separators=(',', ':')), flush=True)
+for line in sys.stdin:
+    if line.startswith('QUIT'):
+        break
+    st()
+    if line.startswith('SAVE '):
+        print('SESSION 1 2', flush=True); st()
+        print('SAVED 3 4096 1.0', flush=True)
+        continue
+    if line.startswith('GEN'):
+        print('PP 1 1 5 200.0', flush=True); st()
+        print('T 90', flush=True); st()
+        print('DONE 1 1 0 1 stop 0 0 0', flush=True); st()
+'''
+
+
+class StatusLinesProcess(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        py = self.root / 'native.py'
+        if os.name == 'nt':
+            py.write_text(FAKE)
+            self.script = self.root / 'native.cmd'
+            self.script.write_text(f'@"{sys.executable}" "{py}" %*\r\n')
+        else:
+            self.script = py
+            py.write_text('#!' + sys.executable + '\n' + FAKE)
+            py.chmod(0o700)
+
+    def engine(self, env=None):
+        e = StrataEngine(str(self.script), ['--stat', json.dumps(STAT)], env=env)
+        self.addCleanup(e.close)
+        return e
+
+    def test_server_turns_it_on_and_keeps_stat_off_the_control_lines(self):
+        saved = os.environ.pop("STRATA_STATUS_LINES", None)
+        self.addCleanup(lambda: saved is not None and os.environ.__setitem__("STRATA_STATUS_LINES", saved))
+        e = self.engine()
+        self.assertEqual(e.info.get("status_env"), 500)
+        svc = Service(e, ByteTokenizer(), ChatTemplate(Path(__file__).parent / 'chat_template.jinja'))
+        out = list(svc.run([1], False, [], 8, {}, threading.Event()))
+        self.assertTrue(out, "the request ends normally with STAT lines between its PP, T and DONE")
+        # a session save reads its own answer: any unknown line there would end the engine (out_of_step)
+        r = e.session_file("save", str(self.root / "s.bin"))
+        self.assertEqual(r["tokens"], 3)
+        self.assertTrue(e.alive())
+        end = time.monotonic() + 2
+        while e.engine_status is None and time.monotonic() < end:
+            time.sleep(0.01)
+        self.assertEqual(e.engine_status["lanes"]["n"], 2)
+        while not e.lines.empty():
+            line = e.lines.get_nowait()
+            self.assertFalse(line is not None and line.startswith("STAT "), "a STAT line reached the control lines")
+        m = e.engine_mode()
+        self.assertTrue(m["lanes"]["live"])
+        self.assertTrue(m["overlap"])
+        self.assertEqual(m["reads"][0]["slot"], 5)
+
+    def test_an_explicit_value_is_kept(self):
+        e = self.engine(env={**os.environ, "STRATA_STATUS_LINES": "0"})
+        self.assertEqual(e.info.get("status_env"), 0)
+
+
+class StatusViews(unittest.TestCase):
+    def test_parse(self):
+        self.assertIsNone(parse_status_line("STAT not json\n"))
+        self.assertIsNone(parse_status_line("STAT [1]\n"))
+        self.assertIsNone(parse_status_line("BT 0 1\n"))
+        self.assertEqual(parse_status_line("STAT " + json.dumps(STAT) + "\n")["seq"], 3)
+
+    def test_slot_keys(self):
+        self.assertEqual(slot_status_keys(None, 0), {})
+        k = slot_status_keys(STAT, 0)
+        self.assertEqual((k["mode"], k["lane"], k["acc"], k["engine_tok_s"]), ("lane", 0, 0.7, 41.2))
+        k = slot_status_keys(STAT, 5)
+        self.assertEqual((k["mode"], k["read_done"], k["read_total"], k["read_beside"]), ("read_ovl", 8192, 30000, "decode"))
+        self.assertNotIn("lane", k)
+        self.assertEqual(slot_status_keys(STAT, 9), {"mode": "idle"})
+
+    def test_mode_view(self):
+        self.assertIsNone(engine_mode_view(None, None))
+        v = engine_mode_view(STAT, 0.25)
+        self.assertEqual(v["slot_modes"], {"lane": 2, "read_ovl": 1, "cached": 1})
+        self.assertEqual(v["lanes"]["configured"], 4)
+
+    def test_slots_view_adds_keys_and_keeps_state(self):
+        e = StrataEngine("strata", [], lazy=True)
+        e.batch = 6
+        e.slot_held = [[] for _ in range(6)]
+        e.slot_live = [None] * 6
+        now = time.time()
+        e.slot_live[0] = {"slot": 0, "state": "decoding", "prompt_tokens": 10, "generated": 300,
+                          "started": now - 10, "first_token": now - 8}
+        e.slot_live[5] = {"slot": 5, "state": "reading", "prompt_tokens": 30000, "generated": 0,
+                          "started": now - 2, "first_token": None, "prompt_read": 4096, "prompt_total": 30000,
+                          "prefill_tok_s": 1200.0}
+        # no status (an older engine): the PP lines' progress only, no mode key
+        v = e.slots_view()
+        self.assertEqual([x["state"] for x in v], ["decoding", "idle", "idle", "idle", "idle", "reading"])
+        self.assertEqual((v[5]["read_done"], v[5]["read_total"]), (4096, 30000))
+        self.assertNotIn("mode", v[0])
+        # a fresh status: new keys, `state` as it was
+        e.engine_status, e.engine_status_at = STAT, time.monotonic()
+        v = e.slots_view()
+        self.assertEqual([x["state"] for x in v], ["decoding", "idle", "idle", "idle", "idle", "reading"])
+        self.assertEqual((v[0]["mode"], v[2]["mode"], v[5]["mode"], v[5]["read_done"]), ("lane", "cached", "read_ovl", 8192))
+        # a stale one is not shown
+        e.engine_status_at = time.monotonic() - 60
+        self.assertNotIn("mode", e.slots_view()[0])
+        self.assertIsNone(e.engine_mode())
+
+
+if __name__ == "__main__":
+    unittest.main()
