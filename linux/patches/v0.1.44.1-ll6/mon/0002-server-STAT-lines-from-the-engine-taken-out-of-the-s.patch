+# STRATA_STATUS_LINES: the engine's live status (`STAT {json}` lines, engine with live_status.hpp) every this many ms.
+# This server turns it on for the engine it starts unless the environment says otherwise (0 = off); an engine that does
+# not know it ignores it.  A status older than STATUS_STALE_S is not shown (the engine stopped sending: an old engine,
+# or it is gone).
+STATUS_LINES_MS = "500"
+STATUS_STALE_S = 5.0
+
+
+def engine_status_env(env: dict | None) -> dict | None:
+    """The engine's environment with STRATA_STATUS_LINES set (a value already there, here or in ours, is kept)."""
+    if "STRATA_STATUS_LINES" in (env if env is not None else os.environ):
+        return env
+    return {**(env if env is not None else os.environ), "STRATA_STATUS_LINES": STATUS_LINES_MS}
+
+
+def parse_status_line(line: str) -> dict | None:
+    """`STAT {json}` -> the dict (v 1+), None for anything that is not one."""
+    if not line.startswith("STAT "):
+        return None
+    try:
+        d = json.loads(line[5:])
+    except ValueError:
+        return None
+    return d if isinstance(d, dict) and isinstance(d.get("v"), int) else None
+
+
+def slot_status_keys(st: dict | None, slot: int) -> dict:
+    """The engine's view of one batch slot as new keys for slots_view (none when the engine sends no status):
+    mode (idle, cached, yielded, batch, lane, parking, reading, read_ovl), lane, engine tok/s, drafts and the read."""
+    if not st:
+        return {}
+    out = {"mode": "idle"}
+    for x in st.get("slots") or ():
+        if isinstance(x, dict) and x.get("s") == slot:
+            out["mode"] = x.get("m", "idle")
+            if x.get("lane", -1) is not None and x.get("lane", -1) >= 0:
+                out["lane"] = x["lane"]
+            for k_in, k_out in (("tok_s", "engine_tok_s"), ("tok_s_mean", "engine_tok_s_mean"), ("acc", "acc"),
+                                ("offered", "drafts_offered"), ("accepted", "drafts_accepted")):
+                if x.get(k_in) is not None:
+                    out[k_out] = x[k_in]
+            break
+    for r in st.get("reads") or ():
+        if isinstance(r, dict) and r.get("slot") == slot:
+            out.update(read_done=r.get("done"), read_total=r.get("total"), read_tok_s=r.get("tok_s"),
+                       read_beside=r.get("beside"), read_state=r.get("state"))
+            break
+    return out
+
+
+def engine_mode_view(st: dict | None, age_s: float | None) -> dict | None:
+    """live.engine_mode: the engine's global view (lanes, overlapped read, solo decode, the reads in flight, the slots
+    per mode); None when the engine sends no status (an older engine, STRATA_STATUS_LINES=0) or it is stale."""
+    if not st:
+        return None
+    modes: dict[str, int] = {}
+    for x in st.get("slots") or ():
+        if isinstance(x, dict):
+            modes[x.get("m", "idle")] = modes.get(x.get("m", "idle"), 0) + 1
+    lanes = st.get("lanes") or {}
+    return {"v": st.get("v"), "age_s": round(age_s, 2) if age_s is not None else None,
+            "lanes": {"configured": lanes.get("on", 0), "live": bool(lanes.get("live")), "running": lanes.get("n", 0),
+                      "starts": lanes.get("starts", 0), "wait": lanes.get("wait")},
+            "overlap": bool((st.get("overlap") or {}).get("active")),
+            "solo": st.get("solo"),
+            "reads": [r for r in (st.get("reads") or ()) if isinstance(r, dict)],
+            "slot_modes": modes}
 RATE_MIN_SPAN_S = 0.25      # younger than this there is no rate yet: the mean so far, with the span floored here
