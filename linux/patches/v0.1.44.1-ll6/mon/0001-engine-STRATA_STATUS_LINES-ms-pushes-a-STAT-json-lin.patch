index 00000000..3a45ee52
--- /dev/null
+++ b/include/strata/program/live_status.hpp
@@ -0,0 +1,373 @@
+// STRATA_STATUS_LINES=<ms> (opt-in, default off): what the serve loop is doing now, pushed to the server as one
+// `STAT {json}` line on stdout at most every <ms> milliseconds (and only when something changed, else a heartbeat every
+// 10 periods).  Off (unset, empty or 0): nothing is started, nothing is stored, nothing is printed - the engine's
+// output stays byte-identical.  Only a server that knows the line sets the variable (serve/server.py takes STAT lines
+// out of its stdout pump before anything else reads them): an older server would take an unknown line for a session
+// command's answer.
+//
+// The serve loop (main thread) and the prompt read's thread store into State with relaxed atomics (no lock, no sync,
+// nothing on the GPU); the emitter thread reads it and prints.  A value can be one window stale - this is a monitor.
+//
+// The line (v = 1; new keys may be added, none is renamed or removed; idle slots are left out):
+//   STAT {"v":1,"t":<ms>,"seq":<n>,
+//         "lanes":{"on":<lanes configured>,"live":0|1,"n":<lanes running>,"starts":<n>,"wait":"<why>"|null},
+//         "overlap":{"active":0|1},
+//         "solo":null|{"mode":"solo_pl"|"solo_serial","tok":<n>,"tok_s":<x>,"offered":<n>,"accepted":<n>,"acc":<0..1>},
+//         "slots":[{"s":<slot>,"m":"<mode>","lane":<j>|-1,"tok":<n>,"tok_s":<recent>,"tok_s_mean":<since start>,
+//                   "offered":<n>,"accepted":<n>,"acc":<0..1>|null}, ...],
+//         "reads":[{"slot":<slot>|-1,"done":<n>,"total":<n>,"from":<n>,"tok_s":<x>,"beside":"decode"|"paused"|"none",
+//                   "state":"run"|"wait"|"yielded"}, ...]}
+// Slot modes: idle, cached (idle, holds its conversation), yielded (its read gave way), batch (the batch windows /
+// pipelined groups), lane (a spec lane), parking (its conversation's capture in flight), reading (its prompt is being
+// read, the slots paused), read_ovl (read beside the slots' decode, STRATA_PIPE_OVERLAP).  A read that belongs to a slot
+// sets that slot's mode; reads[] has one entry per read in flight (concurrent reads: more entries, nothing else changes).
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <thread>
+
+namespace strata::program::live_status {
+
+constexpr int kSlots = 64;
+constexpr int kReads = 8;
+
+enum Mode : int { idle = 0, cached = 1, yielded = 2, batch = 3, lane = 4, parking = 5 };
+enum ReadState : int { read_free = 0, read_run = 1, read_wait = 2, read_yielded = 3 };
+
+inline const char* mode_name(int m) {
+    switch (m) {
+        case cached: return "cached";
+        case yielded: return "yielded";
+        case batch: return "batch";
+        case lane: return "lane";
+        case parking: return "parking";
+        default: return "idle";
+    }
+}
+
+// the switch: unset, empty, 0 or not a number -> 0 (off); else the period in ms (at least 50)
+inline int parse_period(const char* v) {
+    if (v == nullptr || v[0] == '\0') return 0;
+    const int ms = std::atoi(v);
+    if (ms <= 0) return 0;
+    return ms < 50 ? 50 : ms;
+}
+
+inline int period_ms() {
+    static const int p = parse_period(std::getenv("STRATA_STATUS_LINES"));
+    return p;
+}
+inline bool on() { return period_ms() > 0; }
+
+inline int64_t to_ms(std::chrono::steady_clock::time_point t) {
+    return std::chrono::duration_cast<std::chrono::milliseconds>(t.time_since_epoch()).count();
+}
+inline int64_t now_ms() { return to_ms(std::chrono::steady_clock::now()); }
+
+struct Slot {
+    std::atomic<int> mode{idle}, lane{-1};
+    std::atomic<int64_t> produced{0}, t0_ms{0}, offered{0}, accepted{0};
+};
+struct Read {
+    std::atomic<int> state{read_free}, slot{-1}, overlapped{0};
+    std::atomic<int64_t> done{0}, total{0}, from{0}, t0_ms{0};
+};
+struct Solo {
+    std::atomic<int> active{0}, pipelined{0};
+    std::atomic<int64_t> produced{0}, offered{0}, accepted{0}, t0_ms{0};
+};
+struct State {
+    std::atomic<int> n_slots{0}, lanes_on{0}, lanes_live{0}, lanes_n{0}, overlap{0}, any_decoding{0};
+    std::atomic<int64_t> lanes_starts{0};
+    std::atomic<const char*> lanes_wait{nullptr};   // a string literal (the gate's reason) or null
+    std::atomic<int> main_read{-1};                 // the reads[] entry the serve loop's read updates
+    std::atomic<uint64_t> seq{0};
+    std::atomic<bool> stop{false};
+    Slot slots[kSlots];
+    Read reads[kReads];
+    Solo solo;
+};
+inline State& state() {
+    static State s;
+    return s;
+}
+
+// ---- the writers (each a few relaxed stores; the caller checks on() first where it would compute anything)
+inline void bump(State& S = state()) { S.seq.fetch_add(1, std::memory_order_relaxed); }
+
+// a prompt read starts (slot: the batch slot it continues in, -1: a request beside the slots); its entry index
+inline int read_begin(int slot, int64_t total, int64_t from, State& S = state()) {
+    int i = 0;
+    for (; i < kReads; ++i)
+        if (S.reads[i].state.load(std::memory_order_relaxed) == read_free) break;
+    if (i == kReads) i = 0;   // (cannot happen today: one read at a time)
+    Read& R = S.reads[i];
+    R.slot.store(slot, std::memory_order_relaxed);
+    R.total.store(total, std::memory_order_relaxed);
+    R.from.store(from, std::memory_order_relaxed);
+    R.done.store(from, std::memory_order_relaxed);
+    R.t0_ms.store(now_ms(), std::memory_order_relaxed);
+    R.overlapped.store(0, std::memory_order_relaxed);
+    R.state.store(read_run, std::memory_order_relaxed);
+    S.main_read.store(i, std::memory_order_relaxed);
+    bump(S);
+    return i;
+}
+inline void read_progress(int64_t done, State& S = state()) {
+    const int i = S.main_read.load(std::memory_order_relaxed);
+    if (i < 0 || i >= kReads) return;
+    S.reads[i].done.store(done, std::memory_order_relaxed);
+    bump(S);
+}
+inline void read_overlapped(bool ov, State& S = state()) {
+    const int i = S.main_read.load(std::memory_order_relaxed);
+    if (i >= 0 && i < kReads) S.reads[i].overlapped.store(ov ? 1 : 0, std::memory_order_relaxed);
+    S.overlap.store(ov ? 1 : 0, std::memory_order_relaxed);
+    bump(S);
+}
+inline void read_end(State& S = state()) {
+    const int i = S.main_read.exchange(-1, std::memory_order_relaxed);
+    if (i >= 0 && i < kReads) S.reads[i].state.store(read_free, std::memory_order_relaxed);
+    bump(S);
+}
+// a request beside the slots decodes (pipelined or serial)
+inline void solo_begin(bool pipelined, State& S = state()) {
+    S.solo.pipelined.store(pipelined ? 1 : 0, std::memory_order_relaxed);
+    S.solo.produced.store(0, std::memory_order_relaxed);
+    S.solo.offered.store(0, std::memory_order_relaxed);
+    S.solo.accepted.store(0, std::memory_order_relaxed);
+    S.solo.t0_ms.store(now_ms(), std::memory_order_relaxed);
+    S.solo.active.store(1, std::memory_order_relaxed);
+    bump(S);
+}
+inline void solo_progress(int64_t produced, int64_t offered, int64_t accepted, State& S = state()) {
+    S.solo.produced.store(produced, std::memory_order_relaxed);
+    S.solo.offered.store(offered, std::memory_order_relaxed);
+    S.solo.accepted.store(accepted, std::memory_order_relaxed);
+    bump(S);
+}
+// the request ended, whichever way: its read and its solo decode are over
+inline void request_end(State& S = state()) {
+    read_end(S);
+    S.overlap.store(0, std::memory_order_relaxed);
+    S.solo.active.store(0, std::memory_order_relaxed);
+    bump(S);
+}
+inline void slot_drafts(int b, int64_t offered, int64_t accepted, State& S = state()) {
+    if (b < 0 || b >= kSlots) return;
+    S.slots[b].offered.fetch_add(offered, std::memory_order_relaxed);
+    S.slots[b].accepted.fetch_add(accepted, std::memory_order_relaxed);
+}
+inline void slot_admitted(int b, State& S = state()) {
+    if (b < 0 || b >= kSlots) return;
+    S.slots[b].offered.store(0, std::memory_order_relaxed);
+    S.slots[b].accepted.store(0, std::memory_order_relaxed);
+}
+
+// ---- the reader: one JSON object from State.  `Rates` keeps the previous sample per slot (the recent tok/s)
+struct Rates {
+    int64_t at_ms[kSlots + 1] = {};
+    int64_t produced[kSlots + 1] = {};
+    int64_t t0[kSlots + 1] = {};
+    double rate[kSlots + 1] = {};
+};
+
+namespace detail {
+inline void num(std::string& s, double v) {
+    char b[32];
+    std::snprintf(b, sizeof b, "%.1f", v);
+    s += b;
+}
+inline void num(std::string& s, int64_t v) { s += std::to_string((long long) v); }
+inline void frac(std::string& s, int64_t acc, int64_t off) {
+    if (off <= 0) { s += "null"; return; }
+    char b[32];
+    std::snprintf(b, sizeof b, "%.3f", (double) acc / (double) off);
+    s += b;
+}
+// the recent rate of counter `i` (EMA over the samples; reset when a new request starts there)
+inline double recent(Rates* r, int i, int64_t produced, int64_t t0, int64_t now) {
+    if (r == nullptr) return 0.0;
+    if (r->t0[i] != t0 || produced < r->produced[i] || r->at_ms[i] == 0) {
+        r->t0[i] = t0;
+        r->produced[i] = produced;
+        r->at_ms[i] = now;
+        const double dt = (double) (now - t0);
+        r->rate[i] = dt > 0 && t0 > 0 ? 1000.0 * (double) produced / dt : 0.0;
+        return r->rate[i];
+    }
+    const int64_t dt = now - r->at_ms[i];
+    if (dt < 100) return r->rate[i];
+    const double inst = 1000.0 * (double) (produced - r->produced[i]) / (double) dt;
+    r->rate[i] = 0.5 * r->rate[i] + 0.5 * inst;
+    r->produced[i] = produced;
+    r->at_ms[i] = now;
+    return r->rate[i];
+}
+}  // namespace detail
+
+// with_t: the "t" and "seq" keys (the emitter compares the rest to decide whether anything changed)
+inline std::string to_json(State& S, int64_t now, Rates* rates, bool with_t = true) {
+    using detail::num;
+    std::string s;
+    s.reserve(1024);
+    s += "{\"v\":1";
+    if (with_t) {
+        s += ",\"t\":";
+        num(s, now);
+        s += ",\"seq\":";
+        s += std::to_string((unsigned long long) S.seq.load(std::memory_order_relaxed));
+    }
+    const int lanes_live = S.lanes_live.load(std::memory_order_relaxed);
+    const char* wait = S.lanes_wait.load(std::memory_order_relaxed);
+    s += ",\"lanes\":{\"on\":";
+    num(s, (int64_t) S.lanes_on.load(std::memory_order_relaxed));
+    s += ",\"live\":";
+    num(s, (int64_t) lanes_live);
+    s += ",\"n\":";
+    num(s, (int64_t) S.lanes_n.load(std::memory_order_relaxed));
+    s += ",\"starts\":";
+    num(s, S.lanes_starts.load(std::memory_order_relaxed));
+    s += ",\"wait\":";
+    if (wait != nullptr && !lanes_live) {
+        s += '"';
+        for (const char* c = wait; *c; ++c)
+            if (*c != '"' && *c != '\\' && (unsigned char) *c >= 0x20) s += *c;
+        s += '"';
+    } else {
+        s += "null";
+    }
+    s += "},\"overlap\":{\"active\":";
+    num(s, (int64_t) S.overlap.load(std::memory_order_relaxed));
+    s += "},\"solo\":";
+    if (S.solo.active.load(std::memory_order_relaxed)) {
+        const int64_t prod = S.solo.produced.load(std::memory_order_relaxed);
+        const int64_t off = S.solo.offered.load(std::memory_order_relaxed);
+        const int64_t acc = S.solo.accepted.load(std::memory_order_relaxed);
+        const int64_t t0 = S.solo.t0_ms.load(std::memory_order_relaxed);
+        s += "{\"mode\":\"";
+        s += S.solo.pipelined.load(std::memory_order_relaxed) ? "solo_pl" : "solo_serial";
+        s += "\",\"tok\":";
+        num(s, prod);
+        s += ",\"tok_s\":";
+        num(s, detail::recent(rates, kSlots, prod, t0, now));
+        s += ",\"offered\":";
+        num(s, off);
+        s += ",\"accepted\":";
+        num(s, acc);
+        s += ",\"acc\":";
+        detail::frac(s, acc, off);
+        s += '}';
+    } else {
+        s += "null";
+    }
+    // the reads first: a slot that is read shows that
+    const int n_slots = std::min(S.n_slots.load(std::memory_order_relaxed), kSlots);
+    int read_of[kSlots];
+    for (int b = 0; b < kSlots; ++b) read_of[b] = -1;
+    std::string reads = "[";
+    const bool decoding = S.any_decoding.load(std::memory_order_relaxed) != 0;
+    for (int i = 0; i < kReads; ++i) {
+        const Read& R = S.reads[i];
+        const int st = R.state.load(std::memory_order_relaxed);
+        if (st == read_free) continue;
+        const int slot = R.slot.load(std::memory_order_relaxed);
+        const int64_t done = R.done.load(std::memory_order_relaxed), from = R.from.load(std::memory_order_relaxed);
+        const int64_t t0 = R.t0_ms.load(std::memory_order_relaxed);
+        const bool ov = R.overlapped.load(std::memory_order_relaxed) != 0;
+        if (slot >= 0 && slot < kSlots) read_of[slot] = i;
+        if (reads.size() > 1) reads += ',';
+        reads += "{\"slot\":";
+        num(reads, (int64_t) slot);
+        reads += ",\"done\":";
+        num(reads, done);
+        reads += ",\"total\":";
+        num(reads, R.total.load(std::memory_order_relaxed));
+        reads += ",\"from\":";
+        num(reads, from);
+        reads += ",\"tok_s\":";
+        num(reads, now > t0 && done > from ? 1000.0 * (double) (done - from) / (double) (now - t0) : 0.0);
+        reads += ",\"beside\":\"";
+        reads += ov ? "decode" : decoding ? "paused" : "none";
+        reads += "\",\"state\":\"";
+        reads += st == read_wait ? "wait" : st == read_yielded ? "yielded" : "run";
+        reads += "\"}";
+    }
+    reads += ']';
+    s += ",\"slots\":[";
+    bool first = true;
+    for (int b = 0; b < n_slots; ++b) {
+        const Slot& L = S.slots[b];
+        const int m = L.mode.load(std::memory_order_relaxed);
+        const int ri = read_of[b];
+        if (m == idle && ri < 0) continue;
+        if (!first) s += ',';
+        first = false;
+        s += "{\"s\":";
+        num(s, (int64_t) b);
+        s += ",\"m\":\"";
+        s += ri >= 0 ? (S.reads[ri].overlapped.load(std::memory_order_relaxed) ? "read_ovl" : "reading") : mode_name(m);
+        s += "\",\"lane\":";
+        num(s, (int64_t) L.lane.load(std::memory_order_relaxed));
+        if (ri < 0 && (m == batch || m == lane)) {
+            const int64_t prod = L.produced.load(std::memory_order_relaxed);
+            const int64_t t0 = L.t0_ms.load(std::memory_order_relaxed);
+            const int64_t off = L.offered.load(std::memory_order_relaxed);
+            const int64_t acc = L.accepted.load(std::memory_order_relaxed);
+            s += ",\"tok\":";
+            num(s, prod);
+            s += ",\"tok_s\":";
+            num(s, detail::recent(rates, b, prod, t0, now));
+            s += ",\"tok_s_mean\":";
+            num(s, now > t0 && t0 > 0 ? 1000.0 * (double) prod / (double) (now - t0) : 0.0);
+            s += ",\"offered\":";
+            num(s, off);
+            s += ",\"accepted\":";
+            num(s, acc);
+            s += ",\"acc\":";
+            detail::frac(s, acc, off);
+        }
+        s += '}';
+    }
+    s += "],\"reads\":";
+    s += reads;
+    s += '}';
+    return s;
+}
+
+// the emitter: started once, after READY, only when on().  A line when the content changed (at most one per period),
+// else one every 10 periods; one printf per line (stdio's lock: it cannot tear against the loop's BT lines)
+inline void start_emitter() {
+    if (!on()) return;
+    std::printf("INFO status_lines=%d\n", period_ms());
+    std::fflush(stdout);
+    std::thread([] {
+        State& S = state();
+        Rates rates;
+        std::string last;
+        int quiet = 0;
+        const int p = period_ms();
+        while (!S.stop.load(std::memory_order_relaxed)) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(p));
+            if (S.stop.load(std::memory_order_relaxed)) break;
+            const int64_t now = now_ms();
+            Rates probe = rates;   // (the change test must not advance the rates)
+            const std::string body = to_json(S, now, &probe, false);
+            if (body == last && ++quiet < 10) continue;
+            quiet = 0;
+            last = body;
+            const std::string line = to_json(S, now, &rates, true);
+            std::printf("STAT %s\n", line.c_str());
+            std::fflush(stdout);
+        }
+    }).detach();
+}
+inline void stop_emitter() { state().stop.store(true, std::memory_order_relaxed); }
+
+}  // namespace strata::program::live_status
