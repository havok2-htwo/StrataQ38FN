+// STRATA_STATUS_LINES (include/strata/program/live_status.hpp): the switch and the STAT line's JSON for the modes the
+// serve loop publishes (slots, lanes, reads, solo).  Header-only, CPU: no model, no GPU.
+#include "strata/program/live_status.hpp"
+
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+namespace ls = strata::program::live_status;
+
+namespace {
+int failures = 0;
+void check(bool ok, const char* what) {
+    if (!ok) {
+        std::fprintf(stderr, "FAIL: %s\n", what);
+        ++failures;
+    }
+}
+bool has(const std::string& s, const char* part) { return s.find(part) != std::string::npos; }
+}  // namespace
+
+int main() {
+    // the switch: unset, empty, 0, negative and text are off; small periods are raised to 50 ms
+    check(ls::parse_period(nullptr) == 0, "unset is off");
+    check(ls::parse_period("") == 0, "empty is off");
+    check(ls::parse_period("0") == 0, "0 is off");
+    check(ls::parse_period("-5") == 0, "negative is off");
+    check(ls::parse_period("yes") == 0, "text is off");
+    check(ls::parse_period("500") == 500, "500 ms");
+    check(ls::parse_period("1") == 50, "at least 50 ms");
+
+    // an idle engine: no slot, no read, no solo
+    {
+        ls::State S;
+        S.n_slots.store(16);
+        const std::string j = ls::to_json(S, 1000, nullptr, true);
+        check(has(j, "\"v\":1"), "versioned");
+        check(has(j, "\"t\":1000"), "the time");
+        check(has(j, "\"slots\":[]"), "idle slots are left out");
+        check(has(j, "\"reads\":[]"), "no read");
+        check(has(j, "\"solo\":null"), "no solo");
+        check(has(j, "\"wait\":null"), "no lane wait");
+        check(!has(ls::to_json(S, 1000, nullptr, false), "\"t\":"), "without t");
+    }
+    // two lanes running, one batch slot with MTP drafts, a cached slot, a read overlapped beside decode in slot 5
+    {
+        ls::State S;
+        S.n_slots.store(16);
+        S.lanes_on.store(4);
+        S.lanes_live.store(1);
+        S.lanes_n.store(2);
+        S.any_decoding.store(3);
+        S.slots[0].mode.store(ls::lane);
+        S.slots[0].lane.store(0);
+        S.slots[0].produced.store(300);
+        S.slots[0].t0_ms.store(0 + 1);
+        S.slots[0].offered.store(100);
+        S.slots[0].accepted.store(70);
+        S.slots[4].mode.store(ls::lane);
+        S.slots[4].lane.store(1);
+        S.slots[1].mode.store(ls::batch);
+        S.slots[2].mode.store(ls::cached);
+        S.slots[8].mode.store(ls::parking);
+        S.slots[9].mode.store(ls::yielded);
+        const int i = ls::read_begin(5, 30000, 1000, S);
+        check(i == 0, "the first read takes entry 0");
+        ls::read_progress(8192, S);
+        ls::read_overlapped(true, S);
+        const std::string j = ls::to_json(S, 10001, nullptr, true);
+        check(has(j, "\"lanes\":{\"on\":4,\"live\":1,\"n\":2"), "lanes");
+        check(has(j, "{\"s\":0,\"m\":\"lane\",\"lane\":0,\"tok\":300"), "slot 0 in lane 0");
+        check(has(j, "\"acc\":0.700"), "acceptance");
+        check(has(j, "{\"s\":1,\"m\":\"batch\""), "slot 1 in the batch windows");
+        check(has(j, "{\"s\":2,\"m\":\"cached\""), "slot 2 cached");
+        check(has(j, "{\"s\":8,\"m\":\"parking\""), "slot 8 parking");
+        check(has(j, "{\"s\":9,\"m\":\"yielded\""), "slot 9 gave way");
+        check(has(j, "{\"s\":5,\"m\":\"read_ovl\""), "slot 5 read beside decode");
+        check(has(j, "\"reads\":[{\"slot\":5,\"done\":8192,\"total\":30000,\"from\":1000"), "the read's progress");
+        check(has(j, "\"beside\":\"decode\",\"state\":\"run\""), "beside decode, running");
+        check(has(j, "\"overlap\":{\"active\":1}"), "overlap");
+        ls::read_overlapped(false, S);
+        check(has(ls::to_json(S, 10001, nullptr), "\"m\":\"reading\""), "a read with the slots paused");
+        check(has(ls::to_json(S, 10001, nullptr), "\"beside\":\"paused\""), "paused beside");
+        // a second (concurrent) read: another entry, nothing else changes
+        const int k = ls::read_begin(6, 500, 0, S);
+        check(k == 1, "a second read takes entry 1");
+        const std::string j2 = ls::to_json(S, 10001, nullptr);
+        check(has(j2, "{\"slot\":5,") && has(j2, "{\"slot\":6,"), "two reads listed");
+        ls::request_end(S);   // ends the current (main) read only
+        const std::string j3 = ls::to_json(S, 10001, nullptr);
+        check(!has(j3, "{\"slot\":6,") && has(j3, "{\"slot\":5,"), "request_end ends its own read");
+    }
+    // a solo request, pipelined, and the lanes waiting for a reason (quotes are dropped from it)
+    {
+        ls::State S;
+        S.lanes_on.store(4);
+        S.lanes_wait.store("a \"prompt\" read overlaps");
+        ls::solo_begin(true, S);
+        ls::solo_progress(120, 100, 68, S);
+        const std::string j = ls::to_json(S, ls::now_ms(), nullptr);
+        check(has(j, "\"solo\":{\"mode\":\"solo_pl\",\"tok\":120"), "solo pipelined");
+        check(has(j, "\"acc\":0.680"), "solo acceptance");
+        check(has(j, "\"wait\":\"a prompt read overlaps\""), "lane wait reason, escaped");
+        ls::request_end(S);
+        check(has(ls::to_json(S, ls::now_ms(), nullptr), "\"solo\":null"), "solo ends with the request");
+    }
+    // recent tok/s: an EMA over the samples, reset by a new request
+    {
+        ls::Rates r;
+        const double a = ls::detail::recent(&r, 0, 10, 1000, 2000);   // 10 tokens in 1 s since t0
+        check(a > 9.9 && a < 10.1, "first sample: the mean since t0");
+        const double b = ls::detail::recent(&r, 0, 40, 1000, 3000);   // +30 in 1 s
+        check(b > 19.9 && b < 20.1, "EMA of 10 and 30");
+        const double c = ls::detail::recent(&r, 0, 5, 2500, 3000);    // a new request (t0 changed)
+        check(c > 9.9 && c < 10.1, "reset on a new request");
+    }
+    if (failures == 0) std::printf("live_status_test: all checks passed\n");
+    return failures == 0 ? 0 : 1;
+}
