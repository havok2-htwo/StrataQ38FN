+
+    def _new_tokens(self, ids: list[int] | None, plen: int = 0) -> int:
+        """STRATA_YIELD_SHORT (the caller holds slot_cv): the tokens a prompt would read - its length minus the longest
+        start of it a slot holds (what the engine reuses from a slot; its RAM cache is not seen here)."""
+        if ids is None:
+            return plen
+        best = 0
+        for h in self.slot_held:
+            if h and best < len(h) < len(ids) and ids[:len(h)] == h:
+                best = len(h)
+        return len(ids) - best
+
+    def _yield_row(self) -> int:
+        """The engine's rule for a slot a read may give way into (INFO yield_row=k: b % k == k - 1); 0: no such engine."""
+        info = self.info or {}
+        if YIELD_SHORT <= 0 or not info.get("read_yield"):
+            return 0
+        k = info.get("yield_row")
+        return k if isinstance(k, int) and k >= 1 else 1
+
+    def _yield_slot_ok(self, slot) -> bool:
+        """STRATA_YIELD_SHORT: may the engine keep a read that gives way in this slot (no pad row writes it)."""
+        k = self._yield_row()
+        return slot is not None and (k <= 1 or slot % k == k - 1)
 
