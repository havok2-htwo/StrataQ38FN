--- /dev/null
+++ b/serve/test_read_yield.py
@@ -0,0 +1,212 @@
+"""serve/test_read_yield.py - STRATA_YIELD_SHORT with an engine run with STRATA_READ_YIELD=1 (INFO read_yield=1
+yield_row=k): which waiting request a read gives way to (new tokens, not prompt length), into which slot (the top row
+of a pipelined group, where no pad row writes it), and the retry after the engine's YIELDNO.  Unset: the #656 rule as
+before.  No GPU: the unit part has no process, the service part runs test_parallel's fake engine with the YIELDNO rule.
+
+    python -m unittest serve.test_read_yield -v
+"""
+from __future__ import annotations
+
+import sys
+import threading
+import time
+import unittest
+from pathlib import Path
+from unittest import mock
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import serve.server as server  # noqa: E402
+from serve.server import StrataEngine  # noqa: E402
+from serve.test_parallel import FAKE_BATCH, ParallelService  # noqa: E402
+
+
+def engine(n, info=None, gs=0):
+    e = StrataEngine("missing-executable", [], lazy=True)
+    e.batch = n
+    e.slot_order = [g * gs + t for t in range(gs) for g in range(n // gs)] if gs else list(range(n))
+    e.slot_busy = [False] * n
+    e.slot_held = [[] for _ in range(n)]
+    e.slot_used = [0.0] * n
+    e.slot_live = [None] * n
+    e.slot_group = [b // gs if gs else 0 for b in range(n)]
+    e.slot_groups = n // gs if gs else 1
+    e.slot_gs = gs
+    e.slot_cv = threading.Condition()
+    e.wait_lens = []
+    e.info = dict(info or {})
+    return e
+
+
+class Rules(unittest.TestCase):
+    def test_new_tokens_count_what_a_slot_does_not_hold(self):
+        e = engine(4)
+        e.slot_held[2] = list(range(100))
+        self.assertEqual(e._new_tokens(list(range(130))), 30)          # a follow-up of slot 2's conversation
+        self.assertEqual(e._new_tokens(list(range(1, 131))), 130)       # not a start of it
+        self.assertEqual(e._new_tokens(list(range(100))), 100)          # a held prompt is never the whole prompt
+        self.assertEqual(e._new_tokens(None, 77), 77)
+
+    def test_unset_keeps_the_656_rule(self):
+        e = engine(4, {"read_yield": 1, "yield_row": 4})
+        e.wait_lens = [[400, 0.0, True, list(range(400))]]
+        with mock.patch.object(server, "YIELD_SHORT", 0):
+            self.assertTrue(e._shorter_waiting(1000, list(range(1000))))
+            self.assertFalse(e._shorter_waiting(700, list(range(700))))
+            self.assertEqual(e._yield_row(), 0)
+            self.assertTrue(e._yield_slot_ok(1))
+
+    def test_short_by_new_tokens(self):
+        e = engine(4, {"read_yield": 1, "yield_row": 4})
+        conv = list(range(50000))
+        e.slot_held[0] = conv
+        with mock.patch.object(server, "YIELD_SHORT", 2048), mock.patch.object(server, "YIELD_MIN_LEFT", 8192):
+            # a 50,300-token follow-up whose 50,000 a slot holds waits: 300 new tokens, worth giving way to
+            e.wait_lens = [[50300, 0.0, True, conv + list(range(9, 309))]]
+            self.assertTrue(e._shorter_waiting(100000, list(range(100000))))
+            # the #656 rule would not have (50,300 is not under half of 100,000 ... and 60,000)
+            self.assertFalse(e._shorter_waiting(60000, list(range(60000))) and 50300 * 2 <= 60000)
+            # a waiting fresh 3,000-token prompt is not short
+            e.wait_lens = [[3000, 0.0, True, list(range(7, 3007))]]
+            self.assertFalse(e._shorter_waiting(100000, list(range(100000))))
+            # an entry without tokens counts its length
+            e.wait_lens = [[1500, 0.0, True]]
+            self.assertTrue(e._shorter_waiting(100000, list(range(100000))))
+            # the running read is nearly done: no yield
+            e.progress = (95000, 100000)
+            self.assertFalse(e._shorter_waiting(100000, list(range(100000))))
+            e.progress = (10000, 100000)
+            self.assertTrue(e._shorter_waiting(100000, list(range(100000))))
+        # an engine without STRATA_READ_YIELD: the old rule even with the variable set
+        e.info = {}
+        with mock.patch.object(server, "YIELD_SHORT", 2048):
+            e.wait_lens = [[1500, 0.0, True]]
+            self.assertTrue(e._shorter_waiting(4000, list(range(4000))))
+            self.assertFalse(e._shorter_waiting(2000, list(range(2000))))
+
+    def test_slot_rule(self):
+        e = engine(16, {"read_yield": 1, "yield_row": 4}, gs=4)
+        with mock.patch.object(server, "YIELD_SHORT", 2048):
+            self.assertEqual([b for b in range(16) if e._yield_slot_ok(b)], [3, 7, 11, 15])
+            e.info["yield_row"] = 1
+            self.assertTrue(all(e._yield_slot_ok(b) for b in range(16)))
+            self.assertFalse(e._yield_slot_ok(None))
+
+    def test_a_read_that_may_give_way_takes_a_top_row_slot(self):
+        e = engine(16, {"read_yield": 1, "yield_row": 4}, gs=4)
+        long_p, short_p = list(range(20000)), list(range(300))
+        with mock.patch.object(server, "YIELD_SHORT", 2048), mock.patch.object(server, "YIELD_MIN_LEFT", 8192):
+            with e.slot_cv:
+                self.assertEqual(e.pick_slot(short_p), 0)                 # short: the usual spreading order
+                self.assertIn(e.pick_slot(long_p), (3, 7, 11, 15))        # long: a top row
+                e.slot_busy[4] = e.slot_busy[5] = e.slot_busy[6] = True   # group 1 full below its top: no pad row added
+                self.assertEqual(e.pick_slot(long_p), 7)
+                e.slot_busy[7] = True
+                e.slot_busy[9] = True                                      # group 2: one row below the top stays pad
+                self.assertEqual(e.pick_slot(long_p), 11)
+                for b in (3, 11, 15):
+                    e.slot_busy[b] = True
+                self.assertEqual(e.pick_slot(long_p), 0)                  # no top row free: the usual choice
+            with mock.patch.object(server, "YIELD_TOP_ROW", False):
+                e.slot_busy = [False] * 16
+                with e.slot_cv:
+                    self.assertEqual(e.pick_slot(long_p), 0)
+        with mock.patch.object(server, "YIELD_SHORT", 0):                 # unset: as before
+            e.slot_busy = [False] * 16
+            with e.slot_cv:
+                self.assertEqual(e.pick_slot(long_p), 0)
+
+
+# the fake engine with STRATA_READ_YIELD's answers: INFO read_yield=1 yield_row=K, YIELDNO for a slot that is not a
+# top row (and, with --yield-no-first, for the first BYIELD it gets)
+FAKE_YIELD = FAKE_BATCH.replace(
+    'groups = int(args[args.index("--says-groups") + 1]) if "--says-groups" in args else 0',
+    'groups = int(args[args.index("--says-groups") + 1]) if "--says-groups" in args else 0\n'
+    'RY = int(args[args.index("--read-yield") + 1]) if "--read-yield" in args else 0\n'
+    'NOFIRST = "--yield-no-first" in args\n'
+    'refused_once = []').replace(
+    '(f" batch_groups={groups}" if groups > 1 else ""), flush=True)',
+    '(f" batch_groups={groups}" if groups > 1 else "") + (f" read_yield=1 yield_row={RY}" if RY else ""), flush=True)'
+).replace(
+    '''                    if len(ids) - 1 - q > CH and (slot is None or ys == slot) and given is None:
+                        given = (ys, q)''',
+    '''                    if RY and (ys % RY != RY - 1 or (NOFIRST and not refused_once)):
+                        refused_once.append(ys)
+                        print(f"YIELDNO {ys}", flush=True)
+                        if log:
+                            log.write(f"YIELDNO {ys}\\n"); log.flush()
+                    elif len(ids) - 1 - q > CH and (slot is None or ys == slot) and given is None:
+                        given = (ys, q)''')
+
+
+class YieldService(ParallelService):
+    """The real StrataEngine and Service over HTTP with the fake engine's STRATA_READ_YIELD answers."""
+
+    def start(self, slots, *a, **kw):
+        with mock.patch("serve.test_parallel.FAKE_BATCH", FAKE_YIELD):
+            super().start(slots, *a, **kw)
+
+    def setUp(self):
+        self.assertIn("read_yield=1", FAKE_YIELD)
+        self.assertIn("YIELDNO", FAKE_YIELD)
+        patches = [mock.patch.object(server, "YIELD_SHORT", 200), mock.patch.object(server, "YIELD_MIN_LEFT", 256),
+                   mock.patch.object(server, "YIELD_RETRY_S", 0.05)]
+        for p in patches:
+            p.start()
+            self.addCleanup(p.stop)
+
+    def test_a_long_solo_read_gives_way_from_a_top_row_slot(self):
+        self.start(4, says_groups=2, more=["--read-yield", "2"])
+        long_q, short_q = "long " * 600, "short"
+        res = self.race(long_q, short_q)
+        self.assertEqual(res[long_q][0], "ok, done.")
+        self.assertEqual(res[short_q][0], "ok, done.")
+        self.assertLess(res[short_q][1], res[long_q][1] - 0.5, res)
+        log = self.log.read_text().splitlines()
+        yields = [x.split() for x in log if x.startswith("YIELD ")]
+        self.assertTrue(yields, log)
+        self.assertEqual(int(yields[0][1]) % 2, 1, log)                     # a top row (k = 2: slots 1 and 3)
+        self.assertFalse(any(x.startswith("YIELDNO") for x in log), log)
+        # the long one went on in that slot
+        resumed = [x.split() for x in log if x.startswith("BGEN ") and int(x.split()[2]) > 2600]
+        self.assertTrue(resumed and resumed[0][1] == yields[0][1], log)
+        self.assertFalse(any(self.engine.slot_busy))
+
+    def test_asked_again_after_yieldno(self):
+        self.start(4, says_groups=2, more=["--read-yield", "2", "--yield-no-first"])
+        long_q, short_q = "long " * 600, "short"
+        res = self.race(long_q, short_q)
+        self.assertEqual(res[long_q][0], "ok, done.")
+        self.assertEqual(res[short_q][0], "ok, done.")
+        log = self.log.read_text().splitlines()
