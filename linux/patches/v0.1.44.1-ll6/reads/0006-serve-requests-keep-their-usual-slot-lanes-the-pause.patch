+    def _yield_park_pick(self, own, prompt: list[int]):
+        """STRATA_YIELD_SHORT (the caller holds slot_cv): the slot a read's paused part waits in - its own admission's
+        slot when the engine can keep it there (a top row, or any slot without pipelined groups), else a free top-row
+        slot (one that holds nothing first, then the one used longest ago; it is idle meanwhile, so it widens no
+        group's window).  The request itself decodes in its own slot later.  None: none free now (asked again later)."""
+        if own is not None and self._yield_slot_ok(own):
+            return own
+        free = [b for b in self.slot_order if not self.slot_busy[b] and self._yield_slot_ok(b)]
+        if not free:
+            return None
+        return min(free, key=lambda b: (bool(self.slot_held[b]), self.slot_used[b]))
