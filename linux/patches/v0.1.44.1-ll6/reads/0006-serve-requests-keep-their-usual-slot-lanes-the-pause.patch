+    def _short_waiting_besides(self, me) -> bool:
+        """STRATA_YIELD_SHORT (the caller holds slot_cv): a request other than `me` waits with at most that many new
+        tokens - a paused read (`me`) waits for it.  Not after STRATA_ADMIT_MAX_WAIT_S of waiting (never for good)."""
+        if ADMIT_MAX_WAIT_S > 0 and time.monotonic() - me[1] >= ADMIT_MAX_WAIT_S:
+            return False
+        return any(e is not me and self._entry_new(e) <= YIELD_SHORT for e in self.wait_lens)
+
+    def _entry_new(self, e) -> int:
+        """_new_tokens of a waiting entry ([plen, arrival, new, ids, cache]) or of [ids, cache], computed again only when
+        a slot's held tokens changed (each assignment puts a new list there: their ids and lengths are the key), so the
+        checks under slot_cv do not compare long token lists every time."""
+        if e and isinstance(e[0], list):
+            ids, plen, at = e[0], len(e[0]), 1
+        elif len(e) > 3:
+            ids, plen, at = e[3], e[0], 4
+        else:
+            return e[0]
+        key = tuple((id(h), len(h)) for h in self.slot_held)
+        if len(e) > at and e[at][0] == key:
+            return e[at][1]
+        v = self._new_tokens(ids, plen)
+        if len(e) > at:
+            e[at] = (key, v)
+        else:
+            e.append((key, v))
+        return v
 
