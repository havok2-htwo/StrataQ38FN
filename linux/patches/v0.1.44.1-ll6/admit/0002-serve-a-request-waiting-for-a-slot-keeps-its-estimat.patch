@@ -1510,16 +1510,17 @@ class StrataEngine:
     YIELDS_MAX = 2   # #656: how often one request's prompt read gives way to a shorter waiting one
 
     def _take_control(self, cancel, plen: int, after_epoch: int | None = None, new: bool = False,
-                      quiet: bool = False, total: int | None = None):
+                      quiet: bool = False, total: int | None = None, since: float | None = None):
         """Waits for the control lines (one prompt read at a time), yielding None heartbeats; False when cancelled.
         `after_epoch`: a request whose read gave way lets the requests waiting then go first.  `new`: a request not
         admitted yet - while an image request waits for the engine alone, or has it (image_line), it stands back and
         is not counted as waiting meanwhile (a read that gave way to it would otherwise wait for it, holding the slot
         the image request waits for).  `quiet`: the image request itself, never counted as waiting (a solo request is
         not moved into a slot for it, and no read gives way to it).  `total`: the prompt's length when `plen` is the
-        estimate of its new tokens (STRATA_ADMIT_BY_NEW; /v1/load shows both)."""
+        estimate of its new tokens (STRATA_ADMIT_BY_NEW; /v1/load shows both).  `since`: its first arrival (a request
+        not admitted yet that asks again after waiting for a slot keeps its place and its STRATA_ADMIT_MAX_WAIT_S)."""
         # (length - or est. new tokens, arrival, ordered: STRATA_ADMIT_SHORT_FIRST, total length)
-        entry = [plen, time.monotonic(), new, plen if total is None else int(total)]
+        entry = [plen, time.monotonic() if since is None else float(since), new, plen if total is None else int(total)]
         counted = stood = False                         # stood: standing back for an image request (/v1/load counts it)
         with self.slot_cv:
             if not quiet and not (new and self.image_line):
@@ -1598,7 +1599,8 @@ class StrataEngine:
         """STRATA_ADMIT_SHORT_FIRST=<tokens> (the caller holds slot_cv): the new request that takes the control lines
         next - one whose prompt is at most that long (it reads little) before a longer one, in arrival order within
         each; a longer one that has waited STRATA_ADMIT_MAX_WAIT_S counts as short (it is never held back for good).
-        With STRATA_ADMIT_BY_NEW an entry's length is the estimate of the tokens it will read (generate_batched).
+        With STRATA_ADMIT_BY_NEW an entry's length is the estimate of the tokens it will read (generate_batched) - the
+        same threshold on it (two groups, arrival order within each), not a sort by it.
         Off (unset or 0): whoever gets the lock first, as before.  Only the order changes, never what is read."""
         now = time.monotonic()
         ordered = [e for e in self.wait_lens if len(e) > 2 and e[2]]
@@ -1821,12 +1823,20 @@ class StrataEngine:
             return
         holding, born = True, self.gen                  # (the engine it now has the control lines of)
         btrace("ctl acquired")
-        if est is not None:
+        noted = est is None
+
+        def admitted():       # STRATA_ADMIT_BY_NEW: once, as its first read is sent (it holds the lines and a slot)
+            nonlocal noted, est_chain
+            if noted:
+                return
+            noted = True
+            waited = time.monotonic() - asked_at
             with self.slot_cv:
                 behind = int(self.waiting)
+            kind = ("short" if rank <= ADMIT_SHORT_FIRST else
+                    "long, max-wait" if waited >= ADMIT_MAX_WAIT_S else "long")
             print(f"[strata] admit: total {len(prompt)}, est. new {rank} (cached ~{len(prompt) - rank}), "
-                  f"waited {time.monotonic() - asked_at:.1f} s, "
-                  f"{'short' if rank <= ADMIT_SHORT_FIRST else 'long'}, {behind} waiting", flush=True)
+                  f"waited {waited:.1f} s, {kind}, {behind} waiting", flush=True)
             try:
                 est_chain = est.note(prompt, est_chain)   # read now: a request with the same start reuses it
             except Exception:
@@ -1850,6 +1860,7 @@ class StrataEngine:
                     self._last_done = None                  # (#879: this request's DONE decides below)
                     self._send(f"{head} {','.join(str(int(t)) for t in prompt)}")
                     phase = "solo"
+                    admitted()
                     self._note_where("solo")
                     self._ctl_mode, self._ctl_result, self._yielded = "solo", None, None
                     self._ctl_erred = False
@@ -1941,7 +1952,11 @@ class StrataEngine:
                             if cancel.is_set():
                                 return
                             if not holding:             # (one with nothing generated yet is not admitted yet)
-                                ok = yield from self._take_control(cancel, len(prompt), new=not out)
+                                # not admitted yet (nothing generated): it asks again as it did first - by its
+                                # estimate (not re-estimated: its own prompt is noted), keeping its arrival time
+                                ok = yield from (self._take_control(cancel, rank, new=True, total=len(prompt),
+                                                                    since=asked_at) if not out else
+                                                 self._take_control(cancel, len(prompt)))
                                 if not ok:
                                     return
                                 holding, born = True, self.gen
@@ -1970,6 +1985,7 @@ class StrataEngine:
                     self._send(f"{head} {','.join(str(int(t)) for t in prompt)}")
                     self.slot_held[slot] = []               # the admission overwrites what the slot held
                     phase = "admit"
+                    admitted()
                     self._note_where("slot", slot)
                     self._ctl_mode, self._ctl_result, self._yielded = "batch", None, None
                     self._ctl_erred = False
@@ -2104,17 +2120,18 @@ class StrataEngine:
                 if bd is not None:
                     self._apply_bdone(bd.split())
                     bdone_in = True
-            if est is not None and est_chain is not None and len(out) > 1:
-                try:                                    # STRATA_ADMIT_BY_NEW: the next turn starts with these
-                    est.note(list(ids) + out[:-1], est_chain)
-                except Exception:
-                    pass
             if reused0 is not None and isinstance(self.last, dict):
                 self.last = {**self.last, "reused": reused0}
             if carry and isinstance(self.last, dict):
                 self.last = add_carry(carry, self.last)
             if holding:
                 self.ctl.release()
+            if (est is not None and est_chain is not None and len(out) > 1 and self.gen == born and
+                    est.gen == born):                   # (after the lines are given back; not after a restart)
+                try:                                    # STRATA_ADMIT_BY_NEW: the next turn starts with these
+                    est.note(list(ids) + out[:-1], est_chain)
+                except Exception:
+                    pass
             if admit_wait:
                 with self.slot_cv:
                     self.admitting = max(0, self.admitting - 1)
