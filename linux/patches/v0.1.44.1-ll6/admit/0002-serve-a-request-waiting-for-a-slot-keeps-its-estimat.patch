--- a/serve/server.py
+++ b/serve/server.py
@@ -314,7 +314,7 @@ def admit_env(env) -> tuple[int, bool, float, int]:
         blocks = max(1, int(env.get("STRATA_ADMIT_EST_BLOCKS") or 65536))
     except ValueError:
