+def admit_env(env) -> tuple[int, bool, float, int]:
+    """(STRATA_ADMIT_SHORT_FIRST, STRATA_ADMIT_BY_NEW, STRATA_ADMIT_MAX_WAIT_S, STRATA_ADMIT_EST_BLOCKS) - see above."""
+    try:
