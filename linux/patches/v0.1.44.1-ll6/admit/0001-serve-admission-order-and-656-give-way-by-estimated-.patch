+"""serve/admit_est.py - STRATA_ADMIT_BY_NEW=1: how many tokens of a waiting prompt the engine will most likely have to
+READ, so the admission order (StrataEngine._admit_next, the #656 give-way) ranks requests by their new tokens instead
+of their total length (opt-in).
+
+A multi-turn follow-up is long in total (15-20K tokens) but its start is the previous turn's prompt and reply, which
+the engine's conversation cache (or the slot that ran it) still holds: only the last ~4K are read.  Ranked by the
+total it waits behind every cold first-turn read (results/mt-regression-2026-10-17.md).
+
+The estimate: the longest start the prompt shares, in whole BLOCK-token blocks, with what this server recently sent the
+engine - a prompt when its read began, its prompt + generated tokens when it ended.  Each block has a chained hash
+(block k's hash covers tokens 0 up to the end of block k), so "the first k blocks are known" is one dict lookup per
+block, O(len / BLOCK) per request.  The hashes are kept in one LRU of at most `max_blocks` entries (about 80 bytes
+each: 65536 blocks ~ 5 MB, covering 16M distinct prefix tokens); a conversation's turns share their start blocks, so
+the many turns of one conversation cost only their new blocks.  A sequence is entered deepest block first, so its
+start is the freshest part and the last to be dropped (a lookup stops at the first unknown block anyway).
+
+It is only an estimate - the server does not see what the engine evicted (its RAM cache, the checkpoints it falls
+back to, a restart), and Python's hash() of an int tuple is not keyed (a collision only misorders, never changes
+what is read or generated).  It changes nothing but the order in which waiting requests take the control lines.
+
+    python -m unittest serve.test_admit_est -v
+"""
+from __future__ import annotations
+
+import threading
+
+BLOCK = 256
+SEED = 0x5157_7A1E
+
+
+def chain(ids, block: int = BLOCK, prefix: list[int] | None = None) -> list[int]:
+    """The chained hashes of `ids`' whole blocks.  `prefix`: the chain of a start of `ids` already hashed (its blocks
+    are taken as they are and hashing goes on after them)."""
+    out = list(prefix or ())
+    h = out[-1] if out else SEED
+    n = len(ids) - len(ids) % block
+    for i in range(len(out) * block, n, block):
+        h = hash((h, tuple(ids[i:i + block])))       # (a numpy int hashes as the int)
+        out.append(h)
+    return out
+
+
+class AdmitEstimate:
+    """The recently sent sequences' block hashes (thread-safe).  estimate() -> (est. reused, est. new, chain)."""
+
+    def __init__(self, block: int = BLOCK, max_blocks: int = 65536):
+        self.block, self.max_blocks = int(block), max(1, int(max_blocks))
+        self.known: dict[int, None] = {}            # chained hash -> None, least recently used first
+        self.lock = threading.Lock()
+        self.gen = None                             # the engine process the hashes are for (StrataEngine.gen)
+        self.estimates = self.noted = self.dropped = 0
+
+    def clear(self):
+        with self.lock:
+            self.known.clear()
+
+    def reused(self, ch: list[int]) -> int:
+        """Tokens of the start these block hashes describe that a recent sequence shared (whole blocks); the
+        matched blocks count as used now."""
+        with self.lock:
+            k = 0
+            for h in ch:
+                if h not in self.known:
+                    break
+                k += 1
+            for h in reversed(ch[:k]):              # touched: deepest first, so the start stays the freshest
+                self.known.pop(h, None)
+                self.known[h] = None
+            self.estimates += 1
+        return k * self.block
+
+    def estimate(self, ids) -> tuple[int, int, list[int]]:
+        """(est. reused, est. new, chain) for a prompt.  The engine reads at least one token, so new >= 1."""
+        ch = chain(ids, self.block)
+        n = len(ids)
+        r = min(self.reused(ch), max(0, n - 1))
+        return r, max(1 if n else 0, n - r), ch
+
+    def note(self, ids, prefix: list[int] | None = None) -> list[int]:
+        """`ids` were sent to the engine (a prompt being read, or a prompt + what it generated): their blocks are
+        known now.  `prefix`: the chain of a start of them (from estimate()), not hashed again."""
+        ch = chain(ids, self.block, prefix)
+        with self.lock:
+            for h in reversed(ch):                  # deepest first: the start is the most recently used
+                self.known.pop(h, None)
+                self.known[h] = None
+            while len(self.known) > self.max_blocks:
+                del self.known[next(iter(self.known))]
+                self.dropped += 1
+            self.noted += 1
+        return ch
+
+    def stats(self) -> dict:
+        with self.lock:
+            return {"blocks": len(self.known), "max_blocks": self.max_blocks, "block": self.block,
+                    "estimates": self.estimates, "noted": self.noted, "dropped": self.dropped}
