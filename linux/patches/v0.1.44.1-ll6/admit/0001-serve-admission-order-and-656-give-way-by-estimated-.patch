@@ -0,0 +1,264 @@
+"""serve/test_admit_est.py - STRATA_ADMIT_BY_NEW=1: the admission order by estimated NEW tokens (serve/admit_est.py,
+StrataEngine._take_control / _admit_next / _shorter_waiting / generate_batched; no GPU).
+
+    python -m unittest serve.test_admit_est -v
+"""
+from __future__ import annotations
+
+import contextlib
+import io
+import json
+import random
+import sys
+import time
+import unittest
+from pathlib import Path
+from unittest import mock
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import serve.server as server  # noqa: E402
+from serve.admit_est import BLOCK, AdmitEstimate, chain  # noqa: E402
+from serve import test_admit_order  # noqa: E402
+from serve.test_image_alone import engine_without_process  # noqa: E402
+
+
+def toks(n, seed):
+    r = random.Random(seed)
+    return [r.randrange(150000) for _ in range(n)]
+
+
+class Chain(unittest.TestCase):
+    def test_whole_blocks_only_and_deterministic(self):
+        ids = toks(3 * BLOCK + 17, 1)
+        self.assertEqual(len(chain(ids)), 3)
+        self.assertEqual(chain(ids), chain(list(ids)))
+        self.assertEqual(chain(ids[:BLOCK - 1]), [])
+
+    def test_a_chain_covers_everything_before(self):
+        a, b = toks(2 * BLOCK, 2), toks(2 * BLOCK, 2)
+        b[5] += 1                                       # differs in block 0: every later hash differs too
+        ca, cb = chain(a), chain(b)
+        self.assertNotEqual(ca[0], cb[0])
+        self.assertNotEqual(ca[1], cb[1])
+        c = a[:BLOCK] + toks(BLOCK, 3)                  # same block 0, different block 1
+        self.assertEqual(chain(c)[0], ca[0])
+        self.assertNotEqual(chain(c)[1], ca[1])
+
+    def test_extending_a_prefix_equals_hashing_it_all(self):
+        p = toks(5 * BLOCK + 100, 4)
+        full = p + toks(3 * BLOCK, 5)
+        self.assertEqual(chain(full, prefix=chain(p)), chain(full))
+
+    def test_numpy_like_ints_hash_as_ints(self):
+        try:
+            import numpy as np
+        except ImportError:
+            self.skipTest("numpy not installed")
+        ids = toks(2 * BLOCK, 6)
+        self.assertEqual(chain(np.array(ids, dtype=np.int64)), chain(ids))
+
+
+class Estimate(unittest.TestCase):
+    def test_a_cold_prompt_is_all_new(self):
+        est = AdmitEstimate()
+        p = toks(11000, 7)
+        r, new, ch = est.estimate(p)
+        self.assertEqual((r, new, len(ch)), (0, 11000, 11000 // BLOCK))
+
+    def test_a_follow_up_is_its_new_part(self):
+        """Turn 1 (11K prompt + its reply) noted at its end: turn 2 = all of that + ~4K new reads ~4K."""
+        est = AdmitEstimate()
+        p1 = toks(11000, 8)
+        _, _, ch1 = est.estimate(p1)
+        est.note(p1, ch1)                               # admitted: its read began
+        reply = toks(300, 9)
+        est.note(p1 + reply, ch1)                       # ended
+        p2 = p1 + reply + toks(4100, 10)
+        r, new, _ = est.estimate(p2)
+        self.assertEqual(r, (11300 // BLOCK) * BLOCK)
+        self.assertLess(new, 4100 + BLOCK)
+        self.assertGreaterEqual(new, 4100)
+
+    def test_a_rewritten_reply_still_reuses_the_prompt(self):
+        """The template renders the reply differently next turn (thinking dropped): the prompt's blocks still count."""
+        est = AdmitEstimate()
+        p1 = toks(8000, 11)
+        est.note(p1 + toks(500, 12))
+        p2 = p1 + toks(3000, 13)
+        r, new, _ = est.estimate(p2)
+        self.assertEqual(r, (8000 // BLOCK) * BLOCK)
+
+    def test_a_change_early_on_counts_from_there(self):
+        est = AdmitEstimate()
+        p = toks(10 * BLOCK, 14)
+        est.note(p)
+        q = list(p)
+        q[3 * BLOCK + 7] ^= 1                           # block 3 differs
+        self.assertEqual(est.estimate(q)[0], 3 * BLOCK)
+
+    def test_the_same_prompt_again_reads_at_least_one_token(self):
+        est = AdmitEstimate()
+        p = toks(4 * BLOCK, 15)
+        est.note(p)
+        r, new, _ = est.estimate(p)
+        self.assertEqual((r, new), (4 * BLOCK - 1, 1))
+        self.assertEqual(est.estimate([])[:2], (0, 0))
+
+    def test_bounded_and_the_least_recently_used_goes(self):
+        est = AdmitEstimate(max_blocks=40)
+        old, recent = toks(20 * BLOCK, 16), toks(20 * BLOCK, 17)
+        est.note(old)
+        est.note(recent)
+        self.assertEqual(est.estimate(old + [1])[0], 20 * BLOCK)     # touched now: `recent` is the older one
+        est.note(toks(10 * BLOCK, 18))                          # 10 blocks more: 10 of `recent`'s go
+        self.assertEqual(len(est.known), 40)
+        self.assertEqual(est.estimate(old + [1])[0], 20 * BLOCK)
+        # its start was entered last (deepest first), so its deepest blocks went and its start is still known
+        self.assertEqual(est.estimate(recent)[0], 10 * BLOCK)
+        self.assertEqual(est.stats()["dropped"], 10)
+
+    def test_memory_and_time_stay_small(self):
+        """A few MB for the default 65536 blocks, and a 100K-token prompt estimated in milliseconds."""
+        est = AdmitEstimate()
+        for i in range(70):                                    # 70 conversations of 900 blocks: over the bound
+            est.note(list(range(i << 24, (i << 24) + 900 * BLOCK)))
+        self.assertLessEqual(len(est.known), 65536)
+        size = sys.getsizeof(est.known) + sum(sys.getsizeof(k) for k in est.known)
+        self.assertLess(size, 10 * 1024 * 1024, size)
+        p = toks(100_000, 19)
+        t0 = time.perf_counter()
+        est.estimate(p)
+        self.assertLess(time.perf_counter() - t0, 0.25)
