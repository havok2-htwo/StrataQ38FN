+class Switch(unittest.TestCase):
+    def test_off_unless_asked(self):
+        if "STRATA_ADMIT_BY_NEW" not in __import__("os").environ:
+            self.assertFalse(server.ADMIT_BY_NEW)
+        e = engine_without_process(2)
+        with mock.patch.object(server, "ADMIT_BY_NEW", False):
+            self.assertIsNone(e._admit_estimate())
+            self.assertNotIn("admit_by_new", e.load_counts())
+
+    def test_defaults_when_on(self):
+        self.assertEqual(server.admit_env({"STRATA_ADMIT_BY_NEW": "1"}), (8192, True, 45.0, 65536))
+        self.assertEqual(server.admit_env({"STRATA_ADMIT_BY_NEW": "1", "STRATA_ADMIT_SHORT_FIRST": "4096",
+                                           "STRATA_ADMIT_MAX_WAIT_S": "60", "STRATA_ADMIT_EST_BLOCKS": "1000"}),
+                         (4096, True, 60.0, 1000))
+        self.assertEqual(server.admit_env({"STRATA_ADMIT_BY_NEW": "1", "STRATA_ADMIT_SHORT_FIRST": "0"})[0], 0)
+
+    def test_unchanged_when_off(self):
+        self.assertEqual(server.admit_env({}), (0, False, 30.0, 65536))
+        self.assertEqual(server.admit_env({"STRATA_ADMIT_SHORT_FIRST": "8192"}), (8192, False, 30.0, 65536))
+        self.assertEqual(server.admit_env({"STRATA_ADMIT_SHORT_FIRST": "x", "STRATA_ADMIT_MAX_WAIT_S": "0"}),
+                         (0, False, 0.0, 65536))
+
+    def test_a_new_engine_process_starts_empty(self):
+        e = engine_without_process(2)
+        with mock.patch.object(server, "ADMIT_BY_NEW", True):
+            est = e._admit_estimate()
+            est.note(toks(4 * BLOCK, 20))
+            self.assertIs(e._admit_estimate(), est)
+            self.assertEqual(len(est.known), 4)
+            e.gen += 1                                  # restart(): the engine's caches are gone
+            self.assertIs(e._admit_estimate(), est)
+            self.assertEqual(len(est.known), 0)
