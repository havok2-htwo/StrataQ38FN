 inline bool env_on(const char* own, const char* umbrella) { return own != nullptr ? text_on(own) : text_on(umbrella); }
 
 /// T0a: how many warm checkpoints the pool keeps (0: off).  "1" (or the umbrella alone) is 2, a number N >= 2 is N,
-/// capped at 8 (each is the size of one checkpoint, ~118 MB with a layer split's parts).
+/// capped at 8 (each is the size of one checkpoint, ~118 MB with a layer split's parts: up to ~0.95 GB of host RAM
+/// outside --conversation-cache-mib; a warm checkpoint is made only while --conversation-cache-min-free-mib stays free).
 inline int warm_reserve(const char* own, const char* umbrella) {
     if (!env_on(own, umbrella)) return 0;
     const int n = own != nullptr ? std::atoi(own) : 1;
@@ -47,8 +50,10 @@ inline int warm_reserve(const char* own, const char* umbrella) {
     return n > 8 ? 8 : n;
 }
 
-/// The pool's keep limit with T0a: at least the reserve (the default pool keeps 2).
-inline size_t pool_cap(size_t cap, int reserve) { return reserve > 0 && (size_t) reserve > cap ? (size_t) reserve : cap; }
+/// The pool's keep limit with T0a: the reserve on top of the default limit (the default pool keeps 2), so the gives of
+/// an admission (the slot's old checkpoints, an evicted one) still find room after the warm thread has filled the
+/// reserve; what overflows even then is freed on the warm thread, not the caller's (CheckpointPool::give).
+inline size_t pool_cap(size_t cap, int reserve) { return reserve > 0 ? cap + (size_t) reserve : cap; }
 
 /// Does the pool want another warm checkpoint (`free_n` kept now)?
 inline bool warm_wants(size_t free_n, int reserve) { return reserve > 0 && free_n < (size_t) reserve; }
@@ -125,6 +130,29 @@ inline bool stage_plan(strata::core::ConversationCheckpoint& c, const PartSizes&
     return off == z.bytes();
 }
 
+/// T0b verify (STRATA_SR_CKPT_LATE_VERIFY): do the bytes the late copy wrote (`rg`, stage_plan's regions of one part)
+/// equal a direct save `v` of that part at the same point, in stage_plan's order (gdn, ple, per layer tail, dead,
+/// block_pos)?  False on any size or byte difference.
+inline bool stage_matches(const std::vector<StageRegion>& rg, const strata::core::ConversationCheckpoint& v,
+                          const PartSizes& z) {
+    if (v.gdn.size() != z.gdn || v.ple.size() != z.ple || v.tails.size() != z.layers * z.tail ||
+        v.dead.size() != z.layers * z.dead || v.block_pos.size() != z.layers * z.block_pos)
+        return false;
+    std::vector<std::pair<const uint8_t*, size_t>> want;
+    auto add = [&](const uint8_t* p, size_t n) { if (n != 0) want.emplace_back(p, n); };
+    add(v.gdn.data(), z.gdn);
+    add(v.ple.data(), z.ple);
+    for (size_t j = 0; j < z.layers; ++j) {
+        add(v.tails.data() + j * z.tail, z.tail);
+        add(v.dead.data() + j * z.dead, z.dead);
+        add(v.block_pos.data() + j * z.block_pos, z.block_pos);
+    }
+    if (want.size() != rg.size()) return false;
+    for (size_t i = 0; i < rg.size(); ++i)
+        if (rg[i].bytes != want[i].second || std::memcmp(rg[i].host, want[i].first, rg[i].bytes) != 0) return false;
+    return true;
+}
+
 /// T0b: is `c` (or one of its parts) the checkpoint whose bytes the late copy still writes?  It is known by the
 /// address of its first part's GDN vector, which a move of the checkpoint (into a slot, or inside a vector that grows
 /// or erases) keeps, and which no other live checkpoint shares.
@@ -149,6 +177,9 @@ struct NoDrainLine {
     bool mrope_rebuild = false;    ///< the M-RoPE table is not the identity (a text request after a picture)
     bool adapt_busy = false;       ///< an asynchronous adaptive round is in flight (adapt_tick would land it)
     bool nan_flush = false;        ///< #879: the request drops every cached state first
+    bool nan_guard = false;        ///< #879's check runs (STRATA_NAN_GUARD unset or 1): a pump may set nan_flush, which
+                                   ///< the request must see before it chooses what to restore, so the groups drain here
+    bool batch_mtp = false;        ///< --batch-mtp (graph limit, LRU): the read's layouts are refreshed by overlap_prepare
     bool dry_run_ok = false;       ///< the overlapped read could start now without a capture (the dry run)
 };
 inline const char* no_drain_refusal(const NoDrainLine& l) {
@@ -160,6 +191,8 @@ inline const char* no_drain_refusal(const NoDrainLine& l) {
     if (l.mrope_rebuild) return "the M-RoPE table is rebuilt";
     if (l.adapt_busy) return "an adaptive round in flight";
     if (l.nan_flush) return "a non-finite flush (#879)";
+    if (l.nan_guard) return "the non-finite check (#879) runs (STRATA_NAN_GUARD=0 turns it off)";
+    if (l.batch_mtp) return "--batch-mtp";
     if (!l.dry_run_ok) return "the overlapped read would need a capture or is refused";
     return nullptr;
 }
