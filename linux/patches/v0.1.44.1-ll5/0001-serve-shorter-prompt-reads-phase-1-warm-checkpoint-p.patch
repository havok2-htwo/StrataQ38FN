new file mode 100644
index 00000000..7a661554
--- /dev/null
+++ b/tests/program/short_reads_test.cpp
@@ -0,0 +1,225 @@
+// Shorter prompt reads, phase 1 (include/strata/program/short_reads.hpp): the switches and their umbrella, the warm
+// pool's sizes, the late checkpoint's staging plan against conversation_checkpoint_save's layout (a host model of the
+// device copies: stage, then copy back, must give the bytes a direct save gives), the late checkpoint's identity across
+// moves, and the no-drain line check and its layouts.  Header-only, CPU: no model, no GPU.
+#include "strata/program/short_reads.hpp"
+
+#include <cstdio>
+#include <cstring>
+#include <utility>
+#include <vector>
+
+namespace sr = strata::program::short_reads;
+using strata::core::ConversationCheckpoint;
+
+namespace {
+int failures = 0;
+void check(bool ok, const char* what) {
+    if (!ok) {
+        std::fprintf(stderr, "FAIL: %s\n", what);
+        ++failures;
+    }
+}
+
+// a session's running state on the "device": one buffer per source, filled with a pattern of its own
+struct FakePart {
+    sr::PartSizes z;
+    std::vector<uint8_t> gdn, ple;
+    std::vector<std::vector<uint8_t>> tail, dead, bp;
+    sr::PartSources src() const {
+        sr::PartSources s;
+        s.gdn = gdn.empty() ? nullptr : gdn.data();
+        s.ple = ple.empty() ? nullptr : ple.data();
+        for (size_t j = 0; j < z.layers; ++j) {
+            s.tail.push_back(tail[j].data());
+            s.dead.push_back(dead[j].data());
+            s.block_pos.push_back(bp[j].data());
+        }
+        return s;
+    }
+};
+FakePart fake(const sr::PartSizes& z, uint8_t seed) {
+    FakePart f;
+    f.z = z;
+    auto fill = [&](std::vector<uint8_t>& v, size_t n, uint8_t s) {
+        v.resize(n);
+        for (size_t i = 0; i < n; ++i) v[i] = (uint8_t) (s + i * 7);
+    };
+    fill(f.gdn, z.gdn, seed);
+    fill(f.ple, z.ple, (uint8_t) (seed + 1));
+    f.tail.resize(z.layers);
+    f.dead.resize(z.layers);
+    f.bp.resize(z.layers);
+    for (size_t j = 0; j < z.layers; ++j) {
+        fill(f.tail[j], z.tail, (uint8_t) (seed + 2 + j));
+        fill(f.dead[j], z.dead, (uint8_t) (seed + 40 + j));
+        fill(f.bp[j], z.block_pos, (uint8_t) (seed + 80 + j));
+    }
+    return f;
+}
+// what conversation_checkpoint_save writes (conversation_state.cpp): gdn, ple, then per layer its tail, dead, block_pos
+// at j * size in their vectors
+ConversationCheckpoint direct_save(const FakePart& f) {
+    ConversationCheckpoint c;
+    c.gdn = f.gdn;
+    c.ple = f.ple;
+    for (size_t j = 0; j < f.z.layers; ++j) {
+        c.tails.insert(c.tails.end(), f.tail[j].begin(), f.tail[j].end());
+        c.dead.insert(c.dead.end(), f.dead[j].begin(), f.dead[j].end());
+        c.block_pos.insert(c.block_pos.end(), f.bp[j].begin(), f.bp[j].end());
+    }
+    return c;
+}
+bool same_state(const ConversationCheckpoint& a, const ConversationCheckpoint& b) {
+    return a.gdn == b.gdn && a.ple == b.ple && a.tails == b.tails && a.dead == b.dead && a.block_pos == b.block_pos;
+}
+// the late path on the host: plan, "device" copies into the staging buffer, later the copies back into the vectors
+bool staged_save(ConversationCheckpoint& c, const FakePart& f, std::vector<uint8_t>& staging) {
+    sr::presize(c, f.z);
+    std::vector<sr::StageRegion> rg;
+    if (!sr::stage_plan(c, f.z, f.src(), rg)) return false;
+    staging.assign(f.z.bytes(), 0xEE);
+    for (const auto& r : rg) std::memcpy(staging.data() + r.off, r.dev, r.bytes);
+    for (const auto& r : rg) std::memcpy(r.host, staging.data() + r.off, r.bytes);
+    return true;
+}
+}  // namespace
+
+int main() {
+    // ---- the switches: off by default; the umbrella turns each on unless its own says otherwise
+    check(!sr::env_on(nullptr, nullptr), "neither set: off (the default path)");
+    check(!sr::env_on(nullptr, "0"), "umbrella 0: off");
+    check(sr::env_on(nullptr, "1"), "umbrella alone: on");
+    check(!sr::env_on("0", "1"), "own 0 beats the umbrella");
+    check(sr::env_on("1", nullptr), "own 1 alone: on");
+    check(!sr::env_on("", "1"), "own empty: off");
+    check(sr::warm_reserve(nullptr, nullptr) == 0, "T0a off by default");
+    check(sr::warm_reserve("1", nullptr) == 2, "STRATA_SR_CKPT_WARM=1 keeps 2");
+    check(sr::warm_reserve(nullptr, "1") == 2, "the umbrella keeps 2");
+    check(sr::warm_reserve("3", nullptr) == 3, "=3 keeps 3");
+    check(sr::warm_reserve("99", nullptr) == 8, "capped at 8");
+    check(sr::warm_reserve("0", "1") == 0, "=0 beats the umbrella");
+    check(sr::pool_cap(2, 0) == 2 && sr::pool_cap(2, 2) == 2 && sr::pool_cap(2, 4) == 4, "the keep limit rises to the reserve");
+    check(sr::warm_wants(0, 2) && sr::warm_wants(1, 2) && !sr::warm_wants(2, 2) && !sr::warm_wants(0, 0),
+          "the warm thread makes one while fewer than the reserve are kept, never when off");
+
+    // ---- T0a: a warm checkpoint has every part's vectors at the save's sizes (so a save resizes nothing)
+    sr::PartSizes a;
+    a.gdn = 4096; a.ple = 640; a.tail = 96; a.dead = 32; a.block_pos = 4; a.layers = 3;
+    sr::PartSizes b = a;
+    b.ple = 0;   // a later stage: no PLE history
+    b.layers = 2;
+    const ConversationCheckpoint w = sr::warm_checkpoint({a, b, b});
+    check(w.gdn.size() == a.gdn && w.ple.size() == a.ple && w.tails.size() == 3 * a.tail && w.dead.size() == 3 * a.dead &&
+              w.block_pos.size() == 3 * a.block_pos, "warm: the first part's sizes");
+    check(w.stage_parts.size() == 2 && w.stage_parts[1].gdn.size() == b.gdn && w.stage_parts[1].ple.empty() &&
+              w.stage_parts[1].tails.size() == 2 * b.tail, "warm: one part per later stage, at its sizes");
+    check(w.ids.empty() && w.imgs.empty() && !w.pinned && !w.slot_turn, "warm: no tokens, no marks");
+    check(a.bytes() == 4096 + 640 + 3 * (96 + 32 + 4), "PartSizes::bytes");
+
+    // ---- T0b: the staged copies give the bytes the direct save gives, for every part shape
+    for (const sr::PartSizes& z : {a, b}) {
+        const FakePart f = fake(z, (uint8_t) z.layers);
+        const ConversationCheckpoint want = direct_save(f);
+        ConversationCheckpoint fresh;   // a new checkpoint (its vectors resized by presize)
+        std::vector<uint8_t> staging;
+        check(staged_save(fresh, f, staging), "late: a fresh checkpoint plans");
+        check(same_state(fresh, want), "late: a fresh checkpoint holds the direct save's bytes");
+        ConversationCheckpoint pooled = sr::warm_checkpoint({z});   // a pooled one: other bytes in it before
+        std::memset(pooled.gdn.data(), 0x5A, pooled.gdn.size());
+        if (!pooled.tails.empty()) std::memset(pooled.tails.data(), 0xA5, pooled.tails.size());
+        check(staged_save(pooled, f, staging), "late: a pooled checkpoint plans");
+        check(same_state(pooled, want), "late: every byte of a pooled checkpoint is overwritten");
+        std::vector<sr::StageRegion> rg;
+        check(sr::stage_plan(pooled, z, f.src(), rg), "late: plan again");
+        size_t off = 0;
+        bool packed = true;
+        for (const auto& r : rg) {
+            packed = packed && r.off == off && r.bytes > 0;
+            off += r.bytes;
+        }
+        check(packed && off == z.bytes(), "late: the regions tile the staging buffer in order, no gap, no overlap");
+    }
+    {   // a plan is refused (the caller saves as before) when a vector has another size or a source is missing
+        const FakePart f = fake(a, 9);
+        ConversationCheckpoint c;
+        std::vector<sr::StageRegion> rg;
+        check(!sr::stage_plan(c, a, f.src(), rg), "late: unsized vectors are refused");
+        sr::presize(c, a);
+        sr::PartSources s = f.src();
+        s.gdn = nullptr;
+        check(!sr::stage_plan(c, a, s, rg), "late: a missing source is refused");
+        s = f.src();
+        s.tail.pop_back();
+        check(!sr::stage_plan(c, a, s, rg), "late: a missing layer is refused");
+    }
+
+    // ---- T0b: the late checkpoint is known by its first part's GDN storage across the moves the serve loop makes
+    {
+        std::vector<ConversationCheckpoint> checks;
+        checks.push_back(sr::warm_checkpoint({a}));
+        checks.push_back(sr::warm_checkpoint({a}));
+        const void* key = checks[1].gdn.data();
+        check(!sr::holds_late(checks, nullptr), "late: none pending finds nothing");
+        check(sr::holds_late(checks, key) && sr::is_late(checks[1], key) && !sr::is_late(checks[0], key),
+              "late: found in the chain");
+        for (int i = 0; i < 64; ++i) checks.push_back(sr::warm_checkpoint({b}));   // the vector grows (moves)
+        check(sr::holds_late(checks, key), "late: still found after the chain grew");
+        checks.erase(checks.begin());   // an eviction in front of it (moves)
+        check(sr::is_late(checks[0], key), "late: still found after an erase moved it");
+        std::vector<ConversationCheckpoint> slot;   // STRATA_SLOT_CKPT_MOVE: into the slot
+        slot.push_back(std::move(checks[0]));
+        checks.erase(checks.begin());
+        check(!sr::holds_late(checks, key) && sr::holds_late(slot, key), "late: moved into the slot, found there only");
+        ConversationCheckpoint copy = slot[0];   // a copy is another checkpoint (its own storage)
+        check(!sr::is_late(copy, key), "late: a copy is not the pending one");
+    }
+
+    // ---- T0c: the line check says why it drains, in order; all clear: no reason
+    {
+        sr::NoDrainLine l;
+        check(std::strcmp(sr::no_drain_refusal(l), "off") == 0, "nodrain: off by default");
+        l.switch_on = true;
+        check(sr::no_drain_refusal(l) != nullptr, "nodrain: needs the overlap");
+        l.overlap_on = true;
+        l.text_bgen = true;
+        l.in_flight = true;
+        l.dry_run_ok = true;
+        check(sr::no_drain_refusal(l) == nullptr, "nodrain: a text BGEN beside groups, dry run passed");
+        auto refused = [&](bool sr::NoDrainLine::*f, bool v) {
+            sr::NoDrainLine m = l;
+            m.*f = v;
+            return sr::no_drain_refusal(m) != nullptr;
+        };
+        check(refused(&sr::NoDrainLine::text_bgen, false), "nodrain: not for BGENI or another line");
+        check(refused(&sr::NoDrainLine::in_flight, false), "nodrain: nothing in flight, nothing to skip");
+        check(refused(&sr::NoDrainLine::lanes, true), "nodrain: not with the spec lanes");
+        check(refused(&sr::NoDrainLine::mrope_rebuild, true), "nodrain: not when the M-RoPE table is rebuilt");
+        check(refused(&sr::NoDrainLine::adapt_busy, true), "nodrain: not with an adaptive round in flight");
+        check(refused(&sr::NoDrainLine::nan_flush, true), "nodrain: not before a non-finite flush");
+        check(refused(&sr::NoDrainLine::dry_run_ok, false), "nodrain: not when the read would need a capture");
+    }
+    {   // the layouts the read's pump may launch: what overlap_prepare captures, plus each in-flight group's width
+        const int GS = 4;
+        const auto want = sr::needed_layouts(GS, {2, 0, 4, 1}, {3, 0, 0, 4});
+        auto has = [&](int base, int S) {
+            for (const auto& w : want)
+                if (w.first == base && w.second == S) return true;
+            return false;
+        };
+        check(has(0, 1) && has(0, 2) && has(0, 4) && has(0, 3), "group 0: widths 1..2 (own), full, its in-flight 3");
+        check(has(4, 4) && !has(4, 1), "group 1 (idle): the full width only");
+        check(has(8, 1) && has(8, 2) && has(8, 3) && has(8, 4), "group 2 (full): 1..3 and the full width");
+        check(has(12, 1) && has(12, 4) && !has(12, 2), "group 3: its own 1, full (also its in-flight width)");
+        size_t dups = 0;
+        for (size_t i = 0; i < want.size(); ++i)
+            for (size_t j = i + 1; j < want.size(); ++j) dups += want[i] == want[j] ? 1 : 0;
+        check(dups == 0, "no layout twice");
+        check(want.size() == 4 + 1 + 4 + 2, "the count: 4 + 1 + 4 + 2");
+        const auto same = sr::needed_layouts(GS, {2, 0, 4, 1}, {});
+        check(same.size() == 3 + 1 + 4 + 2, "nothing in flight: what overlap_prepare captures");
+    }
+
+    if (failures == 0) std::printf("short_reads_test: all passed\n");
+    return failures == 0 ? 0 : 1;
+}
