+// include/strata/program/short_reads.hpp - shorter prompt reads beside many slots, phase 1 (opt-in, all exact): the
+// switches, the warm checkpoint pool's sizes, the late turn checkpoint's staging layout and the no-drain admission's
+// gate.  Header-only (CPU): the rules the engine follows, tested without a model or a GPU
+// (tests/program/short_reads_test.cpp).
+//
+//   T0a STRATA_SR_CKPT_WARM=1|N   the checkpoint pool (STRATA_CKPT_POOL) keeps N (1: 2) checkpoints with their
+//                                 running-state vectors already allocated and faulted in, refilled on a thread of
+//                                 its own after each take: a save or a slot's copy never resizes fresh vectors
+//                                 (~15 ms for a save, ~55 ms for a copy measured).  Every byte is overwritten by the
+//                                 save or the copy, so the checkpoints are the same.
+//   T0b STRATA_SR_CKPT_LATE=1     a turn checkpoint (the cuts of a prompt read: turn, root, message, pin) is first
+//                                 copied on the device into a staging buffer per stage (a few hundred us), and from
+//                                 there to the host on threads of their own, while the first window, the slot copy
+//                                 and BADM go on.  The device copy reads the state at the same point the save read it
+//                                 (after the same device syncs), and nothing but the late copy writes the checkpoint
+//                                 until it is done: every reader of the checkpoint's bytes waits for it first.
+//   T0c STRATA_SR_NODRAIN=1       a text BGEN with slot groups in flight does not drain them at the line when a dry
+//                                 run shows that the overlapped read could start beside them without a capture (every
+//                                 stage holds every layout the read's pump may need, the drafter's prompt records are
+//                                 ready).  The request's own steps that might wait on a device, move the expert
+//                                 tables or touch another slot drain the groups first (a deferred drain), so only a
+//                                 read whose way to the overlapped read is host work and its own sessions skips it.
+//   STRATA_SHORT_READS=1          the umbrella: each of the three is on unless its own switch says otherwise.
+#pragma once
+
+#include "strata/core/conversation_cache.hpp"
+
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <vector>
+
+namespace strata::program::short_reads {
+
+/// A switch's text: unset (nullptr) is "not said"; empty and "0..." are off, anything else on.
+inline bool text_on(const char* v) { return v != nullptr && v[0] != '\0' && v[0] != '0'; }
+
+/// A sub-step's switch with the umbrella: its own value when set, else the umbrella's.  Neither set: off.
+inline bool env_on(const char* own, const char* umbrella) { return own != nullptr ? text_on(own) : text_on(umbrella); }
+
+/// T0a: how many warm checkpoints the pool keeps (0: off).  "1" (or the umbrella alone) is 2, a number N >= 2 is N,
+/// capped at 8 (each is the size of one checkpoint, ~118 MB with a layer split's parts).
+inline int warm_reserve(const char* own, const char* umbrella) {
+    if (!env_on(own, umbrella)) return 0;
+    const int n = own != nullptr ? std::atoi(own) : 1;
+    if (n <= 1) return 2;
+    return n > 8 ? 8 : n;
+}
+
+/// The pool's keep limit with T0a: at least the reserve (the default pool keeps 2).
+inline size_t pool_cap(size_t cap, int reserve) { return reserve > 0 && (size_t) reserve > cap ? (size_t) reserve : cap; }
+
+/// Does the pool want another warm checkpoint (`free_n` kept now)?
+inline bool warm_wants(size_t free_n, int reserve) { return reserve > 0 && free_n < (size_t) reserve; }
+
+/// The running state one session's part of a checkpoint holds, in bytes: the GDN rows, the PLE history (0 without
+/// one), and per owned QSA layer its indexer tail, its dead row and its block position.  The sizes
+/// conversation_checkpoint_save resizes its vectors to (ConversationStateSizes and the session's carve).
+struct PartSizes {
+    size_t gdn = 0, ple = 0, tail = 0, dead = 0, block_pos = 0;
+    size_t layers = 0;
+    size_t bytes() const { return gdn + ple + layers * (tail + dead + block_pos); }
+};
+
+/// T0a: a checkpoint part's vectors at their sizes (zero-filled: their pages are faulted in), ready for a save or a
+/// copy to overwrite every byte.
+inline void presize(strata::core::ConversationCheckpoint& c, const PartSizes& z) {
+    c.gdn.resize(z.gdn);
+    c.ple.resize(z.ple);
+    c.tails.resize(z.layers * z.tail);
+    c.dead.resize(z.layers * z.dead);
+    c.block_pos.resize(z.layers * z.block_pos);
+}
+
+/// T0a: a whole warm checkpoint: the first part's vectors in `c`, every later stage's in c.stage_parts.
+inline strata::core::ConversationCheckpoint warm_checkpoint(const std::vector<PartSizes>& parts) {
+    strata::core::ConversationCheckpoint c;
+    if (parts.empty()) return c;
+    presize(c, parts[0]);
+    c.stage_parts.resize(parts.size() - 1);
+    for (size_t k = 1; k < parts.size(); ++k) presize(c.stage_parts[k - 1], parts[k]);
+    return c;
+}
+
+/// T0b: where a session's running state comes from on the device (the same pointers conversation_checkpoint_save
+/// reads: the session's gdn_state and ple_hist, and per owned QSA layer its idx_tail, idx_dead and idx_block_pos).
+struct PartSources {
+    const void* gdn = nullptr;
+    const void* ple = nullptr;
+    std::vector<const void*> tail, dead, block_pos;   ///< one per owned QSA layer
+};
+
+/// T0b: one copy of the late checkpoint: `bytes` from the device source `dev` to the staging buffer at `off`, and later
+/// from there into the checkpoint's host vector at `host`.
+struct StageRegion {
+    uint8_t* host = nullptr;
+    const void* dev = nullptr;
+    size_t off = 0, bytes = 0;
+};
+
+/// T0b: the copies of one part, in the order conversation_checkpoint_save makes them (gdn, ple, then per layer tail,
+/// dead, block_pos), packed in the staging buffer in that order.  `c`'s vectors must be presized to `z` (presize).
+/// False when a source is missing for a nonzero size or a vector has another size: the caller saves as before.
+inline bool stage_plan(strata::core::ConversationCheckpoint& c, const PartSizes& z, const PartSources& s,
+                       std::vector<StageRegion>& out) {
+    out.clear();
+    if (c.gdn.size() != z.gdn || c.ple.size() != z.ple || c.tails.size() != z.layers * z.tail ||
+        c.dead.size() != z.layers * z.dead || c.block_pos.size() != z.layers * z.block_pos)
+        return false;
+    if (s.tail.size() != z.layers || s.dead.size() != z.layers || s.block_pos.size() != z.layers) return false;
+    size_t off = 0;
+    auto add = [&](uint8_t* host, const void* dev, size_t bytes) -> bool {
+        if (bytes == 0) return true;
+        if (dev == nullptr || host == nullptr) return false;
+        out.push_back(StageRegion{host, dev, off, bytes});
+        off += bytes;
+        return true;
+    };
+    if (!add(c.gdn.data(), s.gdn, z.gdn) || !add(c.ple.data(), s.ple, z.ple)) return false;
+    for (size_t j = 0; j < z.layers; ++j)
+        if (!add(c.tails.data() + j * z.tail, s.tail[j], z.tail) ||
+            !add(c.dead.data() + j * z.dead, s.dead[j], z.dead) ||
+            !add(c.block_pos.data() + j * z.block_pos, s.block_pos[j], z.block_pos))
+            return false;
+    return off == z.bytes();
+}
+
+/// T0b: is `c` (or one of its parts) the checkpoint whose bytes the late copy still writes?  It is known by the
+/// address of its first part's GDN vector, which a move of the checkpoint (into a slot, or inside a vector that grows
+/// or erases) keeps, and which no other live checkpoint shares.
+inline bool is_late(const strata::core::ConversationCheckpoint& c, const void* late) {
+    return late != nullptr && !c.gdn.empty() && (const void*) c.gdn.data() == late;
+}
+inline bool holds_late(const std::vector<strata::core::ConversationCheckpoint>& v, const void* late) {
+    if (late == nullptr) return false;
+    for (const auto& c : v)
+        if (is_late(c, late)) return true;
+    return false;
+}
+
+/// T0c: what the BGEN line knows when it decides whether to leave the groups in flight.  Each field true is a reason
+/// to drain as before (`why` says the first).
+struct NoDrainLine {
+    bool switch_on = false;        ///< STRATA_SR_NODRAIN (or the umbrella)
+    bool overlap_on = false;       ///< STRATA_PIPE_OVERLAP and pipelined slot groups
+    bool text_bgen = false;        ///< the line is a text BGEN (a BGENI's picture rebuilds the M-RoPE table)
+    bool in_flight = false;        ///< slot groups in flight (nothing to skip otherwise)
+    bool lanes = false;            ///< the spec lanes run or a lane slot is held
+    bool mrope_rebuild = false;    ///< the M-RoPE table is not the identity (a text request after a picture)
+    bool adapt_busy = false;       ///< an asynchronous adaptive round is in flight (adapt_tick would land it)
+    bool nan_flush = false;        ///< #879: the request drops every cached state first
+    bool dry_run_ok = false;       ///< the overlapped read could start now without a capture (the dry run)
+};
+inline const char* no_drain_refusal(const NoDrainLine& l) {
+    if (!l.switch_on) return "off";
+    if (!l.overlap_on) return "no overlapped reads (STRATA_PIPE_OVERLAP with pipelined slot groups)";
+    if (!l.text_bgen) return "not a text batch admission";
+    if (!l.in_flight) return "no slot groups in flight";
+    if (l.lanes) return "the spec lanes";
+    if (l.mrope_rebuild) return "the M-RoPE table is rebuilt";
+    if (l.adapt_busy) return "an adaptive round in flight";
+    if (l.nan_flush) return "a non-finite flush (#879)";
+    if (!l.dry_run_ok) return "the overlapped read would need a capture or is refused";
+    return nullptr;
+}
+
+/// T0c: the layouts the overlapped read's pump may launch beside the read, all of which must be captured on every
+/// stage before it may start with groups in flight: each group's full width; each active group's widths 1 .. its own
+/// width (min with GS - 1: a group may shrink to them, as overlap_prepare captures them); and each group in flight its
+/// launch width (its later stages run it at that width).  (base, S) pairs, base = group * GS.
+inline std::vector<std::pair<int, int>> needed_layouts(int GS, const std::vector<int>& own_width,
+                                                       const std::vector<int>& inflight_width) {
+    std::vector<std::pair<int, int>> want;
+    const size_t groups = own_width.size();
+    auto add = [&](int base, int S) {
+        if (S < 1 || S > GS) return;
+        for (const auto& w : want)
+            if (w.first == base && w.second == S) return;
+        want.emplace_back(base, S);
+    };
+    for (size_t gi = 0; gi < groups; ++gi) {
+        const int base = (int) gi * GS;
+        for (int S = 1; S <= own_width[gi] && S <= GS - 1; ++S) add(base, S);
+        add(base, GS);
+        if (gi < inflight_width.size() && inflight_width[gi] > 0) add(base, inflight_width[gi]);
+    }
+    return want;
+}
+
+}  // namespace strata::program::short_reads
