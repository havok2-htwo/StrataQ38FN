+bool MtpDrafter::prefill_records_ready(int64_t n) const {
+    if (g_ == nullptr) return false;
+    const bool per_group_sync = prefill_per_group_sync();
+    const int64_t per_row = 1 + 4 + g_->n_head;
+    if (!per_group_sync && pf_cap_ < n * per_row) return false;
+    for (int T = 1; T <= max_t_; ++T)
+        if (!(per_group_sync ? prefill_exec_[T] : prefill_dev_exec_[T])) return false;
+    return true;
+}
