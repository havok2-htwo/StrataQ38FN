+}
+// STRATA_SR_CKPT_LATE=1 (T0b): a turn checkpoint is copied into a staging buffer on each stage's device and from there
+// to the host on threads of their own while the request goes on to its first window and BADM; every reader of it
+// waits for that copy first.  Needs the pool (STRATA_CKPT_POOL or STRATA_SLOT_CKPT_MOVE)
+bool sr_ckpt_late_env() {
+    static const bool on = strata::program::short_reads::env_on(std::getenv("STRATA_SR_CKPT_LATE"),
+                                                                std::getenv("STRATA_SHORT_READS"));
+    return on;
+}
+// STRATA_SR_NODRAIN=1 (T0c): a text BGEN leaves the slot groups in flight when its overlapped read could start beside
+// them without a capture; the request drains them at its first step that needs it (a deferred drain).  Needs
+// STRATA_PIPE_OVERLAP
+bool sr_nodrain_env() {
+    static const bool on = strata::program::short_reads::env_on(std::getenv("STRATA_SR_NODRAIN"),
+                                                                std::getenv("STRATA_SHORT_READS"));
+    return on;
+}
 // STRATA_SLOT_CKPT_MOVE=1 (read once; off by default): a batch admission MOVES its own turn checkpoint into the slot
 // instead of copying it (~112 MB of host vectors).  The main session's chain no longer holds it, so the request path
