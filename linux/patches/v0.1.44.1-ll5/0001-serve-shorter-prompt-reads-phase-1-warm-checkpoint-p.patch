         // checkpoint frees nothing at the next prune, so every save would fault in fresh pages (17 -> 40-60 ms)
         CheckpointPool ckpt_pool(ckpt_pool_env() || slot_ckpt_move_env());
+        // the running state one session's part of a checkpoint holds (the sizes conversation_checkpoint_save resizes to)
+        auto sr_part_sizes = [&](const strata::core::SessionState& s) {
