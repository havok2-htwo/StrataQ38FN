@@ -1833,12 +1859,23 @@ bool checkpoint_restore(const ConvCheckpoint& c, strata::core::SessionState& ss,
     return false;
 }
 
+static void spread_engine_thread();   // (below: the warm pool's thread goes where the copy threads go)
 /// STRATA_CKPT_POOL: the storage of dropped checkpoints, for the next save or slot copy to reuse.  `give` keeps a
 /// checkpoint's vectors (its tokens, pictures and marks cleared), `take` hands one back (an empty checkpoint when none
 /// is kept).  At most `cap` are kept (a batch admission drops and takes about two), the rest are freed as before.
 class CheckpointPool {
 public:
     explicit CheckpointPool(bool on, size_t cap = 2) : on_(on), cap_(cap) {}
+    CheckpointPool(const CheckpointPool&) = delete;
+    CheckpointPool& operator=(const CheckpointPool&) = delete;
+    ~CheckpointPool() {
+        {
+            std::lock_guard<std::mutex> lk(mu_);
+            stop_ = true;
+        }
+        warm_cv_.notify_all();
+        if (warm_th_.joinable()) warm_th_.join();
+    }
     bool on() const { return on_; }
     void give(ConvCheckpoint&& c) {
         if (!on_ || c.gdn.empty()) return;
@@ -1847,12 +1884,44 @@ public:
         if (free_.size() < cap_) free_.push_back(std::move(c));
     }
     ConvCheckpoint take() {
-        std::lock_guard<std::mutex> lk(mu_);
-        if (!on_ || free_.empty()) return ConvCheckpoint{};
-        ConvCheckpoint c = std::move(free_.back());
-        free_.pop_back();
+        bool refill = false;
+        ConvCheckpoint c;
+        {
+            std::lock_guard<std::mutex> lk(mu_);
+            if (!on_) return c;
+            if (reserve_ > 0) ++takes_;
+            if (free_.empty()) {
+                if (reserve_ > 0) ++misses_;
+            } else {
+                c = std::move(free_.back());
+                free_.pop_back();
+            }
+            refill = strata::program::short_reads::warm_wants(free_.size(), reserve_);
+        }
+        if (refill) warm_cv_.notify_one();   // (T0a: the warm thread makes the next one now)
         return c;
     }
+    /// STRATA_SR_CKPT_WARM (T0a): keep `reserve` checkpoints with every part's vectors allocated at `parts`' sizes and
+    /// faulted in, made on a thread of its own whenever fewer are kept (at once, and after each take).  The keep limit
+    /// rises to the reserve.  A save or a copy overwrites every byte of a taken one, as of any pooled one.
+    void set_warm(int reserve, const std::vector<strata::program::short_reads::PartSizes>& parts) {
+        if (!on_ || reserve <= 0 || parts.empty()) return;
+        {
+            std::lock_guard<std::mutex> lk(mu_);
+            reserve_ = reserve;
+            cap_ = strata::program::short_reads::pool_cap(cap_, reserve);
+            parts_ = parts;
+            if (!warm_th_.joinable()) warm_th_ = std::thread([this] { warm_loop(); });
+        }
+        warm_cv_.notify_one();
+    }
+    /// T0a's counts: takes since the start, takes that found the pool empty, warm checkpoints made
+    void warm_counts(uint64_t& takes, uint64_t& misses, uint64_t& made) {
+        std::lock_guard<std::mutex> lk(mu_);
+        takes = takes_;
+        misses = misses_;
+        made = made_;
+    }
     /// v.erase(remove_if(v, drop)) with the dropped ones given to the pool (the kept ones keep their order)
     template <class Drop> void erase_if(std::vector<ConvCheckpoint>& v, Drop drop) {
         size_t w = 0;
@@ -1865,10 +1934,50 @@ public:
     }
 private:
     static void clear_marks(ConvCheckpoint& c) { strata::core::conversation_checkpoint_clear_marks(c); }
+    void warm_loop() {
+        spread_engine_thread();   // off the host thread's CPU (--aux-cpus, else every CPU the process may use)
+        std::unique_lock<std::mutex> lk(mu_);
+        for (;;) {
+            warm_cv_.wait(lk, [&] { return stop_ || strata::program::short_reads::warm_wants(free_.size(), reserve_); });
+            if (stop_) return;
+            const std::vector<strata::program::short_reads::PartSizes> parts = parts_;
+            lk.unlock();
+            ConvCheckpoint c;
+            bool made = false;
+            try {
+                c = strata::program::short_reads::warm_checkpoint(parts);   // (zero-filled: the pages are in)
+                made = true;
+            } catch (...) {
+            }
+            lk.lock();
+            if (stop_) return;
+            if (!made) {   // no memory for it: the pool goes on as without the switch, said once
+                reserve_ = 0;
+                std::fprintf(stderr, "strata serve: STRATA_SR_CKPT_WARM: a warm checkpoint could not be allocated; the "
+                                     "pool is no longer kept warm\n");
+                continue;
+            }
+            if (free_.size() < cap_) {
+                free_.push_back(std::move(c));
+                ++made_;
+            } else {
+                lk.unlock();
+                c = ConvCheckpoint{};   // (freed outside the lock)
+                lk.lock();
+            }
+        }
+    }
     bool on_;
     size_t cap_;
     std::mutex mu_;
     std::vector<ConvCheckpoint> free_;
+    // STRATA_SR_CKPT_WARM (T0a); reserve_ 0: off
+    int reserve_ = 0;
+    std::vector<strata::program::short_reads::PartSizes> parts_;
+    uint64_t takes_ = 0, misses_ = 0, made_ = 0;
+    bool stop_ = false;
+    std::condition_variable warm_cv_;
+    std::thread warm_th_;   // last: started once the members above exist
 };
 
