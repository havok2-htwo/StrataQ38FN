+    def test_a_burst_of_short_requests_all_go_before_the_paused_read(self):
+        """Review fix: a paused read takes the control lines back only once no short request waits (not after the
+        first one), so a burst behind a long read is answered before the long read's end."""
+        self.start(8, says_groups=2, more=["--read-yield", "4"])
+        long_q = "long " * 700
+        done = {}
+
+        def go(t):
+            try:
+                r = self.chat(t, max_tokens=16)
+                done[t] = (r["choices"][0]["message"]["content"], time.time())
+            except Exception as e:      # (said in the assertion below)
+                done[t] = (repr(e), time.time())
+        a = threading.Thread(target=go, args=(long_q,))
+        a.start()
+        time.sleep(0.15)
+        shorts = [f"short {i}" for i in range(5)]
+        th = [threading.Thread(target=go, args=(q,)) for q in shorts]
+        for t in th:
+            t.start()
+            time.sleep(0.01)
+        for t in th:
+            t.join(30)
+        a.join(30)
+        self.assertEqual(done[long_q][0], "ok, done.")
+        for q in shorts:
+            self.assertEqual(done[q][0], "ok, done.")
+            self.assertLess(done[q][1], done[long_q][1], (q, done))
+        log = self.log.read_text().splitlines()
+        self.assertEqual(len([x for x in log if x.startswith("YIELD ")]), 1, log)   # one pause served the burst
+        self.assertFalse(any(self.engine.slot_busy))
