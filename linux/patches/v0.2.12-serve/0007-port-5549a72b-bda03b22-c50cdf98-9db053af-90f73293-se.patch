+class SlotsBusy(unittest.TestCase):
+    """Every slot busy (the normal case under load): a request that got the control lines gives them back while it
+    waits for a slot and asks again - by its estimate and with its first arrival time, not by its total length."""
+
+    def test_a_follow_up_keeps_its_rank_while_it_waits_for_a_slot(self):
+        e = engine_without_process(2)
+        e.slot_order = [0, 1]
+        e.slot_busy = [True, True]
+        e.slot_held = [[], []]
+        e.slot_claims = {0, 1}                          # (owned: not reaped as #1603 orphans)
+        e.slot_q = [queue.Queue(), queue.Queue()]
+        e._note_where = lambda *a, **k: None
+        conv = toks(11000, 70) + toks(250, 71)
+        cancels = []
+
+        def run(prompt):
+            c = __import__("threading").Event()
+            cancels.append(c)
+
+            def go():
+                try:
+                    for _ in e.generate_batched(prompt, 16, {}, c):
+                        pass
+                except Exception:
+                    import traceback
+                    traceback.print_exc(file=sys.__stderr__)
+            __import__("threading").Thread(target=go, daemon=True).start()
+
+        out = io.StringIO()
+        with mock.patch.object(server, "ADMIT_BY_NEW", True), mock.patch.object(server, "ADMIT_SHORT_FIRST", 8192), \
+                mock.patch.object(server, "ADMIT_MAX_WAIT_S", 45.0), contextlib.redirect_stdout(out):
+            e._admit_estimate().note(conv)
+            try:
+                t0 = time.monotonic()
+                run(toks(11000, 72))                    # cold, first
+                time.sleep(0.05)
+                run(conv + toks(4000, 73))              # follow-up, after it
+                self.assertTrue(until(lambda: e.admitting == 2, 10))   # both had the lines, both wait for a slot
+                self.assertTrue(e.ctl.acquire(timeout=5))   # (held: both ask again and queue up)
+                try:
+                    until(lambda: len(e.wait_lens) == 2, 5)
+                    with e.slot_cv:
+                        ents = [(x[0], x[1], x[2], x.total) for x in e.wait_lens]
+                finally:
+                    e.ctl.release()
+                self.assertEqual(len(ents), 2, ents)
+                ents.sort(key=lambda x: x[1])
+                cold, fu = ents
+                self.assertEqual((cold[0], cold[3]), (11000, 11000))
+                self.assertLessEqual(fu[0], 4000 + 250 + BLOCK)  # by its estimate, not 15K
+                self.assertEqual(fu[3], 15250)
+                self.assertTrue(cold[2] and fu[2])
+                self.assertLess(fu[1] - t0, 1.0)        # its first arrival, kept
+                with e.slot_cv:
+                    self.assertEqual(e._admit_next().total, 15250)   # the follow-up takes the lines first
+            finally:
+                for c in cancels:
+                    c.set()
+                time.sleep(1.2)
+        self.assertNotIn("[strata] admit: total", out.getvalue())   # nothing was read: no admission line
+
