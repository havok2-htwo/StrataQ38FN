+    def test_an_admission_in_a_lower_row_parks_in_a_top_row(self):
+        """A long read admitted beside a decoding slot into a lower row (k = 3: only slot 2 keeps a part): the BYIELD
+        names a reserved top-row slot, and the resumed BGEN goes back into its own slot with yslot= that one."""
+        self.start(6, says_groups=2, more=["--read-yield", "3"])
