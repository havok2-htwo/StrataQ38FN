+class WithAdmitByNew(unittest.TestCase):
+    """STRATA_YIELD_SHORT beside STRATA_ADMIT_BY_NEW: an entry's plen is the estimate of its new tokens, its `total`
+    and `ids` are named fields beside it (WaitEntry); the estimate orders admissions, the yield rule counts what slots
+    hold."""
