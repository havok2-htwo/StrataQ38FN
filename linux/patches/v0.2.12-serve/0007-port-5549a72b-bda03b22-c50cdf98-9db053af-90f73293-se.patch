+"""serve/test_read_yield.py - STRATA_YIELD_SHORT with an engine run with STRATA_READ_YIELD=1 (INFO read_yield=1
+yield_row=k): which waiting request a read gives way to (new tokens, not prompt length), into which slot (the top row
+of a pipelined group, where no pad row writes it), and the retry after the engine's YIELDNO.  Unset: the #656 rule as
+before.  No GPU: the unit part has no process, the service part runs test_parallel's fake engine with the YIELDNO rule.
+
+    python -m unittest serve.test_read_yield -v
+"""
+from __future__ import annotations
+
+import sys
+import threading
+import time
+import unittest
+from pathlib import Path
+from unittest import mock
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import serve.server as server  # noqa: E402
+from serve.server import StrataEngine, WaitEntry as W  # noqa: E402
+from serve.test_parallel import FAKE_BATCH, ParallelService  # noqa: E402
+
+
+def engine(n, info=None, gs=0):
+    e = StrataEngine("missing-executable", [], lazy=True)
+    e.batch = n
+    e.slot_order = [g * gs + t for t in range(gs) for g in range(n // gs)] if gs else list(range(n))
+    e.slot_busy = [False] * n
+    e.slot_held = [[] for _ in range(n)]
+    e.slot_used = [0.0] * n
+    e.slot_live = [None] * n
+    e.slot_group = [b // gs if gs else 0 for b in range(n)]
+    e.slot_groups = n // gs if gs else 1
+    e.slot_gs = gs
+    e.slot_cv = threading.Condition()
+    e.wait_lens = []
+    e.info = dict(info or {})
+    return e
+
+
+class Rules(unittest.TestCase):
+    def test_new_tokens_count_what_a_slot_does_not_hold(self):
+        e = engine(4)
+        e.slot_held[2] = list(range(100))
+        self.assertEqual(e._new_tokens(list(range(130))), 30)          # a follow-up of slot 2's conversation
+        self.assertEqual(e._new_tokens(list(range(1, 131))), 130)       # not a start of it
+        self.assertEqual(e._new_tokens(list(range(100))), 100)          # a held prompt is never the whole prompt
+        self.assertEqual(e._new_tokens(None, 77), 77)
+
+    def test_unset_keeps_the_656_rule(self):
+        e = engine(4, {"read_yield": 1, "yield_row": 4})
+        e.wait_lens = [W(400, 0.0, True, total=400, ids=list(range(400)))]
+        with mock.patch.object(server, "YIELD_SHORT", 0):
+            self.assertTrue(e._shorter_waiting(1000, list(range(1000))))
+            self.assertFalse(e._shorter_waiting(700, list(range(700))))
+            self.assertEqual(e._yield_row(), 0)
+            self.assertTrue(e._yield_slot_ok(1))
+
+    def test_short_by_new_tokens(self):
+        e = engine(4, {"read_yield": 1, "yield_row": 4})
+        conv = list(range(50000))
+        e.slot_held[0] = conv
+        with mock.patch.object(server, "YIELD_SHORT", 2048), mock.patch.object(server, "YIELD_MIN_LEFT", 8192):
+            # a 50,300-token follow-up whose 50,000 a slot holds waits: 300 new tokens, worth giving way to
+            e.wait_lens = [W(50300, 0.0, True, total=50300, ids=conv + list(range(9, 309)))]
