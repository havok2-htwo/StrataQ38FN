+class Estimate(unittest.TestCase):
+    def test_a_cold_prompt_is_all_new(self):
+        est = AdmitEstimate()
+        p = toks(11000, 7)
+        r, new, ch = est.estimate(p)
+        self.assertEqual((r, new, len(ch)), (0, 11000, 11000 // BLOCK))
+
+    def test_a_follow_up_is_its_new_part(self):
+        """Turn 1 (11K prompt + its reply) noted at its end: turn 2 = all of that + ~4K new reads ~4K."""
+        est = AdmitEstimate()
+        p1 = toks(11000, 8)
+        _, _, ch1 = est.estimate(p1)
+        est.note(p1, ch1)                               # admitted: its read began
+        reply = toks(300, 9)
+        est.note(p1 + reply, ch1)                       # ended
+        p2 = p1 + reply + toks(4100, 10)
+        r, new, _ = est.estimate(p2)
+        self.assertEqual(r, (11300 // BLOCK) * BLOCK)
+        self.assertLess(new, 4100 + BLOCK)
+        self.assertGreaterEqual(new, 4100)
+
+    def test_a_rewritten_reply_still_reuses_the_prompt(self):
+        """The template renders the reply differently next turn (thinking dropped): the prompt's blocks still count."""
+        est = AdmitEstimate()
+        p1 = toks(8000, 11)
+        est.note(p1 + toks(500, 12))
+        p2 = p1 + toks(3000, 13)
+        r, new, _ = est.estimate(p2)
+        self.assertEqual(r, (8000 // BLOCK) * BLOCK)
+
+    def test_a_change_early_on_counts_from_there(self):
+        est = AdmitEstimate()
+        p = toks(10 * BLOCK, 14)
+        est.note(p)
+        q = list(p)
+        q[3 * BLOCK + 7] ^= 1                           # block 3 differs
+        self.assertEqual(est.estimate(q)[0], 3 * BLOCK)
+
+    def test_the_same_prompt_again_reads_at_least_one_token(self):
+        est = AdmitEstimate()
+        p = toks(4 * BLOCK, 15)
+        est.note(p)
+        r, new, _ = est.estimate(p)
+        self.assertEqual((r, new), (4 * BLOCK - 1, 1))
+        self.assertEqual(est.estimate([])[:2], (0, 0))
+
+    def test_bounded_and_the_least_recently_used_goes(self):
+        est = AdmitEstimate(max_blocks=40)
+        old, recent = toks(20 * BLOCK, 16), toks(20 * BLOCK, 17)
+        est.note(old)
+        est.note(recent)
+        self.assertEqual(est.estimate(old + [1])[0], 20 * BLOCK)     # touched now: `recent` is the older one
+        est.note(toks(10 * BLOCK, 18))                          # 10 blocks more: 10 of `recent`'s go
+        self.assertEqual(len(est.known), 40)
+        self.assertEqual(est.estimate(old + [1])[0], 20 * BLOCK)
+        # its start was entered last (deepest first), so its deepest blocks went and its start is still known
+        self.assertEqual(est.estimate(recent)[0], 10 * BLOCK)
+        self.assertEqual(est.stats()["dropped"], 10)
+
+    def test_memory_and_time_stay_small(self):
+        """A few MB for the default 65536 blocks, and a 100K-token prompt estimated in milliseconds."""
+        est = AdmitEstimate()
+        for i in range(70):                                    # 70 conversations of 900 blocks: over the bound
+            est.note(list(range(i << 24, (i << 24) + 900 * BLOCK)))
+        self.assertLessEqual(len(est.known), 65536)
+        size = sys.getsizeof(est.known) + sum(sys.getsizeof(k) for k in est.known)
+        self.assertLess(size, 10 * 1024 * 1024, size)
+        p = toks(100_000, 19)
+        t0 = time.perf_counter()
+        est.estimate(p)
+        self.assertLess(time.perf_counter() - t0, 0.25)
