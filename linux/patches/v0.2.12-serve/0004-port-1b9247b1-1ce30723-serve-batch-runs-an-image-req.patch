+    def go(self, fn, text, out, errors):
+        def one():
+            try:
+                out[text] = fn(text)["choices"][0]["message"]["content"]
+            except Exception as e:   # noqa: BLE001 - reported by the test
+                errors.append((text, repr(e)))
+        th = threading.Thread(target=one)
+        th.start()
+        return th
