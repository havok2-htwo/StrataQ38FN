+
+    def alive(self):
+        return False
+
+    def restart(self):
+        self.starts += 1
+        raise RuntimeError("no GPU for it")
+
+    def unload(self):
+        pass
+
+    def encode(self, source, keep=()):
+        return self.rows, 3
+
