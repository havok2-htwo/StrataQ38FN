+
+def tools_of(mod, req):
+    return mod.openai_to_messages(req)[1]
+
+
+def norm(events):
+    """Events as plain data; call ids (random) replaced by their order of appearance."""
+    ids, out = {}, []
+    for e in events:
+        c = e.call
+        call_ = None
+        if c is not None:
+            call_ = (c.name, json.dumps(c.arguments, sort_keys=True, ensure_ascii=False), ids.setdefault(c.id, len(ids)))
+        out.append((e.kind, e.text, call_))
+    return out
+
+
+def joined(events):
+    """Consecutive "tool_args" pieces of one call joined into one (the text a client concatenates)."""
+    out = []
+    for e in events:
+        if out and e[0] == "tool_args" and out[-1][0] == "tool_args" and out[-1][2] == e[2]:
+            out[-1] = ("tool_args", out[-1][1] + e[1], e[2])
+        else:
+            out.append(e)
+    return out
+
+
+def chunkings(text, seed):
+    """Whole, fixed sizes, every character, and a seeded random split (token-like deltas of 1..12 characters)."""
+    yield "whole", [text]
+    for size in (1, 2, 3, 5, 7, 16, 64):
+        yield f"size{size}", [text[i:i + size] for i in range(0, len(text), size)]
+    rnd = random.Random(seed)
+    parts, i = [], 0
+    while i < len(text):
+        n = rnd.randint(1, 12)
+        parts.append(text[i:i + n])
+        i += n
+    yield "random", parts
+
+
+def run(mod, req, thinking, parts, stream_tools, recover, reason):
+    parser = mod.OutputParser(thinking=thinking, tools=tools_of(mod, req), stream_tools=stream_tools, recover=recover)
+    events = []
+    for p in parts:
+        events.extend(parser.feed(p))
+    events.extend(parser.finish(reason))
+    return norm(events)
+
+
+@unittest.skipIf(old is None, f"the production parser ({OLD_REV}:serve/frontend.py) is neither vendored nor readable from git here")
+class GenesisReplay(unittest.TestCase):
+    maxDiff = None
+
+    def test_the_request_side_is_unchanged(self):
+        tpl_new = new.ChatTemplate(Path(new.__file__).parent / "chat_template.jinja")
+        tpl_old = old.ChatTemplate(Path(new.__file__).parent / "chat_template.jinja")
+        for name, req in REQUESTS.items():
+            with self.subTest(name):
+                a, b = old.openai_to_messages(json.loads(json.dumps(req))), new.openai_to_messages(json.loads(json.dumps(req)))
+                self.assertEqual(a, b)
+                messages, tools, kw = b
+                self.assertEqual(tpl_old.render(messages, tools, **kw), tpl_new.render(messages, tools, **kw))
+
+    def test_the_default_effort_fill_is_unchanged_for_the_shapes(self):
+        """e69cbfa5: only a missing or empty reasoning_effort takes the default; every Genesis shape is filled (or
+        not) exactly as before, whatever the config's default."""
+        from serve.server import Service
+
+        class Stub:
+            shared = {}
+
+            def __init__(self, effort):
+                self.effort = effort
+
+            def effort_default(self):
+                return self.effort
+
+        def old_rule(req, effort):
+            req = dict(req)
+            ctk = req.get("chat_template_kwargs") if isinstance(req.get("chat_template_kwargs"), dict) else {}
+            if effort and not req.get("reasoning_effort") and not req.get("reasoning") and \
+                    "enable_thinking" not in ctk and "reasoning_effort" not in ctk:
+                req["reasoning_effort"] = effort
+            return req
+
+        for effort in (None, "none", "low", "high", "xhigh"):
+            for name, req in REQUESTS.items():
+                with self.subTest(effort=effort, shape=name):
+                    self.assertEqual(Service.with_shared(Stub(effort), dict(req), "openai"), old_rule(req, effort))
+
+    def test_outputs_give_identical_events(self):
+        """Every event identical once a call's consecutive "tool_args" pieces are joined; with token-like deltas
+        (1-3 characters, the seeded 1-12 split) identical piece for piece too.  The one allowed difference: when a
+        delta brings a literal `</parameter>` in a value together with the real close and a `<parameter=NA` whose name
+        is still arriving, the new parser (77794e34: the same name again would be part of the value) holds the
+        arguments from the literal tag until the name is complete - the same text, in one more piece."""
+        n, regrouped = 0, []
+        for label, (shape, thinking, text) in OUTPUTS.items():
+            req = REQUESTS[shape]
+            for cut, parts in chunkings(text, label):
+                for stream_tools in (True, False):
+                    for recover in (False, True):
+                        for reason in (None, "length"):
+                            with self.subTest(label=label, cut=cut, stream_tools=stream_tools, recover=recover,
+                                              reason=reason):
+                                a = run(new, req, thinking, parts, stream_tools, recover, reason)
+                                b = run(old, req, thinking, parts, stream_tools, recover, reason)
+                                self.assertEqual(joined(a), joined(b))
+                                if a != b:
+                                    regrouped.append((label, cut))
+                                    self.assertNotIn(cut, ("size1", "size2", "size3", "random"))
+                                    self.assertIn("</parameter>", text)
+                                n += 1
+        self.assertGreater(n, 1000)
+        print(f"\n[replay] {n} runs; tool_args regrouped (same text) in {len(regrouped)}: {sorted(set(regrouped))}",
+              file=sys.stderr)
+
+    def test_the_outputs_mean_what_genesis_expects(self):
+        """A sanity check of the replay itself (the new parser): calls, their arguments and the visible text."""
+        def collect(label):
