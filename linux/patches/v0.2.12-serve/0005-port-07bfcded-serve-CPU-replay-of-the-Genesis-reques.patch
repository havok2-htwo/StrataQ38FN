+         "temperature": 0.1, "max_tokens": 2048, "tools": [GET_TIME], "chat_template_kwargs": {"reasoning_effort": "low"},
+         "reasoning_budget": 2048, "stream": True, "stream_options": {"include_usage": True}}
+REQ_C_XHIGH = {**REQ_C, "chat_template_kwargs": {"reasoning_effort": "xhigh"}}
