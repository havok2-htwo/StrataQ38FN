+REQ_A = {"messages": [{"role": "user", "content": "Antworte nur mit OK."}], "temperature": 0, "max_tokens": 24,
+         "chat_template_kwargs": {"enable_thinking": False}, "stream": True, "stream_options": {"include_usage": True}}
+REQ_B = {**REQ_A, "response_format": {"type": "json_object"}}
+REQ_B_LOGPROBS = {**REQ_B, "logprobs": True, "top_logprobs": 2}
+REQ_C = {"messages": [{"role": "system", "content": "Du bist ein Testagent."},
