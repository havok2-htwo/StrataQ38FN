+    "c_call_prose": ("c", True, "Uhrzeit gefragt.\n</think>\n\nIch rufe das Werkzeug auf.\n\n" + call("get_time")),
+    "c_call_no_params_inline": ("c", True, "ok\n</think>\n\n<tool_call>\n<function=get_time>\n</function>\n</tool_call>"),
+    "c_reasoning_quotes_markup": ("c_xhigh", True,
