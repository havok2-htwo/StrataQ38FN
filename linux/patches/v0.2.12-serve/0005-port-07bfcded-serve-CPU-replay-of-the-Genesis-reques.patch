+REQUESTS = {"a": REQ_A, "b": REQ_B, "b_logprobs": REQ_B_LOGPROBS, "c": REQ_C, "c_xhigh": REQ_C_XHIGH,
+            "c_top": REQ_C_TOP, "c_files": REQ_C_FILES, "d": REQ_D}
+
+# ------------------------------------------------------------------------------------------------ the outputs
+FENCED = ("# Notizen\n\nSo ruft man es auf:\n\n```python\nimport time\n\n\ndef now():\n    return time.strftime('%H:%M')\n"
+          "```\n\nUnd in der Shell:\n\n```bash\ndate +%H:%M\n```\n")
+LITERAL_CLOSE = ("Das Format schliesst einen Wert mit </parameter> ab, z.B. `<parameter=path>x</parameter>`.\n"
+                 "Ein </parameter> mitten im Satz ist Text.\n")
+NESTED_FENCE = "````markdown\n```json\n{\"a\": 1}\n```\n````\n"
