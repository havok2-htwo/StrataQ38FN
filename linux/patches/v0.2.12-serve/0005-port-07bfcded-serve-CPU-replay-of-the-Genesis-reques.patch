+    "c_call_in_reasoning": ("c_top", True, "Ich brauche die Zeit.\n\n" + call("get_time") + "\n</think>\n\n"),
+    "c_call_in_reasoning_end": ("c_top", True, "Ich brauche die Zeit.\n\n" + call("get_time")),
