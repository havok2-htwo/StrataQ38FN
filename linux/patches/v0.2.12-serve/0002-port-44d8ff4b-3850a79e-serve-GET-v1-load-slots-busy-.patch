+class AdmissionStateTest(unittest.TestCase):
+    """The states the batched server really has (the gate code of StrataEngine itself)."""
+
+    def setUp(self):
+        self.cancels = []
+
+    def tearDown(self):
+        for c in self.cancels:
+            c.set()
+
+    def take(self, e, plen, **kw):
+        c = threading.Event()
+        threading.Thread(target=lambda: run(e._take_control(c, plen, **kw)), daemon=True).start()
+        self.cancels.append(c)
+
+    def until(self, cond):
+        end = time.time() + 5
+        while time.time() < end and not cond():
+            time.sleep(0.01)
+        self.assertTrue(cond())
+
+    def test_a_request_waiting_for_the_control_lines_is_counted_once(self):
+        e = engine_without_process(16)
+        s = on(e)
+        self.assertTrue(e.ctl.acquire(timeout=1))           # a long read on the control lines
+        register(s)
+        for _ in range(3):
+            register(s)
+            self.take(e, 1500, new=True)
+        self.until(lambda: e.waiting == 3)
+        v = s.load_view()
+        e.ctl.release()
+        self.assertEqual(v["slots"], {"total": 16, "busy": 1, "decoding": 0, "reading_prompt": 1, "free": 15,
+                                      "waiting": 3})
+        self.assertTrue(v["would_wait"])
+        self.assertIn("queueing", v["advice"])
+
+    def test_coalesced_and_resuming_waiters_run_and_are_not_queued(self):
+        e = engine_without_process(16)
+        s = on(e)
+        with e.slot_cv:
+            e.slot_busy[0] = e.slot_busy[1] = True          # the leader's slot and its coalesced follower's
+        self.assertTrue(e.ctl.acquire(timeout=1))           # the leader reads both prompts
+        register(s)                                         # the leader
+        follower = threading.Event()
+        follower._strata_preslot = 1                        # STRATA_COALESCE_PREFILL: its prompt is read into slot 1
+        register(s)
+        threading.Thread(target=lambda: run(e._take_control(follower, 1500, new=True)), daemon=True).start()
+        self.cancels.append(follower)
+        register(s, tok_s=40.0)                             # back from its slot to the solo path (SOLO_AGAIN)
+        self.take(e, 1800)
+        register(s)                                         # a new request: it really waits
+        self.take(e, 900, new=True)
+        self.until(lambda: e.waiting == 3)
+        c = e.load_counts()
+        v = s.load_view()
+        e.ctl.release()
+        self.assertEqual((c["waiting"], c["coalesced"], c["resuming"]), (1, 1, 1))
+        self.assertEqual(v["slots"], {"total": 16, "busy": 3, "decoding": 1, "reading_prompt": 2, "free": 13,
+                                      "waiting": 1})
+        self.assertTrue(v["would_wait"])
+
+    def test_requests_waiting_for_a_slot_are_waiting(self):
+        e = engine_without_process(16)
+        s = on(e)
+        with e.slot_cv:
+            e.slot_busy = [True] * 16
+            e.admitting = 2
+        for _ in range(16):
+            register(s, tok_s=37.5)
+        register(s)
+        register(s)
+        v = s.load_view()
+        self.assertEqual((v["slots"]["busy"], v["slots"]["decoding"], v["slots"]["reading_prompt"],
+                          v["slots"]["waiting"], v["slots"]["free"]), (16, 16, 0, 2, 0))
+        self.assertIn("queueing", v["advice"])
+
