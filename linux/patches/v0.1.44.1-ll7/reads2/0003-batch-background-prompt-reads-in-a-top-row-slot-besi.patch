+            return why.empty();
+        };
+        // STRATA_PIPE_OVERLAP_KVS with --kv-resident: the park slot's QSA states (what the read writes) against every other
+        // session of the same stage (the slots' the windows use, the main one) - overlap_kvs_check for a slot
+        auto bg_kvs_check = [&](int park, std::string& why) -> bool {
+            using strata::program::KvSpan;
+            using strata::program::kv_span;
+            const strata::kernels::QsaShapes qs = strata::core::qsa_shapes(g);
+            auto spans_of = [&](const strata::core::QsaState& st, std::vector<KvSpan>& out) {
+                const uint64_t bb = strata::kernels::kv_block_bytes(qs, strata::core::qsa_kv_format(st));
+                const void* pool = st.k_q != nullptr ? (const void*) st.k_q
+                                 : st.k_q4 != nullptr ? (const void*) st.k_q4 : (const void*) st.k_pool;
+                const void* host = st.host.k_q != nullptr ? (const void*) st.host.k_q
+                                 : st.host.k_q4 != nullptr ? (const void*) st.host.k_q4 : (const void*) st.host.k_pool;
+                out.push_back(kv_span(pool, (uint64_t) st.n_slots * bb));
+                out.push_back(kv_span(host, (uint64_t) st.n_pages * bb));
+                for (const void* p : {(const void*) st.page_table, (const void*) st.map.ctl, (const void*) st.map.slot_block,
+                                      (const void*) st.idx_pooled, (const void*) st.idx_tail, (const void*) st.step})
+                    out.push_back(kv_span(p, 0));
+            };
+            auto all_of = [&](const strata::core::SessionState& u, std::vector<KvSpan>& out) {
+                for (int64_t j = 0; j < u.qsa_alloc; ++j) spans_of(u.qsa_states[u.qsa_ord0 + j], out);
+            };
+            bool disjoint = true;
+            for (int k = 0; k < n_pipe && disjoint && k < (int) bslot_ss.size(); ++k) {
+                std::vector<KvSpan> a, b;
+                all_of(*bslot_ss[(size_t) k][(size_t) park], a);
+                all_of(k == 0 ? ss : stages[(size_t) k - 1]->ss, b);
+                for (size_t j = 0; j < bslot_ss[(size_t) k].size(); ++j)
+                    if ((int) j != park) all_of(*bslot_ss[(size_t) k][j], b);
+                disjoint = strata::program::kv_spans_disjoint(a, b);
+            }
+            return strata::program::overlap_kvs_allows(pipe_overlap_env(), pipe_overlap_kvs_env(), o.kv_resident > 0,
+                                                       disjoint, why);
+        };
+        // may the read run beside the groups (overlap_gate's request-independent part, for its park slot)
