+        // ---- STRATA_READS: the background reads between the lines (ReadCtx above; bg_handoff in the request).  Only
+        // with reads held does any of this run: bg_reads is empty without STRATA_READS.
+        // a read leaves: the slot holds nothing of it (BRDONE <park> cancel|err <why>)
+        auto bg_drop = [&](ReadCtx& r, const char* kind, const std::string& why) {
+            BSlot& sl = bs[(size_t) r.park];
+            if (ckpt_pool.on()) {
+                for (ConvCheckpoint& c : sl.checks) ckpt_pool.give(std::move(c));
+                for (ConvCheckpoint& c : r.checks) ckpt_pool.give(std::move(c));
+                for (ConvCheckpoint& c : r.evicted) ckpt_pool.give(std::move(c));
+            }
+            sl.checks.clear();
+            sl.ids.clear();
+            sl.cached = sl.partial = sl.reading = sl.bg_ready = false;
+            std::fprintf(stderr, "strata batch: the background read of slot %d's request (in slot %d) ends at %lld of %lld "
+                                 "tokens: %s%s%s\n", r.slot, r.park, (long long) r.done.load(), (long long) r.h, kind,
+                         why.empty() ? "" : ": ", why.c_str());
+            std::string w = why;
+            std::replace(w.begin(), w.end(), '\n', ' ');
+            std::printf("BRDONE %d %s%s%s\n", r.park, kind, w.empty() ? "" : " ", w.c_str());
+            std::fflush(stdout);
+        };
+        // a read whose plan is read: the slot holds [0, h) as a read that gave way (the pin takes it: stage 1's resume)
+        auto bg_ready = [&](ReadCtx& r) {
+            BSlot& sl = bs[(size_t) r.park];
+            if (ckpt_pool.on())
+                for (ConvCheckpoint& c : r.evicted) ckpt_pool.give(std::move(c));
+            r.evicted.clear();
+            // the read's clock onto the main one, in its order (the cache's LRU then sees them as made now)
+            std::vector<ConvCheckpoint*> by_use;
+            for (ConvCheckpoint& c : r.checks) by_use.push_back(&c);
+            std::sort(by_use.begin(), by_use.end(), [](const ConvCheckpoint* a, const ConvCheckpoint* b) { return a->used < b->used; });
+            for (ConvCheckpoint* c : by_use) c->used = ++check_clock;
+            sl.ids.assign(r.ids32.begin(), r.ids32.begin() + r.h);
+            sl.cached = true;
+            sl.partial = true;
+            sl.partial_from0 = r.from0;
+            sl.cvec = r.cvec;
+            sl.checks = std::move(r.checks);
+            sl.partial_next_check = r.next_check;
+            sl.partial_resume0 = r.resume0;
+            sl.partial_part_next = r.part_next;
+            sl.partial_tail_saved = r.tail_saved;
+            sl.partial_tail_len = r.tail_len;
+            sl.reading = false;
+            sl.bg_ready = true;
+            sl.tainted = false;
+            if (const int j = lane_of(r.park); j >= 0) lane_dk[j] = -1;
+            const double ms = std::chrono::duration<double, std::milli>(Clock::now() - r.t0).count();
+            std::fprintf(stderr, "strata batch: the background read of slot %d's request is ready in slot %d: %lld tokens "
+                                 "read in %.0f ms since the hand-over (%.1f tok/s), %zu checkpoint(s)\n", r.slot, r.park,
+                         (long long) (r.h - r.at), ms, ms > 0 ? 1000.0 * (double) (r.h - r.at) / ms : 0.0, sl.checks.size());
+            std::printf("BREADY %d %lld\n", r.park, (long long) r.h);
+            std::fflush(stdout);
+        };
+        // after a run: the reads that are done, failed or cancelled leave the list
+        auto bg_events = [&]() {
+            for (size_t i = 0; i < bg_reads.size();) {
+                ReadCtx& r = *bg_reads[i];
+                if (r.cancelled.load()) bg_drop(r, "cancel", "");
+                else if (r.failed) bg_drop(r, "err", r.err);
+                else if (r.done.load() >= r.h) bg_ready(r);
+                else { ++i; continue; }
+                bg_reads.erase(bg_reads.begin() + (std::ptrdiff_t) i);
+            }
+        };
+        auto bg_drop_all = [&](const std::string& why) {
+            for (auto& r : bg_reads) bg_drop(*r, "err", why);
+            bg_reads.clear();
+        };
+        // region 0 of the M-RoPE table back to the identity (a picture's request left its positions there): what the next
+        // text request would do itself.  Only between the lines, with the groups drained, and only where no batch row reads
+        // region 0 (the slots' own regions: --vision with mrope_slot_n > 0)
+        auto bg_mrope_identity = [&]() -> bool {
+            if (mrope_identity) return true;
+            if (!o.vision || mrope_slot_n == 0 || d_mrope == nullptr || mrope_host.empty()) return false;
+            const int64_t cells = (int64_t) mrope_host.size() / 3;
+            for (int64_t c = 0; c < cells; ++c)
+                mrope_host[(size_t) c * 3] = mrope_host[(size_t) c * 3 + 1] = mrope_host[(size_t) c * 3 + 2] = (int32_t) c;
+            cudaDeviceSynchronize();
+            bool ok = cudaMemcpy(d_mrope, mrope_host.data(), mrope_host.size() * sizeof(int32_t), cudaMemcpyHostToDevice) ==
+                      cudaSuccess;
+            for (auto& st : stages) {
+                const strata::core::OnDevice on(st->dev);
+                cudaDeviceSynchronize();
+                ok = ok && cudaMemcpy(st->mrope, mrope_host.data(), mrope_host.size() * sizeof(int32_t),
+                                      cudaMemcpyHostToDevice) == cudaSuccess;
+            }
+            if (!ok) return false;
+            mrope_identity = true;
+            return true;
+        };
+        // what the read itself needs (any way it is read): the chunk it was planned with on every stage (A2: a relayout
+        // or a loan changes it), region 0 the identity, its sessions as at the hand-over, no picture rows
+        auto bg_can_read = [&](ReadCtx& r, std::string& why) -> bool {
+            if (sp.chunk() != r.chunk) why = "the prompt path's chunk changed since the hand-over";
+            for (auto& st : stages)
+                if (why.empty() && st->sp.chunk() != r.chunk) why = "a stage's prompt chunk changed since the hand-over";
+            if (why.empty() && std::any_of(pf_parts.begin(), pf_parts.end(), [](const PfPart& p) { return !p.lent.empty(); }))
+                why = "expert cache slots are lent to the prompt path";
+            if (why.empty() && !mrope_identity && !(pipe_drain() && bg_mrope_identity()))
