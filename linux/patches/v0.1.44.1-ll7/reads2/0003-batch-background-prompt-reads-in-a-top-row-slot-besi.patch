+                if (!stage_verifier(k).ar_live()) { why = "stage " + std::to_string(k + 1) + " runs the doorbell graph"; return false; }
+            if (o.kv_resident > 0 && !pipe_overlap_kvs_env()) { why = "K/V streaming (--kv-resident)"; return false; }
+            if (o.kv_resident > 0 && !bg_kvs_check(r.park, why)) return false;
