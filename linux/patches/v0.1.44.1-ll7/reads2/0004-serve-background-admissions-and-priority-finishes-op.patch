+    def _reads_row(self) -> int:
+        """STRATA_SERVER_READS: the engine's rule for a slot a background read may read into (INFO reads_row=k: b % k ==
+        k - 1); 0: no background reads (the switch off, or an engine without STRATA_READS)."""
