+            return 0
+        k = info.get("reads_row")
+        return k if isinstance(k, int) and k >= 1 else 1
+
+    def _reads_park_pick(self, own):
+        """STRATA_SERVER_READS (the caller holds slot_cv): the slot a background read reads into - the admission's own
+        when it is a top row, else a free top-row slot (empty first, then the one used longest ago).  None: none free,
+        or the engine holds as many background reads as it takes (INFO reads)."""
+        k = self._reads_row()
+        if k <= 0 or len(self.bg_parks) >= int((self.info or {}).get("reads") or 0):
+            return None
+        ok = lambda b: k <= 1 or b % k == k - 1
+        if own is not None and ok(own):
+            return own
+        free = [b for b in self.slot_order if not self.slot_busy[b] and ok(b) and b not in self.bg_parks]
+        if not free:
+            return None
+        return min(free, key=lambda b: (bool(self.slot_held[b]), self.slot_used[b]))
+
+    def _bg_wait(self, park: int, cancel, live: dict):
+        """STRATA_SERVER_READS: waits for the background read in `park` (its lines come on the slot's queue), yielding
+        None heartbeats; a cancel sends BSTOP <park> once.  Returns ("ready", h), ("cancel", why) or ("err", why)."""
+        q = self.slot_q[park]
+        stopped = False
+        beat = time.monotonic()
+        try:
+            while True:
+                try:
+                    line = q.get(timeout=0.5)
+                except queue.Empty:
+                    if cancel.is_set() and not stopped:
+                        self._send(f"BSTOP {park}")
+                        stopped = True
+                    if time.monotonic() - beat >= 10.0:
+                        beat = time.monotonic()
+                        yield None
+                    continue
+                if line is None:
+                    raise EngineDied(f"the engine stopped unexpectedly (exit code {self.exit_code()})")
+                f = line.split()
+                if line.startswith("BPP "):
+                    if len(f) >= 3 and f[2].isdigit():
+                        live["read"] = int(f[2])
+                    if cancel.is_set() and not stopped:
+                        self._send(f"BSTOP {park}")
+                        stopped = True
+                    beat = time.monotonic()
+                    yield None
+                elif line.startswith("BREADY "):
+                    return ("ready", int(f[2]) if len(f) >= 3 and f[2].isdigit() else 0)
+                elif line.startswith("BRDONE "):
+                    return (f[2] if len(f) >= 3 else "err", " ".join(f[3:]))
+        finally:
+            with self.slot_cv:
+                self.bg_parks.discard(park)
+                self.slot_cv.notify_all()
+
+    def _release_bg_when_done(self, park: int):
+        """STRATA_SERVER_READS: a request left while its read was in the background: BSTOP the read and free its park
+        slot once the engine says BRDONE (or BREADY: it was done anyway), in the background."""
+        if park >= len(self.slot_q):
+            return
+        try:
+            self._send(f"BSTOP {park}")
+        except EngineDied:
+            pass
+        q, busy, releasing = self.slot_q[park], self.slot_busy, self.slot_releasing
+        releasing.add(park)
+
+        def wait():
+            end = time.monotonic() + 600.0
+            while time.monotonic() < end:
+                try:
+                    line = q.get(timeout=5.0)
+                except queue.Empty:
+                    continue
+                if line is None or line.startswith(("BRDONE ", "BREADY ")):
+                    break
+            with self.slot_cv:
+                self.bg_parks.discard(park)
+                busy[park] = False
+                releasing.discard(park)
+                self.slot_cv.notify_all()
+        threading.Thread(target=wait, daemon=True).start()
