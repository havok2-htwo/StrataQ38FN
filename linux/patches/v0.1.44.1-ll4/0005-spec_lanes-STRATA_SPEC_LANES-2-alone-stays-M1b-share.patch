 /// admitted, so every one runs admission -> lane windows only.  True while 1 <= n < k lane slots decode, each fresh
 /// and lane_ok, and nothing else.  (k = 2 is M1b's HOLD=1: one lone fresh lane slot.)
+/// (review: k = 2 is exactly M1b's rule - a lone fresh lane slot waits whether or not it may run in a lane; k >= 3
+/// holds only lane_ok slots, since a slot that may not run in a lane would keep the others waiting for nothing)
 inline bool hold(const Slot* lanes, int L, bool others_active, int k) {
-    const int n = lane_count(lanes, L, others_active);
-    if (n < 1 || n >= k) return false;
-    for (int j = 0; j < L; ++j)
-        if (lanes[j].active && !lanes[j].fresh) return false;
-    return true;
+    if (others_active) return false;
+    int n = 0;
+    for (int j = 0; j < L; ++j) {
+        if (!lanes[j].active) continue;
+        if (!lanes[j].fresh || (k != 2 && !lanes[j].lane_ok)) return false;
+        ++n;
+    }
+    return n >= 1 && n < k;
 }
 /// STRATA_SPEC_LANES_HOLD's value: unset / empty / "0": off (0); "1": M1b's (2); k = 2..L: k; more than L: L.
 inline int env_hold(const char* v, int L) {
@@ -88,7 +93,22 @@ inline int env_hold(const char* v, int L) {
     return std::min(std::max(k, 2), std::max(L, 2));
 }
 
-// ---- The shared VRAM (STRATA_SPEC_LANES with STRATA_LC_SHARE, the default).  The modes never run at once (every
+/// The shared-VRAM profile's default (STRATA_LC_SHARE unset; review of the low-concurrency modes): on for 3 and 4
+/// lanes, off for 2 - STRATA_SPEC_LANES=2 alone is M1b as deployed (an arena per lane, KEEP=0, M1b's boot rule, the
+/// solo pipeline's graphs captured at its first request), so a binary swap under production's config changes nothing.
+inline bool share_default(int lanes) { return lanes >= 3; }
+/// A switch with a default: unset: `def`; set: its number, non-zero on (so "" and "0" are off, as before).
+inline bool env_flag(const char* v, bool def) {
+    if (v == nullptr) return def;
+    long n = 0;
+    bool neg = false;
+    const char* c = v;
+    if (*c == '-' || *c == '+') neg = *c++ == '-';
+    while (*c >= '0' && *c <= '9') n = n * 10 + (*c++ - '0');
+    return (neg ? -n : n) != 0;
+}
+
+// ---- The shared VRAM (STRATA_SPEC_LANES with STRATA_LC_SHARE: the default for 3 and 4 lanes).  The modes never run at once (every
 // line but BSTOP/BYIELD drains the lanes; the solo path runs only with nothing else), so a lane's verifier carves its
 // buffers from the arena of a verifier that is idle while the lanes run: lane 0 from the stage's main verifier (the
 // batch windows', the serial solo windows'), lane 1 from the solo pipeline's second verifier (when there is one).
@@ -102,20 +122,24 @@ inline int own_arenas(int L, bool share, bool has_b) {
     return std::max(0, L - (has_b ? 2 : 1));
 }
 
-/// Do the solo pipeline's two GDN snapshots of a front stage (`snap_bytes` each, 256-aligned) fit in lane 2's arena?
-inline bool snaps_in_lane(int L, bool share, bool has_b, int64_t snap_bytes, int64_t arena_bytes) {
+/// Do the solo pipeline's two GDN snapshots of a front stage (`snap_bytes` each, 256-aligned) fit in lane 2's arena
+/// below its first buffer that outlives a window (`room`: Verifier::persist_offset - argmax_rows' counter and the
+/// constant 1 sit there, and nothing may overwrite them; review)?
+inline bool snaps_in_lane(int L, bool share, bool has_b, int64_t snap_bytes, int64_t room) {
     const int64_t one = (snap_bytes + 255) & ~(int64_t) 255;
-    return share && has_b && L >= 3 && snap_bytes > 0 && 2 * one <= arena_bytes;
+    return share && has_b && L >= 3 && snap_bytes > 0 && 2 * one <= room;
 }
 
 /// What L lanes take on one card (bytes, estimated before they are made): their own arenas (`arena` each, with the
 /// verifier object `obj`), each lane's graphs and objects (`per_lane`), less the snapshots (`snap_total`, both
 /// buffers) that move into lane 2's arena instead of their own allocation.
-inline int64_t lanes_cost(int L, bool share, bool has_b, int64_t arena, int64_t per_lane, int64_t snap_total) {
+/// (`room`: the arena's bytes below its persistent buffers, Verifier::persist_offset; snaps_in_lane)
+inline int64_t lanes_cost(int L, bool share, bool has_b, int64_t arena, int64_t per_lane, int64_t snap_total,
+                          int64_t room) {
     if (L <= 0) return 0;
     const int own = own_arenas(L, share, has_b);
     int64_t c = (int64_t) own * arena + (int64_t) L * per_lane;
-    if (snap_total > 0 && snaps_in_lane(L, share, has_b, snap_total / 2, arena)) c -= snap_total;
+    if (snap_total > 0 && snaps_in_lane(L, share, has_b, snap_total / 2, room)) c -= snap_total;
     return c;
 }
 
