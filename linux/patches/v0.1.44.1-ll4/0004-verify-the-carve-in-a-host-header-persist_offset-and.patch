diff --git a/tests/core/arena_carve_test.cpp b/tests/core/arena_carve_test.cpp
new file mode 100644
index 00000000..170b34a1
--- /dev/null
+++ b/tests/core/arena_carve_test.cpp
@@ -0,0 +1,67 @@
+// The verifier's arena carve (include/strata/core/arena_carve.hpp): the counting pass and the carving pass agree, every
+// buffer is 256-aligned, the signature tells two layouts apart, and poison_arena's keep range is what it checks.
+// Host only: no model, no GPU.
+#include "strata/core/arena_carve.hpp"
+
+#include <cstdint>
+#include <cstdio>
+#include <vector>
+
+namespace ac = strata::core::arena_carve;
+
+namespace {
+int failures = 0;
+void check(bool ok, const char* what) {
+    if (!ok) {
+        std::fprintf(stderr, "FAIL: %s\n", what);
+        ++failures;
+    }
+}
+// a carve shaped like Verifier::init's tail: scratch rows (T), the head's logits, argmax_rows' scratch, one_, hist_snap_
+struct Ptrs { float* rows; float* logits; uint8_t* arg; int32_t* one; float* hist; };
+Ptrs carve(ac::Bump& b, uint64_t T, uint64_t vocab) {
+    Ptrs p;
+    p.rows = b.take<float>(T * 4096);
+    p.logits = b.take<float>(T * vocab);
+    p.arg = b.take<uint8_t>(T * 24 + 8);
+    p.one = b.take<int32_t>(4);
+    p.hist = b.take<float>(T * 64);
+    return p;
+}
+}  // namespace
+
+int main() {
+    ac::Bump c1, c2, c3;
+    carve(c1, 8, 1000);
+    carve(c2, 8, 1000);
+    carve(c3, 6, 1000);
+    check(c1.used == c2.used && c1.sig == c2.sig, "the same carve: the same bytes and signature");
+    check(c1.sig != c3.sig, "another T: another signature");
+    ac::Bump c4;
+    carve(c4, 8, 1001);
+    check(c4.sig != c1.sig, "another size of one buffer: another signature");
+    // the same total with the buffers in another order: still another signature (offsets are hashed)
+    ac::Bump x, y;
+    x.take<uint8_t>(256); x.take<uint8_t>(512);
+    y.take<uint8_t>(512); y.take<uint8_t>(256);
+    check(x.used == y.used && x.sig != y.sig, "another order: another signature");
+
+    std::vector<uint8_t> mem(c1.used + 256);
+    ac::Bump real;
+    real.base = mem.data();
+    const Ptrs p = carve(real, 8, 1000);
+    check(real.used == c1.used && real.sig == c1.sig, "the carving pass is the counting pass");
+    for (const void* q : {(const void*) p.rows, (const void*) p.logits, (const void*) p.arg, (const void*) p.one,
+                          (const void*) p.hist})
+        check(((const uint8_t*) q - mem.data()) % 256 == 0, "every buffer 256-aligned from the base");
+    const uint8_t* a = mem.data();
+    check(ac::keep_range_ok(a, real.used, p.arg, (const uint8_t*) p.one, (const uint8_t*) p.hist), "the keep range: ordered");
+    check(!ac::keep_range_ok(a, real.used, (const uint8_t*) p.one, p.arg, (const uint8_t*) p.hist), "swapped: refused");
+    check(!ac::keep_range_ok(a, (size_t) ((const uint8_t*) p.hist - a) - 1, p.arg, (const uint8_t*) p.one,
+                             (const uint8_t*) p.hist), "the next buffer past the end: refused");
+    check(!ac::keep_range_ok(nullptr, real.used, p.arg, (const uint8_t*) p.one, (const uint8_t*) p.hist), "no arena: refused");
+    // the persistent offset (Verifier::persist_offset) is argmax_rows' scratch: what lies below it is scratch
+    const size_t persist = (size_t) (p.arg - a);
+    check(persist > (size_t) ((const uint8_t*) p.logits - a), "the persistent tail after the logits");
+    return failures == 0 ? 0 : 1;
+}
