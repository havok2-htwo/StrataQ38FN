--- /dev/null
+++ b/include/strata/core/arena_carve.hpp
@@ -0,0 +1,35 @@
+// include/strata/core/arena_carve.hpp - the verifier's device-arena carve (header-only, host: no CUDA).
+//
+// Verifier::init lays every device buffer out in one arena: a counting pass (base null) sizes it, a second pass with
+// the allocation's base hands out the pointers.  Each buffer starts 256-aligned.  The signature is an FNV-1a hash of
+// every buffer's offset and size, so two verifiers with the same signature lay their buffers out alike
+// (Verifier::carve_signature; STRATA_SPEC_LANES' shared arenas check it before a verifier carves another's arena).
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace strata::core::arena_carve {
+
+struct Bump {
+    uint8_t* base = nullptr;
+    uint64_t used = 0;
+    uint64_t sig = 1469598103934665603ull;   // FNV-1a over every buffer's offset and size
+    template <typename T> T* take(uint64_t n) {
+        T* p = base ? (T*) (base + used) : nullptr;
+        const uint64_t sz = (n * sizeof(T) + 255) & ~255ull;
+        sig = (sig ^ used) * 1099511628211ull;
+        sig = (sig ^ sz) * 1099511628211ull;
+        used += sz;
+        return p;
+    }
+};
+
+/// Verifier::poison_arena's precondition: inside the arena [a, a + bytes) the buffers a window reads before it writes
+/// them - argmax_rows' scratch (`keep0`) and the constant 1 (`one`) - lie in that order, followed by the buffer carved
+/// next (`keep1`), so filling [a, keep0) and [keep1, a + bytes) leaves exactly those two alone.
+inline bool keep_range_ok(const uint8_t* a, size_t bytes, const uint8_t* keep0, const uint8_t* one, const uint8_t* keep1) {
+    return a != nullptr && a <= keep0 && keep0 < one && one < keep1 && keep1 <= a + bytes;
+}
+
+}  // namespace strata::core::arena_carve
diff --git a/include/strata/core/verify.hpp b/include/strata/core/verify.hpp
index f9464751..8ae51d83 100644
--- a/include/strata/core/verify.hpp
+++ b/include/strata/core/verify.hpp
@@ -304,6 +304,13 @@ public:
     size_t arena_bytes() const { return arena_bytes_; }
     uint64_t carve_signature() const { return carve_sig_; }
     bool arena_external() const { return arena_ext_; }
+    /// The offset of the arena's first buffer that outlives a window (argmax_rows' self-resetting counter, then the
+    /// constant 1; poison_arena keeps both): what lies below it is the windows' scratch, which another user of the
+    /// arena (the solo pipeline's GDN snapshots in lane 2's, STRATA_SPEC_LANES) may overwrite between windows.  After
+    /// `init` (before it: 0).
+    size_t persist_offset() const {
+        return arena_ != nullptr && arg_scratch_ != nullptr ? (size_t) (arg_scratch_ - (const uint8_t*) arena_) : 0;
+    }
     /// STRATA_LC_POISON (testing): queue on `s` a fill of every arena byte with `byte`, except the buffers a window
