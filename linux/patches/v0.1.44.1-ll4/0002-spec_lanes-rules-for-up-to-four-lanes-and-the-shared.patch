@@ -35,6 +40,10 @@ int main() {
     check(!sl::lane_slots(16, 1, 2, ls), "one group: no lanes");
     check(!sl::lane_slots(0, 4, 2, ls), "no slots: no lanes");
     check(!sl::lane_slots(15, 4, 2, ls), "groups that do not divide the slots: no lanes");
+    check(sl::lane_slots(16, 4, 4, ls) && ls[0] == 0 && ls[1] == 4 && ls[2] == 8 && ls[3] == 12,
