@@ -1,4 +1,4 @@
-// include/strata/program/spec_lanes.hpp - STRATA_SPEC_LANES=2 (opt-in): spec lanes beside the --batch slot groups
+// include/strata/program/spec_lanes.hpp - STRATA_SPEC_LANES=2..4 (opt-in): spec lanes beside the --batch slot groups
