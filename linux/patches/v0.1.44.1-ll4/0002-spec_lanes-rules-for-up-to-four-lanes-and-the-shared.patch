     // the gate: both lane slots active, nothing else, both lane_ok
     sl::Slot both[2] = {{true, true}, {true, true}};
@@ -49,6 +58,93 @@ int main() {
     check(!sl::gate(none, 2, false, true), "nothing active: no lanes");
     check(!sl::gate(img, 2, false, true), "one: an active slot that may not run in a lane stops them");
 
+    // the generalized gates (up to four lanes): start with n_min .. L lane slots, keep while one decodes
+    {
+        sl::Slot s4[4] = {{true, true}, {true, true}, {false, false}, {false, false}};
+        check(sl::lane_count(s4, 4, false) == 2, "two of four lane slots active");
+        check(sl::gate_start(s4, 4, false, 2), "two users of up to four: lanes");
+        check(!sl::gate_start(s4, 4, false, 4), "n_min 4 (every lane slot): not with two");
+        check(!sl::gate_start(s4, 4, true, 2), "a fifth user on a non-lane slot: the pump");
+        s4[2] = {true, true};
+        s4[3] = {true, true};
