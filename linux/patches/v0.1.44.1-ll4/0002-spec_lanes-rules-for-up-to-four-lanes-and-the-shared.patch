+    // the shared arenas: what a card allocates for L lanes
+    {
+        check(sl::own_arenas(2, true, true) == 0, "M1a + 2 lanes shared: no arena of their own");
+        check(sl::own_arenas(4, true, true) == 2, "4 lanes shared: lanes 2 and 3");
+        check(sl::own_arenas(3, true, false) == 2, "3 lanes without M1a: lanes 1 and 2");
+        check(sl::own_arenas(2, false, true) == 2, "STRATA_LC_SHARE=0: one each (M1b)");
+        check(sl::own_arenas(0, true, true) == 0, "no lanes: nothing");
