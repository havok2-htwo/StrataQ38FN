#!/usr/bin/env python3
# stdin/stdout proxy around strata-g3-142fc: timestamps every BGEN (head only, waiting=N) and BADM/BDONE/DONE/ERR line
import os, subprocess, sys, threading, time
ENG = "/media/raid0/StrataQ38FN/Strata/engine/strata-g3-142fc"
if "--serve" not in sys.argv[1:]:
    os.execv(ENG, [ENG] + sys.argv[1:])
LOG = open(os.environ.get("QPROBE_LOG", "/media/raid0/StrataQ38FN/linux/results/batchadmit/qprobe/proto.log"), "a", buffering=1)
lk = threading.Lock()
def log(d, l):
    with lk:
        LOG.write(f"{time.monotonic():.4f} {d} {l}\n")
p = subprocess.Popen([ENG] + sys.argv[1:], stdin=subprocess.PIPE, stdout=subprocess.PIPE, bufsize=0)
def fwd_in():
    try:
        for line in sys.stdin.buffer:
            if line.startswith((b"BGEN", b"BSTOP", b"BYIELD", b"STOP", b"GEN")):
                h = line[:160].decode("utf-8", "replace")
                cut = h.find(",")
                log(">", h[:cut] if cut > 0 else h.strip())
            p.stdin.write(line); p.stdin.flush()
    except Exception as e:
        log("!", f"in: {e}")
    try: p.stdin.close()
    except Exception: pass
threading.Thread(target=fwd_in, daemon=True).start()
out = sys.stdout.buffer
for line in p.stdout:
    if line.startswith((b"BADM", b"BDONE", b"DONE", b"ERR", b"READY", b"REUSED")):
        log("<", line.decode("utf-8", "replace").strip()[:100])
    out.write(line); out.flush()
sys.exit(p.wait())
